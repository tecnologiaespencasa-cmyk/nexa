<section class="home-hero">
    <img class="home-hero-banner"
         src="~/images/oficina-banner.jpeg"
         asp-append-version="true"
         alt="Equipo de Especialistas en Casa en la oficina" />
    <div class="home-hero-backdrop"></div>

    <div class="home-hero-content">
        <div class="home-shell home-hero-grid">
            <div class="home-hero-copy">
                <span class="home-kicker">Sistema Nexa</span>
                <h1 class="home-hero-title">Bienvenido, @fullName</h1>
                <p class="home-hero-subtitle">Especialistas en casa</p>
                <p class="home-hero-description">
                    Tu punto de entrada para iniciar la jornada con contexto claro, accesos directos y la
                    informacion clave siempre visible.
                </p>
            </div>

            <div class="home-hero-side">
                <img class="home-brand-logo"
                     src="~/images/especialistas-en-casa-logo.png"
                     asp-append-version="true"
                     alt="Especialistas en Casa" />

                <div class="home-clock-panel" aria-live="polite">
                    <span class="home-clock-label">Fecha y hora actual</span>
                    <strong id="home-current-time">@serverNow.ToString("hh:mm:ss tt", culture)</strong>
                    <span id="home-current-date">@culture.TextInfo.ToTitleCase(serverNow.ToString("dddd, dd 'de' MMMM 'de' yyyy", culture))</span>
                </div>
            </div>
        </div>
    </div>

    <div class="home-hero-ribbon">
        <div class="home-shell home-hero-ribbon-grid">
            <div class="home-ribbon-item">
                <span>Usuario activo</span>
                <strong>@fullName</strong>
            </div>
            <div class="home-ribbon-item">
                <span>Plataforma</span>
                <strong>Nexa</strong>
            </div>
            <div class="home-ribbon-item">
                <span>Operacion</span>
                <strong>Especialistas en Casa</strong>
            </div>
        </div>
    </div>
</section>

<section class="home-overview">
    <div class="home-shell">
        <div class="home-section-heading">
            <div>
                <span class="home-section-kicker">Centro de ayuda</span>
                <h2>Documentación, políticas y material de apoyo</h2>
            </div>
            <p>Todo el material institucional vive en Mi espacio corporativo, junto con los equipos que tienes asignados.</p>
        </div>

        <div class="home-resource-grid">
            <article class="home-resource-card">
                <span class="home-resource-icon" aria-hidden="true"><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i></span>
                <div class="home-resource-content">
                    <strong>Políticas y manuales</strong>
                    <span>Consulta el material oficial de cada área, siempre en su versión vigente.</span>
                </div>
            </article>

            <article class="home-resource-card">
                <span class="home-resource-icon" aria-hidden="true"><i class="bi bi-search" aria-hidden="true"></i></span>
                <div class="home-resource-content">
                    <strong>Búsqueda y favoritos</strong>
                    <span>Filtra por categoría o tipo de documento y marca como favoritos los que más usas.</span>
                </div>
            </article>

            <article class="home-resource-card">
                <span class="home-resource-icon" aria-hidden="true"><i class="bi bi-pc-display" aria-hidden="true"></i></span>
                <div class="home-resource-content">
                    <strong>Tus equipos asignados</strong>
                    <span>Revisa serial y estado de tus activos, y reporta cualquier novedad al área de TI.</span>
                </div>
            </article>
        </div>

        @if ((await AuthorizationService.AuthorizeAsync(User, SystemPermissions.EspacioCorporativoAccess)).Succeeded)
        {
            <div class="home-coming-soon">
                <div class="home-coming-soon-copy">
                    <span class="home-coming-soon-kicker">Ya disponible</span>
                    <h3>Mi espacio corporativo</h3>
                    <p>
                        Encuentra allí la documentación publicada por cada área y la información de los equipos
                        que tienes a tu cargo.
                    </p>
                    <a class="home-coming-soon-cta" asp-controller="EspacioCorporativo" asp-action="Index">
                        Ir a Mi espacio corporativo
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const timeElement = document.getElementById("home-current-time");
            const dateElement = document.getElementById("home-current-date");

            if (!timeElement || !dateElement) {
                return;
            }

            const timeFormatter = new Intl.DateTimeFormat("es-CO", {
                timeZone: "America/Bogota",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: true
            });

            const dateFormatter = new Intl.DateTimeFormat("es-CO", {
                timeZone: "America/Bogota",
                weekday: "long",
                day: "2-digit",
                month: "long",
                year: "numeric"
            });

            const capitalize = (value) => value.charAt(0).toUpperCase() + value.slice(1);

            const updateClock = () => {
                const now = new Date();
                timeElement.textContent = timeFormatter.format(now);
                dateElement.textContent = capitalize(dateFormatter.format(now));
            };

            updateClock();
            window.setInterval(updateClock, 1000);
        })();
    </script>
}
