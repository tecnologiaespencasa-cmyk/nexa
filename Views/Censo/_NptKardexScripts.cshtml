@model CensoNptViewModel
@*
    Requisición de insumos de NPT.

    Es el mismo documento que el de clínica de heridas, así que comparte sus estilos, pero el
    guion es propio y bastante más corto: NPT no tiene planes, ni tipos de atención, ni apósitos
    que elegir. Los ids llevan prefijo nptKardex porque un paciente puede tener heridas y NPT
    abiertos a la vez y los dos modales conviven en la misma página.
*@
@* Valores del servidor para wwwroot/js/censo/npt-kardex.js. El resto del script es estático
   y el navegador lo guarda en caché. *@
<script>
    window.NexaCenso = window.NexaCenso || {};
    window.NexaCenso.nptKardex = {
        recordId: @Json.Serialize(Model.EditingRecordId),
        kardexUrl: "@Url.Action("KardexNpt", "Censo")",
        guardarUrl: "@Url.Action("GuardarKardexNpt", "Censo")",
        enviarUrl: "@Url.Action("EnviarKardexNptAFarmacia", "Censo")",
        adjuntoUrl: "@Url.Action("SubirAdjuntoKardexNpt", "Censo")",
        adjuntoEliminarUrl: "@Url.Action("EliminarAdjuntoKardexNpt", "Censo")",
        adjuntoDescargaUrl: "@Url.Action("DescargarAdjuntoKardexNpt", "Censo")",
    };
</script>
<script src="~/js/censo/npt-kardex.js" asp-append-version="true"></script>
