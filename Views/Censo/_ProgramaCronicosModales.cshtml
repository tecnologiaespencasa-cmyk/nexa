@model CensoCronicoViewModel
@*
    Modales de este programa (kardex, requisicion, confirmaciones).

    Se renderizan fuera de .censo-page a proposito: esa capa declara isolation: isolate, que
    crea su propio contexto de apilamiento. Un modal declarado dentro queda atrapado en el,
    mientras Bootstrap cuelga el fondo oscuro del body, y el fondo termina tapando al modal:
    la pantalla se ve negra y no se puede interactuar ni cerrar.
*@
@*
    Formulario del programa dentro de la pantalla unica de censo.

    Es el mismo marcado que tenia la pantalla independiente y envia a la misma accion, para
    que kardex, requisiciones, farmacia y prorrogas sigan funcionando igual. Los cambios son
    dos: los identificadores de panel llevan el prefijo del programa, porque los cinco
    conviven ahora en un mismo documento, y los campos que subieron al maestro de paciente
    viajan ocultos, para que la validacion de este censo siga recibiendo el modelo completo.
*@
@using Nexa.Data.Entities
@using System.Text.Json


@{
    ViewData["Title"] = "Programa Cronicos";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var sondaVesicalActiva = string.Equals(Model.SondaVesical, "Si", StringComparison.OrdinalIgnoreCase);
    var mipresPanalesActivo = string.Equals(Model.MipresPanales, "Si", StringComparison.OrdinalIgnoreCase);
    var mipresNutricionActivo = string.Equals(Model.MipresNutricion, "Si", StringComparison.OrdinalIgnoreCase);
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
    var medicamentoCatalogJson = JsonSerializer.Serialize(Model.MedicamentoCatalog);
    var kardexDocumentoCronico = $"{Model.TipoIdentificacion} {Model.NumeroIdentificacion}".Trim();
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");
}

<div class="modal fade censo-kardex-modal" id="cronicoKardexModal" tabindex="-1" aria-labelledby="cronicoKardexModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header censo-document-header">
                <div class="censo-document-header__title">
                    <span class="censo-card-heading__eyebrow">Programa Cr&oacute;nicos</span>
                    <h5 class="modal-title" id="cronicoKardexModalTitle">Gestionar kardex y requisici&oacute;n</h5>
                    <span class="censo-document-context-badge censo-document-context-badge--prorroga" id="cronicoDocumentContextBadge" aria-live="polite"></span>
                </div>
                <div class="censo-document-switch censo-document-switch--header" role="tablist" aria-label="Seleccionar documento">
                    <button type="button" class="censo-document-switch__button active" id="cronicoKardexTabButton" data-cronico-document-target="kardex" role="tab" aria-selected="true" aria-controls="cronicoKardexPane">Kardex</button>
                    <button type="button" class="censo-document-switch__button" id="cronicoRequisicionTabButton" data-cronico-document-target="requisicion" role="tab" aria-selected="false" aria-controls="cronicoRequisicionPane">Requisici&oacute;n</button>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning d-none censo-document-closed-banner" id="cronicoDocumentClosedBanner" role="alert">
                    <strong>Kardex cerrado.</strong> Este kardex y su requisici&oacute;n ya fueron aprobados por farmacia y quedan solo para consulta.
                </div>
                <section class="censo-document-pane active" id="cronicoKardexPane" data-cronico-document-pane="kardex" role="tabpanel" aria-labelledby="cronicoKardexTabButton">
                <div class="censo-kardex-sheet" aria-label="Kardex aplicaci&oacute;n de medicamentos">
                    <div class="censo-kardex-sheet__head">
                        <div class="censo-kardex-sheet__logo">
                            <img src="~/images/logo.png" asp-append-version="true" alt="Especialistas En Casa" />
                        </div>
                        <div class="censo-kardex-sheet__title">KARDEX APLICACI&Oacute;N DE MEDICAMENTOS</div>
                        <div class="censo-kardex-sheet__meta">
                            <label>C&oacute;digo:<input data-kardex-field="codigoFormato" value="FO-SEF-07" /></label>
                            <label>Versi&oacute;n:<input data-kardex-field="versionFormato" value="04" /></label>
                            <label>pagina:<input data-kardex-field="paginaFormato" value="1 de 1" /></label>
                            <label>Fecha:<input data-kardex-field="fechaFormato" value="01/05/2026" /></label>
                        </div>
                    </div>

                    <div class="censo-kardex-patient-table">
                        <div class="censo-kardex-section-title censo-kardex-section-title--patient">Datos del paciente</div>
                        <div class="censo-kardex-section-title censo-kardex-section-title--payer">Asegurador</div>
                        <div class="censo-kardex-section-title censo-kardex-section-title--diagnosis">Diagn&oacute;stico descriptivo</div>

                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">Paciente:</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="paciente" value="@Model.NombrePaciente" />
                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">Asegurador:</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="asegurador" />
                        <textarea class="censo-kardex-patient-table__cell censo-kardex-patient-table__diagnosis" data-kardex-field="diagnostico" aria-label="Diagn&oacute;stico descriptivo"></textarea>

                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">Documento de identidad:</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="documento" value="@kardexDocumentoCronico" />
                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">Peso:</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="peso" />

                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">Direccion:</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="direccion" value="@Model.Direccion" />
                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">Edad:</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="edad" value="@Model.Edad" />

                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">telefonos:</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="telefonos" />
                        <label class="censo-kardex-patient-table__cell censo-kardex-patient-table__label">CIE10</label>
                        <input class="censo-kardex-patient-table__cell" data-kardex-field="cie10" />
                    </div>

                    <div class="censo-kardex-section-title censo-kardex-section-title--full">Registro de aplicaci&oacute;n de medicamentos</div>
                    <div class="censo-kardex-med-table" role="table" aria-label="Medicamentos kardex">
                        <div class="censo-kardex-med-table__header" role="row">
                            <span>PRESENTACION<br />MEDICAMENTOS</span>
                            <span>DOSIS Y FRECUENCIA</span>
                            <span>VEHICULO DE RECONSTITUCION</span>
                            <span>VOLUMEN DE DILUCI&Oacute;N</span>
                            <span>TIEMPO DE INFUSI&Oacute;N</span>
                            <span>ES FOTOSENSIBLE</span>
                            <span>CADENA DE FRIO</span>
                            <span>Aislamiento</span>
                            <span>ESTABILIDAD</span>
                            <span>BOMBA DE INFUSI&Oacute;N</span>
                            <span>FECHA INICIO</span>
                            <span>FECHA FIN</span>
                        </div>
                        @for (var kardexRow = 1; kardexRow <= 6; kardexRow++)
                        {
                            <div class="censo-kardex-med-table__row @(kardexRow > 1 ? "d-none" : "")" role="row" data-kardex-med-row="@kardexRow">
                                <textarea aria-label="Presentaci&oacute;n medicamentos @kardexRow" data-kardex-med-field="presentacion">Medicamento @kardexRow</textarea>
                                <textarea aria-label="Dosis y frecuencia @kardexRow" data-kardex-med-field="dosisFrecuencia"></textarea>
                                <textarea aria-label="Veh&iacute;culo de reconstituci&oacute;n @kardexRow" data-kardex-med-field="vehiculoReconstitucion"></textarea>
                                <input aria-label="Volumen de diluci&oacute;n @kardexRow" data-kardex-med-field="volumenDilucion" />
                                <input aria-label="Tiempo de infusi&oacute;n @kardexRow" data-kardex-med-field="tiempoInfusion" />
                                <input aria-label="Es fotosensible @kardexRow" data-kardex-med-field="fotosensible" />
                                <input aria-label="Cadena de frio @kardexRow" data-kardex-med-field="cadenaFrio" />
                                <input aria-label="Aislamiento @kardexRow" data-kardex-med-field="aislamiento" />
                                <input aria-label="Estabilidad @kardexRow" data-kardex-med-field="estabilidad" />
                                <input aria-label="Bomba de infusi&oacute;n @kardexRow" data-kardex-med-field="bombaInfusion" />
                                <input aria-label="Fecha inicio @kardexRow" data-kardex-med-field="fechaInicio" />
                                <input aria-label="Fecha fin @kardexRow" data-kardex-med-field="fechaFin" />
                            </div>
                        }
                    </div>

                    <div class="censo-kardex-footer-table">
                        <label>OBSERVACI&Oacute;N:</label>
                        <textarea data-kardex-field="observaciones"></textarea>
                        <label>Cambio de equipo:</label>
                        <input data-kardex-field="cambioEquipo" value="CADA 3 DIAS" />
                        <label>MEDICO TRATANTE</label>
                        <input data-kardex-field="medicoTratante" />
                        <label>PROGRAMADOR:</label>
                        <input data-kardex-field="programador" />
                        <label>AUXILIAR ASIGNADO</label>
                        <input data-kardex-field="auxiliarAsignado" />
                    </div>
                </div>
                </section>
                <section class="censo-document-pane" id="cronicoRequisicionPane" data-cronico-document-pane="requisicion" role="tabpanel" aria-labelledby="cronicoRequisicionTabButton">
                    <div class="censo-requisition-sheet" aria-label="Requisici&oacute;n aplicaci&oacute;n de medicamentos">
                        <div class="censo-requisition-sheet__head">
                            <div class="censo-requisition-sheet__logo">
                                <img src="~/images/logo.png" asp-append-version="true" alt="Especialistas En Casa" />
                            </div>
                            <div class="censo-requisition-sheet__title">REQUISICI&Oacute;N APLICACI&Oacute;N DE MEDICAMENTOS</div>
                            <div class="censo-requisition-sheet__meta">
                                <label>C&oacute;digo:<input data-requisition-field="codigoFormato" value="FO-SEF-07" /></label>
                                <label>Versi&oacute;n:<input data-requisition-field="versionFormato" value="03" /></label>
                                <label>pagina:<input data-requisition-field="paginaFormato" value="1 de 1" /></label>
                                <label>Fecha:<input data-requisition-field="fechaFormato" value="01/05/2026" /></label>
                            </div>
                        </div>

                        <div class="censo-requisition-section-title">RESPONSABLES</div>
                        <div class="censo-requisition-responsibles">
                            <label>AUXILIAR ENCARGADO</label>
                            <input data-requisition-field="auxiliarEncargado" />
                            <label>REALIZADO POR</label>
                            <input data-requisition-field="realizadoPor" />
                        </div>

                        <div class="censo-requisition-section-title">DATOS DEL PACIENTE</div>
                        <div class="censo-requisition-patient">
                            <label>Paciente:</label>
                            <input data-requisition-field="paciente" value="@Model.NombrePaciente" />
                            <label>AUTORIZACION</label>
                            <input data-requisition-field="autorizacion" />

                            <label>Documento identidad:</label>
                            <input data-requisition-field="documento" value="@Model.NumeroIdentificacion" />
                            <label>Fecha de solicitud:</label>
                            <input data-requisition-field="fechaSolicitud" />

                            <label>Direccion:</label>
                            <input data-requisition-field="direccion" value="@Model.Direccion" />
                            <label>telefonos:</label>
                            <input data-requisition-field="telefonos" />

                            <label>Diagnostico</label>
                            <input class="censo-requisition-patient__diagnosis" data-requisition-field="diagnostico" />
                        </div>

                        <div class="censo-requisition-section-title censo-requisition-section-title--center">DETALLE DE LA REQUISICI&Oacute;N</div>
                        <div class="censo-requisition-detail" role="table" aria-label="Detalle de la requisici&oacute;n">
                            <div class="censo-requisition-detail__header" role="row">
                                <span>Item</span>
                                <span>DESCRIPCION</span>
                                <span>DETALLE</span>
                                <span>CANTIDAD</span>
                                <span>Fecha de inicio</span>
                                <span>Fecha de finalizaci&oacute;n</span>
                            </div>
                            @for (var requisicionRow = 1; requisicionRow <= 16; requisicionRow++)
                            {
                                <div class="censo-requisition-detail__row" role="row" data-requisition-row="@requisicionRow">
                                    <input aria-label="Item @requisicionRow" data-requisition-item-field="item" value="@requisicionRow" />
                                    <input aria-label="Descripci&oacute;n @requisicionRow" data-requisition-item-field="descripcion" />
                                    <input aria-label="Detalle @requisicionRow" data-requisition-item-field="detalle" />
                                    <input aria-label="Cantidad @requisicionRow" data-requisition-item-field="cantidad" />
                                    <input aria-label="Fecha de inicio @requisicionRow" data-requisition-item-field="fechaInicio" />
                                    <input aria-label="Fecha de finalizaci&oacute;n @requisicionRow" data-requisition-item-field="fechaFin" />
                                </div>
                            }
                        </div>
                    </div>
                </section>
            </div>
            <div class="modal-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input" type="checkbox" role="switch" id="cronicoServiciosCargadosSwitch" />
                    <label class="form-check-label fw-semibold" for="cronicoServiciosCargadosSwitch">Servicios cargados</label>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span id="cronicoReaperturaStatusNote" class="small text-warning-emphasis fw-semibold d-none" aria-live="polite"></span>
                    <button type="button" class="btn btn-outline-warning d-none" id="solicitarReaperturaCronicoBtn" title="Solicitar reapertura de kardex">
                        <svg viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true" style="vertical-align:middle;margin-right:4px" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9 9 0 0 0-6.4 2.6L3 8"/><path d="M3 3v5h5"/></svg>
                        <span>Solicitar reapertura de kardex</span>
                    </button>
                    <button type="button" class="btn btn-success d-none" id="aprobarReaperturaCronicoBtn" title="Aprobar reapertura de kardex">
                        <svg viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true" style="vertical-align:middle;margin-right:4px" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Aprobar reapertura</span>
                    </button>
                    <button type="button" class="btn btn-outline-danger d-none" id="rechazarReaperturaCronicoBtn" title="Rechazar reapertura de kardex">
                        <svg viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true" style="vertical-align:middle;margin-right:4px" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <span>Rechazar</span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-outline-success" id="guardarCronicoDocumentosBtn">
                        <svg viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true" style="vertical-align:middle;margin-right:4px"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        <span>Guardar</span>
                    </button>
                    <div id="enviarFarmaciaCronicoBtnWrapper" style="display:inline-block;">
                        <button type="button" class="btn btn-primary censo-kardex-send-button" id="enviarFarmaciaCronicoBtn" disabled>
                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                <path d="M21 3L3 10.2l6.7 2.6 2.7 8.2 3.2-5.1 5.4 4.1L21 3z"></path>
                                <path d="M9.7 12.8L21 3"></path>
                            </svg>
                            <span>Enviar a farmacia</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cronicoReaperturaModal" tabindex="-1" aria-labelledby="cronicoReaperturaModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cronicoReaperturaModalTitle">Solicitar reapertura de kardex</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Selecciona el motivo de la reapertura. La solicitud se enviar&aacute; a gerencia y requiere la aprobaci&oacute;n de un supervisor.</p>
                <div id="cronicoReaperturaMotivosContainer">
                    @for (var motivoIndex = 0; motivoIndex < Model.ReaperturaMotivos.Count; motivoIndex++)
                    {
                        var motivo = Model.ReaperturaMotivos[motivoIndex];
                        var motivoId = $"cronicoReaperturaMotivo_{motivoIndex}";
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="cronicoReaperturaMotivo" id="@motivoId" value="@motivo" />
                            <label class="form-check-label" for="@motivoId">@motivo</label>
                        </div>
                    }
                </div>
                <div id="cronicoReaperturaMotivoError" class="text-danger small mt-2 d-none">Selecciona un motivo.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" id="confirmarReaperturaCronicoBtn">Enviar solicitud</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cronicoFeedbackModal" tabindex="-1" aria-labelledby="cronicoFeedbackModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="cronicoFeedbackModalHeader">
                <h5 class="modal-title" id="cronicoFeedbackModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="cronicoFeedbackModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Entendido</button>
            </div>
        </div>
    </div>
</div>

