@model CensoNptViewModel
@* Scripts del programa, dentro del @section Scripts de la pantalla unica. *@
@using Nexa.Data.Entities


@{
    ViewData["Title"] = "NPT";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasAuxiliares = Model.AuxiliarEnfermeriaOptions.Any();
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
    var seccionesGuardado = new[]
    {
        new
        {
            Id = "tab-manejo-npt",
            Eyebrow = "Sección 2",
            Titulo = "Manejo de la NPT",
            Descripcion = "Fechas, días de tratamiento y horas de conexión.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el manejo de la NPT."
        },
        new
        {
            Id = "tab-cargue-servicios",
            Eyebrow = "Sección 3",
            Titulo = "Cargue de servicios",
            Descripcion = "Cargues de laboratorios, glucometría y seguimientos.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el cargue de servicios."
        },
        new
        {
            Id = "tab-activo-fijo",
            Eyebrow = "Sección 4",
            Titulo = "Activo fijo",
            Descripcion = "Equipos en comodato asignados al paciente.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el activo fijo."
        },
        new
        {
            Id = "tab-seguimiento-hospitalizado",
            Eyebrow = "Sección 5",
            Titulo = "Seguimiento hospitalizado",
            Descripcion = "Hospitalización y fechas de seguimiento.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el seguimiento hospitalizado."
        },
        new
        {
            Id = "tab-devolucion-productos",
            Eyebrow = "Sección 6",
            Titulo = "Devolución de productos",
            Descripcion = "Novedades y gestión del servicio farmacéutico.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar la devolución de productos."
        },
        new
        {
            Id = "tab-alta-programa",
            Eyebrow = "Sección 7",
            Titulo = "Alta del programa",
            Descripcion = "Motivo del egreso y estado del paciente.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el alta del programa."
        }
    };
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");
}

    <partial name="_ValidationScriptsPartial" />
    @* Valores del servidor para wwwroot/js/censo/npt.js. El resto del script es estático
       y el navegador lo guarda en caché. *@
    <script>
        window.NexaCenso = window.NexaCenso || {};
        window.NexaCenso.npt = {
            validarDireccionUrl: "@Url.Action("ValidarDireccion", "Censo")",
            buscarBarriosUrl: "@Url.Action("BuscarBarrios", "Censo")",
            defaultsMunicipioUrl: "@Url.Action("ObtenerDefaultsMunicipio", "Censo")",
            buscarDiagnosticoCie10Url: "@Url.Action("BuscarDiagnosticoCie10", "Censo")",
            direccionValidada: @Model.DireccionEsValida.ToString().ToLowerInvariant(),
        };
    </script>
    <script src="~/js/censo/npt.js" asp-append-version="true"></script>