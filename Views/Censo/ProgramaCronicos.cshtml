            const sondaVesicalSelect = document.getElementById("sondaVesicalSelect");
            const sondaVesicalFields = document.getElementById("sondaVesicalFields");
            const frecuenciaCambioSondaVesicalInput = document.getElementById("frecuenciaCambioSondaVesicalInput");
            const fechaUltimoCambioSondaVesicalInput = document.getElementById("fechaUltimoCambioSondaVesicalInput");
            const fechaProximoCambioSondaVesicalInput = document.getElementById("fechaProximoCambioSondaVesicalInput");

            const calcularFechaProximoCambioSonda = () => {
                if (!fechaProximoCambioSondaVesicalInput) return;
                const base = String(fechaUltimoCambioSondaVesicalInput?.value || "").trim();
                const dias = Number.parseInt(String(frecuenciaCambioSondaVesicalInput?.value || "").trim(), 10);
                if (!base || !Number.isFinite(dias) || dias < 0) {
                    fechaProximoCambioSondaVesicalInput.value = "";
                    return;
                }
                const fecha = new Date(`${base}T00:00:00`);
                if (Number.isNaN(fecha.getTime())) {
                    fechaProximoCambioSondaVesicalInput.value = "";
                    return;
                }
                fecha.setDate(fecha.getDate() + dias);
                const y = String(fecha.getFullYear()).padStart(4, "0");
                const m = String(fecha.getMonth() + 1).padStart(2, "0");
                const d = String(fecha.getDate()).padStart(2, "0");
                fechaProximoCambioSondaVesicalInput.value = `${y}-${m}-${d}`;
            };

            const syncSondaVesical = () => {
                if (!sondaVesicalFields) return;
                const activo = String(sondaVesicalSelect?.value || "").trim().toUpperCase() === "SI";
                sondaVesicalFields.classList.toggle("d-none", !activo);
