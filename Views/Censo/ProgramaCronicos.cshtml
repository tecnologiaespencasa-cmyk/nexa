@model CensoCronicoViewModel
@using IntranetPrueba.Data.Entities

@section Styles
{
    <link rel="stylesheet" href="~/css/censo.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Programa Cronicos";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasAuxiliares = Model.AuxiliarEnfermeriaOptions.Any();
    var clinicaHeridasActiva = string.Equals(Model.ClinicaHeridas, "Si", StringComparison.OrdinalIgnoreCase);
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");
}

<div class="censo-page @(showCurrentPatientBar ? "censo-page--with-current-patient" : null)">
    <aside class="censo-sidebar">
        <section class="censo-section-strip">
            <div class="censo-section-strip__nav">
                <div class="list-group censo-nav censo-nav--top" id="cronico-tab" role="tablist">
                    <button class="list-group-item list-group-item-action active censo-nav__item"
                            id="tab-datos-basicos-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-datos-basicos"
                            type="button"
                            role="tab"
                            aria-controls="tab-datos-basicos"
                            aria-selected="true">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="9" cy="7" r="3"></circle>
                                <path d="M4 19v-1a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1"></path>
                                <path d="M16 8h4"></path>
                                <path d="M18 6v4"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 1</span>
                            <span class="censo-nav__title">Datos básicos</span>
                            <span class="censo-nav__description">Ingreso, identificación y ubicación del paciente.</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-gestion-caso-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-gestion-caso"
                            type="button"
                            role="tab"
                            aria-controls="tab-gestion-caso"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M9 11l3 3 8-8"></path>
                                <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 2</span>
                            <span class="censo-nav__title">Gestión del caso</span>
                            <span class="censo-nav__description">Clasificación, agudización y escalas clínicas.</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-validaciones-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-validaciones"
                            type="button"
                            role="tab"
                            aria-controls="tab-validaciones"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M12 3l7 4v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V7z"></path>
                                <path d="m9 12 2 2 4-4"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 3</span>
                            <span class="censo-nav__title">Validaciones</span>
                            <span class="censo-nav__description">Servicios, dispositivos, Mipres y hospitalización.</span>
                        </span>
                    </button>
                </div>
            </div>
            <div class="censo-section-strip__tools">
                <form method="get" asp-action="ProgramaCronicos" class="censo-filter-panel">
                    <h2 class="censo-filter-panel__title">Filtros rápidos</h2>
                    <label for="cedulaCronicoFiltroInput" class="form-label censo-filter-panel__label">Buscar por documento</label>
                    <div class="censo-filter-panel__input-wrap">
                        <input class="form-control censo-filter-panel__input" id="cedulaCronicoFiltroInput" name="cedulaPaciente" value="@Model.CedulaFiltro" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                        <span class="censo-filter-panel__search-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="m20 20-3.5-3.5"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="censo-filter-panel__actions">
                        <button type="submit" class="btn btn-outline-primary censo-filter-panel__button">Buscar</button>
                        <a class="btn btn-outline-secondary censo-filter-panel__button" asp-action="ProgramaCronicos">Limpiar</a>
                    </div>
                </form>
            </div>
        </section>
    </aside>

    @if (showCurrentPatientBar)
    {
        <section class="censo-current-patient" aria-label="Paciente actual">
            <div class="censo-current-patient__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21a8 8 0 0 1 16 0"></path>
                </svg>
            </div>

            <div class="censo-current-patient__identity">
                <span class="censo-current-patient__label">Paciente actual</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.NombrePaciente) ? $"{Model.TipoIdentificacion} {Model.NumeroIdentificacion}" : Model.NombrePaciente)</strong>
                @if (!string.IsNullOrWhiteSpace(Model.EstadoPaciente))
                {
                    <span class="censo-current-patient__status">@Model.EstadoPaciente</span>
                }
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Fuente de ingreso</span>
                <strong>@Model.FuenteIngreso</strong>
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Fecha de ingreso</span>
                <strong>
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                        <path d="M8 3v4"></path>
                        <path d="M16 3v4"></path>
                        <path d="M4 10h16"></path>
                    </svg>
                    @Model.FechaIngreso.ToString("dd/MM/yyyy")
                </strong>
            </div>

            <div class="censo-current-patient__actions">
                <div class="dropdown">
                    <button class="btn censo-current-patient__button" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                            <path d="M15 19a6 6 0 0 0-12 0"></path>
                            <circle cx="9" cy="8" r="3"></circle>
                            <path d="M19 8v6"></path>
                            <path d="M16 11h6"></path>
                        </svg>
                        <span>Cambiar paciente</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end censo-current-patient__dropdown">
                        <form method="get" asp-action="ProgramaCronicos" class="censo-current-patient__search">
                            <label for="cambiarCronicoPacienteDocumento" class="form-label">Documento</label>
                            <div class="input-group">
                                <input class="form-control" id="cambiarCronicoPacienteDocumento" name="cedulaPaciente" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                                <button class="btn" type="submit" aria-label="Buscar paciente">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <circle cx="11" cy="11" r="7"></circle>
                                        <path d="m20 20-3.5-3.5"></path>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <a class="btn censo-current-patient__button censo-current-patient__button--primary" asp-action="ProgramaCronicos">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    <span>Nuevo ingreso</span>
                </a>
            </div>
        </section>
    }

    <section class="censo-content">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-warning">@errorMessage</div>
        }

        <form asp-action="ProgramaCronicos" method="post" id="censoCronicoForm" class="censo-form-shell">
            <input asp-for="EditingRecordId" type="hidden" />
            <input asp-for="CedulaFiltro" type="hidden" />
            <input asp-for="DireccionEsValida" type="hidden" id="direccionEsValidaInput" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger censo-validation-summary mb-4" role="alert"></div>

            <div class="tab-content">
                @* ---------- Sección 1: Datos básicos ---------- *@
                <div class="tab-pane fade show active" id="tab-datos-basicos" role="tabpanel" aria-labelledby="tab-datos-basicos-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Programa Cronicos</span>
                                <h2 class="h5 mb-0">Datos básicos</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <circle cx="12" cy="8" r="4"></circle>
                                            <path d="M4 21a8 8 0 0 1 16 0"></path>
                                        </svg>
                                    </span>
                                    <h3>Información personal</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-12">
                                        <label class="form-label">Fuente de ingreso @RequiredMark()</label>
                                        <div class="censo-check-grid">
                                            @for (var i = 0; i < Model.FuenteIngresoOptions.Count; i++)
                                            {
                                                var option = Model.FuenteIngresoOptions[i];
                                                var inputId = $"fuenteIngreso_{i}";
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" id="@inputId" name="FuenteIngreso" value="@option.Value"
                                                           checked="@string.Equals(Model.FuenteIngreso, option.Value, StringComparison.OrdinalIgnoreCase)" />
                                                    <label class="form-check-label" for="@inputId">@option.Text</label>
                                                </div>
                                            }
                                        </div>
                                        <span asp-validation-for="FuenteIngreso" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="FechaIngreso" class="form-label"></label>@RequiredMark()
                                        <input asp-for="FechaIngreso" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="FechaIngreso" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="NombrePaciente" class="form-label"></label>@RequiredMark()
                                        <input asp-for="NombrePaciente" class="form-control" autocomplete="off" placeholder="Ingrese nombre completo del paciente" />
                                        <span asp-validation-for="NombrePaciente" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="TipoIdentificacion" class="form-label"></label>@RequiredMark()
                                        <select asp-for="TipoIdentificacion" asp-items="Model.TipoIdentificacionOptions" class="form-select" id="tipoIdentificacionSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="TipoIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="NumeroIdentificacion" class="form-label"></label>@RequiredMark()
                                        <input asp-for="NumeroIdentificacion" class="form-control" inputmode="numeric" maxlength="20" autocomplete="off" id="numeroIdentificacionInput" placeholder="Ingrese número de identificación" />
                                        <span asp-validation-for="NumeroIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="FechaNacimiento" class="form-label"></label>@RequiredMark()
                                        <input asp-for="FechaNacimiento"
                                               type="date"
                                               class="form-control"
                                               id="fechaNacimientoInput"
                                               max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                                               data-msg-max="La fecha de nacimiento debe ser anterior a la fecha actual."
                                               oninvalid="this.setCustomValidity('La fecha de nacimiento debe ser anterior a la fecha actual.')"
                                               oninput="this.setCustomValidity('')" />
                                        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-2">
                                        <label asp-for="Edad" class="form-label"></label>
                                        <input asp-for="Edad" class="form-control" id="edadInput" readonly />
                                    </div>
                                    <div class="col-lg-6">
                                        <label asp-for="CorreoElectronico" class="form-label"></label>
                                        <input asp-for="CorreoElectronico" class="form-control" type="email" autocomplete="off" placeholder="correo@ejemplo.com" />
                                        <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Género @RequiredMark()</label>
                                        <div class="censo-check-grid">
                                            @for (var i = 0; i < Model.GeneroOptions.Count; i++)
                                            {
                                                var option = Model.GeneroOptions[i];
                                                var inputId = $"genero_{i}";
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" id="@inputId" name="Genero" value="@option.Value"
                                                           checked="@string.Equals(Model.Genero, option.Value, StringComparison.OrdinalIgnoreCase)" />
                                                    <label class="form-check-label" for="@inputId">@option.Text</label>
                                                </div>
                                            }
                                        </div>
                                        <span asp-validation-for="Genero" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M12 21s7-4.7 7-11a7 7 0 1 0-14 0c0 6.3 7 11 7 11Z"></path>
                                            <circle cx="12" cy="10" r="2.5"></circle>
                                        </svg>
                                    </span>
                                    <h3>Dirección y ubicación</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-12">
                                        <label asp-for="Direccion" class="form-label"></label>
                                        <div class="input-group censo-direccion-group">
                                            <input asp-for="Direccion" class="form-control" id="direccionInput" placeholder="Ingrese dirección completa del paciente" />
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="validarDireccionBtn">Validar dirección</button>
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="limpiarDireccionBtn">Limpiar</button>
                                        </div>
                                        <span asp-validation-for="Direccion" class="text-danger d-block"></span>
                                        @if (!string.IsNullOrWhiteSpace(Model.DireccionMensajeValidacion))
                                        {
                                            <div class="alert @(Model.DireccionEsValida ? "alert-success" : "alert-warning") mt-2" id="direccionValidacionServerMensaje">
                                                @Model.DireccionMensajeValidacion
                                                @if (!string.IsNullOrWhiteSpace(Model.DireccionSugerida))
                                                {
                                                    <div class="mt-1">
                                                        Sugerencia: <strong>@Model.DireccionSugerida</strong>
                                                        <button type="button" class="btn btn-sm btn-link p-0 ms-2" id="usarSugerenciaDireccionBtnServer">Usar sugerencia</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <div class="alert d-none mt-2" id="direccionValidacionMensaje"></div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check censo-direccion-check">
                                            <input asp-for="AsumirDireccionErrada" class="form-check-input" type="checkbox" id="asumirDireccionErradaCheck" />
                                            <label asp-for="AsumirDireccionErrada" class="form-check-label">
                                                Asumir dirección errada y continuar
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="DetalleDireccion" class="form-label"></label>
                                        <input asp-for="DetalleDireccion" class="form-control" maxlength="200" placeholder="Ej: Apartamento 501 torre 2" />
                                        <span asp-validation-for="DetalleDireccion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="ClasificacionZonaSura" class="form-label"></label>
                                        <select asp-for="ClasificacionZonaSura" asp-items="Model.ClasificacionZonaSuraOptions" class="form-select" id="clasificacionZonaSuraSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="ClasificacionZonaSura" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="MunicipioResidencia" class="form-label"></label>
                                        <select asp-for="MunicipioResidencia" asp-items="Model.MunicipioResidenciaOptions" class="form-select" id="municipioResidenciaSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="MunicipioResidencia" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="Barrio" class="form-label"></label>
                                        <select asp-for="Barrio" class="form-select" id="barrioSelect">
                                            <option value="" disabled hidden>Selecciona barrio...</option>
                                            @foreach (var barrioOption in Model.BarrioOptions)
                                            {
                                                <option value="@barrioOption">@barrioOption</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Barrio" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="ZonaDireccionSegunMunicipio" class="form-label"></label>
                                        <select asp-for="ZonaDireccionSegunMunicipio" asp-items="Model.ZonaDireccionOptions" class="form-select" id="zonaDireccionSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="ZonaDireccionSegunMunicipio" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="Area" class="form-label"></label>
                                        <select asp-for="Area" asp-items="Model.AreaOptions" class="form-select" id="areaSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Area" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <div class="censo-form-actions">
                                <button type="submit" class="btn btn-primary censo-save-button">
                                    <span>@(Model.EditingRecordId.HasValue ? "Actualizar registro" : "Guardar registro")</span>
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <path d="M5 12h14"></path>
                                        <path d="m13 6 6 6-6 6"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @* ---------- Sección 2: Gestión del caso ---------- *@
                <div class="tab-pane fade" id="tab-gestion-caso" role="tabpanel" aria-labelledby="tab-gestion-caso-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Programa Cronicos</span>
                                <h2 class="h5 mb-0">Gestión del caso</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar la gestión del caso.
                                </div>
                            }
                            else
                            {
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M9 11l3 3 8-8"></path>
                                                <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"></path>
                                            </svg>
                                        </span>
                                        <h3>Clasificación y agudización</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-12">
                                            <label class="form-label">Clasificación del caso</label>
                                            <div class="censo-check-grid">
                                                @for (var i = 0; i < Model.ClasificacionCasoOptions.Count; i++)
                                                {
                                                    var option = Model.ClasificacionCasoOptions[i];
                                                    var inputId = $"clasificacionCaso_{i}";
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" id="@inputId" name="ClasificacionCaso" value="@option.Value"
                                                               checked="@string.Equals(Model.ClasificacionCaso, option.Value, StringComparison.OrdinalIgnoreCase)" />
                                                        <label class="form-check-label" for="@inputId">@option.Text</label>
                                                    </div>
                                                }
                                            </div>
                                            <span asp-validation-for="ClasificacionCaso" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-4">
                                            <label asp-for="EstadoPaciente" class="form-label"></label>
                                            <select asp-for="EstadoPaciente" asp-items="Model.EstadoPacienteOptions" class="form-select">
                                                <option value="">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="EstadoPaciente" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-4">
                                            <label asp-for="NumeroAgudizacionesUltimoAnio" class="form-label"></label>
                                            <input asp-for="NumeroAgudizacionesUltimoAnio" class="form-control" type="number" min="0" step="1" />
                                            <span asp-validation-for="NumeroAgudizacionesUltimoAnio" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-4">
                                            <label asp-for="FechaAgudizacion" class="form-label"></label>
                                            <input asp-for="FechaAgudizacion" type="date" class="form-control" />
                                            <span asp-validation-for="FechaAgudizacion" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="MotivoAgudizacion" class="form-label"></label>
                                            <input asp-for="MotivoAgudizacion" class="form-control" id="motivoAgudizacionInput" maxlength="10" autocomplete="off" placeholder="Ej: I693" />
                                            <span asp-validation-for="MotivoAgudizacion" class="text-danger"></span>
                                        </div>
