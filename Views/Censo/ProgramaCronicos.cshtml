            clinicaHeridasSelect?.addEventListener("change", syncEstadoClinicaHeridas);
            syncEstadoClinicaHeridas();

            const programaNutricionSelect = document.getElementById("programaNutricionSelect");
            const programaNutricionFields = document.getElementById("programaNutricionFields");
            const syncProgramaNutricion = () => {
                if (!programaNutricionFields) return;
