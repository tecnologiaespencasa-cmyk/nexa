            const lookupCie10 = async (codeInput, groupInput) => {
                if (!codeInput || !groupInput) return;
                const codigo = normalizeCie10(codeInput.value);
                codeInput.value = codigo;
                if (codigo.length !== 4) { groupInput.value = ""; return; }
                try {
                    const response = await fetch(`${buscarDiagnosticoCie10Url}?codigo=${encodeURIComponent(codigo)}`);
                    if (!response.ok) { groupInput.value = ""; return; }
                    const data = await response.json();
                    groupInput.value = data.diagnostico || "";
                } catch { groupInput.value = ""; }
            };

            // "Diagnóstico crónico CIE10" está restringido al catálogo cerrado de patologías
            // crónicas: el grupo solo se autocompleta si el código pertenece a ese listado.
            const lookupGrupoPatologiaCronica = async (codeInput, groupInput) => {
                if (!codeInput || !groupInput) return;
                const codigo = normalizeCie10(codeInput.value);
                codeInput.value = codigo;
                if (codigo.length !== 4) { groupInput.value = ""; return; }
                try {
                    const response = await fetch(`${buscarGrupoPatologiaCronicaUrl}?codigo=${encodeURIComponent(codigo)}`);
                    if (!response.ok) { groupInput.value = ""; return; }
                    const data = await response.json();
                    groupInput.value = data.grupo || "";
                } catch { groupInput.value = ""; }
            };

            // El diagnóstico complementario no puede iniciar por Z (factores que influyen en el
            // estado de salud) ni R (síntomas y signos): se elimina esa letra apenas se escribe.
            const normalizeComplementarioCie10 = (value) => {
                let normalized = normalizeCie10(value);
                while (normalized && (normalized[0] === "Z" || normalized[0] === "R")) {
                    normalized = normalized.slice(1);
                }
                return normalized;
            };

            diagnosticoCronicoInput?.addEventListener("input", () => {
                diagnosticoCronicoInput.value = normalizeCie10(diagnosticoCronicoInput.value);
