                programaNutricionFields.classList.toggle("d-none", !activo);
                if (!activo) {
                    const fechaInicio = document.getElementById("FechaInicioNutricion");
                    const fechaFin = document.getElementById("FechaFinNutricion");
                    if (fechaInicio) fechaInicio.value = "";
                    if (fechaFin) fechaFin.value = "";
