                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                <path d="M5 12h14"></path>
                                                <path d="m13 6 6 6-6 6"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>

                @* ---------- Sección 3: Agudizaciones ---------- *@
                <div class="tab-pane fade" id="tab-agudizaciones" role="tabpanel" aria-labelledby="tab-agudizaciones-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Programa Cronicos</span>
                                <h2 class="h5 mb-0">Agudizaciones</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar agudizaciones.
                                </div>
                            }
                            else
                            {
                                <div class="censo-prorroga-version-panel mb-3">
                                    <div>
                                        <label class="form-label fw-semibold" for="agudizacionVersionSelect">Agudizaciones del paciente</label>
                                        <select class="form-select" id="agudizacionVersionSelect">
                                            <option value="">Nueva agudización</option>
                                        </select>
                                    </div>
                                    <div class="censo-prorroga-version-panel__actions">
                                        <button type="button" class="btn btn-outline-primary" id="adicionarAgudizacionBtn">
                                            Adicionar agudización
                                        </button>
                                    </div>
                                    <span class="badge text-bg-primary d-none" id="agudizacionNumeroBadge">Agudización #1</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-lg-3">
                                        <label class="form-label" for="agudizacionCie10Input">CIE10</label>
                                        <input class="form-control" id="agudizacionCie10Input" maxlength="4" autocomplete="off" />
                                    </div>
                                    <div class="col-lg-9">
                                        <label class="form-label" for="agudizacionDiagnosticoInput">Diagnostico descriptivo</label>
                                        <input class="form-control" id="agudizacionDiagnosticoInput" readonly />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-semibold">¿Seguimiento médico?</label>
                                        <div class="censo-check-grid" role="radiogroup" aria-label="Seguimiento médico">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="agudizacion-seguimiento-medico" id="agudizacionSeguimientoSi" value="si" />
                                                <label class="form-check-label" for="agudizacionSeguimientoSi">Sí</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="agudizacion-seguimiento-medico" id="agudizacionSeguimientoNo" value="no" />
                                                <label class="form-check-label" for="agudizacionSeguimientoNo">No</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="agudizacion-seguimiento-medico" id="agudizacionSeguimientoNoAplica" value="no-aplica" />
                                                <label class="form-check-label" for="agudizacionSeguimientoNoAplica">No aplica</label>
                                            </div>
                                        </div>
                                    </div>

                                    @for (var medIndex = 1; medIndex <= 6; medIndex++)
                                    {
                                        var suffix = medIndex == 1 ? "Principal" : medIndex.ToString();
                                        var etiqueta = medIndex == 1 ? "principal" : $"número {medIndex}";
                                        if (medIndex > 1)
                                        {
                                            var toggleLabels = new[] { "", "", "segundo", "tercer", "cuarto", "quinto", "sexto" };
                                            <div class="col-12 @(medIndex > 2 ? "d-none" : null)" id="agudizacionToggle@(medIndex)Wrapper">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input js-agudizacion-med-toggle" type="checkbox" role="switch" id="agudizacionTieneMed@(medIndex)" data-med-index="@medIndex" />
                                                    <label class="form-check-label" for="agudizacionTieneMed@(medIndex)">Tiene @toggleLabels[medIndex] medicamento</label>
                                                </div>
                                            </div>
                                        }
                                        <div class="col-12 @(medIndex > 1 ? "d-none" : null)" id="agudizacionMed@(medIndex)Container">
                                            <div class="row g-3">
                                                <div class="col-lg-4">
                                                    <label class="form-label" for="agudizacionNombreMed@(suffix)">Nombre medicamento @etiqueta / Principio activo</label>
                                                    <input class="form-control" id="agudizacionNombreMed@(suffix)" maxlength="300" list="agudizacionMedicamentoOptions" autocomplete="off" />
                                                </div>
                                                <div class="col-lg-1">
                                                    <label class="form-label" for="agudizacionDosisMed@(suffix)">Dosis</label>
                                                    <input class="form-control" id="agudizacionDosisMed@(suffix)" type="number" min="0.01" max="999999.99" step="0.01" inputmode="decimal" />
                                                </div>
                                                <div class="col-lg-2">
                                                    <label class="form-label" for="agudizacionMedidaMed@(suffix)">Medida</label>
                                                    <select class="form-select" id="agudizacionMedidaMed@(suffix)">
                                                        <option value=""></option>
                                                        @foreach (var opt in Model.MedidaMedicamentoOptions)
                                                        {
                                                            <option value="@opt.Value">@opt.Text</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-lg-2">
                                                    <label class="form-label" for="agudizacionViaMed@(suffix)">Vía de administración</label>
                                                    <select class="form-select" id="agudizacionViaMed@(suffix)">
                                                        <option value=""></option>
                                                        @foreach (var opt in Model.ViaAdministracionMedicamentoOptions)
                                                        {
                                                            <option value="@opt.Value">@opt.Text</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-lg-2">
                                                    <label class="form-label" for="agudizacionFrecuenciaMed@(suffix)">Frecuencia</label>
                                                    <select class="form-select js-agudizacion-calc" id="agudizacionFrecuenciaMed@(suffix)">
                                                        <option value=""></option>
                                                        @foreach (var opt in Model.FrecuenciaAdministracionOptions)
                                                        {
                                                            <option value="@opt.Value">@opt.Text</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-lg-1">
                                                    <label class="form-label" for="agudizacionDiasMed@(suffix)">Días</label>
                                                    <input class="form-control js-agudizacion-calc" id="agudizacionDiasMed@(suffix)" type="number" min="1" max="999" step="1" inputmode="numeric" />
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <datalist id="agudizacionMedicamentoOptions">
                                        @foreach (var medicamento in Model.MedicamentoPrincipalOptions)
                                        {
                                            <option value="@medicamento"></option>
                                        }
                                    </datalist>

                                    <div class="col-lg-6">
                                        <label class="form-label" for="agudizacionAplicacionesTotales">Aplicaciones totales</label>
                                        <input class="form-control" id="agudizacionAplicacionesTotales" readonly />
                                    </div>
                                    <div class="col-lg-6">
                                        <label class="form-label" for="agudizacionDiasTratamientoIv">Días de tratamiento IV</label>
                                        <input class="form-control" id="agudizacionDiasTratamientoIv" readonly />
                                    </div>

                                    <div class="col-lg-4">
                                        <label class="form-label" for="agudizacionFechaInicio">Fecha de inicio de tratamiento</label>
                                        <input class="form-control js-agudizacion-calc" id="agudizacionFechaInicio" type="date" />
                                    </div>
                                    <div class="col-lg-4">
                                        <label class="form-label" for="agudizacionFechaFin">Fecha fin de tratamiento</label>
                                        <input class="form-control" id="agudizacionFechaFin" type="date" readonly />
                                    </div>
                                    <div class="col-lg-4">
                                        <label class="form-label" for="agudizacionFechaPromesa">Fecha ordenamiento</label>
                                        <input class="form-control" id="agudizacionFechaPromesa" type="date" />
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label" for="agudizacionAuxiliarAsignado">Auxiliar asignado</label>
                                        <select class="form-select" id="agudizacionAuxiliarAsignado">
                                            <option value=""></option>
                                            @foreach (var opt in Model.AuxiliarEnfermeriaOptions)
                                            {
                                                <option value="@opt.Value">@opt.Text</option>
                                            }
                                        </select>
                                        <div class="form-text">Selecciona un auxiliar OPS activo.</div>
                                    </div>
                                </div>

                                <div class="censo-prorroga-actions mt-4">
                                    <button type="button" class="btn btn-primary" id="guardarAgudizacionBtn">
                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" style="width:1rem;height:1rem;margin-right:.4rem;vertical-align:-.15em">
                                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                            <polyline points="7 3 7 8 15 8"></polyline>
                                        </svg>
                                        <span>Guardar agudización</span>
                                    </button>
                                    <button type="button" class="btn censo-kardex-button" id="gestionarCronicoKardexBtn" data-bs-toggle="modal" data-bs-target="#cronicoKardexModal">
                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                            <path d="M9 3h6"></path>
                                            <path d="M10 3v2"></path>
                                            <path d="M14 3v2"></path>
                                            <rect x="5" y="5" width="14" height="16" rx="3"></rect>
                                            <path d="M8 11h8"></path>
                                            <path d="M8 15h5"></path>
                                        </svg>
                                        <span>Gestionar kardex y requisici&oacute;n</span>
                                    </button>
                                    <span class="censo-prorroga-actions__status ms-3 text-muted small" id="agudizacionGuardadoStatus"></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* ---------- Sección 4: Hospitalización y seguimiento ---------- *@
                <div class="tab-pane fade" id="tab-hospitalizacion" role="tabpanel" aria-labelledby="tab-hospitalizacion-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Programa Cronicos</span>
                                <h2 class="h5 mb-0">Hospitalización y seguimiento</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar la hospitalización y seguimiento.
                                </div>
                            }
                            else
                            {
                                var seguimientoLabels = new[]
                                {
                                    "Fecha de 1er seguimiento (24 horas)",
                                    "Fecha de 2do seguimiento (48 horas)",
                                    "Fecha de 3er seguimiento (72 horas)",
                                    "Fecha de 4to seguimiento (Semana 1)",
                                    "Fecha de 5to seguimiento (Semana 2)",
                                    "Fecha de 6to seguimiento (Semana 3)",
                                    "Fecha de 7mo seguimiento (Semana 4)"
                                };
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M3 12h4l2-5 4 10 2-5h6"></path>
                                            </svg>
                                        </span>
                                        <h3>Hospitalización y seguimiento</h3>
                                    </div>

                                    <div class="censo-prorroga-version-panel mb-3">
                                        <div>
                                            <label class="form-label fw-semibold" for="hospVersionSelect">Hospitalizaciones del paciente</label>
                                            <select class="form-select" id="hospVersionSelect">
                                                <option value="">Nueva hospitalización</option>
                                            </select>
                                        </div>
                                        <div class="censo-prorroga-version-panel__actions">
                                            <button type="button" class="btn btn-outline-primary" id="adicionarHospitalizacionBtn">
                                                Adicionar hospitalización
                                            </button>
                                        </div>
                                        <span class="badge text-bg-primary d-none" id="hospNumeroBadge">Hospitalización #1</span>
                                    </div>

                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label class="form-label" for="hospFechaHospitalizacion">Fecha de hospitalización</label>
                                            <input class="form-control" id="hospFechaHospitalizacion" type="date" />
                                        </div>
                                        <div class="col-lg-5">
                                            <label class="form-label" for="hospMotivo">Motivo de la hospitalización</label>
                                            <input class="form-control" id="hospMotivo" maxlength="200" autocomplete="off" />
                                        </div>
                                        <div class="col-lg-2">
                                            <label class="form-label" for="hospRemitidoPor">Remitido por</label>
                                            <input class="form-control" id="hospRemitidoPor" maxlength="100" autocomplete="off" />
                                        </div>
                                        <div class="col-lg-2">
                                            <label class="form-label" for="hospIps">IPS intramural</label>
                                            <input class="form-control" id="hospIps" maxlength="200" autocomplete="off" />
                                        </div>
                                        <div class="col-lg-3">
                                            <label class="form-label" for="hospCie10Input">CIE10</label>
                                            <input class="form-control" id="hospCie10Input" maxlength="4" autocomplete="off" />
                                        </div>
                                        <div class="col-lg-9">
                                            <label class="form-label" for="hospDiagnosticoInput">Diagnóstico descriptivo</label>
                                            <input class="form-control" id="hospDiagnosticoInput" readonly />
                                        </div>

                                        @for (var seg = 1; seg <= 7; seg++)
                                        {
                                            <div class="col-lg-3">
                                                <label class="form-label" for="hospSeguimiento@(seg)Fecha">@seguimientoLabels[seg - 1]</label>
                                                <input class="form-control js-hosp-seguimiento-fecha" id="hospSeguimiento@(seg)Fecha" data-seguimiento="@seg" type="date" />
                                                <div class="hosp-seguimiento-obs d-none mt-2" id="hospSeguimiento@(seg)ObsWrapper">
                                                    <label class="form-label mb-1" for="hospSeguimiento@(seg)Obs">Observación</label>
                                                    <textarea class="form-control form-control-sm" id="hospSeguimiento@(seg)Obs" rows="2" maxlength="500" placeholder="Observación del seguimiento"></textarea>
                                                </div>
                                            </div>
                                        }

                                        <div class="col-lg-3">
                                            <label class="form-label" for="hospFechaAlta">Fecha de alta de hospitalización</label>
                                            <input class="form-control" id="hospFechaAlta" type="date" />
                                        </div>
                                        <div class="col-lg-3">
                                            <label class="form-label" for="hospNumeroHospitalizaciones">N° hospitalizaciones en último año</label>
                                            <input class="form-control" id="hospNumeroHospitalizaciones" type="number" min="0" step="1" />
                                        </div>
                                    </div>

                                    <div class="censo-prorroga-actions mt-4">
                                        <button type="button" class="btn btn-primary" id="guardarHospitalizacionBtn">
                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true" style="width:1rem;height:1rem;margin-right:.4rem;vertical-align:-.15em">
                                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                                <polyline points="7 3 7 8 15 8"></polyline>
                                            </svg>
                                            <span>Guardar hospitalización</span>
                                        </button>
                                        <span class="censo-prorroga-actions__status ms-3 text-muted small" id="hospGuardadoStatus"></span>
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>

                @* ---------- Sección 5: Gestión del alta ---------- *@
                <div class="tab-pane fade" id="tab-gestion-alta" role="tabpanel" aria-labelledby="tab-gestion-alta-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Programa Cronicos</span>
                                <h2 class="h5 mb-0">Gestión del alta</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar el egreso del programa.
                                </div>
                            }
                            else
                            {
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                                <path d="M8 3v4"></path>
                                                <path d="M16 3v4"></path>
                                                <path d="M4 10h16"></path>
                                                <path d="m9 15 2 2 4-5"></path>
                                            </svg>
                                        </span>
                                        <h3>Egreso del programa</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label asp-for="EgresaProgramaCronico" class="form-label"></label>
                                            <select asp-for="EgresaProgramaCronico" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                            <span asp-validation-for="EgresaProgramaCronico" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-6">
                                            <label asp-for="MotivoEgreso" class="form-label"></label>
                                            <select asp-for="MotivoEgreso" asp-items="Model.MotivoEgresoOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                            <span asp-validation-for="MotivoEgreso" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="FechaEgreso" class="form-label"></label>
                                            <input asp-for="FechaEgreso" type="date" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="censo-form-actions censo-form-actions--inline">
                                        <button type="submit" class="btn btn-primary censo-save-button" formaction="@Url.Action("GuardarCronicoHospitalizacion", "Censo")" formmethod="post" formnovalidate>
                                            <span>Guardar egreso del programa</span>
                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                <path d="M5 12h14"></path>
                                                <path d="m13 6 6 6-6 6"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </section>
</div>

<section class="censo-history-shell" id="cronicoHistorial">
    <div class="censo-history-shell__header">
        <div class="censo-history-shell__header-copy">
            <span class="censo-history-shell__eyebrow">Historial</span>
            <h2>Últimos registros de programa crónicos</h2>
            <p>
                @if (!string.IsNullOrWhiteSpace(Model.CedulaFiltro))
                {
                    @($"Últimos 100 registros para el documento {Model.CedulaFiltro}.")
                }
                else
                {
                    @("Se muestran los últimos 100 registros creados en este censo.")
                }
            </p>
        </div>
        <div class="censo-history-shell__meta" aria-label="Exportar censo de programa crónicos">
            <div class="censo-history-export-card">
                <div>
                    <span>Informe</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.CedulaFiltro) ? "Programa crónicos" : $"Documento {Model.CedulaFiltro}")</strong>
                </div>
                <a asp-action="ExportarCronicosExcel" asp-route-cedulaPaciente="@Model.CedulaFiltro" download>Descargar Excel</a>
            </div>
        </div>
    </div>

    @if (!Model.UltimosRegistros.Any())
    {
        <div class="alert alert-warning mb-0">
            @if (!string.IsNullOrWhiteSpace(Model.CedulaFiltro))
            {
                @("No se encontraron registros de programa crónicos con los filtros seleccionados.")
            }
            else
            {
                @("No hay registros de programa crónicos para mostrar.")
            }
        </div>
    }
    else
    {
        <div class="censo-history-table-wrap">
            <table class="table table-sm table-bordered censo-history-table mb-0">
                <thead>
                    <tr>
                        <th>Abrir</th>
                        <th>Registro</th>
                        <th>Paciente</th>
                        <th>Documento</th>
                        <th>Fuente ingreso</th>
                        <th>Género</th>
                        <th>Fecha ingreso</th>
                        <th>Clasificación</th>
                        <th>Estado paciente</th>
                        <th>Diag. crónico</th>
                        <th>Egresa</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.UltimosRegistros)
                    {
                        <tr>
                            <td>
                                <a class="censo-history-table__open" asp-action="ProgramaCronicos" asp-route-recordId="@record.Id" asp-route-cedulaPaciente="@Model.CedulaFiltro" title="Cargar registro @record.Id" aria-label="Cargar registro @record.Id">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <circle cx="11" cy="11" r="6"></circle>
                                        <path d="M16 16l5 5"></path>
                                    </svg>
                                </a>
                            </td>
                            <td>@record.Id</td>
                            <td>@record.NombrePaciente</td>
                            <td>@record.TipoIdentificacion @record.NumeroIdentificacion</td>
                            <td>@record.FuenteIngreso</td>
                            <td>@record.Genero</td>
                            <td>@record.FechaIngreso.ToString("dd/MM/yyyy")</td>
                            <td>@record.ClasificacionCaso</td>
                            <td>@record.EstadoPaciente</td>
                            <td>@record.DiagnosticoCronicoCie10</td>
                            <td>@(string.IsNullOrWhiteSpace(record.EgresaProgramaCronico) ? "" : record.EgresaProgramaCronico)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (Model.EditingRecordId.HasValue)
{
<div class="modal fade censo-kardex-modal" id="cronicoKardexModal" tabindex="-1" aria-labelledby="cronicoKardexModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header censo-document-header">
                <div class="censo-document-header__title">
                    <span class="censo-card-heading__eyebrow">Programa Cr&oacute;nicos</span>
                    <h5 class="modal-title" id="cronicoKardexModalTitle">Gestionar kardex y requisici&oacute;n</h5>
                    <span class="censo-document-context-badge censo-document-context-badge--prorroga" id="cronicoDocumentContextBadge" aria-live="polite"></span>
