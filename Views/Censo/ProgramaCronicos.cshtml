                farmaciaEstado = a.FarmaciaEstado,
                tuvoReapertura = a.TuvoReaperturaKardex,
                reaperturaSolicitud = (object?)null
            })));
            let activeAgudizacionId = null;

            const getAgudValue = (id) => (document.getElementById(id)?.value || "").trim();
            const setAgudValue = (id, value) => { const el = document.getElementById(id); if (el) el.value = value || ""; };
            const getMedToggle = (index) => document.getElementById(`agudizacionTieneMed${index}`);
            const getMedContainer = (index) => document.getElementById(`agudizacionMed${index}Container`);
            const isMedActive = (index) => index === 1 || !!getMedToggle(index)?.checked;

            const getAgudDays = (suffix) => {
                const value = Number.parseInt(getAgudValue(`agudizacionDiasMed${suffix}`) || "0", 10);
                return Number.isFinite(value) && value > 0 ? value : 0;
            };

            const calcAplicaciones = (frequency, days) => {
                if (days < 1) return 0;
                const normalized = String(frequency || "").trim().toUpperCase();
                if (!normalized || normalized === "NO APLICA") return 0;
                if (normalized === "INFUSION CONTINUA") return days;
                const match = normalized.match(/^CADA\s+(\d+(?:[.,]\d+)?)\s+HORAS$/);
                if (!match) return 0;
                const hours = Number.parseFloat(String(match[1]).replace(",", "."));
                return hours > 0 ? Math.ceil((days * 24) / hours) : 0;
            };

            const parseIsoDate = (value) => {
                const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || "").trim());
                if (!match) return null;
                const year = Number.parseInt(match[1], 10);
                const month = Number.parseInt(match[2], 10);
                const day = Number.parseInt(match[3], 10);
                const date = new Date(year, month - 1, day);
                return (date.getFullYear() === year && date.getMonth() === month - 1 && date.getDate() === day) ? date : null;
            };

            // Solo permite una letra al inicio seguida de hasta tres dígitos (formato CIE10).
            const normalizeAgudizacionCie10 = (value) => {
                const source = String(value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
                if (!source) return "";
                const firstLetterIndex = source.search(/[A-Z]/);
                if (firstLetterIndex < 0) return "";
                const trimmed = source.slice(firstLetterIndex);
                const letter = trimmed[0];
                const digits = trimmed.slice(1).replace(/\D/g, "").slice(0, 3);
                return `${letter}${digits}`;
            };

            agudizacionCie10Input?.addEventListener("input", () => {
                agudizacionCie10Input.value = normalizeAgudizacionCie10(agudizacionCie10Input.value);
                if (agudizacionDiagnosticoInput) agudizacionDiagnosticoInput.value = "";
            });
            agudizacionCie10Input?.addEventListener("blur", async () => {
                const codigo = normalizeAgudizacionCie10(agudizacionCie10Input.value);
                agudizacionCie10Input.value = codigo;
                if (!agudizacionDiagnosticoInput) return;
                if (codigo.length !== 4 || !/^[A-Z][0-9]{3}$/.test(codigo)) {
                    agudizacionDiagnosticoInput.value = "";
                    return;
                }
                try {
                    const response = await fetch(`${buscarDiagnosticoCie10Url}?codigo=${encodeURIComponent(codigo)}`);
                    if (!response.ok) { agudizacionDiagnosticoInput.value = ""; return; }
                    const data = await response.json();
                    agudizacionDiagnosticoInput.value = data.diagnostico || "";
                } catch { agudizacionDiagnosticoInput.value = ""; }
            });

            const syncAgudizacionCalculos = () => {
                let total = 0;
                let maxDays = 0;
                let winningFreq = "";
                medSuffixes.forEach((suffix, i) => {
                    const index = i + 1;
                    if (!isMedActive(index)) return;
                    const days = getAgudDays(suffix);
                    const freq = getAgudValue(`agudizacionFrecuenciaMed${suffix}`);
                    total += calcAplicaciones(freq, days);
                    if (days > maxDays) { maxDays = days; winningFreq = freq; }
                });
                if (agudizacionAplicacionesInput) agudizacionAplicacionesInput.value = total > 0 ? String(total) : "";
                if (agudizacionDiasIvInput) agudizacionDiasIvInput.value = maxDays > 0 ? String(maxDays) : "";
                if (agudizacionFechaInicioInput && agudizacionFechaFinInput) {
                    const startDate = parseIsoDate(agudizacionFechaInicioInput.value);
                    if (!startDate || maxDays < 1) {
                        agudizacionFechaFinInput.value = "";
                    } else {
                        const offset = String(winningFreq || "").trim().toUpperCase() === "CADA 24 HORAS" ? maxDays - 1 : maxDays;
                        const endDate = new Date(startDate);
                        endDate.setDate(endDate.getDate() + offset);
                        const y = String(endDate.getFullYear()).padStart(4, "0");
                        const m = String(endDate.getMonth() + 1).padStart(2, "0");
                        const d = String(endDate.getDate()).padStart(2, "0");
                        agudizacionFechaFinInput.value = `${y}-${m}-${d}`;
                    }
                }
            };

            document.querySelectorAll(".js-agudizacion-calc").forEach((control) => {
                control.addEventListener("input", syncAgudizacionCalculos);
                control.addEventListener("change", syncAgudizacionCalculos);
            });

            const clearAgudMedFields = (index) => {
                const suffix = medSuffixes[index - 1];
                ["Nombre", "Dosis", "Medida", "Via", "Frecuencia", "Dias"].forEach((prefix) => {
                    setAgudValue(`agudizacion${prefix}Med${suffix}`, "");
                });
            };

            // Los toggles aparecen progresivamente: cada uno solo se muestra cuando
            // el medicamento anterior está activo. Al desactivar uno, se ocultan y
            // limpian todos los siguientes en cascada.
            const syncAgudizacionMedProgression = () => {
                for (let index = 2; index <= 6; index++) {
                    const prevActive = index === 2 ? true : isMedActive(index - 1);
                    const wrapper = document.getElementById(`agudizacionToggle${index}Wrapper`);
                    if (wrapper) wrapper.classList.toggle("d-none", !prevActive);
                    if (!prevActive) {
                        const toggle = getMedToggle(index);
                        if (toggle && toggle.checked) toggle.checked = false;
                        getMedContainer(index)?.classList.add("d-none");
                        clearAgudMedFields(index);
                    }
                }
            };

            document.querySelectorAll(".js-agudizacion-med-toggle").forEach((toggle) => {
                toggle.addEventListener("change", () => {
                    const index = Number(toggle.getAttribute("data-med-index"));
                    getMedContainer(index)?.classList.toggle("d-none", !toggle.checked);
                    if (!toggle.checked) {
                        clearAgudMedFields(index);
                    }
                    syncAgudizacionMedProgression();
                    syncAgudizacionCalculos();
                });
            });

            const collectAgudizacionPayload = () => {
                const payload = {
                    codigoCie10: getAgudValue("agudizacionCie10Input"),
                    diagnosticoDescriptivo: getAgudValue("agudizacionDiagnosticoInput"),
                    seguimientoMedico: document.querySelector("input[name='agudizacion-seguimiento-medico']:checked")?.value || "",
                    aplicacionesTotales: getAgudValue("agudizacionAplicacionesTotales"),
                    diasTratamientoIv: getAgudValue("agudizacionDiasTratamientoIv"),
                    fechaInicioTratamiento: getAgudValue("agudizacionFechaInicio"),
                    fechaFinTratamiento: getAgudValue("agudizacionFechaFin"),
                    fechaPromesaInicioTto: getAgudValue("agudizacionFechaPromesa"),
                    auxiliarAsignado: getAgudValue("agudizacionAuxiliarAsignado"),
                    medicamentos: []
                };
                medSuffixes.forEach((suffix, i) => {
                    const index = i + 1;
                    payload.medicamentos.push({
                        numero: index,
                        activo: isMedActive(index),
                        nombre: getAgudValue(`agudizacionNombreMed${suffix}`),
                        dosis: getAgudValue(`agudizacionDosisMed${suffix}`),
                        medida: getAgudValue(`agudizacionMedidaMed${suffix}`),
                        via: getAgudValue(`agudizacionViaMed${suffix}`),
                        frecuencia: getAgudValue(`agudizacionFrecuenciaMed${suffix}`),
                        dias: getAgudValue(`agudizacionDiasMed${suffix}`)
                    });
                });
                return payload;
            };

            const applyAgudizacionPayload = (data) => {
                const payload = data || {};
                const meds = Array.isArray(payload.medicamentos) ? payload.medicamentos : [];
                medSuffixes.forEach((suffix, i) => {
                    const index = i + 1;
                    const med = meds.find((m) => Number(m?.numero) === index) || {};
                    setAgudValue(`agudizacionNombreMed${suffix}`, med.nombre);
                    setAgudValue(`agudizacionDosisMed${suffix}`, med.dosis);
                    setAgudValue(`agudizacionMedidaMed${suffix}`, med.medida);
                    setAgudValue(`agudizacionViaMed${suffix}`, med.via);
                    setAgudValue(`agudizacionFrecuenciaMed${suffix}`, med.frecuencia);
                    setAgudValue(`agudizacionDiasMed${suffix}`, med.dias);
                    if (index > 1) {
                        const toggle = getMedToggle(index);
                        if (toggle) toggle.checked = !!med.activo;
                        getMedContainer(index)?.classList.toggle("d-none", !med.activo);
                    }
                });
                setAgudValue("agudizacionCie10Input", payload.codigoCie10);
                setAgudValue("agudizacionDiagnosticoInput", payload.diagnosticoDescriptivo);
                setAgudValue("agudizacionAplicacionesTotales", payload.aplicacionesTotales);
                setAgudValue("agudizacionDiasTratamientoIv", payload.diasTratamientoIv);
                setAgudValue("agudizacionFechaInicio", payload.fechaInicioTratamiento);
                setAgudValue("agudizacionFechaFin", payload.fechaFinTratamiento);
                setAgudValue("agudizacionFechaPromesa", payload.fechaPromesaInicioTto);
                setAgudValue("agudizacionAuxiliarAsignado", payload.auxiliarAsignado);
                document.querySelectorAll("input[name='agudizacion-seguimiento-medico']").forEach((radio) => {
                    radio.checked = radio.value === payload.seguimientoMedico;
                });
                syncAgudizacionMedProgression();
                syncAgudizacionCalculos();
            };

            const clearAgudizacionForm = () => {
                applyAgudizacionPayload({});
                activeAgudizacionId = null;
                if (agudizacionNumeroBadge) agudizacionNumeroBadge.classList.add("d-none");
            };

            const renderAgudizacionVersions = () => {
                if (!agudizacionVersionSelect) return;
                agudizacionVersionSelect.innerHTML = "";
                const nuevaOption = document.createElement("option");
                nuevaOption.value = "";
                nuevaOption.textContent = "Nueva agudización";
                agudizacionVersionSelect.appendChild(nuevaOption);
                (agudizacionesState || []).forEach((item) => {
                    const option = document.createElement("option");
                    option.value = String(item.id);
                    option.textContent = `Agudización #${item.numero}${item.cerrada ? " - kardex cerrado" : (item.enviadaFarmacia ? " - en farmacia" : "")}`;
                    agudizacionVersionSelect.appendChild(option);
                });
                agudizacionVersionSelect.value = activeAgudizacionId ? String(activeAgudizacionId) : "";
                const activa = (agudizacionesState || []).find((item) => String(item.id) === String(activeAgudizacionId));
                if (agudizacionNumeroBadge) {
                    agudizacionNumeroBadge.classList.toggle("d-none", !activa);
                    if (activa) agudizacionNumeroBadge.textContent = `Agudización #${activa.numero}${activa.cerrada ? " · Kardex cerrado" : ""}`;
                }
            };

            const loadAgudizacion = (versionId) => {
                if (!versionId) { clearAgudizacionForm(); renderAgudizacionVersions(); updateAgudizacionReadonlyMode(); return; }
                const item = (agudizacionesState || []).find((x) => String(x.id) === String(versionId));
                if (!item) { clearAgudizacionForm(); renderAgudizacionVersions(); updateAgudizacionReadonlyMode(); return; }
                activeAgudizacionId = item.id;
                let parsed = {};
                try { parsed = JSON.parse(item.agudizacionJson || "{}"); } catch { parsed = {}; }
                applyAgudizacionPayload(parsed);
                renderAgudizacionVersions();
                updateAgudizacionReadonlyMode();
            };

            agudizacionVersionSelect?.addEventListener("change", () => loadAgudizacion(agudizacionVersionSelect.value));
            adicionarAgudizacionBtn?.addEventListener("click", () => {
                clearAgudizacionForm();
                renderAgudizacionVersions();
                updateAgudizacionReadonlyMode();
                if (agudizacionGuardadoStatus) agudizacionGuardadoStatus.textContent = "Nueva agudización lista para diligenciar.";
            });

            guardarAgudizacionBtn?.addEventListener("click", async () => {
                if (!cronicoRecordId || !csrfTokenInput) return;
                guardarAgudizacionBtn.disabled = true;
                if (agudizacionGuardadoStatus) agudizacionGuardadoStatus.textContent = "Guardando...";
                try {
                    const body = new URLSearchParams();
                    body.set("id", String(cronicoRecordId));
                    body.set("agudizacionJson", JSON.stringify(collectAgudizacionPayload()));
                    if (activeAgudizacionId) body.set("agudizacionVersionId", String(activeAgudizacionId));

                    const response = await fetch(guardarAgudizacionUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": csrfTokenInput.value
                        },
                        body: body.toString()
                    });
                    const data = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        if (agudizacionGuardadoStatus) agudizacionGuardadoStatus.textContent = data.message || "No fue posible guardar la agudización.";
                        return;
                    }
                    activeAgudizacionId = data.agudizacionId || activeAgudizacionId;
                    const listResponse = await fetch(`${obtenerAgudizacionesUrl}?id=${encodeURIComponent(cronicoRecordId)}`);
                    if (listResponse.ok) {
                        const listData = await listResponse.json();
                        agudizacionesState = listData.agudizaciones || [];
                    }
                    renderAgudizacionVersions();
                    updateAgudizacionReadonlyMode();
                    if (agudizacionGuardadoStatus) agudizacionGuardadoStatus.textContent = data.message || "Agudización guardada correctamente.";
                } catch {
                    if (agudizacionGuardadoStatus) agudizacionGuardadoStatus.textContent = "No fue posible guardar la agudización.";
                } finally {
                    guardarAgudizacionBtn.disabled = false;
                }
            });

            // ---------------- Kardex y requisición de agudizaciones ----------------
            // Pipeline independiente del censo de agudos: los documentos viven en la
            // agudización activa (censo_cronico_agudizaciones) y se cierran cuando
            // farmacia da OK Kardex; la reapertura requiere aprobación de un supervisor.
            const cronicoKardexModalEl = document.getElementById("cronicoKardexModal");
            const cronicoDocumentContextBadge = document.getElementById("cronicoDocumentContextBadge");
            const cronicoClosedBanner = document.getElementById("cronicoDocumentClosedBanner");
            const guardarCronicoDocumentosBtn = document.getElementById("guardarCronicoDocumentosBtn");
            const enviarFarmaciaCronicoBtn = document.getElementById("enviarFarmaciaCronicoBtn");
            const enviarFarmaciaCronicoWrapper = document.getElementById("enviarFarmaciaCronicoBtnWrapper");
            const cronicoServiciosSwitch = document.getElementById("cronicoServiciosCargadosSwitch");
            const solicitarReaperturaCronicoBtn = document.getElementById("solicitarReaperturaCronicoBtn");
            const aprobarReaperturaCronicoBtn = document.getElementById("aprobarReaperturaCronicoBtn");
            const rechazarReaperturaCronicoBtn = document.getElementById("rechazarReaperturaCronicoBtn");
            const cronicoReaperturaStatusNote = document.getElementById("cronicoReaperturaStatusNote");
            const cronicoReaperturaModalEl = document.getElementById("cronicoReaperturaModal");
            const guardarCronicoDocumentosUrl = "@Url.Action("GuardarCronicoAgudizacionDocumentos", "Censo")";
            const enviarFarmaciaCronicoUrl = "@Url.Action("EnviarCronicoAgudizacionAFarmacia", "Censo")";
            const solicitarReaperturaCronicoUrl = "@Url.Action("SolicitarReaperturaKardexCronico", "Censo")";
            const aprobarReaperturaCronicoUrl = "@Url.Action("AprobarReaperturaKardexCronico", "Censo")";
            const rechazarReaperturaCronicoUrl = "@Url.Action("RechazarReaperturaKardexCronico", "Censo")";
            const puedeAprobarReaperturaCronico = @Json.Serialize(Model.PuedeAprobarReapertura);
            const cronicoMedicamentoCatalog = @Html.Raw(medicamentoCatalogJson);

            const cronicoEscapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (ch) => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;"
            }[ch]));

            const cronicoFeedbackModalEl = document.getElementById("cronicoFeedbackModal");
            const showCronicoFeedback = (title, bodyHtml, tone) => {
                const header = document.getElementById("cronicoFeedbackModalHeader");
                const titleEl = document.getElementById("cronicoFeedbackModalTitle");
                const bodyEl = document.getElementById("cronicoFeedbackModalBody");
                if (!cronicoFeedbackModalEl || !header || !titleEl || !bodyEl) {
                    window.alert(`${title}\n${String(bodyHtml || "").replace(/<[^>]+>/g, " ").trim()}`);
                    return;
                }
                titleEl.textContent = title;
                bodyEl.innerHTML = bodyHtml;
                header.classList.remove("bg-success-subtle", "text-success-emphasis", "bg-danger-subtle", "text-danger-emphasis", "bg-warning-subtle", "text-warning-emphasis");
                if (tone === "success") header.classList.add("bg-success-subtle", "text-success-emphasis");
                else if (tone === "danger") header.classList.add("bg-danger-subtle", "text-danger-emphasis");
                else header.classList.add("bg-warning-subtle", "text-warning-emphasis");
                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(cronicoFeedbackModalEl).show();
                }
            };

            const normalizeCronicoMedKey = (value) => String(value || "")
                .normalize("NFD")
                .replace(/[̀-ͯ]/g, "")
                .toUpperCase()
                .replace(/[^A-Z0-9]+/g, " ")
                .trim()
                .replace(/\s+/g, " ");

            const cronicoCatalogByName = new Map();
            (Array.isArray(cronicoMedicamentoCatalog) ? cronicoMedicamentoCatalog : []).forEach((item) => {
                [normalizeCronicoMedKey(item.Nombre), normalizeCronicoMedKey(item.NormalizedNombre)]
                    .filter((key) => key)
                    .forEach((key) => {
                        if (!cronicoCatalogByName.has(key)) cronicoCatalogByName.set(key, item);
                    });
            });

            const cronicoCatalogValue = (metadata, field) => metadata && metadata[field] ? String(metadata[field]).trim() : "";

            const cronicoFormatInfusionTime = (metadata) => {
                const value = cronicoCatalogValue(metadata, "TiempoInfusionMinutos");
                if (!value || /NO APLICA/i.test(value) || /ORDEN MEDICA/i.test(value)) return value;
                return /^\d+([.,]\d+)?$/.test(value) ? `${value} MIN` : value;
            };

            const getCronicoFormValue = (name) => {
                const control = form ? form.querySelector(`[name='${name}']`) : null;
                return control ? String(control.value || "").trim() : "";
            };

            const formatDateForCronicoKardex = (value) => {
                const parts = String(value || "").split("-");
                return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : (value || "");
            };

            const setCronicoKardexField = (field, value) => {
                const control = document.querySelector(`#cronicoKardexModal [data-kardex-field='${field}']`);
                if (control) control.value = value || "";
            };

            const setCronicoKardexMedField = (row, field, value) => {
                const control = document.querySelector(`#cronicoKardexModal [data-kardex-med-row='${row}'] [data-kardex-med-field='${field}']`);
                if (control) control.value = value || "";
            };

            const setCronicoRequisitionField = (field, value) => {
                const control = document.querySelector(`#cronicoKardexModal [data-requisition-field='${field}']`);
                if (control) control.value = value || "";
            };

            const setCronicoRequisitionRowField = (row, field, value) => {
                const control = document.querySelector(`#cronicoKardexModal [data-requisition-row='${row}'] [data-requisition-item-field='${field}']`);
                if (control) control.value = value || "";
            };

            const cronicoParseDecimal = (value) => {
                const normalized = String(value || "").replace(/,/g, ".").replace(/[^0-9.]/g, "");
                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const cronicoFormatQuantity = (value) => {
                const numeric = Number(value);
                if (!Number.isFinite(numeric) || numeric <= 0) return "";
                return Number.isInteger(numeric) ? String(numeric) : String(Math.round(numeric * 100) / 100);
            };

            const cronicoFrequencyPerDay = (frequency) => {
                const normalized = String(frequency || "").toUpperCase();
                const numberMatch = normalized.match(/(\d+(?:[.,]\d+)?)/);
                const number = numberMatch ? cronicoParseDecimal(numberMatch[1]) : 0;
                if (normalized.includes("24") && normalized.includes("HORA")) return 1;
                if (normalized.includes("12") && normalized.includes("HORA")) return 2;
                if (normalized.includes("8") && normalized.includes("HORA")) return 3;
                if (normalized.includes("6") && normalized.includes("HORA")) return 4;
                if (normalized.includes("4") && normalized.includes("HORA")) return 6;
                if (number > 0 && normalized.includes("HORA")) return 24 / number;
                if (normalized.includes("DIA") || normalized.includes("DIARIA")) return number > 0 ? number : 1;
                return number;
            };

            const cronicoEveryThreeDaysQty = (daysValue, minimumTwoWhenLessThanOne = false) => {
                const days = cronicoParseDecimal(daysValue);
                if (days <= 0) return minimumTwoWhenLessThanOne ? 2 : 0;
                const raw = days / 3;
                if (minimumTwoWhenLessThanOne && raw < 1) return 2;
                return Math.ceil(raw);
            };

            const getCronicoKardexMeds = () => {
                const fechaInicio = formatDateForCronicoKardex(getAgudValue("agudizacionFechaInicio"));
                const fechaFin = formatDateForCronicoKardex(getAgudValue("agudizacionFechaFin"));
                return medSuffixes.map((suffix, i) => {
                    const index = i + 1;
                    const active = isMedActive(index);
                    const name = active ? getAgudValue(`agudizacionNombreMed${suffix}`) : "";
                    return {
                        name,
                        dose: active ? getAgudValue(`agudizacionDosisMed${suffix}`) : "",
                        measure: active ? getAgudValue(`agudizacionMedidaMed${suffix}`) : "",
                        route: active ? getAgudValue(`agudizacionViaMed${suffix}`) : "",
                        frequency: active ? getAgudValue(`agudizacionFrecuenciaMed${suffix}`) : "",
                        days: active ? getAgudValue(`agudizacionDiasMed${suffix}`) : "",
                        startDate: name ? fechaInicio : "",
                        endDate: name ? fechaFin : ""
                    };
                });
            };

            const buildCronicoDoseText = (medication) => {
                const doseParts = [medication.dose, medication.measure].filter((part) => part);
                return [
                    medication.name,
                    doseParts.join(" "),
                    medication.route,
                    medication.frequency,
                    medication.days ? `POR ${medication.days} DIAS` : ""
                ].filter((part) => part).join(" ").toUpperCase();
            };

            const syncCronicoKardexSheet = () => {
                const tipoDocumento = getCronicoFormValue("TipoIdentificacion");
                const numeroDocumento = getCronicoFormValue("NumeroIdentificacion");
                setCronicoKardexField("paciente", getCronicoFormValue("NombrePaciente"));
                setCronicoKardexField("documento", [tipoDocumento, numeroDocumento].filter((v) => v).join(" "));
                setCronicoKardexField("direccion", [getCronicoFormValue("Direccion"), getCronicoFormValue("DetalleDireccion")].filter((v) => v).join(" "));
                setCronicoKardexField("edad", getCronicoFormValue("Edad"));
                setCronicoKardexField("cie10", getAgudValue("agudizacionCie10Input"));
                setCronicoKardexField("diagnostico", getAgudValue("agudizacionDiagnosticoInput"));
                setCronicoKardexField("auxiliarAsignado", getAgudValue("agudizacionAuxiliarAsignado"));
                setCronicoKardexField("observaciones", "");

                getCronicoKardexMeds().forEach((medication, i) => {
                    const row = i + 1;
                    const metadata = cronicoCatalogByName.get(normalizeCronicoMedKey(medication.name));
                    const hasMedication = !!medication.name;
                    const rowEl = document.querySelector(`#cronicoKardexModal [data-kardex-med-row='${row}']`);
                    if (rowEl) rowEl.classList.toggle("d-none", row > 1 && !hasMedication);
                    setCronicoKardexMedField(row, "presentacion", hasMedication
                        ? [`Medicamento ${row}`, medication.name].filter((part) => part).join("\n")
                        : `Medicamento ${row}`);
                    setCronicoKardexMedField(row, "dosisFrecuencia", hasMedication ? buildCronicoDoseText(medication) : "");
                    setCronicoKardexMedField(row, "vehiculoReconstitucion", cronicoCatalogValue(metadata, "VehiculoReconstitucion"));
                    setCronicoKardexMedField(row, "volumenDilucion", cronicoCatalogValue(metadata, "DilucionRecomendada"));
                    setCronicoKardexMedField(row, "tiempoInfusion", cronicoFormatInfusionTime(metadata));
                    setCronicoKardexMedField(row, "fotosensible", cronicoCatalogValue(metadata, "EquipoFotosensible"));
                    setCronicoKardexMedField(row, "cadenaFrio", cronicoCatalogValue(metadata, "CadenaFrio"));
                    setCronicoKardexMedField(row, "aislamiento", "");
                    setCronicoKardexMedField(row, "estabilidad", cronicoCatalogValue(metadata, "TiempoEstabilidad"));
                    setCronicoKardexMedField(row, "bombaInfusion", cronicoCatalogValue(metadata, "BombaInfusion"));
                    setCronicoKardexMedField(row, "fechaInicio", medication.startDate);
                    setCronicoKardexMedField(row, "fechaFin", medication.endDate);
                });
            };

            const syncCronicoRequisitionSheet = () => {
                setCronicoRequisitionField("auxiliarEncargado", getAgudValue("agudizacionAuxiliarAsignado"));
                setCronicoRequisitionField("paciente", getCronicoFormValue("NombrePaciente"));
                setCronicoRequisitionField("documento", getCronicoFormValue("NumeroIdentificacion"));
                setCronicoRequisitionField("direccion", getCronicoFormValue("Direccion"));
                setCronicoRequisitionField("diagnostico", [getAgudValue("agudizacionCie10Input"), getAgudValue("agudizacionDiagnosticoInput")].filter((v) => v).join(" "));

                const medications = getCronicoKardexMeds().filter((m) => m.name && m.name.toLowerCase() !== "no");
                const rows = medications.map((medication) => {
                    const dose = Math.max(cronicoParseDecimal(medication.dose) || 1, 1);
                    const dailyDoses = cronicoFrequencyPerDay(medication.frequency);
                    const days = cronicoParseDecimal(medication.days);
                    return {
                        descripcion: medication.name,
                        detalle: "",
                        cantidad: cronicoFormatQuantity(dose * dailyDoses * days),
                        fechaInicio: medication.startDate,
                        fechaFin: medication.endDate
                    };
                });

                const pushDistinctCatalogRows = (description, field, quantity) => {
                    const details = new Map();
                    medications.forEach((medication) => {
                        const metadata = cronicoCatalogByName.get(normalizeCronicoMedKey(medication.name));
                        const detail = cronicoCatalogValue(metadata, field);
                        if (detail) details.set(detail.toUpperCase(), detail);
                    });
                    details.forEach((detail) => {
                        rows.push({
                            descripcion: description,
                            detalle: detail,
                            cantidad: typeof quantity === "function" ? quantity() : quantity,
                            fechaInicio: medications[0]?.startDate || "",
                            fechaFin: medications[0]?.endDate || ""
                        });
                    });
                };

                const aplicacionesTotales = cronicoFormatQuantity(cronicoParseDecimal(getAgudValue("agudizacionAplicacionesTotales")));
                const diasTratamientoIv = getAgudValue("agudizacionDiasTratamientoIv");
                pushDistinctCatalogRows("SOLUCION PARA DILUCION", "SolucionParaDilucion", "");
                pushDistinctCatalogRows("JERINGA", "Jeringa", aplicacionesTotales);
                [
                    ["JELCO #22", cronicoEveryThreeDaysQty(diasTratamientoIv, true)],
                    ["ATI", cronicoEveryThreeDaysQty(diasTratamientoIv)],
                    ["MACROGOTERO", cronicoEveryThreeDaysQty(diasTratamientoIv)],
                    ["BURETRA", cronicoEveryThreeDaysQty(diasTratamientoIv)],
                    ["GUANTES (PAR)", cronicoParseDecimal(getAgudValue("agudizacionAplicacionesTotales"))]
                ].forEach(([descripcion, cantidad]) => {
                    rows.push({
                        descripcion,
                        detalle: "",
                        cantidad: cronicoFormatQuantity(cantidad),
                        fechaInicio: medications[0]?.startDate || formatDateForCronicoKardex(getAgudValue("agudizacionFechaInicio")),
                        fechaFin: medications[0]?.endDate || formatDateForCronicoKardex(getAgudValue("agudizacionFechaFin"))
                    });
                });

                for (let row = 1; row <= 16; row += 1) {
                    const data = rows[row - 1] || {};
                    setCronicoRequisitionRowField(row, "item", row);
                    setCronicoRequisitionRowField(row, "descripcion", data.descripcion || "");
                    setCronicoRequisitionRowField(row, "detalle", data.detalle || "");
                    setCronicoRequisitionRowField(row, "cantidad", data.cantidad || "");
                    setCronicoRequisitionRowField(row, "fechaInicio", data.fechaInicio || "");
                    setCronicoRequisitionRowField(row, "fechaFin", data.fechaFin || "");
                }
            };

            const collectCronicoKardexPayload = () => {
                const fields = {};
                document.querySelectorAll("#cronicoKardexModal [data-kardex-field]").forEach((control) => {
                    fields[control.dataset.kardexField] = control.value || "";
                });
                const medRows = Array.from(document.querySelectorAll("#cronicoKardexModal [data-kardex-med-row]"))
                    .map((rowElement) => {
                        const rowData = { row: rowElement.dataset.kardexMedRow };
                        rowElement.querySelectorAll("[data-kardex-med-field]").forEach((control) => {
                            rowData[control.dataset.kardexMedField] = control.value || "";
                        });
                        return rowData;
                    });
                return { fields, medRows };
            };

            const collectCronicoRequisitionPayload = () => {
                const fields = {};
                document.querySelectorAll("#cronicoKardexModal [data-requisition-field]").forEach((control) => {
                    fields[control.dataset.requisitionField] = control.value || "";
                });
                const rows = Array.from(document.querySelectorAll("#cronicoKardexModal [data-requisition-row]"))
                    .map((rowElement) => {
                        const row = {};
                        rowElement.querySelectorAll("[data-requisition-item-field]").forEach((control) => {
                            row[control.dataset.requisitionItemField] = control.value || "";
                        });
                        return row;
                    })
                    .filter((row) => Object.entries(row)
                        .some(([key, value]) => key !== "item" && String(value || "").trim().length > 0));
                return { fields, rows };
            };

            // Datos del paciente y de la agudización que siempre se sincronizan desde el
            // formulario (nunca se restauran del JSON guardado) para reflejar correcciones.
            const cronicoKardexSyncedFields = new Set([
                "paciente", "documento", "direccion", "edad", "cie10", "diagnostico", "auxiliarAsignado"
            ]);

            const loadCronicoKardexPayload = (payload) => {
                if (!payload) return;
                if (payload.fields) {
                    Object.entries(payload.fields).forEach(([key, value]) => {
                        if (cronicoKardexSyncedFields.has(key) || !value) return;
                        const control = document.querySelector(`#cronicoKardexModal [data-kardex-field='${key}']`);
                        if (control) control.value = value;
                    });
                }
                if (Array.isArray(payload.medRows)) {
                    payload.medRows.forEach((rowData) => {
                        const row = rowData.row;
                        Object.entries(rowData).forEach(([field, value]) => {
                            if (field === "row" || !value) return;
                            const control = document.querySelector(`#cronicoKardexModal [data-kardex-med-row='${row}'] [data-kardex-med-field='${field}']`);
                            if (control) control.value = value;
                        });
                    });
                }
            };

            const cronicoRequisitionSyncedFields = new Set([
                "paciente", "documento", "direccion", "diagnostico", "auxiliarEncargado"
            ]);

            const loadCronicoRequisitionPayload = (payload) => {
                if (!payload) return;
                if (payload.fields) {
                    Object.entries(payload.fields).forEach(([key, value]) => {
                        if (cronicoRequisitionSyncedFields.has(key)) return;
                        const control = document.querySelector(`#cronicoKardexModal [data-requisition-field='${key}']`);
                        if (control) control.value = value || "";
                    });
                }
                if (Array.isArray(payload.rows)) {
                    payload.rows.forEach((rowData, index) => {
                        const rowNum = index + 1;
                        Object.entries(rowData).forEach(([field, value]) => {
                            const control = document.querySelector(`#cronicoKardexModal [data-requisition-row='${rowNum}'] [data-requisition-item-field='${field}']`);
                            if (control) control.value = value || "";
                        });
                    });
                }
            };

            const getActiveAgudizacionItem = () =>
                (agudizacionesState || []).find((x) => String(x.id) === String(activeAgudizacionId)) || null;

            const isCronicoDocumentClosed = () => !!getActiveAgudizacionItem()?.cerrada;

            const refreshAgudizacionesState = async () => {
                if (!cronicoRecordId) return;
                try {
                    const response = await fetch(`${obtenerAgudizacionesUrl}?id=${encodeURIComponent(cronicoRecordId)}`);
                    if (response.ok) {
                        const data = await response.json();
                        agudizacionesState = data.agudizaciones || [];
                    }
                } catch { /* se conserva el estado local */ }
                renderAgudizacionVersions();
            };

            const setCronicoDocumentClosedMode = (closed) => {
                cronicoKardexModalEl?.classList.toggle("is-document-closed", closed);
                cronicoClosedBanner?.classList.toggle("d-none", !closed);
                document
                    .querySelectorAll("#cronicoKardexModal input, #cronicoKardexModal textarea, #cronicoKardexModal select")
                    .forEach((control) => {
                        if (control.id === "cronicoServiciosCargadosSwitch") {
                            control.disabled = closed;
                            return;
                        }
                        if (control.type === "hidden") return;
                        control.readOnly = closed;
                        if (control.matches("select, input[type=checkbox], input[type=radio]")) {
                            control.disabled = closed;
                        }
                    });
                if (guardarCronicoDocumentosBtn) guardarCronicoDocumentosBtn.disabled = closed;
                if (enviarFarmaciaCronicoBtn) enviarFarmaciaCronicoBtn.disabled = closed || !(cronicoServiciosSwitch?.checked);
            };

            const updateCronicoReaperturaControls = () => {
                if (!solicitarReaperturaCronicoBtn) return;
                const closed = isCronicoDocumentClosed();
                const solicitud = getActiveAgudizacionItem()?.reaperturaSolicitud || null;
                const pendiente = !!(solicitud && solicitud.estado === "Pendiente");

                solicitarReaperturaCronicoBtn.classList.toggle("d-none", !(closed && !pendiente));

                if (cronicoReaperturaStatusNote) {
                    if (pendiente) {
                        const quien = solicitud.solicitante ? ` por ${solicitud.solicitante}` : "";
                        cronicoReaperturaStatusNote.textContent = `Reapertura solicitada${quien} — pendiente de aprobación.`;
                    }
                    cronicoReaperturaStatusNote.classList.toggle("d-none", !pendiente);
                }

                const puedeGestionar = pendiente && puedeAprobarReaperturaCronico;
                aprobarReaperturaCronicoBtn?.classList.toggle("d-none", !puedeGestionar);
                rechazarReaperturaCronicoBtn?.classList.toggle("d-none", !puedeGestionar);
            };

            const postCronicoForm = async (url, fieldsObj) => {
                const body = new URLSearchParams();
                Object.entries(fieldsObj || {}).forEach(([k, v]) => body.set(k, String(v)));
                const response = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded",
                        ...(csrfTokenInput?.value ? { "RequestVerificationToken": csrfTokenInput.value } : {})
                    },
                    body: body.toString()
                });
                const data = await response.json().catch(() => ({}));
                return { ok: response.ok, data };
            };

            // Modo solo lectura de la sección Agudizaciones cuando el kardex está cerrado.
            const agudizacionAlwaysReadonlyIds = new Set([
                "agudizacionDiagnosticoInput", "agudizacionAplicacionesTotales",
                "agudizacionDiasTratamientoIv", "agudizacionFechaFin"
            ]);

            const updateAgudizacionReadonlyMode = () => {
                const pane = document.getElementById("tab-agudizaciones");
                if (!pane) return;
                const closed = isCronicoDocumentClosed();
                let banner = document.getElementById("agudizacionKardexCerradoBanner");
                if (closed && !banner) {
                    banner = document.createElement("div");
                    banner.id = "agudizacionKardexCerradoBanner";
                    banner.className = "alert alert-warning mb-3";
                    banner.setAttribute("role", "alert");
                    banner.innerHTML = "<strong>Kardex cerrado.</strong> Esta agudización fue aprobada por farmacia y quedó en modo de solo lectura. Para modificarla usa <strong>Solicitar reapertura de kardex</strong> dentro de <strong>Gestionar kardex y requisición</strong>.";
                    pane.querySelector(".card-body")?.prepend(banner);
                }
                banner?.classList.toggle("d-none", !closed);

                pane.querySelectorAll("input, select, textarea").forEach((control) => {
                    if (control.id === "agudizacionVersionSelect") return;
                    if (control.type === "hidden") return;
                    if (control.matches("select, input[type=checkbox], input[type=radio]")) {
                        control.disabled = closed;
                    } else {
                        control.readOnly = closed || agudizacionAlwaysReadonlyIds.has(control.id);
                    }
                });
                if (guardarAgudizacionBtn) guardarAgudizacionBtn.disabled = closed;
            };

            const switchCronicoDocumentPane = (target) => {
                document.querySelectorAll("#cronicoKardexModal [data-cronico-document-target]").forEach((button) => {
                    const isActive = button.dataset.cronicoDocumentTarget === target;
                    button.classList.toggle("active", isActive);
                    button.setAttribute("aria-selected", isActive ? "true" : "false");
                });
                document.querySelectorAll("#cronicoKardexModal [data-cronico-document-pane]").forEach((pane) => {
                    pane.classList.toggle("active", pane.dataset.cronicoDocumentPane === target);
                });
            };

            document.querySelectorAll("#cronicoKardexModal [data-cronico-document-target]").forEach((button) => {
                button.addEventListener("click", () => switchCronicoDocumentPane(button.dataset.cronicoDocumentTarget || "kardex"));
            });

            if (cronicoKardexModalEl) {
                cronicoKardexModalEl.addEventListener("show.bs.modal", (event) => {
                    if (!activeAgudizacionId) {
                        event.preventDefault();
                        showCronicoFeedback(
                            "Guarda la agudización primero",
                            "<p class=\"mb-0\">Selecciona una agudización guardada (o guarda la nueva) antes de gestionar su kardex y requisición.</p>",
                            "warning");
                        return;
                    }

                    (async () => {
                        await refreshAgudizacionesState();
                        const item = getActiveAgudizacionItem();
                        if (cronicoDocumentContextBadge) {
                            cronicoDocumentContextBadge.textContent = item ? `Agudización #${item.numero}` : "";
                        }
                        switchCronicoDocumentPane("kardex");
                        syncCronicoKardexSheet();
                        syncCronicoRequisitionSheet();
                        try { if (item?.kardexJson) loadCronicoKardexPayload(JSON.parse(item.kardexJson)); } catch { /* sync base */ }
                        try { if (item?.requisicionJson) loadCronicoRequisitionPayload(JSON.parse(item.requisicionJson)); } catch { /* sync base */ }
                        if (cronicoServiciosSwitch) cronicoServiciosSwitch.checked = false;
                        setCronicoDocumentClosedMode(isCronicoDocumentClosed());
                        updateCronicoReaperturaControls();
                        updateAgudizacionReadonlyMode();
                    })();
                });
            }

            cronicoServiciosSwitch?.addEventListener("change", () => {
                if (enviarFarmaciaCronicoBtn) {
                    enviarFarmaciaCronicoBtn.disabled = isCronicoDocumentClosed() || !cronicoServiciosSwitch.checked;
                }
            });

            enviarFarmaciaCronicoWrapper?.addEventListener("click", () => {
                if (!enviarFarmaciaCronicoBtn?.disabled) return;
                if (isCronicoDocumentClosed()) {
                    showCronicoFeedback(
                        "Kardex cerrado",
                        "<p class=\"mb-0\">Este kardex y su requisición ya fueron aprobados por farmacia. Están disponibles solo para consulta.</p>",
                        "warning");
                    return;
                }
                showCronicoFeedback(
                    "Servicios no cargados",
                    "<p class=\"mb-0\">Primero tienes que cargar los servicios. Activa el interruptor <strong>Servicios cargados</strong> para poder enviar a farmacia.</p>",
                    "warning");
            });

            guardarCronicoDocumentosBtn?.addEventListener("click", async () => {
                if (!activeAgudizacionId) return;
                if (isCronicoDocumentClosed()) {
                    showCronicoFeedback("Kardex cerrado", "<p class=\"mb-0\">Este kardex y su requisición ya fueron aprobados por farmacia y no se pueden editar.</p>", "warning");
                    return;
                }
                guardarCronicoDocumentosBtn.disabled = true;
                try {
                    const { ok, data } = await postCronicoForm(guardarCronicoDocumentosUrl, {
                        agudizacionId: activeAgudizacionId,
                        kardexJson: JSON.stringify(collectCronicoKardexPayload()),
                        requisicionJson: JSON.stringify(collectCronicoRequisitionPayload())
                    });
                    if (!ok) {
                        showCronicoFeedback("Error al guardar", `<p class="mb-0">${cronicoEscapeHtml(data.message || "No se pudo guardar.")}</p>`, "danger");
                        return;
                    }
                    await refreshAgudizacionesState();
                    showCronicoFeedback("Guardado", `<p class="mb-0">${cronicoEscapeHtml(data.message || "Documentos guardados correctamente.")}</p>`, "success");
                } finally {
                    guardarCronicoDocumentosBtn.disabled = isCronicoDocumentClosed();
                }
            });

            enviarFarmaciaCronicoBtn?.addEventListener("click", async () => {
                if (!activeAgudizacionId) return;
                if (isCronicoDocumentClosed()) {
                    showCronicoFeedback("Kardex cerrado", "<p class=\"mb-0\">Este kardex ya fue aprobado por farmacia y no se puede reenviar.</p>", "warning");
                    return;
                }
                enviarFarmaciaCronicoBtn.disabled = true;
                try {
                    const { ok, data } = await postCronicoForm(enviarFarmaciaCronicoUrl, {
                        agudizacionId: activeAgudizacionId,
                        kardexJson: JSON.stringify(collectCronicoKardexPayload()),
                        requisicionJson: JSON.stringify(collectCronicoRequisitionPayload())
                    });
                    if (!ok) {
                        showCronicoFeedback("No se pudo enviar", `<p class="mb-0">${cronicoEscapeHtml(data.message || "No fue posible enviar el pedido a farmacia.")}</p>`, "danger");
                        return;
                    }
                    await refreshAgudizacionesState();
                    updateCronicoReaperturaControls();
                    showCronicoFeedback("Enviado a farmacia", `<p class="mb-0">${cronicoEscapeHtml(data.message || "Pedido enviado a farmacia correctamente.")}</p>`, "success");
                } finally {
                    enviarFarmaciaCronicoBtn.disabled = isCronicoDocumentClosed() || !(cronicoServiciosSwitch?.checked);
                }
            });

            if (solicitarReaperturaCronicoBtn && cronicoReaperturaModalEl) {
                solicitarReaperturaCronicoBtn.addEventListener("click", () => {
                    document.querySelectorAll("#cronicoReaperturaMotivosContainer input[name='cronicoReaperturaMotivo']").forEach((r) => { r.checked = false; });
                    document.getElementById("cronicoReaperturaMotivoError")?.classList.add("d-none");
                    if (window.bootstrap && window.bootstrap.Modal) {
                        window.bootstrap.Modal.getOrCreateInstance(cronicoReaperturaModalEl).show();
                    }
                });

                const confirmarReaperturaCronicoBtn = document.getElementById("confirmarReaperturaCronicoBtn");
                confirmarReaperturaCronicoBtn?.addEventListener("click", async () => {
                    const seleccionado = document.querySelector("#cronicoReaperturaMotivosContainer input[name='cronicoReaperturaMotivo']:checked");
                    if (!seleccionado) {
                        document.getElementById("cronicoReaperturaMotivoError")?.classList.remove("d-none");
                        return;
                    }
                    if (!activeAgudizacionId) return;
                    confirmarReaperturaCronicoBtn.disabled = true;
                    try {
                        const { ok, data } = await postCronicoForm(solicitarReaperturaCronicoUrl, {
                            agudizacionId: activeAgudizacionId,
                            motivo: seleccionado.value
                        });
                        if (window.bootstrap && window.bootstrap.Modal) {
                            window.bootstrap.Modal.getOrCreateInstance(cronicoReaperturaModalEl).hide();
                        }
                        if (!ok) {
                            showCronicoFeedback("No se pudo solicitar", `<p class="mb-0">${cronicoEscapeHtml(data.message || "Error al solicitar la reapertura.")}</p>`, "danger");
                            return;
                        }
                        await refreshAgudizacionesState();
                        updateCronicoReaperturaControls();
                        showCronicoFeedback("Solicitud enviada", `<p class="mb-0">${cronicoEscapeHtml(data.message || "Solicitud de reapertura enviada.")}</p>`, "success");
                    } finally {
                        confirmarReaperturaCronicoBtn.disabled = false;
                    }
                });
            }

            aprobarReaperturaCronicoBtn?.addEventListener("click", async () => {
                const solicitud = getActiveAgudizacionItem()?.reaperturaSolicitud;
                if (!solicitud) return;
                aprobarReaperturaCronicoBtn.disabled = true;
                try {
                    const { ok, data } = await postCronicoForm(aprobarReaperturaCronicoUrl, { solicitudId: solicitud.id });
                    if (!ok) {
                        showCronicoFeedback("No se pudo aprobar", `<p class="mb-0">${cronicoEscapeHtml(data.message || "Error al aprobar la reapertura.")}</p>`, "danger");
                        return;
                    }
                    await refreshAgudizacionesState();
                    setCronicoDocumentClosedMode(isCronicoDocumentClosed());
                    updateCronicoReaperturaControls();
                    updateAgudizacionReadonlyMode();
                    showCronicoFeedback("Reapertura aprobada", `<p class="mb-0">${cronicoEscapeHtml(data.message || "El kardex quedó habilitado para edición.")}</p>`, "success");
                } finally {
                    aprobarReaperturaCronicoBtn.disabled = false;
                }
            });

            rechazarReaperturaCronicoBtn?.addEventListener("click", async () => {
                const solicitud = getActiveAgudizacionItem()?.reaperturaSolicitud;
                if (!solicitud) return;
                rechazarReaperturaCronicoBtn.disabled = true;
                try {
                    const { ok, data } = await postCronicoForm(rechazarReaperturaCronicoUrl, { solicitudId: solicitud.id });
                    if (!ok) {
                        showCronicoFeedback("No se pudo rechazar", `<p class="mb-0">${cronicoEscapeHtml(data.message || "Error al rechazar la reapertura.")}</p>`, "danger");
                        return;
                    }
                    await refreshAgudizacionesState();
                    updateCronicoReaperturaControls();
                    showCronicoFeedback("Solicitud rechazada", `<p class="mb-0">${cronicoEscapeHtml(data.message || "Solicitud de reapertura rechazada.")}</p>`, "success");
                } finally {
                    rechazarReaperturaCronicoBtn.disabled = false;
                }
            });

            if (agudizacionVersionSelect) {
                if ((agudizacionesState || []).length > 0) {
                    loadAgudizacion(agudizacionesState[agudizacionesState.length - 1].id);
                } else {
                    renderAgudizacionVersions();
                }
                syncAgudizacionMedProgression();
                syncAgudizacionCalculos();
                updateAgudizacionReadonlyMode();
            }

            // ---------------- Hospitalizaciones y seguimiento (multi-registro) ----------------
            // Mismo patrón que las agudizaciones: cada hospitalización se guarda como un JSON
            // independiente; el navegador permite alternar entre ellas y crear nuevas sin perder
            // las anteriores. Las 7 fechas de seguimiento revelan un campo de Observación cuando
            // se diligencian.
            const hospVersionSelect = document.getElementById("hospVersionSelect");
            const adicionarHospitalizacionBtn = document.getElementById("adicionarHospitalizacionBtn");
            const hospNumeroBadge = document.getElementById("hospNumeroBadge");
            const guardarHospitalizacionBtn = document.getElementById("guardarHospitalizacionBtn");
            const hospGuardadoStatus = document.getElementById("hospGuardadoStatus");
            const hospCie10Input = document.getElementById("hospCie10Input");
            const hospDiagnosticoInput = document.getElementById("hospDiagnosticoInput");
            const guardarHospitalizacionUrl = "@Url.Action("GuardarCronicoHospitalizacionRegistro", "Censo")";
            const obtenerHospitalizacionesUrl = "@Url.Action("ObtenerCronicoHospitalizaciones", "Censo")";
            let hospitalizacionesState = @Html.Raw(Json.Serialize(Model.Hospitalizaciones.Select(h => new { id = h.Id, numero = h.Numero, hospitalizacionJson = h.HospitalizacionJson })));
            let activeHospitalizacionId = null;

            const getHospValue = (id) => (document.getElementById(id)?.value || "").trim();
            const setHospValue = (id, value) => { const el = document.getElementById(id); if (el) el.value = value || ""; };
            const hospSeguimientoFecha = (n) => document.getElementById(`hospSeguimiento${n}Fecha`);
            const hospSeguimientoObs = (n) => document.getElementById(`hospSeguimiento${n}Obs`);
            const hospSeguimientoWrapper = (n) => document.getElementById(`hospSeguimiento${n}ObsWrapper`);

            // Muestra u oculta el campo Observación de un seguimiento según tenga fecha.
            const syncHospSeguimientoObs = (n, { clearWhenHidden = false } = {}) => {
                const fecha = hospSeguimientoFecha(n)?.value?.trim();
                const wrapper = hospSeguimientoWrapper(n);
                const visible = !!fecha;
                if (wrapper) wrapper.classList.toggle("d-none", !visible);
                if (!visible && clearWhenHidden) {
                    const obs = hospSeguimientoObs(n);
                    if (obs) obs.value = "";
                }
            };

            for (let n = 1; n <= 7; n++) {
                const fechaInput = hospSeguimientoFecha(n);
                fechaInput?.addEventListener("input", () => syncHospSeguimientoObs(n, { clearWhenHidden: true }));
                fechaInput?.addEventListener("change", () => syncHospSeguimientoObs(n, { clearWhenHidden: true }));
            }

            // Normaliza el CIE10 (una letra + hasta tres dígitos) y autollena el diagnóstico.
            const normalizeHospCie10 = (value) => {
                const source = String(value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
                if (!source) return "";
                const firstLetterIndex = source.search(/[A-Z]/);
                if (firstLetterIndex < 0) return "";
                const trimmed = source.slice(firstLetterIndex);
                const letter = trimmed[0];
                const digits = trimmed.slice(1).replace(/\D/g, "").slice(0, 3);
                return `${letter}${digits}`;
            };

            hospCie10Input?.addEventListener("input", () => {
                hospCie10Input.value = normalizeHospCie10(hospCie10Input.value);
                if (hospDiagnosticoInput) hospDiagnosticoInput.value = "";
            });
            hospCie10Input?.addEventListener("blur", async () => {
                const codigo = normalizeHospCie10(hospCie10Input.value);
                hospCie10Input.value = codigo;
                if (!hospDiagnosticoInput) return;
                if (codigo.length !== 4 || !/^[A-Z][0-9]{3}$/.test(codigo)) {
                    hospDiagnosticoInput.value = "";
                    return;
                }
                try {
                    const response = await fetch(`${buscarDiagnosticoCie10Url}?codigo=${encodeURIComponent(codigo)}`);
                    if (!response.ok) { hospDiagnosticoInput.value = ""; return; }
                    const data = await response.json();
                    hospDiagnosticoInput.value = data.diagnostico || "";
                } catch { hospDiagnosticoInput.value = ""; }
            });

            const collectHospitalizacionPayload = () => {
                const payload = {
                    fechaHospitalizacion: getHospValue("hospFechaHospitalizacion"),
                    motivoHospitalizacion: getHospValue("hospMotivo"),
                    remitidoPor: getHospValue("hospRemitidoPor"),
                    ipsIntramural: getHospValue("hospIps"),
                    codigoCie10: getHospValue("hospCie10Input"),
                    diagnosticoDescriptivo: getHospValue("hospDiagnosticoInput"),
                    fechaAlta: getHospValue("hospFechaAlta"),
                    numeroHospitalizacionesUltimoAnio: getHospValue("hospNumeroHospitalizaciones"),
                    seguimientos: []
                };
                for (let n = 1; n <= 7; n++) {
                    payload.seguimientos.push({
                        numero: n,
                        fecha: hospSeguimientoFecha(n)?.value?.trim() || "",
                        observacion: hospSeguimientoObs(n)?.value?.trim() || ""
                    });
                }
                return payload;
            };

            const applyHospitalizacionPayload = (data) => {
                const payload = data || {};
                setHospValue("hospFechaHospitalizacion", payload.fechaHospitalizacion);
                setHospValue("hospMotivo", payload.motivoHospitalizacion);
                setHospValue("hospRemitidoPor", payload.remitidoPor);
                setHospValue("hospIps", payload.ipsIntramural);
                setHospValue("hospCie10Input", payload.codigoCie10);
                setHospValue("hospDiagnosticoInput", payload.diagnosticoDescriptivo);
                setHospValue("hospFechaAlta", payload.fechaAlta);
                setHospValue("hospNumeroHospitalizaciones", payload.numeroHospitalizacionesUltimoAnio);
                const seguimientos = Array.isArray(payload.seguimientos) ? payload.seguimientos : [];
                for (let n = 1; n <= 7; n++) {
                    const seg = seguimientos.find((s) => Number(s?.numero) === n) || {};
                    setHospValue(`hospSeguimiento${n}Fecha`, seg.fecha);
                    setHospValue(`hospSeguimiento${n}Obs`, seg.observacion);
                    syncHospSeguimientoObs(n);
                }
            };

            const clearHospitalizacionForm = () => {
                applyHospitalizacionPayload({});
                activeHospitalizacionId = null;
                if (hospNumeroBadge) hospNumeroBadge.classList.add("d-none");
            };

            const renderHospitalizacionVersions = () => {
                if (!hospVersionSelect) return;
                hospVersionSelect.innerHTML = "";
                const nuevaOption = document.createElement("option");
                nuevaOption.value = "";
                nuevaOption.textContent = "Nueva hospitalización";
                hospVersionSelect.appendChild(nuevaOption);
                (hospitalizacionesState || []).forEach((item) => {
                    const option = document.createElement("option");
                    option.value = String(item.id);
                    option.textContent = `Hospitalización #${item.numero}`;
                    hospVersionSelect.appendChild(option);
                });
                hospVersionSelect.value = activeHospitalizacionId ? String(activeHospitalizacionId) : "";
                const activa = (hospitalizacionesState || []).find((item) => String(item.id) === String(activeHospitalizacionId));
                if (hospNumeroBadge) {
                    hospNumeroBadge.classList.toggle("d-none", !activa);
                    if (activa) hospNumeroBadge.textContent = `Hospitalización #${activa.numero}`;
                }
            };

            const loadHospitalizacion = (versionId) => {
                if (!versionId) { clearHospitalizacionForm(); renderHospitalizacionVersions(); return; }
                const item = (hospitalizacionesState || []).find((x) => String(x.id) === String(versionId));
                if (!item) { clearHospitalizacionForm(); renderHospitalizacionVersions(); return; }
                activeHospitalizacionId = item.id;
                let parsed = {};
                try { parsed = JSON.parse(item.hospitalizacionJson || "{}"); } catch { parsed = {}; }
                applyHospitalizacionPayload(parsed);
                renderHospitalizacionVersions();
            };

            hospVersionSelect?.addEventListener("change", () => loadHospitalizacion(hospVersionSelect.value));
            adicionarHospitalizacionBtn?.addEventListener("click", () => {
                clearHospitalizacionForm();
                renderHospitalizacionVersions();
                if (hospGuardadoStatus) hospGuardadoStatus.textContent = "Nueva hospitalización lista para diligenciar.";
            });

            guardarHospitalizacionBtn?.addEventListener("click", async () => {
                if (!cronicoRecordId || !csrfTokenInput) return;
                guardarHospitalizacionBtn.disabled = true;
                if (hospGuardadoStatus) hospGuardadoStatus.textContent = "Guardando...";
                try {
                    const body = new URLSearchParams();
                    body.set("id", String(cronicoRecordId));
                    body.set("hospitalizacionJson", JSON.stringify(collectHospitalizacionPayload()));
                    if (activeHospitalizacionId) body.set("hospitalizacionVersionId", String(activeHospitalizacionId));

                    const response = await fetch(guardarHospitalizacionUrl, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded",
                            "RequestVerificationToken": csrfTokenInput.value
                        },
                        body: body.toString()
                    });
                    const data = await response.json().catch(() => ({}));
                    if (!response.ok) {
                        if (hospGuardadoStatus) hospGuardadoStatus.textContent = data.message || "No fue posible guardar la hospitalización.";
                        return;
                    }
                    activeHospitalizacionId = data.hospitalizacionId || activeHospitalizacionId;
                    const listResponse = await fetch(`${obtenerHospitalizacionesUrl}?id=${encodeURIComponent(cronicoRecordId)}`);
                    if (listResponse.ok) {
                        const listData = await listResponse.json();
                        hospitalizacionesState = listData.hospitalizaciones || [];
                    }
                    renderHospitalizacionVersions();
                    if (hospGuardadoStatus) hospGuardadoStatus.textContent = data.message || "Hospitalización guardada correctamente.";
                } catch {
                    if (hospGuardadoStatus) hospGuardadoStatus.textContent = "No fue posible guardar la hospitalización.";
                } finally {
                    guardarHospitalizacionBtn.disabled = false;
                }
            });

            if (hospVersionSelect) {
                if ((hospitalizacionesState || []).length > 0) {
                    loadHospitalizacion(hospitalizacionesState[hospitalizacionesState.length - 1].id);
                } else {
                    renderHospitalizacionVersions();
                    for (let n = 1; n <= 7; n++) syncHospSeguimientoObs(n);
                }
            }

            form?.addEventListener("submit", (event) => {
                const submitAction = event.submitter?.getAttribute("formaction") || "";
                if (submitAction.includes("GuardarCronicoGestionCaso")
                    || submitAction.includes("GuardarCronicoHospitalizacion")) {
                    return;
                }
                if (direccionInput?.value.trim() && !direccionValidada && !asumirDireccionCheck?.checked) {
                    event.preventDefault();
                    setDireccionMessage("warning", "Debes validar la dirección o marcar 'Asumir dirección errada y continuar'.");
                    direccionInput?.focus();
                }
            });
        })();
    </script>
}
