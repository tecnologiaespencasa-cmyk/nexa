        nameof(CensoRecord.FechaPrimerSeguimiento24Horas),
        nameof(CensoRecord.FechaSegundoSeguimiento48Horas),
        nameof(CensoRecord.FechaTercerSeguimiento72Horas),
        nameof(CensoRecord.ObservacionAltaTardia),
        nameof(CensoRecord.NombreQuienRealizaSeguimientoAltaTardia),
        nameof(CensoRecord.PacienteRehospitalizado),
        nameof(CensoRecord.FechaRegistroReporteRehospitalizacion),
        nameof(CensoRecord.FechaRehospitalizacion),
        nameof(CensoRecord.MotivoRehospitalizacion),
        nameof(CensoRecord.AmpliacionMotivoRehospitalizacion),
        nameof(CensoRecord.RemitidoPorRehospitalizacion),
        nameof(CensoRecord.IpsIntramuralRehospitalizacion),
        nameof(CensoRecord.FechaPrimerSeguimientoRehospitalizacion),
        nameof(CensoRecord.FechaSegundoSeguimientoRehospitalizacion),
        nameof(CensoRecord.FechaTercerSeguimientoRehospitalizacion),
        nameof(CensoRecord.FechaAltaHospitalizacion),
        nameof(CensoRecord.ObservacionRehospitalizacion),
        nameof(CensoRecord.FechaNovedadDevolucionProductos),
        nameof(CensoRecord.MotivoNovedadDevolucionProductos),
        nameof(CensoRecord.NotificacionAuxiliarDevolucionProductos),
        nameof(CensoRecord.FechaMaximaDevolucionProductos),
        nameof(CensoRecord.EstadoDevolucionServicioFarmaceutico),
        nameof(CensoRecord.CreatedAtUtc)
    };
    var hiddenCensoTableColumns = new HashSet<string>
    {
        nameof(CensoRecord.KardexEdicionJson),
        nameof(CensoRecord.RequisicionFarmaciaJson),
        nameof(CensoRecord.ProrrogaKardexEdicionJson),
        nameof(CensoRecord.ProrrogaRequisicionFarmaciaJson),
        nameof(CensoRecord.ProrrogaJson),
        nameof(CensoRecord.DireccionValidada),
        nameof(CensoRecord.AsumirDireccionErrada),
        nameof(CensoRecord.FarmaciaEnviadoAtUtc),
        nameof(CensoRecord.FarmaciaKardexVistoAtUtc),
        nameof(CensoRecord.FarmaciaRequisicionVistoAtUtc),
        nameof(CensoRecord.FarmaciaNombreRecibe),
        nameof(CensoRecord.FarmaciaFirmaEntregaDataUrl),
        nameof(CensoRecord.FarmaciaFirmaRecibeDataUrl),
        nameof(CensoRecord.FarmaciaFechaHoraRecepcionUtc),
        nameof(CensoRecord.FarmaciaFirmaActualizadaAtUtc),
        nameof(CensoRecord.Adjuntos),
        nameof(CensoRecord.Prorrogas)
    };
    var censoTableColumns = typeof(CensoRecord).GetProperties()
        .Where(property => !hiddenCensoTableColumns.Contains(property.Name))
        .Select((property, index) => new
        {
            Property = property,
            OriginalIndex = index,
            PriorityIndex = Array.IndexOf(censoColumnOrder, property.Name)
        })
        .OrderBy(item => item.PriorityIndex >= 0 ? item.PriorityIndex : int.MaxValue)
        .ThenBy(item => item.OriginalIndex)
        .Select(item => item.Property)
        .ToArray();
    var censoColumnTitleOverrides = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        [nameof(CensoRecord.Id)] = "Número de registro",
        [nameof(CensoRecord.CreatedAtUtc)] = "Fecha de creación",
        [nameof(CensoRecord.EsProrroga)] = "Tiene prórroga",
        [nameof(CensoRecord.KardexCerradoAtUtc)] = "Fecha de cierre del Kardex",
        [nameof(CensoRecord.KardexCerradoPorFarmaciaId)] = "Registro de Farmacia que cerró el Kardex",
        [nameof(CensoRecord.ProrrogaCerradaAtUtc)] = "Fecha de cierre de la prórroga",
        [nameof(CensoRecord.ProrrogaCerradaPorFarmaciaId)] = "Registro de Farmacia que cerró la prórroga",
        [nameof(CensoRecord.FechaGestionFarmacia)] = "Fecha de envío a Farmacia",
        [nameof(CensoRecord.HoraGestionFarmacia)] = "Hora de envío a Farmacia",
        [nameof(CensoRecord.IndicadorTiempoRespuestaMinutos)] = "Tiempo de respuesta (minutos)",
        [nameof(CensoRecord.IndicadorTiempoGestionMinutos)] = "Tiempo de gestión en Farmacia (minutos)"
    };
    Func<string, string> humanizeColumnTitle = name =>
    {
        var title = System.Text.RegularExpressions.Regex.Replace(name, "([a-z0-9])([A-Z])", "$1 $2");
        return title
            .Replace(" Utc", " UTC", StringComparison.OrdinalIgnoreCase)
            .Replace(" Id", " ID", StringComparison.OrdinalIgnoreCase)
            .Replace("Cie 10", "CIE10", StringComparison.OrdinalIgnoreCase)
            .Replace("Ips", "IPS", StringComparison.OrdinalIgnoreCase)
            .Replace("Tto", "TTO", StringComparison.OrdinalIgnoreCase)
            .Replace("Mx", "MX", StringComparison.OrdinalIgnoreCase);
    };
    Func<string, string> getCensoColumnTitle = name => censoColumnTitleOverrides.TryGetValue(name, out var title)
        ? title
        : humanizeColumnTitle(name);
    var prorrogaColumnTitleOverrides = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Prorroga_Numero"] = "Número de prórroga",
        ["Prorroga_Cerrada"] = "Prórroga cerrada",
        ["Prorroga_TipoProrroga"] = "Tipo de prórroga",
        ["Prorroga_SeguimientoMedico"] = "Seguimiento médico"
    };
    Func<string, string> getProrrogaColumnTitle = name => prorrogaColumnTitleOverrides.TryGetValue(name, out var title)
        ? title
        : $"Prórroga - {humanizeColumnTitle(name.Replace("Prorroga_", string.Empty, StringComparison.OrdinalIgnoreCase))}";
}

        <form asp-action="ProgramaAgudos" method="post" id="censoForm" class="censo-form-shell">
            <div asp-validation-summary="All" class="alert alert-danger censo-validation-summary mb-4" role="alert"></div>
            <input asp-for="EditingRecordId" type="hidden" />
            <input type="hidden" name="CedulaFiltro" value="@Model.CedulaFiltro" />
            <input asp-for="FechaIngresoFiltroDesde" type="hidden" />
            <input asp-for="FechaIngresoFiltroHasta" type="hidden" />

            <div class="tab-content">
                    <div class="tab-pane fade" id="tab-agudos-oculto-recepcion" role="tabpanel" aria-labelledby="tab-agudos-oculto-recepcion-link" data-section-title="Recepción del paciente" data-section-description="Registra tiempos de ingreso, respuesta y responsables del caso con una lectura clara y ordenada.">
                        <div class="card">
                            <div class="card-header">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="censo-card-heading">
                                        <span class="censo-card-heading__eyebrow">Sección 1</span>
                                        <h2 class="h5 mb-0">Recepción del paciente</h2>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                @if (!hasNursingAssistants)
                                {
                                    <div class="alert alert-warning">
                                        No hay auxiliares de enfermería activos. Debes registrarlos en Administración de usuarios.
                                    </div>
                                }

                                <div class="censo-recepcion-layout">
                                    <section class="censo-recepcion-panel censo-recepcion-panel--timing">
                                        <div class="censo-recepcion-panel__header">
                                            <span class="censo-recepcion-panel__eyebrow">Tiempos clave</span>
                                        </div>

                                        <div class="censo-recepcion-timeline">
                                            <div class="censo-time-card">
                                                <div class="censo-time-card__header">
                                                    <span class="censo-time-card__step">01</span>
                                                    <div>
                                                        <label asp-for="FechaIngreso" class="form-label censo-time-card__label"></label>
                                                        <p>Registro inicial del paciente.</p>
                                                    </div>
                                                </div>
                                                <div class="censo-time-card__grid">
                                                    <div class="censo-compact-field">
                                                        <label asp-for="FechaIngreso" class="form-label">Fecha</label>
                                                        <input asp-for="FechaIngreso" type="date" class="form-control" />
                                                    </div>
                                                    <div class="censo-compact-field">
                                                        <label asp-for="HoraIngreso" class="form-label">Hora</label>
                                                        <input asp-for="HoraIngreso" type="text" class="form-control hora-24h-input" placeholder="HH:mm" maxlength="5" autocomplete="off" aria-label="Hora de ingreso (formato 24h)" />
                                                    </div>
                                                </div>
                                                <span asp-validation-for="FechaIngreso" class="text-danger d-block"></span>
                                                <span asp-validation-for="HoraIngreso" class="text-danger d-block"></span>
                                            </div>

                                            <div class="censo-time-card">
                                                <div class="censo-time-card__header">
                                                    <span class="censo-time-card__step">02</span>
                                                    <div>
                                                        <label asp-for="FechaRespuesta" class="form-label censo-time-card__label"></label>
                                                        <p>Momento en que se confirma la atencion del caso.</p>
                                                    </div>
                                                </div>
                                                <div class="censo-time-card__grid">
                                                    <div class="censo-compact-field">
                                                        <label asp-for="FechaRespuesta" class="form-label">Fecha</label>
                                                        <input asp-for="FechaRespuesta" type="date" class="form-control" />
                                                    </div>
                                                    <div class="censo-compact-field">
                                                        <label asp-for="HoraRespuesta" class="form-label">Hora</label>
                                                        <input asp-for="HoraRespuesta" type="text" class="form-control hora-24h-input" placeholder="HH:mm" maxlength="5" autocomplete="off" aria-label="Hora de respuesta (formato 24h)" />
                                                    </div>
                                                </div>
                                                <span asp-validation-for="FechaRespuesta" class="text-danger d-block"></span>
                                                <span asp-validation-for="HoraRespuesta" class="text-danger d-block"></span>
                                            </div>

                                            <div class="censo-time-card">
                                                <div class="censo-time-card__header">
                                                    <span class="censo-time-card__step">03</span>
                                                    <div>
                                                        <label asp-for="FechaGestionFarmacia" class="form-label censo-time-card__label"></label>
                                                        <p>Seguimiento del movimiento con farmacia.</p>
                                                    </div>
                                                </div>
                                                <div class="censo-time-card__grid">
                                                    <div class="censo-compact-field">
                                                        <label asp-for="FechaGestionFarmacia" class="form-label">Fecha</label>
                                                        <input asp-for="FechaGestionFarmacia" type="date" class="form-control" id="fechaGestionFarmaciaDisplay" disabled aria-readonly="true" />
                                                    </div>
                                                    <div class="censo-compact-field">
                                                        <label asp-for="HoraGestionFarmacia" class="form-label">Hora</label>
                                                        <input asp-for="HoraGestionFarmacia" type="text" class="form-control" id="horaGestionFarmaciaDisplay" placeholder="HH:mm" maxlength="5" aria-label="Hora de gestión farmacia" disabled aria-readonly="true" />
                                                    </div>
                                                </div>
                                                <span asp-validation-for="FechaGestionFarmacia" class="text-danger d-block"></span>
                                                <span asp-validation-for="HoraGestionFarmacia" class="text-danger d-block"></span>
                                            </div>
                                        </div>
                                    </section>

                                    <section class="censo-recepcion-panel">
                                        <div class="censo-recepcion-panel__header">
                                            <span class="censo-recepcion-panel__eyebrow">Responsables</span>
                                        </div>

                                        <div class="censo-recepcion-assignments">
                                            <div class="censo-assignment-card">
                                                <label asp-for="NombreRecepcionaCaso" class="form-label"></label>
                                                <select asp-for="NombreRecepcionaCaso" asp-items="Model.NursingAssistantOptions" class="form-select">
                                                    <option value="">Selecciona un auxiliar...</option>
                                                </select>
                                                <span asp-validation-for="NombreRecepcionaCaso" class="text-danger"></span>
                                            </div>

                                            <div class="censo-assignment-card">
                                                <label asp-for="NombreRealizaKardex" class="form-label"></label>
                                                <select asp-for="NombreRealizaKardex" asp-items="Model.NursingAssistantOptions" class="form-select">
                                                    <option value="">Selecciona un auxiliar...</option>
                                                </select>
                                                <span asp-validation-for="NombreRealizaKardex" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </section>

                                    <section class="censo-recepcion-panel censo-recepcion-panel--status">
                                        <div class="censo-recepcion-panel__header">
                                            <span class="censo-recepcion-panel__eyebrow">Estados</span>
                                        </div>

                                        <label class="form-label d-block">Gestión completa o pendiente</label>
                                        <div class="censo-gestion-status-card">
                                            <div class="form-check form-switch censo-gestion-check">
                                                <input asp-for="GestionCompleta" class="form-check-input" type="checkbox" role="switch" id="gestionCompletaSwitch" />
                                                <label class="form-check-label" for="gestionCompletaSwitch">
                                                    <span id="gestionEstadoTexto">Pendiente</span>
                                                </label>
                                            </div>
                                            <p class="censo-gestion-status-card__hint">Usa este control para diferenciar de inmediato los casos cerrados de los que aun necesitan seguimiento.</p>
                                        </div>

                                        <label class="form-label d-block mt-3">Gestión Analista asistencial</label>
                                        <div class="censo-gestion-status-card">
                                            <div class="form-check form-switch censo-gestion-check">
                                                <input asp-for="GestionAnalistaAsistencial" class="form-check-input" type="checkbox" role="switch" id="gestionAnalistaSwitch" />
                                                <label class="form-check-label" for="gestionAnalistaSwitch">
                                                    <span id="gestionAnalistaTexto">No</span>
                                                </label>
                                            </div>
                                            <p class="censo-gestion-status-card__hint">Solo los perfiles con el permiso <strong>Analista asistencial</strong> pueden activar o desactivar este estado.</p>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>

                    <div class="card mt-3" id="precargarPacienteCard" data-censo-no-lock="true">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <h2 class="h5 mb-0">Validar precarga del paciente</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-3">Ingresa el n&uacute;mero de documento para buscar un paciente existente y precargar sus datos en la secci&oacute;n 2. Esto crear&aacute; una nueva atenci&oacute;n.</p>
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4 col-md-6">
                                    <label for="precargaDocumentoInput" class="form-label">N&uacute;mero de documento</label>
                                    <input type="text" id="precargaDocumentoInput" class="form-control" inputmode="text" maxlength="20" placeholder="Ingrese n&uacute;mero de documento" />
                                </div>
                                <div class="col-auto">
                                    <button type="button" id="validarPrecargaBtn" class="btn btn-outline-primary">Validar</button>
                                </div>
                            </div>
                            <div id="precargaMensaje" class="mt-3"></div>
                        </div>
                    </div>
                    </div>

                    <div class="tab-pane fade" id="tab-agudos-oculto-datos-basicos" role="tabpanel" aria-labelledby="tab-agudos-oculto-datos-basicos-link" data-section-title="Datos básicos del paciente" data-section-description="Consolida identificación, dirección, clasificación georreferenciada y canales de contacto.">
