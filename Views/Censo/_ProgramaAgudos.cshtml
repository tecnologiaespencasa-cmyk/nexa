        nameof(CensoRecord.DosisMedicamento4),
        nameof(CensoRecord.MedidaMedicamento4),
        nameof(CensoRecord.ViaAdministracionMedicamento4),
        nameof(CensoRecord.FrecuenciaAdministracionMedicamento4),
        nameof(CensoRecord.DiasMedicamento4),
