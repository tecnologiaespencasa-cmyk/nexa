                                                        {
                                                            <span class="herida-kardex__estado herida-kardex__estado--cerrado">Cerrado por farmacia</span>
                                                        }
                                                        else if (kardex.Enviado)
                                                        {
                                                            <span class="herida-kardex__estado herida-kardex__estado--enviado">En farmacia</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="herida-kardex__estado">Sin enviar</span>
                                                        }
                                                    </header>
                                                    <dl class="herida-kardex__datos">
                                                        <div><dt>Insumos</dt><dd>@kardex.Insumos</dd></div>
                                                        <div><dt>Aplicaciones</dt><dd>@kardex.Aplicaciones</dd></div>
                                                        <div><dt>Adjuntos</dt><dd>@kardex.Adjuntos</dd></div>
                                                    </dl>
                                                    <button type="button"
                                                            class="btn btn-outline-primary herida-kardex__abrir"
                                                            data-kardex-abrir="@kardex.Tipo"
                                                            data-kardex-nombre="@kardex.Nombre">
                                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
                                                            <path d="M14 3v5h5"></path>
                                                        </svg>
                                                        <span>@(kardex.Cerrado ? "Ver requisición" : "Abrir requisición")</span>
                                                    </button>
                                                </article>
                                            }
                                        </div>
                                    }
                                </section>
                            }
                        </div>
                    </div>
                </div>

