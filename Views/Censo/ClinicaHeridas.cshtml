@model CensoClinicaHeridasViewModel
@using System.Globalization
@using Nexa.Data.Entities

@section Styles
{
    <link rel="stylesheet" href="~/css/censo.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Clinica de heridas";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasAuxiliares = Model.AuxiliarEnfermeriaOptions.Any();
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
    var vacActivo = string.Equals(Model.Vac, "Si", StringComparison.OrdinalIgnoreCase);
    var historial = Model.Historial;
    var mostrarApositos = string.Equals(Model.Vac, "Si", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.ManejoHerida, "Si", StringComparison.OrdinalIgnoreCase);
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");

    // Las medidas llegan como double: se muestran sin decimales cuando son enteras (2 cm, no 2,0 cm).
    private static string FormatCm(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Valor(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;
}

<div class="censo-page @(showCurrentPatientBar ? "censo-page--with-current-patient" : null)">
    <aside class="censo-sidebar">
        <section class="censo-section-strip">
            <div class="censo-section-strip__nav">
                <div class="list-group censo-nav censo-nav--top" id="heridas-tab" role="tablist">
                    <button class="list-group-item list-group-item-action active censo-nav__item"
                            id="tab-datos-basicos-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-datos-basicos"
                            type="button"
                            role="tab"
                            aria-controls="tab-datos-basicos"
                            aria-selected="true">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="9" cy="7" r="3"></circle>
                                <path d="M4 19v-1a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1"></path>
                                <path d="M16 8h4"></path>
                                <path d="M18 6v4"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 1</span>
                            <span class="censo-nav__title">Datos básicos</span>
                            <span class="censo-nav__description">Datos personales, contacto y clasificación del paciente.</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-caracteristicas-herida-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-caracteristicas-herida"
                            type="button"
                            role="tab"
                            aria-controls="tab-caracteristicas-herida"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M19 14c1.5-1.5 2-3.2 2-5a7 7 0 0 0-14 0"></path>
                                <path d="M3 10c0 6.3 7 11 9 11s2.5-1 2.5-1"></path>
                                <path d="M12 8v4"></path>
                                <path d="M10 10h4"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 2</span>
                            <span class="censo-nav__title">Características de la herida</span>
                            <span class="censo-nav__description">Seguimientos, medidas y fotos registrados en campo.</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-manejo-herida-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-manejo-herida"
                            type="button"
                            role="tab"
                            aria-controls="tab-manejo-herida"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M10.5 4.5 4.5 10.5"></path>
                                <rect x="2.5" y="9" width="19" height="6" rx="2" transform="rotate(-45 12 12)"></rect>
                                <path d="M14 8.5 8.5 14"></path>
                                <path d="M15.5 10 10 15.5"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 3</span>
                            <span class="censo-nav__title">Manejo de la herida</span>
                            <span class="censo-nav__description">PICC, VAC, apósitos y frecuencia de visita.</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-activo-fijo-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-activo-fijo"
                            type="button"
                            role="tab"
                            aria-controls="tab-activo-fijo"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <rect x="3" y="7" width="18" height="13" rx="2"></rect>
                                <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                <path d="M3 13h18"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 4</span>
                            <span class="censo-nav__title">Activo fijo</span>
                            <span class="censo-nav__description" id="activoFijoNavDescription">@(vacActivo ? "Equipos en comodato asignados al paciente." : "Se habilita cuando VAC está en Si.")</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-seguimiento-hospitalizado-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-seguimiento-hospitalizado"
                            type="button"
                            role="tab"
                            aria-controls="tab-seguimiento-hospitalizado"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M3 12h4l2-5 4 10 2-5h6"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 5</span>
                            <span class="censo-nav__title">Seguimiento hospitalizado</span>
                            <span class="censo-nav__description">Hospitalización y fechas de seguimiento.</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-devolucion-productos-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-devolucion-productos"
                            type="button"
                            role="tab"
                            aria-controls="tab-devolucion-productos"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M21 8v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8"></path>
                                <path d="M1 3h22v5H1z"></path>
                                <path d="M10 12h4"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 6</span>
                            <span class="censo-nav__title">Devolución de productos</span>
                            <span class="censo-nav__description">Novedades y gestión del servicio farmacéutico.</span>
                        </span>
                    </button>

                    <button class="list-group-item list-group-item-action censo-nav__item"
                            id="tab-alta-programa-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-alta-programa"
                            type="button"
                            role="tab"
                            aria-controls="tab-alta-programa"
                            aria-selected="false">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                <path d="M8 3v4"></path>
                                <path d="M16 3v4"></path>
                                <path d="M4 10h16"></path>
                                <path d="m9 15 2 2 4-5"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 7</span>
                            <span class="censo-nav__title">Alta del programa</span>
                            <span class="censo-nav__description">Motivo del egreso y estado del paciente.</span>
                        </span>
                    </button>
                </div>
            </div>
            <div class="censo-section-strip__tools">
                <form method="get" asp-action="ClinicaHeridas" class="censo-filter-panel">
                    <h2 class="censo-filter-panel__title">Filtros rápidos</h2>
                    <label for="cedulaHeridasFiltroInput" class="form-label censo-filter-panel__label">Buscar por documento</label>
                    <div class="censo-filter-panel__input-wrap">
                        <input class="form-control censo-filter-panel__input" id="cedulaHeridasFiltroInput" name="cedulaPaciente" value="@Model.CedulaFiltro" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                        <span class="censo-filter-panel__search-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="m20 20-3.5-3.5"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="censo-filter-panel__actions">
                        <button type="submit" class="btn btn-outline-primary censo-filter-panel__button">Buscar</button>
                        <a class="btn btn-outline-secondary censo-filter-panel__button" asp-action="ClinicaHeridas">Limpiar</a>
                    </div>
                </form>
            </div>
        </section>
    </aside>

    @if (showCurrentPatientBar)
    {
        <section class="censo-current-patient" aria-label="Paciente actual">
            <div class="censo-current-patient__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21a8 8 0 0 1 16 0"></path>
                </svg>
            </div>

            <div class="censo-current-patient__identity">
                <span class="censo-current-patient__label">Paciente actual</span>
                <strong>@Model.NombrePaciente</strong>
                @if (!string.IsNullOrWhiteSpace(Model.ProgramaPertenece))
                {
                    <span class="censo-current-patient__status">Programa @Model.ProgramaPertenece</span>
                }
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Tipo ID</span>
                <strong>@Model.TipoIdentificacion</strong>
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Documento</span>
                <strong>@Model.NumeroIdentificacion</strong>
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Ingreso al programa</span>
                <strong>
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                        <path d="M8 3v4"></path>
                        <path d="M16 3v4"></path>
                        <path d="M4 10h16"></path>
                    </svg>
                    @Model.FechaIngresoPrograma.ToString("dd/MM/yyyy")
                </strong>
            </div>

            <div class="censo-current-patient__actions">
                <div class="dropdown">
                    <button class="btn censo-current-patient__button" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                            <path d="M15 19a6 6 0 0 0-12 0"></path>
                            <circle cx="9" cy="8" r="3"></circle>
                            <path d="M19 8v6"></path>
                            <path d="M16 11h6"></path>
                        </svg>
                        <span>Cambiar paciente</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end censo-current-patient__dropdown">
                        <form method="get" asp-action="ClinicaHeridas" class="censo-current-patient__search">
                            <label for="cambiarHeridasPacienteDocumento" class="form-label">Documento</label>
                            <div class="input-group">
                                <input class="form-control" id="cambiarHeridasPacienteDocumento" name="cedulaPaciente" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                                <button class="btn" type="submit" aria-label="Buscar paciente">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <circle cx="11" cy="11" r="7"></circle>
                                        <path d="m20 20-3.5-3.5"></path>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <a class="btn censo-current-patient__button censo-current-patient__button--primary" asp-action="ClinicaHeridas">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    <span>Nuevo ingreso</span>
                </a>
            </div>
        </section>
    }

    <section class="censo-content">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-warning">@errorMessage</div>
        }

        <form asp-action="ClinicaHeridas" method="post" enctype="multipart/form-data" id="clinicaHeridasForm" class="censo-form-shell">
            <input asp-for="EditingRecordId" type="hidden" />
            <input asp-for="CedulaFiltro" type="hidden" />
            <input asp-for="DireccionEsValida" type="hidden" id="direccionEsValidaInput" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger censo-validation-summary mb-4" role="alert"></div>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-datos-basicos" role="tabpanel" aria-labelledby="tab-datos-basicos-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Clinica de heridas</span>
                                <h2 class="h5 mb-0">Datos básicos</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!hasAuxiliares)
                            {
                                <div class="alert alert-warning">
                                    No hay auxiliares OPS activos para asignar. Puedes guardar el registro y asignarlo después.
                                </div>
                            }

                            <div class="alert alert-info d-none" id="prefillPacienteAlert" role="status"></div>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                            <path d="M8 3v4"></path>
                                            <path d="M16 3v4"></path>
                                            <path d="M4 10h16"></path>
                                        </svg>
                                    </span>
                                    <h3>Ingreso al programa</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-4">
                                        <label asp-for="Asegurador" class="form-label"></label>@RequiredMark()
                                        <select asp-for="Asegurador" asp-items="Model.AseguradorOptions" class="form-select">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Asegurador" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="FuenteIngreso" class="form-label"></label>
                                        <select asp-for="FuenteIngreso" asp-items="Model.FuenteIngresoOptions" class="form-select">
                                            <option value="">Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="FuenteIngreso" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="FechaIngresoPrograma" class="form-label"></label>@RequiredMark()
                                        <input asp-for="FechaIngresoPrograma" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="FechaIngresoPrograma" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <circle cx="12" cy="8" r="4"></circle>
                                            <path d="M4 21a8 8 0 0 1 16 0"></path>
                                        </svg>
                                    </span>
                                    <h3>Información Personal</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-3">
                                        <label asp-for="TipoIdentificacion" class="form-label"></label>@RequiredMark()
                                        <select asp-for="TipoIdentificacion" asp-items="Model.TipoIdentificacionOptions" class="form-select" id="tipoIdentificacionSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="TipoIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="NumeroIdentificacion" class="form-label"></label>@RequiredMark()
                                        <input asp-for="NumeroIdentificacion" class="form-control" inputmode="numeric" maxlength="20" autocomplete="off" id="numeroIdentificacionInput" />
                                        <span asp-validation-for="NumeroIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-6">
                                        <label asp-for="NombrePaciente" class="form-label"></label>@RequiredMark()
                                        <input asp-for="NombrePaciente" class="form-control" autocomplete="off" />
                                        <span asp-validation-for="NombrePaciente" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="FechaNacimiento" class="form-label"></label>@RequiredMark()
                                        <input asp-for="FechaNacimiento"
                                               type="date"
                                               class="form-control"
                                               id="fechaNacimientoInput"
                                               max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                                               data-msg-max="La fecha de nacimiento debe ser anterior a la fecha actual."
                                               oninvalid="this.setCustomValidity('La fecha de nacimiento debe ser anterior a la fecha actual.')"
                                               oninput="this.setCustomValidity('')" />
                                        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-2">
                                        <label asp-for="Edad" class="form-label"></label>
                                        <input asp-for="Edad" class="form-control" id="edadInput" readonly />
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Genero" class="form-label"></label>@RequiredMark()
                                        <select asp-for="Genero" asp-items="Model.GeneroOptions" class="form-select">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Genero" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M12 21s7-4.7 7-11a7 7 0 1 0-14 0c0 6.3 7 11 7 11Z"></path>
                                            <circle cx="12" cy="10" r="2.5"></circle>
                                        </svg>
                                    </span>
                                    <h3>Dirección y ubicación</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-12">
                                        <label asp-for="Direccion" class="form-label"></label>
                                        <div class="input-group censo-direccion-group">
                                            <input asp-for="Direccion" class="form-control" id="direccionInput" placeholder="Ingrese dirección completa del paciente" />
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="validarDireccionBtn">Validar dirección</button>
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="limpiarDireccionBtn">Limpiar</button>
                                        </div>
                                        <span asp-validation-for="Direccion" class="text-danger d-block"></span>
                                        @if (!string.IsNullOrWhiteSpace(Model.DireccionMensajeValidacion))
                                        {
                                            <div class="alert @(Model.DireccionEsValida ? "alert-success" : "alert-warning") mt-2" id="direccionValidacionServerMensaje">
                                                @Model.DireccionMensajeValidacion
                                                @if (!string.IsNullOrWhiteSpace(Model.DireccionSugerida))
                                                {
                                                    <div class="mt-1">
                                                        Sugerencia: <strong>@Model.DireccionSugerida</strong>
                                                        <button type="button" class="btn btn-sm btn-link p-0 ms-2" id="usarSugerenciaDireccionBtnServer">Usar sugerencia</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <div class="alert d-none mt-2" id="direccionValidacionMensaje"></div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check censo-direccion-check">
                                            <input asp-for="AsumirDireccionErrada" class="form-check-input" type="checkbox" id="asumirDireccionErradaCheck" />
                                            <label asp-for="AsumirDireccionErrada" class="form-check-label">
                                                Asumir dirección errada y continuar
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="DetalleDireccion" class="form-label"></label>
                                        <input asp-for="DetalleDireccion" class="form-control" maxlength="200" placeholder="Ej: Apartamento 501 torre 2" />
                                        <span asp-validation-for="DetalleDireccion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="ClasificacionZonaSura" class="form-label"></label>
                                        <select asp-for="ClasificacionZonaSura" asp-items="Model.ClasificacionZonaSuraOptions" class="form-select" id="clasificacionZonaSuraSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="ClasificacionZonaSura" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="MunicipioResidencia" class="form-label"></label>
                                        <select asp-for="MunicipioResidencia" asp-items="Model.MunicipioResidenciaOptions" class="form-select" id="municipioResidenciaSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="MunicipioResidencia" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Barrio" class="form-label"></label>
                                        <select asp-for="Barrio" class="form-select" id="barrioSelect">
                                            <option value="" disabled hidden>Selecciona barrio...</option>
                                            @foreach (var barrioOption in Model.BarrioOptions)
                                            {
                                                <option value="@barrioOption">@barrioOption</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Barrio" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="ZonaDireccionSegunMunicipio" class="form-label"></label>
                                        <select asp-for="ZonaDireccionSegunMunicipio" asp-items="Model.ZonaDireccionOptions" class="form-select" id="zonaDireccionSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="ZonaDireccionSegunMunicipio" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z"></path>
                                        </svg>
                                    </span>
                                    <h3>Contacto</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-4">
                                        <label asp-for="TelefonoPrincipal" class="form-label"></label>@RequiredMark()
                                        <input asp-for="TelefonoPrincipal" class="form-control heridas-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoPrincipal" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="TelefonoAdicional1" class="form-label"></label>@RequiredMark()
                                        <input asp-for="TelefonoAdicional1" class="form-control heridas-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoAdicional1" class="text-danger"></span>
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="telefonoAdicional2Toggle" />
                                            <label class="form-check-label" for="telefonoAdicional2Toggle">
                                                Adicionar otro teléfono
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 d-none" id="telefonoAdicional2Container">
                                        <label asp-for="TelefonoAdicional2" class="form-label"></label>
                                        <input asp-for="TelefonoAdicional2" class="form-control heridas-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoAdicional2" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="LlamadaBienvenida" class="form-label"></label>
                                        <select asp-for="LlamadaBienvenida" asp-items="Model.LlamadaBienvenidaOptions" class="form-select">
                                            <option value="">Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="LlamadaBienvenida" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="TelefonoContacto" class="form-label"></label>
                                        <input asp-for="TelefonoContacto" class="form-control heridas-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoContacto" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Observacion" class="form-label"></label>
                                        <textarea asp-for="Observacion" class="form-control" rows="4" maxlength="2000" placeholder="Registra las observaciones del paciente"></textarea>
                                        <span asp-validation-for="Observacion" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M12 3v18"></path>
                                            <path d="M3 12h18"></path>
                                            <circle cx="12" cy="12" r="9"></circle>
                                        </svg>
                                    </span>
                                    <h3>Información clínica</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-5">
                                        <label asp-for="CodigoCie10" class="form-label"></label>@RequiredMark()
                                        <select asp-for="CodigoCie10" class="form-select" id="codigoCie10Input">
                                            <option value="" disabled hidden selected="@(string.IsNullOrWhiteSpace(Model.CodigoCie10))">Selecciona...</option>
                                            @foreach (var cie in Model.Cie10Options)
                                            {
                                                <option value="@cie.Value" selected="@(string.Equals(cie.Value, Model.CodigoCie10, StringComparison.OrdinalIgnoreCase))">@cie.Text</option>
                                            }
                                        </select>
                                        <div class="form-text">Listado de diagnósticos de clínica de heridas.</div>
                                        <span asp-validation-for="CodigoCie10" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="DiagnosticoDescriptivo" class="form-label"></label>@RequiredMark()
                                        <input asp-for="DiagnosticoDescriptivo" class="form-control" id="diagnosticoDescriptivoInput" readonly />
                                        <span asp-validation-for="DiagnosticoDescriptivo" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="FechaValoracion" class="form-label"></label>@RequiredMark()
                                        <input asp-for="FechaValoracion" type="date" class="form-control" />
                                        <span asp-validation-for="FechaValoracion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="ProgramaPertenece" class="form-label"></label>@RequiredMark()
                                        <select asp-for="ProgramaPertenece" asp-items="Model.ProgramaPerteneceOptions" class="form-select">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="ProgramaPertenece" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="AuxiliarEnfermeriaAsignado" class="form-label"></label>
                                        <input asp-for="AuxiliarEnfermeriaAsignado" class="form-control" maxlength="120" id="auxiliarEnfermeriaInput" list="auxiliarEnfermeriaOptions" autocomplete="off" placeholder="Buscar auxiliar asignado" />
                                        <datalist id="auxiliarEnfermeriaOptions">
                                            @foreach (var assistant in Model.AuxiliarEnfermeriaOptions.Where(option => !string.IsNullOrWhiteSpace(option.Value)))
                                            {
                                                <option value="@assistant.Value">@assistant.Text</option>
                                            }
                                        </datalist>
                                        <div class="form-text">Selecciona un auxiliar OPS activo. Si no aparece, debe registrarse primero en administración de usuarios.</div>
                                        <span asp-validation-for="AuxiliarEnfermeriaAsignado" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <div class="censo-form-actions">
                                <button type="submit" class="btn btn-primary censo-save-button">
                                    <span>@(Model.EditingRecordId.HasValue ? "Actualizar registro" : "Guardar registro")</span>
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <path d="M5 12h14"></path>
                                        <path d="m13 6 6 6-6 6"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-caracteristicas-herida" role="tabpanel" aria-labelledby="tab-caracteristicas-herida-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Clinica de heridas</span>
                                <h2 class="h5 mb-0">Características de la herida</h2>
                            </div>
                            @if (historial.TotalSeguimientos > 0)
                            {
                                <span class="herida-header-count">
                                    @historial.TotalSeguimientos @(historial.TotalSeguimientos == 1 ? "seguimiento" : "seguimientos")
                                </span>
                            }
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para consultar sus seguimientos de herida.
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(historial.Error))
                            {
                                <div class="alert alert-warning mb-0">@historial.Error</div>
                            }
                            else if (historial.TotalSeguimientos == 0)
                            {
                                <div class="herida-empty">
                                    <span class="herida-empty__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M3 7h18v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                            <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            <path d="M9 13h6"></path>
                                        </svg>
                                    </span>
                                    <h3>Sin seguimientos registrados</h3>
                                    <p>
                                        Este paciente todavía no tiene curaciones cargadas en la aplicación de clínica de heridas.
                                        Aparecerán aquí en cuanto el auxiliar registre la primera, con sus medidas y sus cuatro fotos.
                                    </p>
                                </div>
                            }
                            else
                            {
                                var ultimo = historial.Ultimo!;
                                var escala = historial.MedidaMaximaCm > 0 ? historial.MedidaMaximaCm : 1d;

                                <div class="herida-resumen">
                                    <div class="herida-resumen__dato">
                                        <span class="herida-resumen__etiqueta">Última curación</span>
                                        <strong>@ultimo.RegistradoEn.ToString("dd/MM/yyyy")</strong>
                                        <small>@ultimo.RegistradoEn.ToString("HH:mm") · Seguimiento @ultimo.Numero</small>
                                    </div>
                                    <div class="herida-resumen__dato">
                                        <span class="herida-resumen__etiqueta">Medida actual</span>
                                        <strong>@FormatCm(ultimo.DiametroVerticalCm) × @FormatCm(ultimo.DiametroHorizontalCm) cm</strong>
                                        <small>@FormatCm(ultimo.ProfundidadCm) cm de profundidad</small>
                                    </div>
                                    <div class="herida-resumen__dato">
                                        <span class="herida-resumen__etiqueta">Registró</span>
                                        <strong>@(string.IsNullOrWhiteSpace(ultimo.AuxiliarNombre) ? "Sin auxiliar asociado" : ultimo.AuxiliarNombre)</strong>
                                        <small>@(string.IsNullOrWhiteSpace(ultimo.AuxiliarProfesion) ? "—" : ultimo.AuxiliarProfesion)</small>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(historial.CarpetaWebUrl))
                                    {
                                        <a class="herida-resumen__enlace" href="@historial.CarpetaWebUrl" target="_blank" rel="noopener">
                                            <span>Abrir carpeta en SharePoint</span>
                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                <path d="M14 4h6v6"></path>
                                                <path d="M20 4 10 14"></path>
                                                <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
                                            </svg>
                                        </a>
                                    }
                                </div>

                                @if (historial.TotalSeguimientos > 1)
                                {
                                    <section class="herida-evolucion" aria-label="Evolución de la medida de la herida">
                                        <div class="herida-evolucion__titulo">
                                            <h3>Evolución de la medida</h3>
                                            <p>Cada silueta es la herida a escala, del primer seguimiento al último.</p>
                                        </div>
                                        <ol class="herida-evolucion__pista">
                                            @foreach (var seguimiento in historial.Seguimientos.Reverse())
                                            {
                                                var alto = Math.Max(6, Math.Round(seguimiento.DiametroVerticalCm / escala * 72, 1));
                                                var ancho = Math.Max(6, Math.Round(seguimiento.DiametroHorizontalCm / escala * 72, 1));
                                                <li class="herida-evolucion__paso">
                                                    <span class="herida-evolucion__caja">
                                                        <span class="herida-evolucion__silueta"
                                                              style="height:@(alto.ToString(CultureInfo.InvariantCulture))px;width:@(ancho.ToString(CultureInfo.InvariantCulture))px"
                                                              title="@FormatCm(seguimiento.DiametroVerticalCm) × @FormatCm(seguimiento.DiametroHorizontalCm) cm"></span>
                                                    </span>
                                                    <span class="herida-evolucion__numero">@seguimiento.Numero</span>
                                                    <span class="herida-evolucion__medida">@FormatCm(seguimiento.AreaCm2) cm²</span>
                                                </li>
                                            }
                                        </ol>
                                    </section>
                                }

                                <ol class="herida-lista">
                                    @foreach (var seguimiento in historial.Seguimientos)
                                    {
                                        <li class="herida-seguimiento">
                                            <div class="herida-seguimiento__cabecera">
                                                <span class="herida-seguimiento__numero">
                                                    <small>Seguimiento</small>
                                                    <strong>@seguimiento.Numero</strong>
                                                </span>
                                                <div class="herida-seguimiento__meta">
                                                    <span class="herida-seguimiento__fecha">@seguimiento.RegistradoEn.ToString("dd/MM/yyyy · HH:mm")</span>
                                                    <span class="herida-seguimiento__auxiliar">
                                                        @(string.IsNullOrWhiteSpace(seguimiento.AuxiliarNombre) ? "Sin auxiliar asociado" : seguimiento.AuxiliarNombre)
                                                        @if (!string.IsNullOrWhiteSpace(seguimiento.AuxiliarProfesion))
                                                        {
                                                            <em>@seguimiento.AuxiliarProfesion</em>
                                                        }
                                                    </span>
                                                </div>
                                                @if (seguimiento.VariacionAreaPorcentaje.HasValue)
                                                {
                                                    var variacion = seguimiento.VariacionAreaPorcentaje.Value;
                                                    var tono = Math.Abs(variacion) < 0.5 ? "igual" : variacion < 0 ? "baja" : "sube";
                                                    var textoVariacion = Math.Abs(variacion) < 0.5
                                                        ? "Sin cambio de área"
                                                        : $"{(variacion < 0 ? "−" : "+")}{Math.Abs(variacion).ToString("0.#", CultureInfo.InvariantCulture)}% de área";
                                                    <span class="herida-delta herida-delta--@tono">@textoVariacion</span>
                                                }
                                                else
                                                {
                                                    <span class="herida-delta herida-delta--inicial">Medida inicial</span>
                                                }
                                            </div>

                                            <div class="herida-seguimiento__cuerpo">
                                                <div class="herida-medidas">
                                                    <div class="herida-medidas__item">
                                                        <span>Diámetro vertical</span>
                                                        <strong>@FormatCm(seguimiento.DiametroVerticalCm)<em>cm</em></strong>
                                                    </div>
                                                    <div class="herida-medidas__item">
                                                        <span>Diámetro horizontal</span>
                                                        <strong>@FormatCm(seguimiento.DiametroHorizontalCm)<em>cm</em></strong>
                                                    </div>
                                                    <div class="herida-medidas__item">
                                                        <span>Profundidad</span>
                                                        <strong>@FormatCm(seguimiento.ProfundidadCm)<em>cm</em></strong>
                                                    </div>
                                                </div>

                                                <dl class="herida-datos">
                                                    <div>
                                                        <dt>Origen</dt>
                                                        <dd>@Valor(seguimiento.Origen)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Ubicación</dt>
                                                        <dd>@Valor(seguimiento.Ubicacion)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Fondo</dt>
                                                        <dd>@Valor(seguimiento.Fondo)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Lecho</dt>
                                                        <dd>@Valor(seguimiento.Lecho)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Tejido</dt>
                                                        <dd>@Valor(seguimiento.Tejido)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Cavitación / tunelización</dt>
                                                        <dd>@Valor(seguimiento.CavitacionTunelizacion)</dd>
                                                    </div>
                                                    <div>
                                                        <dt>Piel perilesional</dt>
                                                        <dd>@Valor(seguimiento.PielPerilesional)</dd>
                                                    </div>
                                                </dl>

                                                <div class="herida-exudado">
                                                    <h4>Exudado</h4>
                                                    <dl class="herida-datos herida-datos--exudado">
                                                        <div>
                                                            <dt>Cantidad</dt>
                                                            <dd>@Valor(seguimiento.ExudadoCantidad)</dd>
                                                        </div>
                                                        <div>
                                                            <dt>Características</dt>
                                                            <dd>@Valor(seguimiento.ExudadoCaracteristicas)</dd>
                                                        </div>
                                                    </dl>
                                                </div>

                                                <div class="herida-fotos">
                                                    @foreach (var foto in seguimiento.Fotos)
                                                    {
                                                        <figure class="herida-fotos__item">
                                                            @if (foto.Disponible)
                                                            {
                                                                <button type="button"
                                                                        class="herida-fotos__marco"
                                                                        data-herida-foto="@Url.Action("FotoSeguimientoClinicaHeridas", "Censo", new { driveItemId = foto.DriveItemId })"
                                                                        data-herida-foto-titulo="@foto.TipoDescripcion — Seguimiento @seguimiento.Numero">
                                                                    <img src="@Url.Action("FotoSeguimientoClinicaHeridas", "Censo", new { driveItemId = foto.DriveItemId, miniatura = true })"
                                                                         alt="@foto.TipoDescripcion del seguimiento @seguimiento.Numero"
                                                                         loading="lazy" />
                                                                </button>
                                                            }
                                                            else
                                                            {
                                                                <span class="herida-fotos__marco herida-fotos__marco--vacio">
                                                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                                        <rect x="3" y="6" width="18" height="14" rx="2"></rect>
                                                                        <circle cx="12" cy="13" r="3.2"></circle>
                                                                        <path d="M9 6l1.5-2h3L15 6"></path>
                                                                        <path d="m4 20 16-14"></path>
                                                                    </svg>
                                                                    <span>Sin foto</span>
                                                                </span>
                                                            }
                                                            <figcaption>@foto.TipoDescripcion</figcaption>
                                                        </figure>
                                                    }
                                                </div>
                                            </div>
                                        </li>
                                    }
                                </ol>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-manejo-herida" role="tabpanel" aria-labelledby="tab-manejo-herida-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Clinica de heridas</span>
                                <h2 class="h5 mb-0">Manejo de la herida</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar el manejo de la herida.
                                </div>
                            }
                            else
                            {
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M12 3v18"></path>
                                                <path d="M5 8h14"></path>
                                                <path d="M7 16h10"></path>
                                            </svg>
                                        </span>
                                        <h3>Dispositivos</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label asp-for="Picc" class="form-label"></label>@RequiredMark()
                                            <select asp-for="Picc" asp-items="Model.SiNoOptions" class="form-select">
                                                <option value="" disabled hidden selected="@(string.IsNullOrWhiteSpace(Model.Picc))">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="Picc" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Vac" class="form-label"></label>@RequiredMark()
                                            <select asp-for="Vac" asp-items="Model.SiNoOptions" class="form-select" data-kardex-trigger>
                                                <option value="" disabled hidden selected="@(string.IsNullOrWhiteSpace(Model.Vac))">Selecciona...</option>
                                            </select>
                                            <div class="form-text">Con VAC en Si se habilita la sección Activo fijo.</div>
                                            <span asp-validation-for="Vac" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Npt" class="form-label"></label>@RequiredMark()
                                            <select asp-for="Npt" asp-items="Model.SiNoOptions" class="form-select" data-kardex-trigger>
                                                <option value="" disabled hidden selected="@(string.IsNullOrWhiteSpace(Model.Npt))">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="Npt" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="ManejoHerida" class="form-label"></label>@RequiredMark()
                                            <select asp-for="ManejoHerida" asp-items="Model.SiNoOptions" class="form-select" data-kardex-trigger>
                                                <option value="" disabled hidden selected="@(string.IsNullOrWhiteSpace(Model.ManejoHerida))">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="ManejoHerida" class="text-danger"></span>
                                        </div>
                                    </div>
                                </section>

                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <rect x="3" y="7" width="18" height="13" rx="2"></rect>
                                                <path d="M12 11v5"></path>
                                                <path d="M9.5 13.5h5"></path>
                                                <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                                            </svg>
                                        </span>
                                        <h3>Tratamiento</h3>
                                    </div>

                                    <div class="herida-apositos-bloque @(mostrarApositos ? null : "d-none")" id="apositosBloque">
                                        <p class="herida-apositos__ayuda">
                                            Los apósitos y medicamentos entran en las requisiciones de manejo de la herida y VAC.
                                        </p>
                                    <div class="herida-apositos" id="apositosContainer" data-max="4">
                                        <datalist id="apositoMedicamentoOptions">
                                            @foreach (var insumo in Model.ApositoMedicamentoOptions)
                                            {
                                                <option value="@insumo"></option>
                                            }
                                        </datalist>

                                        @{
                                            var apositos = new[]
                                            {
                                                Model.ApositoMedicamento1,
                                                Model.ApositoMedicamento2,
                                                Model.ApositoMedicamento3,
                                                Model.ApositoMedicamento4
                                            };
                                        }

                                        @for (var apositoIndex = 0; apositoIndex < apositos.Length; apositoIndex++)
                                        {
                                            var numero = apositoIndex + 1;
                                            var campo = $"ApositoMedicamento{numero}";
                                            var valor = apositos[apositoIndex];
                                            // El primero siempre esta a la vista; los demas aparecen si traen dato
                                            // guardado o cuando el usuario pulsa "Agregar".
                                            var oculto = apositoIndex > 0 && string.IsNullOrWhiteSpace(valor);
                                            <div class="herida-aposito @(oculto ? "d-none" : null)" data-aposito-slot="@apositoIndex">
                                                <div class="herida-aposito__campo">
                                                    <label class="form-label" for="@campo">Apósito/Medicamento @numero</label>
                                                    <input class="form-control"
                                                           id="@campo"
                                                           name="@campo"
                                                           value="@valor"
                                                           maxlength="200"
                                                           list="apositoMedicamentoOptions"
                                                           autocomplete="off"
                                                           data-aposito-input
                                                           placeholder="Escribe para filtrar el listado" />
