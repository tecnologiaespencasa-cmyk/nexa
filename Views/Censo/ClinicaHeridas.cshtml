                                                    </div>
                                                }
                                            </div>
                                            <button type="button" class="btn btn-link herida-frecuencia__limpiar @(string.IsNullOrWhiteSpace(Model.FrecuenciaVisita) ? "d-none" : null)" id="frecuenciaVisitaLimpiar">
