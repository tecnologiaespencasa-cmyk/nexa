<section class="censo-history-shell" id="heridasHistorial">
    <div class="censo-history-shell__header">
        <div class="censo-history-shell__header-copy">
            <span class="censo-history-shell__eyebrow">Historial</span>
            <h2>Últimos registros de clínica de heridas</h2>
            <p>
                @if (!string.IsNullOrWhiteSpace(Model.CedulaFiltro))
                {
                    @($"Últimos 100 registros para el documento {Model.CedulaFiltro}.")
                }
                else
                {
                    @("Se muestran los últimos 100 registros creados en este censo.")
                }
            </p>
        </div>
    </div>

    @if (!Model.UltimosRegistros.Any())
    {
        <div class="alert alert-warning mb-0">
            @if (!string.IsNullOrWhiteSpace(Model.CedulaFiltro))
            {
                @("No se encontraron registros de clínica de heridas con los filtros seleccionados.")
            }
            else
            {
                @("No hay registros de clínica de heridas para mostrar.")
            }
        </div>
    }
    else
    {
        <div class="censo-history-table-wrap">
            <table class="table table-sm table-bordered censo-history-table mb-0">
                <thead>
                    <tr>
                        <th>Abrir</th>
                        <th>Registro</th>
                        <th>Paciente</th>
                        <th>Documento</th>
                        <th>Asegurador</th>
                        <th>Programa</th>
                        <th>Ingreso programa</th>
                        <th>Fecha valoración</th>
                        <th>PICC</th>
                        <th>VAC</th>
                        <th>Auxiliar</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.UltimosRegistros)
                    {
                        <tr>
                            <td>
                                <a class="censo-history-table__open" asp-action="ClinicaHeridas" asp-route-recordId="@record.Id" asp-route-cedulaPaciente="@Model.CedulaFiltro" title="Cargar registro @record.Id" aria-label="Cargar registro @record.Id">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <circle cx="11" cy="11" r="6"></circle>
                                        <path d="M16 16l5 5"></path>
                                    </svg>
                                </a>
                            </td>
                            <td>@record.Id</td>
                            <td>@record.NombrePaciente</td>
                            <td>@record.TipoIdentificacion @record.NumeroIdentificacion</td>
                            <td>@record.Asegurador</td>
                            <td>@record.ProgramaPertenece</td>
                            <td>@record.FechaIngresoPrograma.ToString("dd/MM/yyyy")</td>
                            <td>@record.FechaValoracion.ToString("dd/MM/yyyy")</td>
                            <td>@record.Picc</td>
                            <td>@record.Vac</td>
                            <td>@record.AuxiliarEnfermeriaAsignado</td>
                            <td>@(string.IsNullOrWhiteSpace(record.Estado) ? "Activo" : record.Estado)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

