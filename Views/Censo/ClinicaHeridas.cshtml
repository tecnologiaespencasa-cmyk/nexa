                                                </div>
                                                @if (apositoIndex > 0)
                                                {
                                                    <button type="button" class="btn btn-link herida-aposito__quitar" data-aposito-quitar>
                                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                            <path d="M6 6l12 12"></path>
                                                            <path d="M18 6 6 18"></path>
                                                        </svg>
                                                        <span>Retirar</span>
                                                    </button>
                                                }
