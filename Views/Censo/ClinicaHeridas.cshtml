                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
                                                <path d="M14 3v5h5"></path>
                                                <path d="M9 13h6"></path>
                                                <path d="M9 17h4"></path>
                                            </svg>
                                        </span>
                                        <h3>Requisiciones de insumos</h3>
                                    </div>

                                    <p class="herida-kardex__ayuda">
                                        Se abre una requisición por cada atención marcada en Sí. Las cantidades salen de la
                                        duración del tratamiento y la frecuencia de visita.
                                    </p>

                                    <div class="alert alert-info d-none" id="kardexDesactualizadoAviso" role="status">
                                        Cambiaste las atenciones del paciente. Guarda el manejo de la herida para actualizar las requisiciones.
                                    </div>

                                    @if (Model.Planes.Any())
                                    {
                                        <div class="herida-planes" id="heridaPlanes">
                                            <div class="herida-planes__barra">
                                                <div class="herida-planes__lista" role="tablist" aria-label="Planes de requisiciones">
                                                    @foreach (var plan in Model.Planes)
                                                    {
                                                        <button type="button"
                                                                class="herida-plan-chip @(plan.Vigente ? "is-vigente is-activo" : null)"
                                                                role="tab"
                                                                aria-selected="@(plan.Vigente ? "true" : "false")"
                                                                data-plan-id="@plan.Id"
                                                                data-plan-numero="@plan.Numero"
                                                                data-plan-vigente="@(plan.Vigente ? "true" : "false")">
                                                            <span class="herida-plan-chip__numero">Plan @plan.Numero</span>
                                                            <span class="herida-plan-chip__estado">@(plan.Vigente ? "Vigente" : "Cerrado")</span>
                                                        </button>
                                                    }
                                                </div>
                                                <button type="button" class="btn btn-outline-primary herida-planes__nuevo" id="heridaPlanNuevo">
                                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                        <path d="M12 5v14"></path>
                                                        <path d="M5 12h14"></path>
                                                    </svg>
                                                    <span>Abrir plan nuevo</span>
                                                </button>
                                            </div>
                                            <p class="herida-planes__meta" id="heridaPlanMeta"></p>
                                        </div>
                                    }

                                    @if (!Model.KardexDisponibles.Any())
                                    {
                                        <div class="herida-kardex__vacio">
                                            Ninguna atención está en Sí todavía. Marca PICC, VAC, NPT o manejo de la herida y
                                            guarda la sección para generar su requisición.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="herida-kardex__grid" id="heridaKardexGrid">
                                            @foreach (var kardex in Model.KardexDisponibles)
                                            {
                                                <article class="herida-kardex__card @(kardex.Cerrado ? "is-cerrado" : kardex.Enviado ? "is-enviado" : null)">
                                                    <header>
                                                        <span class="herida-kardex__tipo">@kardex.Nombre</span>
