                                            <span asp-validation-for="FechaNovedadDevolucionProductos" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-4">
                                            <label asp-for="MotivoNovedadDevolucionProductos" class="form-label"></label>
                                            <select asp-for="MotivoNovedadDevolucionProductos" asp-items="Model.MotivoNovedadDevolucionOptions" class="form-select">
                                                <option value="">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="MotivoNovedadDevolucionProductos" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-2">
                                            <label asp-for="NotificacionAuxiliarDevolucionProductos" class="form-label"></label>
                                            <select asp-for="NotificacionAuxiliarDevolucionProductos" asp-items="Model.SiNoOptions" class="form-select">
                                                <option value="">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="NotificacionAuxiliarDevolucionProductos" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="FechaMaximaDevolucionProductos" class="form-label"></label>
                                            <input asp-for="FechaMaximaDevolucionProductos" type="date" class="form-control" />
                                            <span asp-validation-for="FechaMaximaDevolucionProductos" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-4">
                                            <label asp-for="EstadoDevolucionServicioFarmaceutico" class="form-label"></label>
                                            <select asp-for="EstadoDevolucionServicioFarmaceutico" asp-items="Model.EstadoDevolucionOptions" class="form-select">
                                                <option value="">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="EstadoDevolucionServicioFarmaceutico" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="censo-form-actions censo-form-actions--inline">
                                        <button type="submit" class="btn btn-primary censo-save-button" formaction="@Url.Action("GuardarClinicaHeridasDevolucionProductos", "Censo")" formmethod="post" formnovalidate>
                                            <span>Guardar devolución de productos</span>
                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                <path d="M5 12h14"></path>
                                                <path d="m13 6 6 6-6 6"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-alta-programa" role="tabpanel" aria-labelledby="tab-alta-programa-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Clinica de heridas</span>
                                <h2 class="h5 mb-0">Alta del programa</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar el alta del programa.
                                </div>
