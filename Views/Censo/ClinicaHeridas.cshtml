                                        }

                                        <button type="button" class="btn btn-outline-primary herida-aposito__agregar" id="apositoAgregar">
                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                <path d="M12 5v14"></path>
                                                <path d="M5 12h14"></path>
                                            </svg>
                                            <span>Agregar apósito/medicamento</span>
                                        </button>
