                            else
                            {
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                                <path d="M8 3v4"></path>
                                                <path d="M16 3v4"></path>
                                                <path d="M4 10h16"></path>
                                                <path d="m9 15 2 2 4-5"></path>
                                            </svg>
                                        </span>
                                        <h3>Datos del egreso</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-6">
                                            <label asp-for="MotivoEgreso" class="form-label"></label>
                                            <select asp-for="MotivoEgreso" asp-items="Model.MotivoEgresoOptions" class="form-select">
                                                <option value="">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="MotivoEgreso" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="FechaEgreso" class="form-label"></label>
                                            <input asp-for="FechaEgreso" type="date" class="form-control" />
                                            <span asp-validation-for="FechaEgreso" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Estado" class="form-label"></label>
                                            <select asp-for="Estado" asp-items="Model.EstadoProgramaOptions" class="form-select">
                                                <option value="">Selecciona...</option>
                                            </select>
                                            <span asp-validation-for="Estado" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="censo-form-actions censo-form-actions--inline">
                                        <button type="submit" class="btn btn-primary censo-save-button" formaction="@Url.Action("GuardarClinicaHeridasAltaPrograma", "Censo")" formmethod="post" formnovalidate>
                                            <span>Guardar alta del programa</span>
                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                <path d="M5 12h14"></path>
