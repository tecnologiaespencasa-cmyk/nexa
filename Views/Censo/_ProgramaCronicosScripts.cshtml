@model CensoCronicoViewModel
@* Scripts del programa, dentro del @section Scripts de la pantalla unica. *@
@using Nexa.Data.Entities
@using System.Text.Json


@{
    ViewData["Title"] = "Programa Cronicos";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var sondaVesicalActiva = string.Equals(Model.SondaVesical, "Si", StringComparison.OrdinalIgnoreCase);
    var mipresPanalesActivo = string.Equals(Model.MipresPanales, "Si", StringComparison.OrdinalIgnoreCase);
    var mipresNutricionActivo = string.Equals(Model.MipresNutricion, "Si", StringComparison.OrdinalIgnoreCase);
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
    var medicamentoCatalogJson = JsonSerializer.Serialize(Model.MedicamentoCatalog);
    var kardexDocumentoCronico = $"{Model.TipoIdentificacion} {Model.NumeroIdentificacion}".Trim();
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");
}

    <partial name="_ValidationScriptsPartial" />
    @* Valores del servidor para wwwroot/js/censo/cronicos.js. El resto del script es estático
       y el navegador lo guarda en caché. *@
    <script>
        window.NexaCenso = window.NexaCenso || {};
        window.NexaCenso.cronicos = {
            validarDireccionUrl: "@Url.Action("ValidarDireccion", "Censo")",
            buscarBarriosUrl: "@Url.Action("BuscarBarrios", "Censo")",
            defaultsMunicipioUrl: "@Url.Action("ObtenerDefaultsMunicipio", "Censo")",
            buscarDiagnosticoCie10Url: "@Url.Action("BuscarDiagnosticoCie10", "Censo")",
            buscarGrupoPatologiaCronicaUrl: "@Url.Action("BuscarGrupoPatologiaCronica", "Censo")",
            direccionValidada: @Model.DireccionEsValida.ToString().ToLowerInvariant(),
            guardarAgudizacionUrl: "@Url.Action("GuardarCronicoAgudizacion", "Censo")",
            obtenerAgudizacionesUrl: "@Url.Action("ObtenerCronicoAgudizaciones", "Censo")",
            cronicoRecordId: @(Model.EditingRecordId?.ToString() ?? "0"),
            agudizacionesState: @Html.Raw(Json.Serialize(Model.Agudizaciones.Select(a => new
            {
                id = a.Id,
                numero = a.Numero,
                agudizacionJson = a.AgudizacionJson,
                kardexJson = a.KardexEdicionJson,
                requisicionJson = a.RequisicionFarmaciaJson,
                cerrada = a.KardexCerradoAtUtc != null,
                enviadaFarmacia = a.FarmaciaEnviadoAtUtc != null,
                farmaciaEstado = a.FarmaciaEstado,
                tuvoReapertura = a.TuvoReaperturaKardex,
                reaperturaSolicitud = (object?)null
            }))),
            guardarCronicoDocumentosUrl: "@Url.Action("GuardarCronicoAgudizacionDocumentos", "Censo")",
            enviarFarmaciaCronicoUrl: "@Url.Action("EnviarCronicoAgudizacionAFarmacia", "Censo")",
            solicitarReaperturaCronicoUrl: "@Url.Action("SolicitarReaperturaKardexCronico", "Censo")",
            aprobarReaperturaCronicoUrl: "@Url.Action("AprobarReaperturaKardexCronico", "Censo")",
            rechazarReaperturaCronicoUrl: "@Url.Action("RechazarReaperturaKardexCronico", "Censo")",
            puedeAprobarReaperturaCronico: @Json.Serialize(Model.PuedeAprobarReapertura),
            cronicoMedicamentoCatalog: @Html.Raw(medicamentoCatalogJson),
            guardarHospitalizacionUrl: "@Url.Action("GuardarCronicoHospitalizacionRegistro", "Censo")",
            obtenerHospitalizacionesUrl: "@Url.Action("ObtenerCronicoHospitalizaciones", "Censo")",
            hospitalizacionesState: @Html.Raw(Json.Serialize(Model.Hospitalizaciones.Select(h => new { id = h.Id, numero = h.Numero, hospitalizacionJson = h.HospitalizacionJson }))),
        };
    </script>
    <script src="~/js/censo/cronicos.js" asp-append-version="true"></script>