@model CensoClinicaHeridasViewModel
@* Scripts del programa, dentro del @section Scripts de la pantalla unica. *@
@using System.Globalization
@using Nexa.Data.Entities


@{
    ViewData["Title"] = "Clinica de heridas";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasAuxiliares = Model.AuxiliarEnfermeriaOptions.Any();
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
    var vacActivo = string.Equals(Model.Vac, "Si", StringComparison.OrdinalIgnoreCase);
    var historial = Model.Historial;
    var mostrarApositos = string.Equals(Model.Vac, "Si", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.ManejoHerida, "Si", StringComparison.OrdinalIgnoreCase);
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");

    // Las medidas llegan como double: se muestran sin decimales cuando son enteras (2 cm, no 2,0 cm).
    private static string FormatCm(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string Valor(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;
}

    <partial name="_ValidationScriptsPartial" />
    @* Valores del servidor para wwwroot/js/censo/clinica-heridas.js. El resto del script es estático
       y el navegador lo guarda en caché. *@
    <script>
        window.NexaCenso = window.NexaCenso || {};
        window.NexaCenso.clinicaHeridas = {
            recordIdActual: @(Model.EditingRecordId?.ToString() ?? "null"),
            validarDireccionUrl: "@Url.Action("ValidarDireccion", "Censo")",
            buscarBarriosUrl: "@Url.Action("BuscarBarrios", "Censo")",
            defaultsMunicipioUrl: "@Url.Action("ObtenerDefaultsMunicipio", "Censo")",
            buscarDiagnosticoCie10Url: "@Url.Action("BuscarDiagnosticoCie10", "Censo")",
            buscarPacienteOtrosCensosUrl: "@Url.Action("BuscarPacienteOtrosCensos", "Censo")",
            direccionValidada: @Model.DireccionEsValida.ToString().ToLowerInvariant(),
            guardarVacUrl: "@Url.Action("GuardarClinicaHeridasVac", "Censo")",
            kardexUrl: "@Url.Action("KardexClinicaHeridas", "Censo")",
            kardexGuardarUrl: "@Url.Action("GuardarKardexClinicaHeridas", "Censo")",
            kardexEnviarUrl: "@Url.Action("EnviarKardexClinicaHeridasAFarmacia", "Censo")",
            kardexAdjuntoUrl: "@Url.Action("SubirAdjuntoKardexClinicaHeridas", "Censo")",
            kardexAdjuntoEliminarUrl: "@Url.Action("EliminarAdjuntoKardexClinicaHeridas", "Censo")",
            kardexAdjuntoDescargaUrl: "@Url.Action("DescargarAdjuntoKardexClinicaHeridas", "Censo")",
            planUrl: "@Url.Action("PlanClinicaHeridas", "Censo")",
            planNuevoUrl: "@Url.Action("AbrirPlanClinicaHeridas", "Censo")",
        };
    </script>
    <script src="~/js/censo/clinica-heridas.js" asp-append-version="true"></script>