@model CensoNptViewModel
@using IntranetPrueba.Data.Entities

@section Styles
{
    <link rel="stylesheet" href="~/css/censo.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "NPT";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasAuxiliares = Model.AuxiliarEnfermeriaOptions.Any();
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
    var seccionesGuardado = new[]
    {
        new
        {
            Id = "tab-manejo-npt",
            Eyebrow = "Sección 2",
            Titulo = "Manejo de la NPT",
            Descripcion = "Fechas, días de tratamiento y horas de conexión.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el manejo de la NPT."
        },
        new
        {
            Id = "tab-cargue-servicios",
            Eyebrow = "Sección 3",
            Titulo = "Cargue de servicios",
            Descripcion = "Cargues de laboratorios, glucometría y seguimientos.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el cargue de servicios."
        },
        new
        {
            Id = "tab-activo-fijo",
            Eyebrow = "Sección 4",
            Titulo = "Activo fijo",
            Descripcion = "Equipos en comodato asignados al paciente.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el activo fijo."
        },
        new
        {
            Id = "tab-seguimiento-hospitalizado",
            Eyebrow = "Sección 5",
            Titulo = "Seguimiento hospitalizado",
            Descripcion = "Hospitalización y fechas de seguimiento.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el seguimiento hospitalizado."
        },
        new
        {
            Id = "tab-devolucion-productos",
            Eyebrow = "Sección 6",
            Titulo = "Devolución de productos",
            Descripcion = "Novedades y gestión del servicio farmacéutico.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar la devolución de productos."
        },
        new
        {
            Id = "tab-alta-programa",
            Eyebrow = "Sección 7",
            Titulo = "Alta del programa",
            Descripcion = "Motivo del egreso y estado del paciente.",
            Mensaje = "Guarda primero los datos básicos del paciente para registrar el alta del programa."
        }
    };
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");
}

<div class="censo-page @(showCurrentPatientBar ? "censo-page--with-current-patient" : null)">
    <aside class="censo-sidebar">
        <section class="censo-section-strip">
            <div class="censo-section-strip__nav">
                <div class="list-group censo-nav censo-nav--top" id="npt-tab" role="tablist">
                    <button class="list-group-item list-group-item-action active censo-nav__item"
                            id="tab-datos-basicos-link"
                            data-bs-toggle="list"
                            data-bs-target="#tab-datos-basicos"
                            type="button"
                            role="tab"
                            aria-controls="tab-datos-basicos"
                            aria-selected="true">
                        <span class="censo-nav__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="9" cy="7" r="3"></circle>
                                <path d="M4 19v-1a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v1"></path>
                                <path d="M16 8h4"></path>
                                <path d="M18 6v4"></path>
                            </svg>
                        </span>
                        <span class="censo-nav__content">
                            <span class="censo-nav__eyebrow">Sección 1</span>
                            <span class="censo-nav__title">Datos básicos</span>
                            <span class="censo-nav__description">Datos personales, contacto y clasificación del paciente.</span>
                        </span>
                    </button>

                    @foreach (var seccion in seccionesGuardado)
                    {
                        <button class="list-group-item list-group-item-action censo-nav__item"
                                id="@(seccion.Id)-link"
                                data-bs-toggle="list"
                                data-bs-target="#@seccion.Id"
                                type="button"
                                role="tab"
                                aria-controls="@seccion.Id"
                                aria-selected="false">
                            <span class="censo-nav__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                    <path d="M8 3v4"></path>
                                    <path d="M16 3v4"></path>
                                    <path d="M4 10h16"></path>
                                </svg>
                            </span>
                            <span class="censo-nav__content">
                                <span class="censo-nav__eyebrow">@seccion.Eyebrow</span>
                                <span class="censo-nav__title">@seccion.Titulo</span>
                                <span class="censo-nav__description">@seccion.Descripcion</span>
                            </span>
                        </button>
                    }
                </div>
            </div>
            <div class="censo-section-strip__tools">
                <form method="get" asp-action="Npt" class="censo-filter-panel">
                    <h2 class="censo-filter-panel__title">Filtros rápidos</h2>
                    <label for="cedulaNptFiltroInput" class="form-label censo-filter-panel__label">Buscar por documento</label>
                    <div class="censo-filter-panel__input-wrap">
                        <input class="form-control censo-filter-panel__input" id="cedulaNptFiltroInput" name="cedulaPaciente" value="@Model.CedulaFiltro" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                        <span class="censo-filter-panel__search-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="m20 20-3.5-3.5"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="censo-filter-panel__actions">
                        <button type="submit" class="btn btn-outline-primary censo-filter-panel__button">Buscar</button>
                        <a class="btn btn-outline-secondary censo-filter-panel__button" asp-action="Npt">Limpiar</a>
                    </div>
                </form>
            </div>
        </section>
    </aside>

    @if (showCurrentPatientBar)
    {
        <section class="censo-current-patient" aria-label="Paciente actual">
            <div class="censo-current-patient__avatar" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M4 21a8 8 0 0 1 16 0"></path>
                </svg>
            </div>

            <div class="censo-current-patient__identity">
                <span class="censo-current-patient__label">Paciente actual</span>
                <strong>@Model.NombrePaciente</strong>
                @if (!string.IsNullOrWhiteSpace(Model.TipoNutricion))
                {
                    <span class="censo-current-patient__status">Nutrición @Model.TipoNutricion</span>
                }
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Tipo ID</span>
                <strong>@Model.TipoIdentificacion</strong>
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Documento</span>
                <strong>@Model.NumeroIdentificacion</strong>
            </div>

            <div class="censo-current-patient__item">
                <span class="censo-current-patient__label">Ingreso al programa</span>
                <strong>
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                        <path d="M8 3v4"></path>
                        <path d="M16 3v4"></path>
                        <path d="M4 10h16"></path>
                    </svg>
                    @Model.FechaIngresoPrograma.ToString("dd/MM/yyyy")
                </strong>
            </div>

            <div class="censo-current-patient__actions">
                <div class="dropdown">
                    <button class="btn censo-current-patient__button" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                            <path d="M15 19a6 6 0 0 0-12 0"></path>
                            <circle cx="9" cy="8" r="3"></circle>
                            <path d="M19 8v6"></path>
                            <path d="M16 11h6"></path>
                        </svg>
                        <span>Cambiar paciente</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end censo-current-patient__dropdown">
                        <form method="get" asp-action="Npt" class="censo-current-patient__search">
                            <label for="cambiarNptPacienteDocumento" class="form-label">Documento</label>
                            <div class="input-group">
                                <input class="form-control" id="cambiarNptPacienteDocumento" name="cedulaPaciente" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                                <button class="btn" type="submit" aria-label="Buscar paciente">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <circle cx="11" cy="11" r="7"></circle>
                                        <path d="m20 20-3.5-3.5"></path>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <a class="btn censo-current-patient__button censo-current-patient__button--primary" asp-action="Npt">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    <span>Nuevo ingreso</span>
                </a>
            </div>
        </section>
    }

    <section class="censo-content">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success">@successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-warning">@errorMessage</div>
        }

        <form asp-action="Npt" method="post" id="censoNptForm" class="censo-form-shell">
            <input asp-for="EditingRecordId" type="hidden" />
            <input asp-for="CedulaFiltro" type="hidden" />
            <input asp-for="DireccionEsValida" type="hidden" id="direccionEsValidaInput" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger censo-validation-summary mb-4" role="alert"></div>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-datos-basicos" role="tabpanel" aria-labelledby="tab-datos-basicos-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">NPT</span>
                                <h2 class="h5 mb-0">Datos básicos</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!hasAuxiliares)
                            {
                                <div class="alert alert-warning">
                                    No hay auxiliares OPS activos para asignar. Puedes guardar el registro y asignarlo después.
                                </div>
                            }

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                            <path d="M8 3v4"></path>
                                            <path d="M16 3v4"></path>
                                            <path d="M4 10h16"></path>
                                        </svg>
                                    </span>
                                    <h3>Ingreso al programa</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-4">
                                        <label asp-for="Asegurador" class="form-label"></label>@RequiredMark()
                                        <select asp-for="Asegurador" asp-items="Model.AseguradorOptions" class="form-select">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Asegurador" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="FechaIngresoPrograma" class="form-label"></label>@RequiredMark()
                                        <input asp-for="FechaIngresoPrograma" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="FechaIngresoPrograma" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <circle cx="12" cy="8" r="4"></circle>
                                            <path d="M4 21a8 8 0 0 1 16 0"></path>
                                        </svg>
                                    </span>
                                    <h3>Información Personal</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-3">
                                        <label asp-for="TipoIdentificacion" class="form-label"></label>@RequiredMark()
                                        <select asp-for="TipoIdentificacion" asp-items="Model.TipoIdentificacionOptions" class="form-select" id="tipoIdentificacionSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="TipoIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="NumeroIdentificacion" class="form-label"></label>@RequiredMark()
                                        <input asp-for="NumeroIdentificacion" class="form-control" inputmode="numeric" maxlength="20" autocomplete="off" id="numeroIdentificacionInput" />
                                        <span asp-validation-for="NumeroIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-6">
                                        <label asp-for="NombrePaciente" class="form-label"></label>@RequiredMark()
                                        <input asp-for="NombrePaciente" class="form-control" autocomplete="off" />
                                        <span asp-validation-for="NombrePaciente" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="FechaNacimiento" class="form-label"></label>@RequiredMark()
                                        <input asp-for="FechaNacimiento"
                                               type="date"
                                               class="form-control"
                                               id="fechaNacimientoInput"
                                               max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                                               data-msg-max="La fecha de nacimiento debe ser anterior a la fecha actual."
                                               oninvalid="this.setCustomValidity('La fecha de nacimiento debe ser anterior a la fecha actual.')"
                                               oninput="this.setCustomValidity('')" />
                                        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-2">
                                        <label asp-for="Edad" class="form-label"></label>
                                        <input asp-for="Edad" class="form-control" id="edadInput" readonly />
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Genero" class="form-label"></label>@RequiredMark()
                                        <select asp-for="Genero" asp-items="Model.GeneroOptions" class="form-select">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Genero" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M12 21s7-4.7 7-11a7 7 0 1 0-14 0c0 6.3 7 11 7 11Z"></path>
                                            <circle cx="12" cy="10" r="2.5"></circle>
                                        </svg>
                                    </span>
                                    <h3>Dirección y ubicación</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-12">
                                        <label asp-for="Direccion" class="form-label"></label>
                                        <div class="input-group censo-direccion-group">
                                            <input asp-for="Direccion" class="form-control" id="direccionInput" placeholder="Ingrese dirección completa del paciente" />
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="validarDireccionBtn">Validar dirección</button>
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="limpiarDireccionBtn">Limpiar</button>
                                        </div>
                                        <span asp-validation-for="Direccion" class="text-danger d-block"></span>
                                        @if (!string.IsNullOrWhiteSpace(Model.DireccionMensajeValidacion))
                                        {
                                            <div class="alert @(Model.DireccionEsValida ? "alert-success" : "alert-warning") mt-2" id="direccionValidacionServerMensaje">
                                                @Model.DireccionMensajeValidacion
                                                @if (!string.IsNullOrWhiteSpace(Model.DireccionSugerida))
                                                {
                                                    <div class="mt-1">
                                                        Sugerencia: <strong>@Model.DireccionSugerida</strong>
                                                        <button type="button" class="btn btn-sm btn-link p-0 ms-2" id="usarSugerenciaDireccionBtnServer">Usar sugerencia</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        <div class="alert d-none mt-2" id="direccionValidacionMensaje"></div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check censo-direccion-check">
                                            <input asp-for="AsumirDireccionErrada" class="form-check-input" type="checkbox" id="asumirDireccionErradaCheck" />
                                            <label asp-for="AsumirDireccionErrada" class="form-check-label">
                                                Asumir dirección errada y continuar
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Barrio" class="form-label"></label>
                                        <select asp-for="Barrio" class="form-select" id="barrioSelect">
                                            <option value="" disabled hidden>Selecciona barrio...</option>
                                            @foreach (var barrioOption in Model.BarrioOptions)
                                            {
                                                <option value="@barrioOption">@barrioOption</option>
                                            }
                                        </select>
                                        <span asp-validation-for="Barrio" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="MunicipioResidencia" class="form-label"></label>
                                        <select asp-for="MunicipioResidencia" asp-items="Model.MunicipioResidenciaOptions" class="form-select" id="municipioResidenciaSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="MunicipioResidencia" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="ZonaDireccionSegunMunicipio" class="form-label"></label>
                                        <select asp-for="ZonaDireccionSegunMunicipio" asp-items="Model.ZonaDireccionOptions" class="form-select" id="zonaDireccionSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="ZonaDireccionSegunMunicipio" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="ClasificacionZonaSura" class="form-label"></label>
                                        <select asp-for="ClasificacionZonaSura" asp-items="Model.ClasificacionZonaSuraOptions" class="form-select" id="clasificacionZonaSuraSelect">
                                            <option value="" disabled hidden>Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="ClasificacionZonaSura" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2Z"></path>
                                        </svg>
                                    </span>
                                    <h3>Contacto</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-4">
                                        <label asp-for="TelefonoPrincipal" class="form-label"></label>@RequiredMark()
                                        <input asp-for="TelefonoPrincipal" class="form-control npt-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoPrincipal" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="TelefonoAdicional1" class="form-label"></label>@RequiredMark()
                                        <input asp-for="TelefonoAdicional1" class="form-control npt-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoAdicional1" class="text-danger"></span>
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="telefonoAdicional2Toggle" />
                                            <label class="form-check-label" for="telefonoAdicional2Toggle">
                                                Adicionar otro teléfono
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 d-none" id="telefonoAdicional2Container">
                                        <label asp-for="TelefonoAdicional2" class="form-label"></label>
                                        <input asp-for="TelefonoAdicional2" class="form-control npt-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoAdicional2" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="LlamadaBienvenida" class="form-label"></label>
                                        <select asp-for="LlamadaBienvenida" asp-items="Model.LlamadaBienvenidaOptions" class="form-select">
                                            <option value="">Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="LlamadaBienvenida" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="TelefonoContacto" class="form-label"></label>
                                        <input asp-for="TelefonoContacto" class="form-control npt-phone-input" inputmode="numeric" maxlength="10" />
                                        <span asp-validation-for="TelefonoContacto" class="text-danger"></span>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Observacion" class="form-label"></label>
                                        <textarea asp-for="Observacion" class="form-control" rows="4" maxlength="2000" placeholder="Registra las observaciones del paciente"></textarea>
                                        <span asp-validation-for="Observacion" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <span class="censo-field-section__icon" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M12 3v18"></path>
                                            <path d="M3 12h18"></path>
                                            <circle cx="12" cy="12" r="9"></circle>
                                        </svg>
                                    </span>
                                    <h3>Información clínica</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-3">
                                        <label asp-for="CodigoCie10" class="form-label"></label>@RequiredMark()
                                        <input asp-for="CodigoCie10" class="form-control" id="codigoCie10Input" maxlength="4" autocomplete="off" />
                                        <span asp-validation-for="CodigoCie10" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-6">
                                        <label asp-for="DiagnosticoDescriptivo" class="form-label"></label>@RequiredMark()
                                        <input asp-for="DiagnosticoDescriptivo" class="form-control" id="diagnosticoDescriptivoInput" readonly />
