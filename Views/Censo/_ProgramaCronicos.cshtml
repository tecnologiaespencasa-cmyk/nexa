                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar el egreso del programa.
                                </div>
                            }
                            else
                            {
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <rect x="4" y="5" width="16" height="15" rx="2"></rect>
                                                <path d="M8 3v4"></path>
                                                <path d="M16 3v4"></path>
                                                <path d="M4 10h16"></path>
                                                <path d="m9 15 2 2 4-5"></path>
                                            </svg>
                                        </span>
                                        <h3>Egreso del programa</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label asp-for="EgresaProgramaCronico" class="form-label"></label>
                                            <select asp-for="EgresaProgramaCronico" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                            <span asp-validation-for="EgresaProgramaCronico" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-6">
                                            <label asp-for="MotivoEgreso" class="form-label"></label>
                                            <select asp-for="MotivoEgreso" asp-items="Model.MotivoEgresoOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                            <span asp-validation-for="MotivoEgreso" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="FechaEgreso" class="form-label"></label>
                                            <input asp-for="FechaEgreso" type="date" class="form-control" />
                                        </div>
                                    </div>
                                    <div class="censo-form-actions censo-form-actions--inline">
                                        <button type="submit" class="btn btn-primary censo-save-button" formaction="@Url.Action("GuardarCronicoHospitalizacion", "Censo")" formmethod="post" formnovalidate>
                                            <span>Guardar egreso del programa</span>
                                            <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                                <path d="M5 12h14"></path>
                                                <path d="m13 6 6 6-6 6"></path>
                                            </svg>
                                        </button>
                                    </div>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>


