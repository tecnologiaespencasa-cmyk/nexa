@model CensoCronicoViewModel
@*
    Formulario del programa dentro de la pantalla unica de censo.

    Es el mismo marcado que tenia la pantalla independiente y envia a la misma accion, para
    que kardex, requisiciones, farmacia y prorrogas sigan funcionando igual. Los cambios son
    dos: los identificadores de panel llevan el prefijo del programa, porque los cinco
    conviven ahora en un mismo documento, y los campos que subieron al maestro de paciente
    viajan ocultos, para que la validacion de este censo siga recibiendo el modelo completo.
*@
@using Nexa.Data.Entities
@using System.Text.Json


@{
    ViewData["Title"] = "Programa Cronicos";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var hasAuxiliares = Model.AuxiliarEnfermeriaOptions.Any();
    var clinicaHeridasActiva = string.Equals(Model.ClinicaHeridas, "Si", StringComparison.OrdinalIgnoreCase);
    var programaNutricionActiva = string.Equals(Model.ProgramaNutricion, "Si", StringComparison.OrdinalIgnoreCase);
    var sondaVesicalActiva = string.Equals(Model.SondaVesical, "Si", StringComparison.OrdinalIgnoreCase);
    var mipresPanalesActivo = string.Equals(Model.MipresPanales, "Si", StringComparison.OrdinalIgnoreCase);
    var mipresNutricionActivo = string.Equals(Model.MipresNutricion, "Si", StringComparison.OrdinalIgnoreCase);
    var showCurrentPatientBar = Model.EditingRecordId.HasValue
        && !string.IsNullOrWhiteSpace(Model.NumeroIdentificacion);
    var medicamentoCatalogJson = JsonSerializer.Serialize(Model.MedicamentoCatalog);
    var kardexDocumentoCronico = $"{Model.TipoIdentificacion} {Model.NumeroIdentificacion}".Trim();
}

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent RequiredMark() =>
        new Microsoft.AspNetCore.Html.HtmlString("<span class=\"text-danger ms-1\" aria-hidden=\"true\">*</span><span class=\"visually-hidden\">obligatorio</span>");
}

        <form asp-action="ProgramaCronicos" method="post" id="censoCronicoForm" class="censo-form-shell">
            <input asp-for="EditingRecordId" type="hidden" />
            <input asp-for="CedulaFiltro" type="hidden" />
            <input asp-for="DireccionEsValida" type="hidden" id="cronicosDireccionEsValidaInput" />

            <div asp-validation-summary="All" class="alert alert-danger censo-validation-summary mb-4" role="alert"></div>

            <div class="tab-content">
                @* ---------- Sección 1: Datos básicos ---------- *@
                <div class="tab-pane fade" id="tab-cronicos-datos-especificos" role="tabpanel" aria-labelledby="tab-cronicos-datos-especificos-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Programa Cronicos</span>
                                <h2 class="h5 mb-0">Datos específicos</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            <section class="censo-field-section">
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-12">
                                        <label class="form-label">Fuente de ingreso @RequiredMark()</label>
                                        <div class="censo-check-grid">
                                            @for (var i = 0; i < Model.FuenteIngresoOptions.Count; i++)
                                            {
                                                var option = Model.FuenteIngresoOptions[i];
                                                var inputId = $"fuenteIngreso_{i}";
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" id="@inputId" name="FuenteIngreso" value="@option.Value"
                                                           checked="@string.Equals(Model.FuenteIngreso, option.Value, StringComparison.OrdinalIgnoreCase)" />
                                                    <label class="form-check-label" for="@inputId">@option.Text</label>
                                                </div>
                                            }
                                        </div>
                                        <span asp-validation-for="FuenteIngreso" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                                    <input asp-for="FechaIngreso" type="hidden" />
                                    <input asp-for="NombrePaciente" type="hidden" />
                                    <input asp-for="TipoIdentificacion" type="hidden" />
                                    <input asp-for="NumeroIdentificacion" type="hidden" />
                                    <input asp-for="FechaNacimiento" type="hidden" />
                                    <input asp-for="Edad" type="hidden" />
                                    <input asp-for="CorreoElectronico" type="hidden" />
                                    @* El genero lo administra "Datos basicos del paciente"; sin este campo el
                                       formulario no lo enviaba y su [Required] hacia imposible guardar cronicos. *@
                                    <input asp-for="Genero" type="hidden" />

                                    <input asp-for="Direccion" type="hidden" />
                                    <input asp-for="AsumirDireccionErrada" type="hidden" />
                                    <input asp-for="DetalleDireccion" type="hidden" />
                                    <input asp-for="ClasificacionZonaSura" type="hidden" />
                                    <input asp-for="MunicipioResidencia" type="hidden" />
                                    <input asp-for="Barrio" type="hidden" />
                                    <input asp-for="ZonaDireccionSegunMunicipio" type="hidden" />
                                    <input asp-for="Area" type="hidden" />

                            <div class="censo-form-actions">
                                <button type="submit" class="btn btn-primary censo-save-button">
                                    <span>@(Model.EditingRecordId.HasValue ? "Actualizar registro" : "Guardar registro")</span>
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <path d="M5 12h14"></path>
                                        <path d="m13 6 6 6-6 6"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @* ---------- Sección 2: Gestión del caso ---------- *@
                <div class="tab-pane fade" id="tab-cronicos-gestion-caso" role="tabpanel" aria-labelledby="tab-cronicos-gestion-caso-link">
                    <div class="card">
                        <div class="card-header">
                            <div class="censo-card-heading">
                                <span class="censo-card-heading__eyebrow">Programa Cronicos</span>
                                <h2 class="h5 mb-0">Gestión del caso</h2>
                            </div>
                        </div>
                        <div class="card-body">
                            @if (!Model.EditingRecordId.HasValue)
                            {
                                <div class="alert alert-warning mb-0">
                                    Guarda primero los datos básicos del paciente para registrar la gestión del caso.
                                </div>
                            }
                            else
                            {
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M9 11l3 3 8-8"></path>
                                                <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"></path>
                                            </svg>
                                        </span>
                                        <h3>Clasificación y agudización</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-12">
                                            <label class="form-label">Clasificación del caso</label>
                                            <div class="censo-check-grid">
                                                @for (var i = 0; i < Model.ClasificacionCasoOptions.Count; i++)
                                                {
                                                    var option = Model.ClasificacionCasoOptions[i];
                                                    var inputId = $"clasificacionCaso_{i}";
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="radio" id="@inputId" name="ClasificacionCaso" value="@option.Value"
                                                               checked="@string.Equals(Model.ClasificacionCaso, option.Value, StringComparison.OrdinalIgnoreCase)" />
                                                        <label class="form-check-label" for="@inputId">@option.Text</label>
                                                    </div>
                                                }
                                            </div>
                                            <span asp-validation-for="ClasificacionCaso" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="DiagnosticoCronicoCie10" class="form-label"></label>
                                            <input asp-for="DiagnosticoCronicoCie10" class="form-control" id="diagnosticoCronicoInput" maxlength="4" autocomplete="off" />
                                            <span asp-validation-for="DiagnosticoCronicoCie10" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-9">
                                            <label asp-for="GrupoPatologiaCronica" class="form-label"></label>
                                            <input asp-for="GrupoPatologiaCronica" class="form-control" id="grupoPatologiaInput" readonly />
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="DiagnosticoCronicoComplementario" class="form-label"></label>
                                            <input asp-for="DiagnosticoCronicoComplementario" class="form-control" id="diagnosticoComplementarioInput" maxlength="4" autocomplete="off" />
                                            <span asp-validation-for="DiagnosticoCronicoComplementario" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-9">
                                            <label asp-for="GrupoPatologiaCronicaComplementario" class="form-label"></label>
                                            <input asp-for="GrupoPatologiaCronicaComplementario" class="form-control" id="grupoPatologiaComplementarioInput" readonly />
                                        </div>
                                    </div>
                                </section>

                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M4 19V5"></path>
                                                <path d="M4 19h16"></path>
                                                <path d="M8 15l3-3 3 2 5-7"></path>
                                            </svg>
                                        </span>
                                        <h3>Escalas y auditoría</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label asp-for="BarthelAuditado" class="form-label"></label>
                                            <select asp-for="BarthelAuditado" asp-items="Model.BarthelAuditadoOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                            <span asp-validation-for="BarthelAuditado" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="FechaAuditoria" class="form-label"></label>
                                            <input asp-for="FechaAuditoria" type="date" class="form-control" />
                                            <span asp-validation-for="FechaAuditoria" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="CalificacionBarthel" class="form-label"></label>
                                            <select asp-for="CalificacionBarthel" asp-items="Model.CalificacionBarthelOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                            <span asp-validation-for="CalificacionBarthel" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Karnofsky" class="form-label"></label>
                                            <select asp-for="Karnofsky" asp-items="Model.KarnofskyOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Fast" class="form-label"></label>
                                            <select asp-for="Fast" asp-items="Model.FastOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Rankin" class="form-label"></label>
                                            <select asp-for="Rankin" asp-items="Model.RankinOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="DisneaMmrc" class="form-label"></label>
                                            <select asp-for="DisneaMmrc" asp-items="Model.DisneaMmrcOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Nyha" class="form-label"></label>
                                            <select asp-for="Nyha" asp-items="Model.NyhaOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Braden" class="form-label"></label>
                                            <input asp-for="Braden" type="number" class="form-control" id="bradenInput" autocomplete="off" />
                                            <span asp-validation-for="Braden" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="RiesgoLesionPiel" class="form-label"></label>
                                            <input asp-for="RiesgoLesionPiel" class="form-control" id="riesgoLesionPielInput" readonly />
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="EscalaMorse" class="form-label"></label>
                                            <input asp-for="EscalaMorse" type="number" class="form-control" id="escalaMorseInput" autocomplete="off" />
                                            <span asp-validation-for="EscalaMorse" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="RiesgoCaida" class="form-label"></label>
                                            <input asp-for="RiesgoCaida" class="form-control" id="riesgoCaidaInput" readonly />
                                        </div>
                                    </div>
                                </section>

                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M12 3l7 4v5c0 4.5-3 8-7 9-4-1-7-4.5-7-9V7z"></path>
                                                <path d="m9 12 2 2 4-4"></path>
                                            </svg>
                                        </span>
                                        <h3>Programas y servicios</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label asp-for="ClinicaHeridas" class="form-label"></label>
                                            <select asp-for="ClinicaHeridas" asp-items="Model.SiNoOptions" class="form-select" id="clinicaHeridasSelect">
                                            </select>
                                            <span asp-validation-for="ClinicaHeridas" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="EstadoClinicaHeridas" class="form-label"></label>
                                            <select asp-for="EstadoClinicaHeridas" asp-items="Model.EstadoClinicaHeridasOptions" class="form-select" id="estadoClinicaHeridasSelect" disabled="@(clinicaHeridasActiva ? null : "disabled")">
                                                <option value=""></option>
                                            </select>
                                            <span asp-validation-for="EstadoClinicaHeridas" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="ProgramaNutricion" class="form-label"></label>
                                            <select asp-for="ProgramaNutricion" asp-items="Model.SiNoOptions" class="form-select" id="programaNutricionSelect">
                                            </select>
                                            <span asp-validation-for="ProgramaNutricion" class="text-danger"></span>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="EducacionPlanCuidados" class="form-label"></label>
                                            <select asp-for="EducacionPlanCuidados" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                            <span asp-validation-for="EducacionPlanCuidados" class="text-danger"></span>
                                        </div>
                                        <div class="col-12 @(programaNutricionActiva ? null : "d-none")" id="programaNutricionFields">
                                            <div class="row g-3">
                                                <div class="col-lg-4">
                                                    <label asp-for="FechaInicioNutricion" class="form-label"></label>
                                                    <input asp-for="FechaInicioNutricion" type="date" class="form-control" />
                                                    <span asp-validation-for="FechaInicioNutricion" class="text-danger"></span>
                                                </div>
                                                <div class="col-lg-4">
                                                    <label asp-for="AuxiliarAsignadoNutricion" class="form-label"></label>
                                                    <input asp-for="AuxiliarAsignadoNutricion" class="form-control" maxlength="120" id="auxiliarNutricionInput" list="auxiliarNutricionOptions" autocomplete="off" placeholder="Buscar auxiliar asignado" />
                                                    <datalist id="auxiliarNutricionOptions">
                                                        @foreach (var assistant in Model.AuxiliarEnfermeriaOptions.Where(option => !string.IsNullOrWhiteSpace(option.Value)))
                                                        {
                                                            <option value="@assistant.Value">@assistant.Text</option>
                                                        }
                                                    </datalist>
                                                    @if (!hasAuxiliares)
                                                    {
                                                        <div class="form-text">No hay auxiliares OPS activos para asignar.</div>
                                                    }
                                                    <span asp-validation-for="AuxiliarAsignadoNutricion" class="text-danger"></span>
                                                </div>
                                                <div class="col-lg-4">
                                                    <label asp-for="FechaFinNutricion" class="form-label"></label>
                                                    <input asp-for="FechaFinNutricion" type="date" class="form-control" />
                                                    <span asp-validation-for="FechaFinNutricion" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M4 19V5"></path>
                                                <path d="M4 19h16"></path>
                                                <path d="M8 15l3-3 3 2 5-7"></path>
                                            </svg>
                                        </span>
                                        <h3>Terapias y valoraciones</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label asp-for="TerapiaFisica" class="form-label"></label>
                                            <select asp-for="TerapiaFisica" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="TerapiaRespiratoria" class="form-label"></label>
                                            <select asp-for="TerapiaRespiratoria" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="TerapiaOcupacional" class="form-label"></label>
                                            <select asp-for="TerapiaOcupacional" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Fonoaudiologia" class="form-label"></label>
                                            <select asp-for="Fonoaudiologia" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Nutricion" class="form-label"></label>
                                            <select asp-for="Nutricion" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Psicologia" class="form-label"></label>
                                            <select asp-for="Psicologia" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                    </div>
                                </section>

                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <circle cx="12" cy="12" r="9"></circle>
                                                <path d="M12 7v5l3 2"></path>
                                            </svg>
                                        </span>
                                        <h3>Dispositivos y sondas</h3>
                                    </div>
                                    <div class="row g-3 censo-field-section__grid">
                                        <div class="col-lg-3">
                                            <label asp-for="Traqueostomia" class="form-label"></label>
                                            <select asp-for="Traqueostomia" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="SondaNasogastrica" class="form-label"></label>
                                            <select asp-for="SondaNasogastrica" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="CalibreSondaNasogastrica" class="form-label"></label>
                                            <select asp-for="CalibreSondaNasogastrica" asp-items="Model.CalibreSondaNasogastricaOptions" class="form-select">
                                                <option value=""></option>
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="FrecuenciaCambioSondaNasogastrica" class="form-label"></label>
                                            <input asp-for="FrecuenciaCambioSondaNasogastrica" class="form-control" maxlength="50" autocomplete="off" />
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="FechaUltimoCambioSondaNasogastrica" class="form-label"></label>
                                            <input asp-for="FechaUltimoCambioSondaNasogastrica" type="date" class="form-control" />
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="SondaGastrostomia" class="form-label"></label>
                                            <select asp-for="SondaGastrostomia" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="Colostomia" class="form-label"></label>
                                            <select asp-for="Colostomia" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="SondaCistostomia" class="form-label"></label>
                                            <select asp-for="SondaCistostomia" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="CateterPicc" class="form-label"></label>
                                            <select asp-for="CateterPicc" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="SondaVesical" class="form-label"></label>
                                            <select asp-for="SondaVesical" asp-items="Model.SiNoOptions" class="form-select" id="sondaVesicalSelect">
                                            </select>
                                        </div>
                                        <div class="col-12 @(sondaVesicalActiva ? null : "d-none")" id="sondaVesicalFields">
                                            <div class="row g-3">
                                                <div class="col-lg-3">
                                                    <label asp-for="CalibreSondaVesical" class="form-label"></label>
                                                    <select asp-for="CalibreSondaVesical" asp-items="Model.CalibreSondaVesicalOptions" class="form-select" id="calibreSondaVesicalSelect">
                                                        <option value=""></option>
                                                    </select>
                                                </div>
                                                <div class="col-lg-3">
                                                    <label asp-for="FrecuenciaCambioSondaVesical" class="form-label"></label>
                                                    <input asp-for="FrecuenciaCambioSondaVesical" class="form-control" type="number" min="0" step="1" inputmode="numeric" maxlength="50" autocomplete="off" id="frecuenciaCambioSondaVesicalInput" />
                                                </div>
                                                <div class="col-lg-3">
                                                    <label asp-for="FechaUltimoCambioSondaVesical" class="form-label"></label>
                                                    <input asp-for="FechaUltimoCambioSondaVesical" type="date" class="form-control" id="fechaUltimoCambioSondaVesicalInput" />
                                                </div>
                                                <div class="col-lg-3">
                                                    <label asp-for="FechaProximoCambioSondaVesical" class="form-label"></label>
                                                    <input asp-for="FechaProximoCambioSondaVesical" type="date" class="form-control" id="fechaProximoCambioSondaVesicalInput" readonly />
                                                </div>
                                                <div class="col-12">
                                                    <label asp-for="ObservacionCambioSonda" class="form-label"></label>
                                                    <textarea asp-for="ObservacionCambioSonda" class="form-control" rows="2" maxlength="500"></textarea>
                                                    <span asp-validation-for="ObservacionCambioSonda" class="text-danger"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
                                                <path d="M14 3v5h5"></path>
                                            </svg>
                                        </span>
