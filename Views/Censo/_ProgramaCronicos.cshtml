                                            <select asp-for="FormulaControl" asp-items="Model.SiNoOptions" class="form-select">
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <div class="censo-field-section__subtitle"><strong>Mipres pañales</strong></div>
                                        </div>
                                        <div class="col-lg-3">
                                            <label asp-for="MipresPanales" class="form-label"></label>
