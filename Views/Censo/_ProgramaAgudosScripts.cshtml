            buscarBarriosUrl: "@Url.Action("BuscarBarrios", "Censo")",
            defaultsMunicipioUrl: "@Url.Action("ObtenerDefaultsMunicipio", "Censo")",
            buscarDiagnosticoCie10Url: "@Url.Action("BuscarDiagnosticoCie10", "Censo")",
            guardarProrrogaUrl: "@Url.Action("GuardarProrroga", "Censo")",
            enviarFarmaciaUrl: "@Url.Action("EnviarAFarmacia", "Censo")",
            guardarDocumentosUrl: "@Url.Action("GuardarDocumentos", "Censo")",
            obtenerDocumentosUrl: "@Url.Action("ObtenerDocumentos", "Censo")",
            indexUrl: "@Url.Action("ProgramaAgudos", "Censo")",
            subirAdjuntoUrl: "@Url.Action("SubirAdjunto", "Censo")",
            eliminarAdjuntoUrl: "@Url.Action("EliminarAdjunto", "Censo")",
            descargarAdjuntoUrl: "@Url.Action("DescargarAdjunto", "Censo")",
