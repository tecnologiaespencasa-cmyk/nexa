        ["Prorroga_TipoProrroga"] = "Tipo de prórroga",
        ["Prorroga_SeguimientoMedico"] = "Seguimiento médico"
    };
    Func<string, string> getProrrogaColumnTitle = name => prorrogaColumnTitleOverrides.TryGetValue(name, out var title)
        ? title
        : $"Prórroga - {humanizeColumnTitle(name.Replace("Prorroga_", string.Empty, StringComparison.OrdinalIgnoreCase))}";
}

