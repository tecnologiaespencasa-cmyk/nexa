            serverSuccessMessage: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage ?? string.Empty)),
            serverErrorMessages: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(saveErrorMessages)),
            serverMissingMandatorySections: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(missingMandatorySections)),
            shouldShowSaveErrorModal: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(shouldShowSaveErrorModal)),
            initialDireccionValidada: @Model.DireccionEsValida.ToString().ToLowerInvariant(),
            initialAsumirDireccionErrada: @Model.AsumirDireccionErrada.ToString().ToLowerInvariant(),
            initialDireccionValue: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Direccion ?? string.Empty)),
            direccionValidada: @Model.DireccionEsValida.ToString().ToLowerInvariant(),
        };
    </script>
    <script src="~/js/censo/agudos.js" asp-append-version="true"></script>
