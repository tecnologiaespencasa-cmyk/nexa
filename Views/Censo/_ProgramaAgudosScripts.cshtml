                const focusAuxiliarAsignado = () => {
                    openSectionTab("tab-agudos-plan-manejo");
                    window.setTimeout(() => {
                        if (auxiliarAsignadoInput) {
                            auxiliarAsignadoInput.focus();
                        }
                    }, 250);
                };

                const requireAuxiliarAsignadoForComplete = (showWarning) => {
                    if (!switchInput.checked || !auxiliarAsignadoInput || !isMedicationAdministrationEnabled() || String(auxiliarAsignadoInput.value || "").trim()) {
                        return true;
                    }

                    switchInput.checked = false;
                    syncStatus();

                    if (showWarning) {
                        showAuxiliarAsignadoRequiredWarning();
                        focusAuxiliarAsignado();
                    }

                    return false;
                };

                requireAuxiliarAsignadoForComplete(false);
                syncStatus();
                switchInput.addEventListener("change", () => {
                    if (requireAuxiliarAsignadoForComplete(true)) {
                        syncStatus();
                    }
                });

                if (auxiliarAsignadoInput) {
                    auxiliarAsignadoInput.addEventListener("input", () => requireAuxiliarAsignadoForComplete(false));
                    auxiliarAsignadoInput.addEventListener("change", () => requireAuxiliarAsignadoForComplete(false));
                }
            }

            const birthDateInput = document.getElementById("fechaNacimientoInput");
            const ageInput = document.getElementById("edadInput");
            if (birthDateInput && ageInput) {
                const validateBirthDateChanged = () => {
                    const today = new Date();
                    const todayValue = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
                    if (!birthDateInput.value || birthDateInput.value >= todayValue) {
                        birthDateInput.setCustomValidity("La fecha de nacimiento debe ser anterior a la fecha actual.");
                    } else {
                        birthDateInput.setCustomValidity("");
                    }
                };

                const syncAge = () => {
                    if (!birthDateInput.value) {
                        ageInput.value = "0";
                        validateBirthDateChanged();
                        return;
                    }

                    const birthDate = new Date(birthDateInput.value + "T00:00:00");
                    const today = new Date();
                    let age = today.getFullYear() - birthDate.getFullYear();
                    const hasBirthdayPassed =
                        today.getMonth() > birthDate.getMonth()
                        || (today.getMonth() === birthDate.getMonth() && today.getDate() >= birthDate.getDate());

                    if (!hasBirthdayPassed) {
                        age -= 1;
                    }

                    ageInput.value = Math.max(age, 0);
                    validateBirthDateChanged();
                };

                syncAge();
                birthDateInput.addEventListener("change", syncAge);
                birthDateInput.addEventListener("input", syncAge);
            }

            if (municipioSelect && municipioSelect.value) {
                const barrioInicial = barrioSelect ? (barrioSelect.value || "") : "";

                applyMunicipalityDefaults(municipioSelect.value, barrioInicial, "");
                loadBarriosByMunicipio(municipioSelect.value, "a", barrioInicial);
            }

            if (serverSuccessMessage) {
                showFeedbackModal(
                    "Guardado exitoso",
                    `<p class="mb-0">${escapeHtml(serverSuccessMessage)}</p>`,
                    "success");
            }

            // ── Prorroga section ──────────────────────────────────────────
            {
                const prorrogaTabLink = document.querySelector('[data-censo-tab="tab-agudos-prorroga"]');
                const prorrogaMed2Toggle = document.getElementById("prorrogaTieneSegundoMed");
                const prorrogaMed2Container = document.getElementById("prorrogaMed2Container");
                const prorrogaMed3Toggle = document.getElementById("prorrogaTieneTercerMed");
                const prorrogaMed3Container = document.getElementById("prorrogaMed3Container");
                const prorrogaMed4Toggle = document.getElementById("prorrogaTieneCuartoMed");
                const prorrogaMed4Container = document.getElementById("prorrogaMed4Container");
                const prorrogaMed5Toggle = document.getElementById("prorrogaTieneQuintoMed");
                const prorrogaMed5Container = document.getElementById("prorrogaMed5Container");
                const prorrogaMed6Toggle = document.getElementById("prorrogaTieneSextoMed");
                const prorrogaMed6Container = document.getElementById("prorrogaMed6Container");
                const prorrogaAplicacionesInput = document.getElementById("prorrogaAplicacionesTotales");
                const prorrogaDiasIvInput = document.getElementById("prorrogaDiasTratamientoIv");
                const prorrogaFechaInicioInput = document.getElementById("prorrogaFechaInicio");
                const prorrogaFechaFinInput = document.getElementById("prorrogaFechaFin");
                const prorrogaGuardadoStatus = document.getElementById("prorrogaGuardadoStatus");
                const guardarProrrogaBtn = document.getElementById("guardarProrrogaBtn");
                let prorrogaDataLoaded = false;

                const getProrrogaInputValue = (id) => (document.getElementById(id)?.value || "").trim();

                const syncProrrogaDiasIv = () => {
                    if (!prorrogaDiasIvInput) return;
                    const d1 = getMedicationDaysValue(document.getElementById("prorrogaDiasMedPrincipal"));
                    const d2 = prorrogaMed2Toggle?.checked ? getMedicationDaysValue(document.getElementById("prorrogaDiasMed2")) : 0;
                    const d3 = prorrogaMed3Toggle?.checked ? getMedicationDaysValue(document.getElementById("prorrogaDiasMed3")) : 0;
                    const d4 = prorrogaMed4Toggle?.checked ? getMedicationDaysValue(document.getElementById("prorrogaDiasMed4")) : 0;
                    const d5 = prorrogaMed5Toggle?.checked ? getMedicationDaysValue(document.getElementById("prorrogaDiasMed5")) : 0;
                    const d6 = prorrogaMed6Toggle?.checked ? getMedicationDaysValue(document.getElementById("prorrogaDiasMed6")) : 0;
                    const max = Math.max(d1, d2, d3, d4, d5, d6);
                    prorrogaDiasIvInput.value = max > 0 ? String(max) : "";
                };

                const getProrrogaWinningFreq = () => {
                    const meds = [
                        { days: getMedicationDaysValue(document.getElementById("prorrogaDiasMedPrincipal")), freq: getProrrogaInputValue("prorrogaFrecuenciaMedPrincipal") },
                    ];
                    if (prorrogaMed2Toggle?.checked) meds.push({ days: getMedicationDaysValue(document.getElementById("prorrogaDiasMed2")), freq: getProrrogaInputValue("prorrogaFrecuenciaMed2") });
                    if (prorrogaMed3Toggle?.checked) meds.push({ days: getMedicationDaysValue(document.getElementById("prorrogaDiasMed3")), freq: getProrrogaInputValue("prorrogaFrecuenciaMed3") });
                    if (prorrogaMed4Toggle?.checked) meds.push({ days: getMedicationDaysValue(document.getElementById("prorrogaDiasMed4")), freq: getProrrogaInputValue("prorrogaFrecuenciaMed4") });
                    if (prorrogaMed5Toggle?.checked) meds.push({ days: getMedicationDaysValue(document.getElementById("prorrogaDiasMed5")), freq: getProrrogaInputValue("prorrogaFrecuenciaMed5") });
                    if (prorrogaMed6Toggle?.checked) meds.push({ days: getMedicationDaysValue(document.getElementById("prorrogaDiasMed6")), freq: getProrrogaInputValue("prorrogaFrecuenciaMed6") });
                    return meds.reduce((best, m) => m.days > best.days ? m : best, { days: 0, freq: "" }).freq;
                };

                const syncProrrogaFechaFin = () => {
                    if (!prorrogaFechaInicioInput || !prorrogaFechaFinInput || !prorrogaDiasIvInput) return;
                    const startDate = parseIsoDateInputValue(prorrogaFechaInicioInput.value);
                    const days = Number.parseInt(prorrogaDiasIvInput.value || "0", 10);
                    if (!startDate || !Number.isFinite(days) || days < 1) {
                        prorrogaFechaFinInput.value = "";
                        return;
                    }
                    const offset = is24HorasFrecuencia(getProrrogaWinningFreq()) ? days - 1 : days;
                    const endDate = new Date(startDate);
                    endDate.setDate(endDate.getDate() + offset);
                    prorrogaFechaFinInput.value = endDate.toISOString().slice(0, 10);
                };

                const syncProrrogaAplicaciones = () => {
                    if (!prorrogaAplicacionesInput) return;
                    const freq1 = getProrrogaInputValue("prorrogaFrecuenciaMedPrincipal");
                    let total = calculateMedicationApplicationsByFrequency(freq1, document.getElementById("prorrogaDiasMedPrincipal"));
                    if (prorrogaMed2Toggle?.checked) {
                        total += calculateMedicationApplicationsByFrequency(getProrrogaInputValue("prorrogaFrecuenciaMed2"), document.getElementById("prorrogaDiasMed2"));
                    }
                    if (prorrogaMed3Toggle?.checked) {
                        total += calculateMedicationApplicationsByFrequency(getProrrogaInputValue("prorrogaFrecuenciaMed3"), document.getElementById("prorrogaDiasMed3"));
                    }
                    if (prorrogaMed4Toggle?.checked) {
                        total += calculateMedicationApplicationsByFrequency(getProrrogaInputValue("prorrogaFrecuenciaMed4"), document.getElementById("prorrogaDiasMed4"));
                    }
                    if (prorrogaMed5Toggle?.checked) {
                        total += calculateMedicationApplicationsByFrequency(getProrrogaInputValue("prorrogaFrecuenciaMed5"), document.getElementById("prorrogaDiasMed5"));
                    }
                    if (prorrogaMed6Toggle?.checked) {
                        total += calculateMedicationApplicationsByFrequency(getProrrogaInputValue("prorrogaFrecuenciaMed6"), document.getElementById("prorrogaDiasMed6"));
                    }
                    prorrogaAplicacionesInput.value = total > 0 ? String(total) : "";
                    syncProrrogaDiasIv();
                    syncProrrogaFechaFin();
                };

                const collectProrrogaPayload = () => ({
                    tipoProrroga: (document.querySelector("input[name='prorroga-tipo']:checked")?.value || ""),
                    seguimientoMedico: (document.querySelector("input[name='prorroga-seguimiento-medico']:checked")?.value || ""),
                    nombreMedicamentoPrincipal: getProrrogaInputValue("prorrogaNombreMedPrincipal"),
                    dosisMedicamentoPrincipal: getProrrogaInputValue("prorrogaDosisMedPrincipal"),
                    medidaMedicamentoPrincipal: getProrrogaInputValue("prorrogaMedidaMedPrincipal"),
                    viaAdministracionMedicamentoPrincipal: getProrrogaInputValue("prorrogaViaMedPrincipal"),
                    frecuenciaAdministracionMxPrincipal: getProrrogaInputValue("prorrogaFrecuenciaMedPrincipal"),
                    diasMedicamentoPrincipal: getProrrogaInputValue("prorrogaDiasMedPrincipal"),
                    tieneSegundoMedicamento: !!(prorrogaMed2Toggle?.checked),
                    nombreMedicamentoNumero2: getProrrogaInputValue("prorrogaNombreMed2"),
                    dosisMedicamento2: getProrrogaInputValue("prorrogaDosisMed2"),
                    medidaMedicamento2: getProrrogaInputValue("prorrogaMedidaMed2"),
                    viaAdministracionMedicamento2: getProrrogaInputValue("prorrogaViaMed2"),
                    frecuenciaAdministracionMedicamento2: getProrrogaInputValue("prorrogaFrecuenciaMed2"),
                    diasMedicamento2: getProrrogaInputValue("prorrogaDiasMed2"),
                    tieneTercerMedicamento: !!(prorrogaMed3Toggle?.checked),
                    nombreMedicamentoNumero3: getProrrogaInputValue("prorrogaNombreMed3"),
                    dosisMedicamento3: getProrrogaInputValue("prorrogaDosisMed3"),
                    medidaMedicamento3: getProrrogaInputValue("prorrogaMedidaMed3"),
                    viaAdministracionMedicamento3: getProrrogaInputValue("prorrogaViaMed3"),
                    frecuenciaAdministracionMedicamento3: getProrrogaInputValue("prorrogaFrecuenciaMed3"),
                    diasMedicamento3: getProrrogaInputValue("prorrogaDiasMed3"),
                    tieneCuartoMedicamento: !!(prorrogaMed4Toggle?.checked),
                    nombreMedicamentoNumero4: getProrrogaInputValue("prorrogaNombreMed4"),
                    dosisMedicamento4: getProrrogaInputValue("prorrogaDosisMed4"),
                    medidaMedicamento4: getProrrogaInputValue("prorrogaMedidaMed4"),
                    viaAdministracionMedicamento4: getProrrogaInputValue("prorrogaViaMed4"),
                    frecuenciaAdministracionMedicamento4: getProrrogaInputValue("prorrogaFrecuenciaMed4"),
                    diasMedicamento4: getProrrogaInputValue("prorrogaDiasMed4"),
                    tieneQuintoMedicamento: !!(prorrogaMed5Toggle?.checked),
                    nombreMedicamentoNumero5: getProrrogaInputValue("prorrogaNombreMed5"),
                    dosisMedicamento5: getProrrogaInputValue("prorrogaDosisMed5"),
                    medidaMedicamento5: getProrrogaInputValue("prorrogaMedidaMed5"),
                    viaAdministracionMedicamento5: getProrrogaInputValue("prorrogaViaMed5"),
                    frecuenciaAdministracionMedicamento5: getProrrogaInputValue("prorrogaFrecuenciaMed5"),
                    diasMedicamento5: getProrrogaInputValue("prorrogaDiasMed5"),
                    tieneSextoMedicamento: !!(prorrogaMed6Toggle?.checked),
                    nombreMedicamentoNumero6: getProrrogaInputValue("prorrogaNombreMed6"),
                    dosisMedicamento6: getProrrogaInputValue("prorrogaDosisMed6"),
                    medidaMedicamento6: getProrrogaInputValue("prorrogaMedidaMed6"),
                    viaAdministracionMedicamento6: getProrrogaInputValue("prorrogaViaMed6"),
                    frecuenciaAdministracionMedicamento6: getProrrogaInputValue("prorrogaFrecuenciaMed6"),
                    diasMedicamento6: getProrrogaInputValue("prorrogaDiasMed6"),
                    aplicacionesTotales: getProrrogaInputValue("prorrogaAplicacionesTotales"),
                    diasTratamientoIv: getProrrogaInputValue("prorrogaDiasTratamientoIv"),
                    fechaInicioTratamiento: getProrrogaInputValue("prorrogaFechaInicio"),
                    fechaFinTratamiento: getProrrogaInputValue("prorrogaFechaFin"),
                    fechaPromesaInicioTto: getProrrogaInputValue("prorrogaFechaPromesa"),
                    horaPromesaDesde: getProrrogaInputValue("prorrogaHoraDesde"),
                    horaPromesaHasta: getProrrogaInputValue("prorrogaHoraHasta"),
                    auxiliarAsignado: getProrrogaInputValue("prorrogaAuxiliarAsignado"),
                    numeroDiasExtension: getProrrogaInputValue("prorrogaNumeroDiasExtension"),
                    notificadoAsegurador: !!(document.getElementById("prorrogaNotificadoAsegurador")?.checked),
                });

                loadProrrogaPayload = (data) => {
                    if (!data) return;
                    const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ""; };
                    const setToggle = (toggle, container, flag) => {
                        if (toggle) {
                            toggle.checked = !!flag;
                            container?.classList.toggle("d-none", !flag);
                        }
                    };
                    set("prorrogaNombreMedPrincipal", data.nombreMedicamentoPrincipal);
                    set("prorrogaDosisMedPrincipal", data.dosisMedicamentoPrincipal);
                    set("prorrogaMedidaMedPrincipal", data.medidaMedicamentoPrincipal);
                    set("prorrogaViaMedPrincipal", data.viaAdministracionMedicamentoPrincipal);
                    set("prorrogaFrecuenciaMedPrincipal", data.frecuenciaAdministracionMxPrincipal);
                    set("prorrogaDiasMedPrincipal", data.diasMedicamentoPrincipal);
                    setToggle(prorrogaMed2Toggle, prorrogaMed2Container, data.tieneSegundoMedicamento);
                    set("prorrogaNombreMed2", data.nombreMedicamentoNumero2);
                    set("prorrogaDosisMed2", data.dosisMedicamento2);
                    set("prorrogaMedidaMed2", data.medidaMedicamento2);
                    set("prorrogaViaMed2", data.viaAdministracionMedicamento2);
                    set("prorrogaFrecuenciaMed2", data.frecuenciaAdministracionMedicamento2);
                    set("prorrogaDiasMed2", data.diasMedicamento2);
                    setToggle(prorrogaMed3Toggle, prorrogaMed3Container, data.tieneTercerMedicamento);
                    set("prorrogaNombreMed3", data.nombreMedicamentoNumero3);
                    set("prorrogaDosisMed3", data.dosisMedicamento3);
                    set("prorrogaMedidaMed3", data.medidaMedicamento3);
                    set("prorrogaViaMed3", data.viaAdministracionMedicamento3);
                    set("prorrogaFrecuenciaMed3", data.frecuenciaAdministracionMedicamento3);
                    set("prorrogaDiasMed3", data.diasMedicamento3);
                    setToggle(prorrogaMed4Toggle, prorrogaMed4Container, data.tieneCuartoMedicamento);
                    set("prorrogaNombreMed4", data.nombreMedicamentoNumero4);
                    set("prorrogaDosisMed4", data.dosisMedicamento4);
                    set("prorrogaMedidaMed4", data.medidaMedicamento4);
                    set("prorrogaViaMed4", data.viaAdministracionMedicamento4);
                    set("prorrogaFrecuenciaMed4", data.frecuenciaAdministracionMedicamento4);
                    set("prorrogaDiasMed4", data.diasMedicamento4);
                    setToggle(prorrogaMed5Toggle, prorrogaMed5Container, data.tieneQuintoMedicamento);
                    set("prorrogaNombreMed5", data.nombreMedicamentoNumero5);
                    set("prorrogaDosisMed5", data.dosisMedicamento5);
                    set("prorrogaMedidaMed5", data.medidaMedicamento5);
                    set("prorrogaViaMed5", data.viaAdministracionMedicamento5);
                    set("prorrogaFrecuenciaMed5", data.frecuenciaAdministracionMedicamento5);
                    set("prorrogaDiasMed5", data.diasMedicamento5);
                    setToggle(prorrogaMed6Toggle, prorrogaMed6Container, data.tieneSextoMedicamento);
                    set("prorrogaNombreMed6", data.nombreMedicamentoNumero6);
                    set("prorrogaDosisMed6", data.dosisMedicamento6);
                    set("prorrogaMedidaMed6", data.medidaMedicamento6);
                    set("prorrogaViaMed6", data.viaAdministracionMedicamento6);
                    set("prorrogaFrecuenciaMed6", data.frecuenciaAdministracionMedicamento6);
                    set("prorrogaDiasMed6", data.diasMedicamento6);
                    set("prorrogaAplicacionesTotales", data.aplicacionesTotales);
                    set("prorrogaDiasTratamientoIv", data.diasTratamientoIv);
                    set("prorrogaFechaInicio", data.fechaInicioTratamiento);
                    set("prorrogaFechaFin", data.fechaFinTratamiento);
                    set("prorrogaFechaPromesa", data.fechaPromesaInicioTto);
                    set("prorrogaHoraDesde", data.horaPromesaDesde);
                    set("prorrogaHoraHasta", data.horaPromesaHasta);
                    set("prorrogaAuxiliarAsignado", data.auxiliarAsignado);
                    if (data.tipoProrroga) {
                        const tipoRadio = document.querySelector(`input[name='prorroga-tipo'][value='${data.tipoProrroga}']`);
                        if (tipoRadio) tipoRadio.checked = true;
                    }
                    document.getElementById("prorrogaExtensionContainer")?.classList.toggle("d-none", data.tipoProrroga !== "extension");
                    if (data.seguimientoMedico) {
                        const segRadio = document.querySelector(`input[name='prorroga-seguimiento-medico'][value='${data.seguimientoMedico}']`);
                        if (segRadio) segRadio.checked = true;
                    }
                    set("prorrogaNumeroDiasExtension", data.numeroDiasExtension);
                    const notifEl = document.getElementById("prorrogaNotificadoAsegurador");
                    if (notifEl) notifEl.checked = !!data.notificadoAsegurador;
                };

                document.querySelectorAll("input[name='prorroga-tipo']").forEach((radio) => {
                    radio.addEventListener("change", () => {
                        const isExtension = document.querySelector("input[name='prorroga-tipo']:checked")?.value === "extension";
                        document.getElementById("prorrogaExtensionContainer")?.classList.toggle("d-none", !isExtension);
                    });
                });

                const wireProrrogaMedToggle = (toggle, container) => {
                    if (toggle) {
                        toggle.addEventListener("change", () => {
                            container?.classList.toggle("d-none", !toggle.checked);
                            syncProrrogaAplicaciones();
                            syncProrrogaMedicamentoValidation(false);
                        });
                    }
                };
                wireProrrogaMedToggle(prorrogaMed2Toggle, prorrogaMed2Container);
                wireProrrogaMedToggle(prorrogaMed3Toggle, prorrogaMed3Container);
                wireProrrogaMedToggle(prorrogaMed4Toggle, prorrogaMed4Container);
                wireProrrogaMedToggle(prorrogaMed5Toggle, prorrogaMed5Container);
                wireProrrogaMedToggle(prorrogaMed6Toggle, prorrogaMed6Container);

                ["prorrogaFrecuenciaMedPrincipal", "prorrogaDiasMedPrincipal",
                 "prorrogaFrecuenciaMed2", "prorrogaDiasMed2",
                 "prorrogaFrecuenciaMed3", "prorrogaDiasMed3",
                 "prorrogaFrecuenciaMed4", "prorrogaDiasMed4",
                 "prorrogaFrecuenciaMed5", "prorrogaDiasMed5",
                 "prorrogaFrecuenciaMed6", "prorrogaDiasMed6"].forEach((id) => {
                    document.getElementById(id)?.addEventListener("change", syncProrrogaAplicaciones);
                    document.getElementById(id)?.addEventListener("input", syncProrrogaAplicaciones);
                });

                if (prorrogaFechaInicioInput) {
                    prorrogaFechaInicioInput.addEventListener("change", syncProrrogaFechaFin);
                }

                const refreshProrrogaSection = async (preferLatest = false) => {
                    const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                    if (recordId <= 0) return;
                    await loadDocumentosState(recordId);
                    renderProrrogaVersionOptions(preferLatest);
                    prorrogaDataLoaded = true;
                    activeProrrogaIsNewAdditional = false;
                    loadSelectedProrrogaIntoForm();
                    if (kardexModal?.classList.contains("show")) {
                        setDocumentClosedMode(isActiveDocumentClosed());
                        updateReaperturaControls();
                    }
                };

                if (prorrogaTabLink) {
                    prorrogaTabLink.addEventListener("click", async () => {
                        try {
                            await refreshProrrogaSection(true);
                        } catch { }
                    });
                }

                refreshProrrogaSection(true).catch(() => { });

                if (prorrogaVersionSelect) {
                    prorrogaVersionSelect.addEventListener("change", () => {
                        activeProrrogaVersionId = prorrogaVersionSelect.value || null;
                        activeProrrogaIsNewAdditional = false;
                        loadSelectedProrrogaIntoForm();
                    });
                }

                if (adicionalProrrogaBtn) {
                    adicionalProrrogaBtn.addEventListener("click", () => {
                        const modalEl = document.getElementById("censoAdicionalProrrogaConfirmModal");
                        if (window.bootstrap && window.bootstrap.Modal && modalEl) {
                            window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
                            return;
                        }

                        activeProrrogaIsNewAdditional = true;
                        activeProrrogaVersionId = null;
                        if (prorrogaVersionSelect) prorrogaVersionSelect.value = "";
                        clearProrrogaForm();
                        updateProrrogaReadonlyMode();
                    });
                }

                if (confirmarAdicionalProrrogaBtn) {
                    confirmarAdicionalProrrogaBtn.addEventListener("click", () => {
                        const modalEl = document.getElementById("censoAdicionalProrrogaConfirmModal");
                        if (window.bootstrap && window.bootstrap.Modal && modalEl) {
                            window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                        }

                        activeProrrogaIsNewAdditional = true;
                        activeProrrogaVersionId = null;
                        if (prorrogaVersionSelect) prorrogaVersionSelect.value = "";
                        clearProrrogaForm();
                        updateProrrogaReadonlyMode();
                    });
                }

                if (guardarProrrogaBtn) {
                    guardarProrrogaBtn.addEventListener("click", async () => {
                        const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                        if (recordId <= 0) {
                            showFeedbackModal("Sin paciente activo", "<p class=\"mb-0\">Primero guarda el paciente antes de guardar la prórroga.</p>", "warning");
                            return;
                        }

                        const invalidProrrogaMedicamentos = syncProrrogaMedicamentoValidation(true);
                        if (invalidProrrogaMedicamentos.length > 0) {
                            invalidProrrogaMedicamentos[0].input?.focus();
                            showFeedbackModal(
                                "Medicamento no válido",
                                "<p class=\"mb-0\">Selecciona los medicamentos de la prórroga desde el listado de sugerencias.</p>",
                                "warning");
                            return;
                        }

                        guardarProrrogaBtn.disabled = true;
                        if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "Guardando...";
                        try {
                            const formData = new FormData();
                            formData.append("id", String(recordId));
                            formData.append("prorrogaJson", JSON.stringify(collectProrrogaPayload()));
                            if (activeProrrogaVersionId) {
                                formData.append("prorrogaVersionId", String(activeProrrogaVersionId));
                            }
                            if (activeProrrogaIsNewAdditional) {
                                formData.append("adicionalProrroga", "true");
                            }
                            if (csrfTokenInput) formData.append("__RequestVerificationToken", csrfTokenInput.value);
                            const resp = await fetch(guardarProrrogaUrl, { method: "POST", body: formData });
                            const result = await resp.json().catch(() => ({}));
                            if (!resp.ok) {
                                showFeedbackModal("No se pudo guardar", `<p class="mb-0">${escapeHtml(result.message || "Error al guardar la prórroga.")}</p>`, "danger");
                                if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "";
                                return;
                            }
                            if (result.prorrogaId) {
                                activeProrrogaVersionId = String(result.prorrogaId);
                                activeProrrogaIsNewAdditional = false;
                                await loadDocumentosState(recordId);
                                renderProrrogaVersionOptions();
                                updateProrrogaReadonlyMode();
                            }
                            if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "Guardado ✓";
                            window.setTimeout(() => { if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = ""; }, 3000);
                        } catch {
                            showFeedbackModal("Error de conexión", "<p class=\"mb-0\">No se pudo conectar al servidor.</p>", "danger");
                            if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "";
                        } finally {
                            const prorrogaCerrada = !activeProrrogaIsNewAdditional && !!getActiveProrroga()?.cerrada;
                            guardarProrrogaBtn.disabled = prorrogaCerrada;
                        }
                    });
                }
            }
            // ── End prorroga section ──────────────────────────────────────

            const requestedCensoSection = new URLSearchParams(window.location.search).get("abrirSeccion");
            if (requestedCensoSection === "estado") {
                window.setTimeout(() => {
                    openSectionTab("tab-agudos-plan-manejo");
                    window.setTimeout(() => {
                        estadoSelect?.scrollIntoView({ behavior: "smooth", block: "center" });
                        estadoSelect?.focus();
                    }, 250);
                }, 100);
            } else if (requestedCensoSection === "prorroga") {
                window.setTimeout(() => {
                    openSectionTab("tab-agudos-prorroga");
                    window.setTimeout(() => {
                        prorrogaTabPane?.scrollIntoView({ behavior: "smooth", block: "start" });
                    }, 250);
                }, 100);
            }

            if (shouldShowSaveErrorModal) {
                const normalizedErrors = Array.from(new Set((serverErrorMessages || [])
                    .map((error) => String(error || "").trim())
                    .filter((error) => error.length > 0)));
                const missingSections = Array.from(new Set((serverMissingMandatorySections || [])
                    .map((section) => String(section || "").trim())
                    .filter((section) => section.length > 0)));

                let bodyHtml = "";
                if (missingSections.length > 0) {
                    const missingDetails = getMissingMandatoryDetailsOnClient()
                        .filter((section) => missingSections.includes(section.name));

                    bodyHtml += missingDetails.length > 0
                        ? `<p class="mb-2">Faltan campos obligatorios por diligenciar:</p>${buildMissingMandatoryDetailsHtml(missingDetails)}`
                        : `<p class="mb-2">Faltan secciones obligatorias por diligenciar:</p>${buildListHtml(missingSections)}`;
                }

                const generalErrors = normalizedErrors
                    .filter((error) => !error.toLowerCase().startsWith("para guardar el censo debes completar"))
                    .slice(0, 10);

                if (generalErrors.length > 0) {
                    bodyHtml += `${bodyHtml ? "<p class=\"mt-3 mb-2\">Revisa tambien:</p>" : "<p class=\"mb-2\">Se encontraron errores de validacion:</p>"}${buildListHtml(generalErrors)}`;
                }

                if (!bodyHtml) {
                    bodyHtml = "<p class=\"mb-0\">No se pudo guardar el registro. Revisa la información del formulario.</p>";
                }

                showFeedbackModal("No se pudo guardar el censo", bodyHtml, "danger");

                if (missingSections.length > 0) {
                    const firstMissingSection = mandatorySectionsConfig.find((section) => section.name === missingSections[0]);
                    if (firstMissingSection) {
                        openSectionTab(firstMissingSection.seccionId);
                    }

                    if (missingSections.includes("Sección 3 - Plan de manejo")) {
                        censoSaveAttempted = true;
                        syncSection3RequiredMessages();
                    }
                }
            }
        })();
    </script>
