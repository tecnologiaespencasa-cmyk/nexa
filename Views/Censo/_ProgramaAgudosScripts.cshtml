                const label = getRequiredFieldLabel(fieldName);
                const control = getFieldControl(fieldName);
                const tagName = String(control?.tagName || "").toUpperCase();

                if (tagName === "SELECT") {
                    return `Selecciona ${toSentenceLabel(label)}.`;
                }

                return `${label} es obligatorio.`;
            };

            const setClientRequiredMessage = (fieldName) => {
                const messageElement = getFieldValidationMessageElement(fieldName);
                if (!messageElement) {
                    return;
                }

                messageElement.textContent = buildRequiredFieldMessage(fieldName);
                messageElement.classList.remove("field-validation-valid");
                messageElement.classList.add("field-validation-error", "text-danger");
            };

            const clearClientRequiredMessage = (fieldName) => {
                const messageElement = getFieldValidationMessageElement(fieldName);
                if (!messageElement) {
                    return;
                }

                const currentMessage = String(messageElement.textContent || "").trim();
                const requiredMessage = buildRequiredFieldMessage(fieldName);
                if (currentMessage && currentMessage !== requiredMessage) {
                    return;
                }

                messageElement.textContent = "";
                messageElement.classList.remove("field-validation-error");
                messageElement.classList.add("field-validation-valid");
            };

