                    measure: getFormValue("MedidaMedicamento4"),
                    route: getFormValue("ViaAdministracionMedicamento4"),
                    frequency: getFormValue("FrecuenciaAdministracionMedicamento4"),
                    days: getFormValue("DiasMedicamento4"),
                    startDate: fechaInicio,
                    endDate: fechaFin
                });

                syncKardexMedicationRow(5, {
                    name: getFormValue("NombreMedicamentoNumero5"),
                    dose: getFormValue("DosisMedicamento5"),
                    measure: getFormValue("MedidaMedicamento5"),
                    route: getFormValue("ViaAdministracionMedicamento5"),
                    frequency: getFormValue("FrecuenciaAdministracionMedicamento5"),
