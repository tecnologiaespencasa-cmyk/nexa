            const precargaDocumentoInput = document.getElementById("precargaDocumentoInput");
            const validarPrecargaBtn = document.getElementById("validarPrecargaBtn");
            const precargaMensaje = document.getElementById("precargaMensaje");

            const applyPrecargaData = async (data) => {
                const setVal = (el, value) => {
                    if (!el) return;
                    el.value = value ?? "";
                    el.dispatchEvent(new Event("input", { bubbles: true }));
                    el.dispatchEvent(new Event("change", { bubbles: true }));
                };

                setVal(document.getElementById("NombrePaciente"), data.nombrePaciente);
                setVal(document.getElementById("TipoIdentificacion"), data.tipoIdentificacion);
                setVal(document.getElementById("NumeroIdentificacion"), data.numeroIdentificacion);
                setVal(document.getElementById("fechaNacimientoInput"), data.fechaNacimiento);
                setVal(document.getElementById("CorreoElectronico"), data.correoElectronico);

                if (codigoCie10Input) codigoCie10Input.value = data.codigoCie10 ?? "";
                if (diagnosticoDescriptivoInput) diagnosticoDescriptivoInput.value = data.diagnosticoDescriptivo ?? "";

                setVal(document.getElementById("direccionInput"), data.direccion);
                setVal(document.getElementById("DetalleDireccion"), data.detalleDireccion);

                if (data.municipioResidencia && municipioSelect) {
                    municipioSelect.value = data.municipioResidencia;
                    await loadBarriosByMunicipio(data.municipioResidencia, data.barrio || "a", data.barrio, false);
                }

                if (data.barrio && barrioSelect) {
                    if (!Array.from(barrioSelect.options).some((o) => o.value === data.barrio)) {
                        const opt = document.createElement("option");
                        opt.value = data.barrio;
                        opt.textContent = data.barrio;
                        barrioSelect.appendChild(opt);
                    }
                    barrioSelect.value = data.barrio;
                }

                if (clasificacionSelect && data.clasificacionZonaSura) clasificacionSelect.value = data.clasificacionZonaSura;
                if (zonaSelect && data.zonaDireccionSegunMunicipio) zonaSelect.value = data.zonaDireccionSegunMunicipio;
                if (areaSelect && data.area) areaSelect.value = data.area;

                if (data.telefono1) setVal(document.getElementById("telefono1Input"), data.telefono1);
                if (data.telefono2) {
                    const t2c = document.getElementById("telefono2Container");
                    if (t2c) t2c.classList.remove("d-none");
                    setVal(document.getElementById("telefono2Input"), data.telefono2);
                }
                if (data.telefono3) {
                    const t3c = document.getElementById("telefono3Container");
                    if (t3c) t3c.classList.remove("d-none");
                    setVal(document.getElementById("telefono3Input"), data.telefono3);
                }
            };

            if (validarPrecargaBtn && precargaDocumentoInput) {
