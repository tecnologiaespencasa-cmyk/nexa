                            "warning");
                        return;
                    }

                    if (!syncAuxiliarAsignadoValidation(true)) {
                        event.preventDefault();
                        openSectionTab("tab-agudos-plan-manejo");
                        showFeedbackModal(
                            "Auxiliar asignado no válido",
                            "<p class=\"mb-0\">Selecciona un auxiliar asignado del listado de sugerencias.</p>",
                            "warning");
