                section3MedicamentoEntries.forEach((entry) => {
                    if (!entry.input || !entry.isActive()) {
                        clearSection3MedicamentoValidationMessage(entry.fieldName);
                        return;
                    }

                    const value = String(entry.input.value || "").trim();
                    const canonicalValue = getCanonicalMedicamentoValue(value);
                    if (canonicalValue) {
                        entry.input.value = canonicalValue;
                        clearSection3MedicamentoValidationMessage(entry.fieldName);
                        return;
                    }

                    if (!value) {
                        clearSection3MedicamentoValidationMessage(entry.fieldName);
                        return;
                    }

                    invalidEntries.push(entry);
                    if (showInvalidMessage) {
                        setSection3MedicamentoValidationMessage(entry.fieldName);
                    }
                });

                return invalidEntries;
            };

            const syncProrrogaMedicamentoValidation = (showInvalidMessage = false) => {
