                if (medicamento2Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento2Input), freq: frecuenciaMedicamento2Select?.value || "" });
                if (medicamento3Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento3Input), freq: frecuenciaMedicamento3Select?.value || "" });
                if (medicamento4Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento4Input), freq: frecuenciaMedicamento4Select?.value || "" });
                if (medicamento5Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento5Input), freq: frecuenciaMedicamento5Select?.value || "" });
                if (medicamento6Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento6Input), freq: frecuenciaMedicamento6Select?.value || "" });
                return meds.reduce((best, m) => m.days > best.days ? m : best, { days: 0, freq: "" }).freq;
            };

            const isCambioFrecuenciaActivo = () =>
