            const escapeHtml = (value) => {
                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;");
            };

            const alphanumericIdentificationTypes = new Set(["PA", "CE"]);
            const normalizeDocumentValue = (value) => String(value || "")
                .toUpperCase()
                .replace(/[^A-Z0-9]/g, "")
                .trim();
            const normalizeAddressForComparison = (value) => String(value || "")
                .trim()
                .replace(/\s+/g, " ")
                .toLocaleUpperCase("es-CO");
            const normalizeCedulaFilter = (value) => normalizeDocumentValue(value);
            const allowsAlphaNumericIdentification = (value) => alphanumericIdentificationTypes.has(String(value || "").trim().toUpperCase());
            const syncNumeroIdentificacionMode = () => {
                if (!numeroIdentificacionInput) {
                    return;
                }

                const allowAlphaNumeric = allowsAlphaNumericIdentification(tipoIdentificacionSelect ? tipoIdentificacionSelect.value : "");
                numeroIdentificacionInput.setAttribute("inputmode", allowAlphaNumeric ? "text" : "numeric");
                numeroIdentificacionInput.title = allowAlphaNumeric
                    ? "Permite letras y números para PA o CE."
                    : "Solo permite dígitos para este tipo de identificación.";

                const currentValue = String(numeroIdentificacionInput.value || "").toUpperCase();
                numeroIdentificacionInput.value = allowAlphaNumeric
                    ? currentValue.replace(/[^A-Z0-9]/g, "").slice(0, 20)
                    : currentValue.replace(/\D/g, "").slice(0, 20);
            };

            const normalizeMedicationKey = (value) => String(value || "")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toUpperCase()
                .replace(/[^A-Z0-9]+/g, " ")
                .trim()
                .replace(/\s+/g, " ");

            const normalizeCatalogOptionKey = (value) => normalizeMedicationKey(value);

            const medicamentoCatalogByName = new Map();
            (Array.isArray(medicamentoCatalog) ? medicamentoCatalog : []).forEach((item) => {
                const keys = [
                    normalizeCatalogOptionKey(item?.Nombre),
                    normalizeCatalogOptionKey(item?.NormalizedNombre)
                ].filter((key) => key);

                keys.forEach((key) => {
                    if (!medicamentoCatalogByName.has(key)) {
                        medicamentoCatalogByName.set(key, item);
                    }
                });
            });

            const getFormControlByName = (name) => form ? form.querySelector(`[name='${name}']`) : null;

            const getFormValue = (name) => {
                const control = getFormControlByName(name);
                return control ? String(control.value || "").trim() : "";
            };

            const setKardexFieldValue = (field, value) => {
                const control = document.querySelector(`#censoKardexModal [data-kardex-field='${field}']`);
                if (control) {
                    control.value = value || "";
                }
            };

            const formatDateForKardex = (value) => {
                if (!value) {
                    return "";
                }

                const parts = String(value).split("-");
                if (parts.length !== 3) {
                    return value;
                }

                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            };

            const buildMedicationDoseText = (medication) => {
                const doseParts = [
                    medication.dose,
                    medication.measure
                ].filter((part) => part);

                return [
                    medication.name,
                    doseParts.join(" "),
                    medication.route,
                    medication.frequency,
                    medication.days ? `POR ${medication.days} DIAS` : ""
                ]
                    .filter((part) => part)
                    .join(" ")
                    .toUpperCase();
            };

            const catalogValue = (metadata, field) => metadata && metadata[field] ? String(metadata[field]).trim() : "";

            const formatInfusionTime = (metadata) => {
                const value = catalogValue(metadata, "TiempoInfusionMinutos");
                if (!value || /NO APLICA/i.test(value) || /ORDEN MEDICA/i.test(value)) {
                    return value;
                }

                return /^\d+([.,]\d+)?$/.test(value) ? `${value} MIN` : value;
            };

            const setKardexMedicationRowField = (row, field, value) => {
                const control = document.querySelector(`#censoKardexModal [data-kardex-med-row='${row}'] [data-kardex-med-field='${field}']`);
                if (control) {
                    control.value = value || "";
