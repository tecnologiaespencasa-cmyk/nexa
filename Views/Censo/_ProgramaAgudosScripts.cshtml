            const configureAltaModal = (authorizationError) => {
                altaModalIsAuthorizationError = authorizationError;
                if (authorizationError) {
                    if (altaModalTitle) altaModalTitle.textContent = "Autorización requerida";
                    if (altaModalMessage) altaModalMessage.textContent = "No se puede seleccionar un estado de alta sin diligenciar el campo Autorización evento.";
                    if (altaModalDetail) altaModalDetail.textContent = "Completa la autorización evento en la sección 3 e intenta nuevamente.";
                    altaModalCancelButton?.classList.add("d-none");
                    if (censoAltaConfirmarBtn) {
                        censoAltaConfirmarBtn.textContent = "Entendido";
                        censoAltaConfirmarBtn.classList.remove("btn-warning");
                        censoAltaConfirmarBtn.classList.add("btn-primary");
                    }
                    return;
                }

                if (altaModalTitle) altaModalTitle.textContent = "Cerrar atención";
                if (altaModalMessage) altaModalMessage.textContent = "La atención de este paciente será cerrada. ¿Estás seguro que deseas continuar?";
                if (altaModalDetail) altaModalDetail.textContent = "Las secciones 1, 2 y 3 quedarán bloqueadas en modo de solo lectura.";
                altaModalCancelButton?.classList.remove("d-none");
