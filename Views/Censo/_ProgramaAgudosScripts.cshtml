                });

                validarPrecargaBtn.addEventListener("click", async () => {
                    const doc = normalizeDocumentValue(precargaDocumentoInput.value);
                    precargaDocumentoInput.value = doc;
                    if (!doc) {
                        if (precargaMensaje) precargaMensaje.innerHTML = '<div class="alert alert-warning mb-0">Ingresa el número de documento.</div>';
                        return;
                    }
                    validarPrecargaBtn.disabled = true;
                    if (precargaMensaje) precargaMensaje.innerHTML = '<div class="text-muted">Buscando...</div>';
                    try {
                        const resp = await fetch(`${obtenerDatosSeccion2Url}?numeroDocumento=${encodeURIComponent(doc)}`);
                        const result = await resp.json();
                        if (!resp.ok) {
                            if (precargaMensaje) precargaMensaje.innerHTML = `<div class="alert alert-danger mb-0">${result.message ?? "Error al buscar el paciente."}</div>`;
                            return;
                        }
                        if (!result.found) {
                            if (precargaMensaje) precargaMensaje.innerHTML = `<div class="alert alert-info mb-0">${result.message}</div>`;
                            return;
                        }
                        await applyPrecargaData(result.data);
                        if (precargaMensaje) precargaMensaje.innerHTML = '<div class="alert alert-success mb-0">Datos precargados correctamente. Revisa y completa la sección 2.</div>';
                    } catch {
                        if (precargaMensaje) precargaMensaje.innerHTML = '<div class="alert alert-danger mb-0">Error de conexión al buscar el paciente.</div>';
                    } finally {
                        validarPrecargaBtn.disabled = false;
                    }
                });
            }

            const normalizeCie10InputValue = (value) => {
                const source = String(value || "").toUpperCase().replace(/[^A-Z0-9]/g, "");
                if (!source) {
                    return "";
                }

                const firstLetterIndex = source.search(/[A-Z]/);
                if (firstLetterIndex < 0) {
                    return "";
                }

                const trimmed = source.slice(firstLetterIndex);
                const letter = trimmed[0];
                const digits = trimmed.slice(1).replace(/\D/g, "").slice(0, 3);
                return `${letter}${digits}`;
            };

            const clearDiagnostico = () => {
                if (diagnosticoDescriptivoInput) {
                    diagnosticoDescriptivoInput.value = "";
                }
            };

            const lookupDiagnosticoByCie10 = async (codigo) => {
                if (!codigo || codigo.length !== 4 || !/^[A-Z][0-9]{3}$/.test(codigo)) {
                    lastCie10Lookup = "";
                    clearDiagnostico();
                    return;
                }

                if (codigo === lastCie10Lookup && diagnosticoDescriptivoInput && diagnosticoDescriptivoInput.value) {
                    return;
                }

                lastCie10Lookup = codigo;
                try {
                    const response = await fetch(`${buscarDiagnosticoCie10Url}?codigo=${encodeURIComponent(codigo)}`);
                    if (!response.ok) {
                        clearDiagnostico();
                        return;
                    }

                    const data = await response.json();
                    if (data && data.found && diagnosticoDescriptivoInput) {
                        diagnosticoDescriptivoInput.value = data.diagnostico || "";
                        return;
                    }

                    clearDiagnostico();
                } catch {
                    clearDiagnostico();
                }
            };

            if (codigoCie10Input) {
                const syncCie10Input = () => {
                    const normalized = normalizeCie10InputValue(codigoCie10Input.value);
                    if (codigoCie10Input.value !== normalized) {
                        codigoCie10Input.value = normalized;
                    }

                    if (cie10LookupTimer) {
                        clearTimeout(cie10LookupTimer);
                    }

                    if (normalized.length === 4) {
                        cie10LookupTimer = setTimeout(() => {
                            lookupDiagnosticoByCie10(normalized);
                        }, 200);
                    } else {
                        lastCie10Lookup = "";
                        clearDiagnostico();
                    }
                };

                codigoCie10Input.addEventListener("input", syncCie10Input);
                codigoCie10Input.addEventListener("blur", () => lookupDiagnosticoByCie10(normalizeCie10InputValue(codigoCie10Input.value)));
                syncCie10Input();
            }

            // ── Pan-American Life de Colombia: campos condicionales de la sección 3 ──
            const aseguradorSelect = document.getElementById("Asegurador");
            const panAmericanContainer = document.getElementById("panAmericanFieldsContainer");
            const panAmericanCartaSelect = document.getElementById("panAmericanCartaSelect");
            const panAmericanCartaContainer = document.getElementById("panAmericanCartaContainer");
            const panAmericanAdjuntosInput = document.getElementById("panAmericanAdjuntosInput");
            const panAmericanSubirAdjuntosBtn = document.getElementById("panAmericanSubirAdjuntosBtn");
            const panAmericanAdjuntosStatus = document.getElementById("panAmericanAdjuntosStatus");
            const panAmericanAdjuntosList = document.getElementById("panAmericanAdjuntosList");

            const isPanAmericanSelected = () =>
                String(aseguradorSelect?.value || "").trim().toUpperCase() === "PAN-AMERICAN LIFE DE COLOMBIA";

            const loadPanAmericanAdjuntos = async () => {
                if (!panAmericanAdjuntosList) return;
                const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                panAmericanAdjuntosList.innerHTML = "";
                if (recordId <= 0) return;
                try {
                    const resp = await fetch(`${obtenerAdjuntosPanAmericanUrl}?id=${recordId}`);
                    if (!resp.ok) return;
                    const data = await resp.json();
                    if (data.error) {
                        panAmericanAdjuntosList.innerHTML = `<li class="list-group-item small text-muted">${escapeHtml(data.error)}</li>`;
                        return;
                    }
                    (data.items || []).forEach((item) => {
                        const li = document.createElement("li");
                        li.className = "list-group-item py-1 px-2";
                        const link = document.createElement("a");
                        link.href = item.webUrl || "#";
                        link.target = "_blank";
                        link.rel = "noopener";
                        link.textContent = item.name || "Documento";
                        li.appendChild(link);
                        panAmericanAdjuntosList.appendChild(li);
                    });
                } catch { /* listado informativo; no bloquear */ }
            };

            const syncPanAmericanVisibility = () => {
                const showPanAmerican = isPanAmericanSelected();
                panAmericanContainer?.classList.toggle("d-none", !showPanAmerican);
                const showCarta = showPanAmerican
                    && String(panAmericanCartaSelect?.value || "").trim().toLowerCase() === "si";
                panAmericanCartaContainer?.classList.toggle("d-none", !showCarta);
                if (showCarta) loadPanAmericanAdjuntos();
