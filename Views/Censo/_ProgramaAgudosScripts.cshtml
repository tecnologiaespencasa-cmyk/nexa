                    const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                    if (recordId <= 0) {
                        showFeedbackModal("Guarda el paciente primero", "<p class=\"mb-0\">Debes guardar el registro del paciente antes de adjuntar documentos.</p>", "warning");
                        return;
                    }
                    const files = panAmericanAdjuntosInput?.files;
                    if (!files || files.length === 0) {
                        showFeedbackModal("Sin archivos", "<p class=\"mb-0\">Selecciona al menos un documento para adjuntar.</p>", "warning");
                        return;
                    }
                    panAmericanSubirAdjuntosBtn.disabled = true;
                    if (panAmericanAdjuntosStatus) panAmericanAdjuntosStatus.textContent = "Subiendo...";
                    try {
                        const formData = new FormData();
                        formData.append("id", String(recordId));
                        Array.from(files).forEach((file) => formData.append("files", file));
                        const resp = await fetch(subirAdjuntoPanAmericanUrl, {
                            method: "POST",
                            body: formData,
                            headers: csrfTokenInput?.value ? { "RequestVerificationToken": csrfTokenInput.value } : {}
                        });
                        const data = await resp.json().catch(() => ({}));
                        if (!resp.ok) {
                            if (panAmericanAdjuntosStatus) panAmericanAdjuntosStatus.textContent = "";
                            showFeedbackModal("No se pudo subir", `<p class="mb-0">${escapeHtml(data.message || "Error al subir los documentos a SharePoint.")}</p>`, "danger");
                            return;
                        }
                        if (panAmericanAdjuntosInput) panAmericanAdjuntosInput.value = "";
                        if (panAmericanAdjuntosStatus) panAmericanAdjuntosStatus.textContent = "Subido ✓";
