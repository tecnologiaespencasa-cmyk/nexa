            solicitarReaperturaUrl: "@Url.Action("SolicitarReaperturaKardex", "Censo")",
            aprobarReaperturaUrl: "@Url.Action("AprobarReaperturaKardex", "Censo")",
            rechazarReaperturaUrl: "@Url.Action("RechazarReaperturaKardex", "Censo")",
            puedeAprobarReapertura: @Json.Serialize(Model.PuedeAprobarReapertura),
            puedeGestionAnalistaAsistencial: @Json.Serialize(Model.PuedeGestionAnalistaAsistencial),
            medicamentoCatalog: @Html.Raw(medicamentoCatalogJson),
            initialKardexInicialCerrado: @Json.Serialize(Model.KardexInicialCerrado),
