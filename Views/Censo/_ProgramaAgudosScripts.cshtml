    Func<string, string> humanizeColumnTitle = name =>
    {
        var title = System.Text.RegularExpressions.Regex.Replace(name, "([a-z0-9])([A-Z])", "$1 $2");
        return title
            .Replace(" Utc", " UTC", StringComparison.OrdinalIgnoreCase)
            .Replace(" Id", " ID", StringComparison.OrdinalIgnoreCase)
            .Replace("Cie 10", "CIE10", StringComparison.OrdinalIgnoreCase)
            .Replace("Ips", "IPS", StringComparison.OrdinalIgnoreCase)
            .Replace("Tto", "TTO", StringComparison.OrdinalIgnoreCase)
            .Replace("Mx", "MX", StringComparison.OrdinalIgnoreCase);
    };
    Func<string, string> getCensoColumnTitle = name => censoColumnTitleOverrides.TryGetValue(name, out var title)
        ? title
        : humanizeColumnTitle(name);
