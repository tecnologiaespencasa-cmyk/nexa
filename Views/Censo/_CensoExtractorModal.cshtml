@*
    Extractor inteligente de remisión.

    Vive en la pantalla única y no en el formulario de un programa: lo que extrae son la
    recepción y los datos básicos del paciente, que se capturan una sola vez para todos.
*@
<div class="modal fade censo-extractor-modal" id="censoExtractorModal" tabindex="-1" aria-labelledby="censoExtractorModalTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header censo-extractor-header">
                <div class="censo-extractor-header__brand">
                    <span class="censo-extractor-header__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 4V2"></path>
                            <path d="M15 10V8"></path>
                            <path d="M12.5 5.5h-2"></path>
                            <path d="M20 5.5h-2"></path>
                            <path d="m17.6 7.4 1.2 1.2"></path>
                            <path d="M4 20 14.5 9.5"></path>
                            <path d="m13 8 3 3"></path>
                        </svg>
                    </span>
                    <div>
                        <h5 class="modal-title" id="censoExtractorModalTitle">Extractor inteligente de remisi&oacute;n</h5>
                        <p class="mb-0">Carga un PDF o Excel, o pega un correo de remisi&oacute;n; revisa los datos y c&oacute;pialos al censo.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div class="censo-extractor-layout">
                    <div class="censo-extractor-pane censo-extractor-pane--left">
                        <div id="extractorIdlePanel" class="censo-extractor-idle">
                            <div class="censo-extractor-idle__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <path d="M14 2v6h6"></path>
                                    <path d="M8 13h8M8 17h5"></path>
                                </svg>
                                <span class="censo-extractor-idle__spark" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                        <path d="M12 2l1.8 5.6L19.5 9l-5.7 1.4L12 16l-1.8-5.6L4.5 9l5.7-1.4z"></path>
                                    </svg>
                                </span>
                            </div>
                            <h6 class="mt-4 mb-1">La extracci&oacute;n aparecer&aacute; aqu&iacute;</h6>
                            <p class="text-muted small mb-0">Arrastra o busca el PDF de remisi&oacute;n en el panel derecho<br />y la inteligencia artificial capturar&aacute; los datos por ti.</p>
                        </div>
                        <div id="extractorLoadingPanel" class="censo-extractor-loading d-none" aria-live="polite">
                            <div class="censo-extractor-loading__card">
                                <div class="censo-extractor-scan">
                                    <svg viewBox="0 0 24 24" width="66" height="66" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <path d="M14 2v6h6"></path>
                                        <path d="M8 12h8M8 15h8M8 18h5"></path>
                                    </svg>
                                    <div class="censo-extractor-scan__beam"></div>
                                    <span class="censo-extractor-scan__particle censo-extractor-scan__particle--1"></span>
                                    <span class="censo-extractor-scan__particle censo-extractor-scan__particle--2"></span>
                                    <span class="censo-extractor-scan__particle censo-extractor-scan__particle--3"></span>
                                </div>
                                <h6 class="censo-extractor-loading__title" id="extractorLoadingStep">Leyendo el documento&hellip;</h6>
                                <ul class="censo-extractor-steps" id="extractorLoadingStepsList"></ul>
                            </div>
                        </div>
                        <div id="extractorResultPanel" class="censo-extractor-result d-none">
                            <div class="censo-extractor-result__card">
                                <div class="censo-extractor-result__header">
                                    <div class="censo-extractor-result__title">
                                        <span class="censo-extractor-result__title-icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
                                                <rect x="9" y="3" width="6" height="4" rx="1"></rect>
                                                <path d="m9 14 2 2 4-4"></path>
                                            </svg>
                                        </span>
                                        <h6 class="mb-0">Datos capturados</h6>
                                        <span class="censo-extractor-chip">Revisar y editar si es necesario</span>
                                    </div>
                                    <button type="button" class="btn btn-sm censo-extractor-ghost-btn" id="extractorReiniciarBtn">
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                            <path d="M17 8l-5-5-5 5"></path>
                                            <path d="M12 3v12"></path>
                                        </svg>
                                        <span>Procesar otra remisi&oacute;n</span>
                                    </button>
                                </div>
                                <div class="censo-extractor-result__body">
                                    <div id="extractorFields"></div>
                                    <div id="extractorMedsSection" class="censo-extractor-group d-none">
                                        <div class="censo-extractor-group__header">
                                            <span class="censo-extractor-group__icon" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m10.5 20.5-7-7a4.95 4.95 0 1 1 7-7l7 7a4.95 4.95 0 1 1-7 7Z"></path>
                                                    <path d="m8.5 8.5 7 7"></path>
                                                </svg>
                                            </span>
                                            <h6 class="mb-0">Medicamentos</h6>
                                        </div>
                                        <div id="extractorMeds" class="d-flex flex-column gap-2"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="censo-extractor-pane censo-extractor-pane--right">
                        <div class="censo-extractor-source-tabs" role="tablist" aria-label="Origen de la remisión">
                            <button type="button" class="censo-extractor-source-tab is-active" data-extractor-source="file" role="tab" aria-selected="true">
                                Cargar archivo
                            </button>
                            <button type="button" class="censo-extractor-source-tab" data-extractor-source="text" role="tab" aria-selected="false">
                                Pegar texto de correo
                            </button>
                        </div>
                        <div id="extractorFileSourcePanel">
                            <div id="extractorDropzone" class="censo-extractor-dropzone" role="button" tabindex="0" aria-label="Arrastra o selecciona el archivo de remisión">
                                <div class="censo-extractor-dropzone__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <path d="M17 8l-5-5-5 5"></path>
                                        <path d="M12 3v12"></path>
                                    </svg>
                                </div>
                                <h6 class="mt-4 mb-1">Arrastra el archivo aqu&iacute;</h6>
                                <div class="censo-extractor-dropzone__divider"><span>o</span></div>
                                <button type="button" class="btn censo-extractor-gradient-btn" id="extractorBuscarBtn">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="11" cy="11" r="7"></circle>
                                        <path d="m20 20-3.5-3.5"></path>
                                    </svg>
                                    <span>Buscar archivo</span>
                                </button>
                                <div class="censo-extractor-dropzone__meta">
                                    <span class="censo-extractor-pill">PDF, Excel u ODS</span>
                                    <span>M&aacute;ximo 10 MB</span>
                                </div>
                                <input type="file" id="extractorFileInput" accept="application/pdf,.pdf,.xls,.xlsx,.xlsm,.xlsb,.xlt,.xltx,.xltm,.ods" class="d-none" />
                            </div>
                        </div>
                        <div id="extractorTextSourcePanel" class="censo-extractor-text-source d-none">
                            <label for="extractorTextInput" class="form-label">Contenido de la remisi&oacute;n recibida por correo</label>
                            <p class="text-muted small mb-3">Pega aquí el correo completo o el texto de la remisión. La información será organizada para el censo.</p>
                            <textarea id="extractorTextInput" class="form-control" rows="14" maxlength="50000" placeholder="Pega aquí el texto del correo…"></textarea>
                            <div class="d-flex justify-content-between align-items-center gap-3 mt-3">
                                <span class="small text-muted" id="extractorTextCounter">0 / 50.000 caracteres</span>
                                <button type="button" class="btn censo-extractor-gradient-btn" id="extractorProcesarTextoBtn">Procesar texto</button>
                            </div>
                        </div>
                        <div id="extractorDocViewer" class="censo-extractor-docviewer d-none">
                            <div class="censo-extractor-docviewer__label">
                                <span class="censo-extractor-docviewer__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <path d="M14 2v6h6"></path>
                                    </svg>
                                </span>
                                <span id="extractorDocViewerTitle">Vista del documento</span>
                                <span class="censo-extractor-docviewer__name" id="extractorDocName"></span>
                            </div>
                            <div id="extractorFilePreviewMessage" class="censo-extractor-file-preview d-none">
                                <strong>Archivo de hoja de cálculo cargado</strong>
                                <span>Se detectará autom&aacute;ticamente la hoja con los datos de la remisi&oacute;n.</span>
                            </div>
                            <iframe id="extractorPdfFrame" class="censo-extractor-pdf" title="Vista previa del PDF de remisi&oacute;n"></iframe>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer censo-extractor-footer">
                <div class="censo-extractor-footer__notice me-auto">
                    <span class="censo-extractor-footer__notice-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z"></path>
                            <path d="m9 12 2 2 4-4"></path>
                        </svg>
                    </span>
                    <div>
                        <strong>Revisa cuidadosamente los datos extra&iacute;dos</strong>
                        <span>Verifica que la informaci&oacute;n sea correcta antes de copiarla al censo.</span>
                    </div>
                </div>
                <div id="extractorError" class="alert alert-danger py-2 px-3 mb-0 d-none" role="alert"></div>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn censo-extractor-wa-btn d-none" id="extractorWhatsappBtn">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"></path>
                    </svg>
                    <span id="extractorWhatsappBtnText">Copiar para WhatsApp</span>
                </button>
                <button type="button" class="btn censo-extractor-gradient-btn d-none" id="extractorCopiarCensoBtn">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
                        <rect x="9" y="3" width="6" height="4" rx="1"></rect>
                        <path d="M12 11v6"></path>
                        <path d="m9 14 3 3 3-3"></path>
                    </svg>
                    <span>Copiar datos al censo</span>
                </button>
            </div>
        </div>
    </div>
</div>
