@model CensoUnificadoViewModel
@* Script del extractor de remisión. Se carga desde la pantalla única. *@
    @* Valores del servidor para wwwroot/js/censo/extractor-remision.js. El resto del script es estático
       y el navegador lo guarda en caché. *@
    <script>
        window.NexaCenso = window.NexaCenso || {};
        window.NexaCenso.extractor = {
            extraerDatosRemisionUrl: "@Url.Action("ExtraerDatosRemision", "Censo")",
            extraerDatosRemisionTextoUrl: "@Url.Action("ExtraerDatosRemisionTexto", "Censo")",
        };
    </script>
    <script src="~/js/censo/extractor-remision.js" asp-append-version="true"></script>
