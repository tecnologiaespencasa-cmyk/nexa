                                                        <label asp-for="HoraIngreso" class="form-label">Hora</label>
                                                        <input asp-for="HoraIngreso" type="text" class="form-control hora-24h-input" placeholder="HH:mm" maxlength="5" autocomplete="off" aria-label="Hora de ingreso (formato 24h)" />
                                                    </div>
                                                </div>
