@* Confirmacion compartida de la pantalla del censo. Va fuera de .censo-page por el mismo motivo
   que los demas modales, y reutiliza los estilos del dialogo de clinica de heridas. *@
<div class="modal fade herida-dialogo" id="censoConfirmarDialogo" tabindex="-1"
     aria-labelledby="censoConfirmarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <div class="herida-dialogo__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                        <path d="M12 9v4"></path>
                        <path d="M12 17h.01"></path>
                        <path d="M10.3 3.9 2.4 17.6A2 2 0 0 0 4.1 20.6h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
                    </svg>
                </div>
                <h2 class="herida-dialogo__titulo" id="censoConfirmarTitulo"></h2>
                <p class="herida-dialogo__mensaje" id="censoConfirmarMensaje"></p>
            </div>
            <div class="modal-footer herida-dialogo__acciones">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="censoConfirmarAceptar">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<partial name="_CensoExtractorModal" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    @* Convierte los <select data-censo-buscable> en listas con busqueda. Va antes que los
       scripts de programa porque estos consultan las opciones del <select> ya montado. *@
    <script src="~/js/censo-combo.js" asp-append-version="true"></script>
    <partial name="_CensoExtractorScripts" model="Model" />
@if (Model.Agudos is not null)
{
    <partial name="_ProgramaAgudosScripts" model="Model.Agudos" />
}
@if (Model.Cronicos is not null)
{
    <partial name="_ProgramaCronicosScripts" model="Model.Cronicos" />
}
@if (Model.ClinicaHeridas is not null)
{
    <partial name="_ClinicaHeridasScripts" model="Model.ClinicaHeridas" />
}
@if (Model.Npt is not null)
{
    <partial name="_NptScripts" model="Model.Npt" />
    <partial name="_NptKardexScripts" model="Model.Npt" />
}
@if (Model.TerapiaAmbulatoria is not null)
{
    <partial name="_TerapiaAmbulatoriaScripts" model="Model.TerapiaAmbulatoria" />
}
    @* Valores del servidor para wwwroot/js/censo/censo-unificado.js. El resto del script es estático
       y el navegador lo guarda en caché. *@
    <script>
        window.NexaCenso = window.NexaCenso || {};
        window.NexaCenso.unificado = {
            programaPorDefecto: @Json.Serialize(Model.ProgramaActivo),
            validarDireccionUrl: "@Url.Action("ValidarDireccion", "Censo")",
            buscarBarriosUrl: "@Url.Action("BuscarBarrios", "Censo")",
            defaultsMunicipioUrl: "@Url.Action("ObtenerDefaultsMunicipio", "Censo")",
            buscarDiagnosticoCie10Url: "@Url.Action("BuscarDiagnosticoCie10", "Censo")",
            verificarPacienteMaestroUrl: "@Url.Action("VerificarPacienteMaestro", "Censo")",
            editablesTrasAlta: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    CensoProgramas.Todos
                        .SelectMany(CensoProgramaSecciones.De)
                        .Select(s => s.Id)
                        .Where(CensoProgramaSecciones.SeEditaTrasElAlta))),
            verificarPacienteUrl: "@Url.Action("VerificarPacienteEnPrograma", "Censo")",
            seccionActivaInicial: @Html.Raw(Json.Serialize(seccionActiva)),
        };
    </script>
    <script src="~/js/censo/censo-unificado.js" asp-append-version="true"></script>
}
