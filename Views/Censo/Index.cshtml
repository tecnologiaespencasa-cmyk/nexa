                        loadSelectedProrrogaIntoForm();
                    });
                }

                if (adicionalProrrogaBtn) {
                    adicionalProrrogaBtn.addEventListener("click", () => {
                        const modalEl = document.getElementById("censoAdicionalProrrogaConfirmModal");
                        if (window.bootstrap && window.bootstrap.Modal && modalEl) {
                            window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
                            return;
                        }

                        activeProrrogaIsNewAdditional = true;
                        activeProrrogaVersionId = null;
                        if (prorrogaVersionSelect) prorrogaVersionSelect.value = "";
                        clearProrrogaForm();
                        updateProrrogaReadonlyMode();
                    });
                }

                if (confirmarAdicionalProrrogaBtn) {
                    confirmarAdicionalProrrogaBtn.addEventListener("click", () => {
                        const modalEl = document.getElementById("censoAdicionalProrrogaConfirmModal");
                        if (window.bootstrap && window.bootstrap.Modal && modalEl) {
                            window.bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                        }

                        activeProrrogaIsNewAdditional = true;
                        activeProrrogaVersionId = null;
                        if (prorrogaVersionSelect) prorrogaVersionSelect.value = "";
                        clearProrrogaForm();
                        updateProrrogaReadonlyMode();
                    });
                }

                if (guardarProrrogaBtn) {
                    guardarProrrogaBtn.addEventListener("click", async () => {
                        const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                        if (recordId <= 0) {
                            showFeedbackModal("Sin paciente activo", "<p class=\"mb-0\">Primero guarda el paciente antes de guardar la prórroga.</p>", "warning");
                            return;
                        }

                        const invalidProrrogaMedicamentos = syncProrrogaMedicamentoValidation(true);
                        if (invalidProrrogaMedicamentos.length > 0) {
                            invalidProrrogaMedicamentos[0].input?.focus();
                            showFeedbackModal(
                                "Medicamento no válido",
                                "<p class=\"mb-0\">Selecciona los medicamentos de la prórroga desde el listado de sugerencias.</p>",
                                "warning");
                            return;
                        }

                        guardarProrrogaBtn.disabled = true;
                        if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "Guardando...";
                        try {
                            const formData = new FormData();
                            formData.append("id", String(recordId));
                            formData.append("prorrogaJson", JSON.stringify(collectProrrogaPayload()));
                            if (activeProrrogaVersionId) {
                                formData.append("prorrogaVersionId", String(activeProrrogaVersionId));
                            }
                            if (activeProrrogaIsNewAdditional) {
                                formData.append("adicionalProrroga", "true");
                            }
                            if (csrfTokenInput) formData.append("__RequestVerificationToken", csrfTokenInput.value);
                            const resp = await fetch(guardarProrrogaUrl, { method: "POST", body: formData });
                            const result = await resp.json().catch(() => ({}));
                            if (!resp.ok) {
                                showFeedbackModal("No se pudo guardar", `<p class="mb-0">${escapeHtml(result.message || "Error al guardar la prórroga.")}</p>`, "danger");
                                if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "";
                                return;
                            }
                            if (result.prorrogaId) {
                                activeProrrogaVersionId = String(result.prorrogaId);
                                activeProrrogaIsNewAdditional = false;
                                await loadDocumentosState(recordId);
                                renderProrrogaVersionOptions();
                                updateProrrogaReadonlyMode();
                            }
                            if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "Guardado ✓";
                            window.setTimeout(() => { if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = ""; }, 3000);
                        } catch {
                            showFeedbackModal("Error de conexión", "<p class=\"mb-0\">No se pudo conectar al servidor.</p>", "danger");
                            if (prorrogaGuardadoStatus) prorrogaGuardadoStatus.textContent = "";
                        } finally {
                            const prorrogaCerrada = !activeProrrogaIsNewAdditional && !!getActiveProrroga()?.cerrada;
                            guardarProrrogaBtn.disabled = prorrogaCerrada;
                        }
                    });
                }
            }
            // ── End prorroga section ──────────────────────────────────────

            const requestedCensoSection = new URLSearchParams(window.location.search).get("abrirSeccion");
            if (requestedCensoSection === "estado") {
                window.setTimeout(() => {
                    openSectionTab("tab-plan-manejo-link");
                    window.setTimeout(() => {
                        estadoSelect?.scrollIntoView({ behavior: "smooth", block: "center" });
                        estadoSelect?.focus();
                    }, 250);
                }, 100);
            } else if (requestedCensoSection === "prorroga") {
                window.setTimeout(() => {
                    openSectionTab("tab-prorroga-link");
                    window.setTimeout(() => {
                        prorrogaTabPane?.scrollIntoView({ behavior: "smooth", block: "start" });
                    }, 250);
                }, 100);
            }

            if (shouldShowSaveErrorModal) {
                const normalizedErrors = Array.from(new Set((serverErrorMessages || [])
                    .map((error) => String(error || "").trim())
                    .filter((error) => error.length > 0)));
                const missingSections = Array.from(new Set((serverMissingMandatorySections || [])
                    .map((section) => String(section || "").trim())
                    .filter((section) => section.length > 0)));

                let bodyHtml = "";
                if (missingSections.length > 0) {
                    const missingDetails = getMissingMandatoryDetailsOnClient()
                        .filter((section) => missingSections.includes(section.name));

                    bodyHtml += missingDetails.length > 0
                        ? `<p class="mb-2">Faltan campos obligatorios por diligenciar:</p>${buildMissingMandatoryDetailsHtml(missingDetails)}`
                        : `<p class="mb-2">Faltan secciones obligatorias por diligenciar:</p>${buildListHtml(missingSections)}`;
                }

                const generalErrors = normalizedErrors
                    .filter((error) => !error.toLowerCase().startsWith("para guardar el censo debes completar"))
                    .slice(0, 10);

                if (generalErrors.length > 0) {
                    bodyHtml += `${bodyHtml ? "<p class=\"mt-3 mb-2\">Revisa tambien:</p>" : "<p class=\"mb-2\">Se encontraron errores de validacion:</p>"}${buildListHtml(generalErrors)}`;
                }

                if (!bodyHtml) {
                    bodyHtml = "<p class=\"mb-0\">No se pudo guardar el registro. Revisa la información del formulario.</p>";
                }

                showFeedbackModal("No se pudo guardar el censo", bodyHtml, "danger");

                if (missingSections.length > 0) {
                    const firstMissingSection = mandatorySectionsConfig.find((section) => section.name === missingSections[0]);
                    if (firstMissingSection) {
                        openSectionTab(firstMissingSection.tabLinkId);
                    }

                    if (missingSections.includes("Sección 3 - Plan de manejo")) {
                        censoSaveAttempted = true;
                        syncSection3RequiredMessages();
                    }
                }
            }
        })();
    </script>
}
