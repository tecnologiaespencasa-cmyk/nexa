            if (birthDateInput && ageInput) {
                const validateBirthDateChanged = () => {
                    const today = new Date();
                    const todayValue = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
                    if (!birthDateInput.value || birthDateInput.value >= todayValue) {
                        birthDateInput.setCustomValidity("La fecha de nacimiento debe ser anterior a la fecha actual.");
                    } else {
                        birthDateInput.setCustomValidity("");
                    }
                };

                const syncAge = () => {
                    if (!birthDateInput.value) {
                        ageInput.value = "0";
                        validateBirthDateChanged();
                        return;
                    }

                    const birthDate = new Date(birthDateInput.value + "T00:00:00");
                    const today = new Date();
                    let age = today.getFullYear() - birthDate.getFullYear();
                    const hasBirthdayPassed =
                        today.getMonth() > birthDate.getMonth()
                        || (today.getMonth() === birthDate.getMonth() && today.getDate() >= birthDate.getDate());

                    if (!hasBirthdayPassed) {
                        age -= 1;
                    }

                    ageInput.value = Math.max(age, 0);
                    validateBirthDateChanged();
                };

                syncAge();
                birthDateInput.addEventListener("change", syncAge);
                birthDateInput.addEventListener("input", syncAge);
