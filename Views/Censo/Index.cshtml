                            <path d="M15 19a6 6 0 0 0-12 0"></path>
                            <circle cx="9" cy="8" r="3"></circle>
                            <path d="M19 8v6"></path>
                            <path d="M16 11h6"></path>
                        </svg>
                        <span>Cambiar paciente</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end censo-current-patient__dropdown">
