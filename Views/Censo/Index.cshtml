                }

                control.value = value ?? "";
                uppercaseControlValue(control);
                if (control.matches("select")) {
                    syncSelectPlaceholderState(control);
                }
            };

            if (usarSugerenciaServerBtn && direccionInput) {
                usarSugerenciaServerBtn.addEventListener("click", (event) => {
                    event.preventDefault();
                    const serverSuggestionElement = document.querySelector("#direccionValidacionServerMensaje strong");
                    if (serverSuggestionElement) {
                        direccionInput.value = serverSuggestionElement.textContent || "";
                        direccionValidada = false;
                        clearServerDireccionMessage();
                    }
                });
            }

            if (direccionInput) {
                direccionInput.addEventListener("input", () => {
                    const restoredOriginalAddress = normalizeAddressForComparison(direccionInput.value)
                        === normalizeAddressForComparison(initialDireccionValue);
                    direccionValidada = restoredOriginalAddress ? initialDireccionValidada : false;
                    if (asumirDireccionCheck) {
                        asumirDireccionCheck.checked = restoredOriginalAddress
                            ? initialAsumirDireccionErrada
                            : false;
                    }
                    latestAddressCandidates = [];
                    clearDireccionMessage();
                    clearServerDireccionMessage();
                });
            }

            if (limpiarDireccionBtn) {
                limpiarDireccionBtn.addEventListener("click", () => {
                    clearAllAddressData();
                });
            }

            if (validarDireccionBtn && direccionInput && csrfTokenInput) {
                validarDireccionBtn.addEventListener("click", async () => {
                    const direccion = (direccionInput.value || "").trim();
                    if (!direccion) {
                        setDireccionMessage("warning", "Debes escribir una dirección para validarla.");
                        direccionValidada = false;
                        return;
                    }

                    validarDireccionBtn.disabled = true;
                    clearDireccionMessage();
                    clearServerDireccionMessage();

                    try {
                        const response = await fetch(validarDireccionUrl, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": csrfTokenInput.value
                            },
                            body: JSON.stringify({ direccion })
                        });

                        if (!response.ok) {
                            throw new Error("No se pudo validar la dirección.");
                        }

                        const data = await response.json();
                        direccionValidada = data.isValid === true;
                        latestAddressCandidates = [];
                        const shouldClearDerivedData = data.outcome === "invalid" || data.outcome === "unavailable";
                        const hasAddressCandidates = data.requiresSelection === true
                            && Array.isArray(data.candidates)
                            && data.candidates.length > 0;
                        const suggestedBarrio = (data.neighborhood || data.district || "").trim();

                        if (shouldClearDerivedData) {
                            clearAddressDerivedFields();
                        }

                        if (!shouldClearDerivedData && hasAddressCandidates) {
                            clearAddressDerivedFields();
                            direccionValidada = false;
                            renderAddressCandidates(data.candidates, data.message);
                            return;
                        }

                        if (!shouldClearDerivedData && municipioSelect && data.municipality) {
                            const hasOption = Array.from(municipioSelect.options).some(x => x.value === data.municipality);
                            if (hasOption) {
                                if (barrioSelect) {
                                    barrioSelect.value = "";
                                }

                                municipioSelect.value = data.municipality;
                                lastValidationDistrict = data.district || "";
                                await applyMunicipalityDefaults(data.municipality, suggestedBarrio, lastValidationDistrict);
                                await loadBarriosByMunicipio(data.municipality, suggestedBarrio || "a", suggestedBarrio, false);
                            }
                        }

                        if (!shouldClearDerivedData && barrioSelect) {
                            setBarrioOptions(barriosLoaded, suggestedBarrio, false);
                        }

                        if (!shouldClearDerivedData && zonaSelect && data.zonaDireccionSegunMunicipio) {
                            zonaSelect.value = data.zonaDireccionSegunMunicipio;
                        }

                        if (data.isValid) {
                            if (data.formattedAddress && !asumirDireccionCheck?.checked) {
                                direccionInput.value = data.formattedAddress;
                            }
                            setDireccionMessage("success", data.message || "Direccion validada correctamente.");
                            return;
                        }

                        let messageHtml = data.message || "La dirección no pudo ser validada.";
                        if (data.suggestedAddress) {
                            messageHtml += `<br/>Sugerencia: <strong>${escapeHtml(data.suggestedAddress)}</strong> <button type="button" class="btn btn-sm btn-link p-0 ms-2" id="usarSugerenciaDireccionBtnClient">Usar sugerencia</button>`;
                        }
                        setDireccionMessage("warning", messageHtml);

                        const usarSugerenciaClientBtn = document.getElementById("usarSugerenciaDireccionBtnClient");
                        if (usarSugerenciaClientBtn && data.suggestedAddress) {
                            usarSugerenciaClientBtn.addEventListener("click", (event) => {
                                event.preventDefault();
                                direccionInput.value = data.suggestedAddress;
                                direccionValidada = false;
                            });
                        }
                    } catch {
                        direccionValidada = false;
                        clearAddressDerivedFields();
                        setDireccionMessage("danger", "No fue posible validar la dirección. Intenta nuevamente o marca 'Asumir dirección errada y continuar'.");
                    } finally {
                        validarDireccionBtn.disabled = false;
                    }
                });
            }

            if (form && asumirDireccionCheck) {
                form.addEventListener("submit", async (event) => {
                    if (isCreatingNewAdmission() && !allowValidatedNewAdmissionSubmit) {
                        event.preventDefault();
                        const submitter = event.submitter;
                        const canContinue = await validateNewAdmissionDocument(true);
                        if (canContinue) {
                            allowValidatedNewAdmissionSubmit = true;
                            form.requestSubmit(submitter || undefined);
                        }
                        return;
                    }
                    allowValidatedNewAdmissionSubmit = false;

                    uppercaseAllCensoTextFields();
                    [telefono1Input, telefono2Input, telefono3Input, numeroTelefonoLlamadaBienvenidaInput].forEach((input) => sanitizePhoneInput(input));
                    [diasMedicamentoPrincipalInput, diasMedicamento2Input, diasMedicamento3Input, diasMedicamento4Input, diasMedicamento5Input, diasMedicamento6Input].forEach((input) => sanitizeDaysInput(input));
                    syncMedicationVisibility();
                    syncAllMedicationDailyDoses();
                    syncAplicacionesTotales();
                    syncPhoneVisibility();
                    syncFechaProximoCambioSonda();
                    syncCateterismoVisibility();
                    syncCateterPiccVisibility();
                    syncGestionAltaVisibility();

                    if (codigoCie10Input) {
                        codigoCie10Input.value = normalizeCie10InputValue(codigoCie10Input.value || "");
                    }

                    if (!syncIpsQueRemiteValidation(true)) {
                        event.preventDefault();
                        openSectionTab("tab-datos-basicos-link");
                        showFeedbackModal(
                            "IPS que remite no valida",
                            "<p class=\"mb-0\">Selecciona una IPS que remite del listado de sugerencias.</p>",
                            "warning");
                        return;
                    }

                    if (!syncAuxiliarAsignadoValidation(true)) {
                        event.preventDefault();
                        openSectionTab("tab-plan-manejo-link");
                        showFeedbackModal(
                            "Auxiliar asignado no válido",
                            "<p class=\"mb-0\">Selecciona un auxiliar asignado del listado de sugerencias.</p>",
                            "warning");
                        return;
                    }

                    const invalidSection3Medicamentos = syncSection3MedicamentoValidation(true);
                    if (invalidSection3Medicamentos.length > 0) {
                        event.preventDefault();
                        openSectionTab("tab-plan-manejo-link");
                        invalidSection3Medicamentos[0].input?.focus();
                        showFeedbackModal(
                            "Medicamento no válido",
                            "<p class=\"mb-0\">Selecciona los medicamentos desde el listado de sugerencias.</p>",
                            "warning");
                        return;
                    }

                    censoSaveAttempted = true;
                    syncSection3RequiredMessages();

                    const missingMandatoryDetails = getMissingMandatoryDetailsOnClient();
                    if (missingMandatoryDetails.length > 0) {
                        event.preventDefault();

                        const firstMissingSection = mandatorySectionsConfig.find((section) => section.name === missingMandatoryDetails[0].name);
                        if (firstMissingSection) {
                            openSectionTab(firstMissingSection.tabLinkId);
                        }

                        showFeedbackModal(
                            "Faltan secciones obligatorias",
                            `<p class="mb-2">Para guardar debes completar estos campos:</p>${buildMissingMandatoryDetailsHtml(missingMandatoryDetails)}`,
                            "warning");

                        return;
                    }

                    if (!direccionValidada && !asumirDireccionCheck.checked) {
                        event.preventDefault();
                        setDireccionMessage("warning", "Debes validar la dirección o marcar 'Asumir dirección errada y continuar'.");
                        showFeedbackModal(
                            "Validacion pendiente",
                            "<p class=\"mb-0\">Debes validar la dirección o marcar 'Asumir dirección errada y continuar'.</p>",
                            "warning");
                    }
                });
            }

            if (municipioSelect) {
                municipioSelect.addEventListener("change", async () => {
                    const municipio = municipioSelect.value || "";
                    lastValidationDistrict = "";
                    if (barrioSelect) {
                        barrioSelect.value = "";
                    }

                    await applyMunicipalityDefaults(municipio, "", "");
                    await loadBarriosByMunicipio(municipio, "a", "");
                });
            }

            if (barrioSelect) {
                barrioSelect.addEventListener("change", async () => {
                    const municipio = municipioSelect ? municipioSelect.value : "";
                    const barrio = barrioSelect.value || "";
                    await applyMunicipalityDefaults(municipio, barrio, lastValidationDistrict);
                });
            }

            const sanitizePhoneInput = (input) => {
                if (!input) {
                    return;
                }

                input.value = (input.value || "").replace(/\D/g, "").slice(0, 10);
            };

            const sanitizeDaysInput = (input) => {
                if (!input) {
                    return;
                }

                const digits = (input.value || "").replace(/\D/g, "").slice(0, 3);
                if (!digits) {
                    input.value = "";
                    return;
                }

                const value = Math.min(999, Math.max(1, Number.parseInt(digits, 10)));
                input.value = String(value);
            };

            const formatDateInputValue = (date) => {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");
                return `${year}-${month}-${day}`;
            };

            const addDaysToDateInputValue = (value, days) => {
                const match = String(value || "").match(/^(\d{4})-(\d{2})-(\d{2})$/);
                if (!match) {
                    return "";
                }

                const year = Number.parseInt(match[1], 10);
                const month = Number.parseInt(match[2], 10) - 1;
                const day = Number.parseInt(match[3], 10);
                const date = new Date(year, month, day);

                if (
                    date.getFullYear() !== year
                    || date.getMonth() !== month
                    || date.getDate() !== day
                ) {
                    return "";
                }

                date.setDate(date.getDate() + days);
                return formatDateInputValue(date);
            };

            const syncFechaProximoCambioSonda = () => {
                if (!fechaUltimoCambioSondaInput || !fechaProximoCambioSondaInput) {
                    return;
                }

                fechaProximoCambioSondaInput.value = addDaysToDateInputValue(fechaUltimoCambioSondaInput.value, 21);
            };

            const isEstadoAlta = () => String(estadoSelect ? estadoSelect.value : "")
                .toLowerCase()
                .includes("alta");

            const clearGestionAltaFields = () => {
                if (fechaAltaInput) {
                    fechaAltaInput.value = "";
                }

                if (nombreQuienGestionaAltaInput) {
                    nombreQuienGestionaAltaInput.value = "";
                }
            };

            const syncGestionAltaVisibility = () => {
                const showGestionAlta = isEstadoAlta();

                if (gestionAltaTabLink) {
                    gestionAltaTabLink.classList.remove("d-none");
                    gestionAltaTabLink.classList.toggle("censo-nav__item--locked", !showGestionAlta);
                    gestionAltaTabLink.setAttribute("aria-hidden", "false");
                    gestionAltaTabLink.setAttribute("aria-disabled", showGestionAlta ? "false" : "true");
                    gestionAltaTabLink.tabIndex = showGestionAlta ? 0 : -1;

                    if (showGestionAlta) {
                        gestionAltaTabLink.setAttribute("data-bs-toggle", "list");
                        gestionAltaTabLink.setAttribute("data-bs-target", "#tab-gestion-alta");
                        gestionAltaTabLink.removeAttribute("title");
                    } else {
                        gestionAltaTabLink.removeAttribute("data-bs-toggle");
                        gestionAltaTabLink.removeAttribute("data-bs-target");
                        gestionAltaTabLink.setAttribute("title", "Disponible cuando el estado del paciente sea alta");
                    }
                }

                const gestionAltaLockHint = document.getElementById("tab-gestion-alta-lock-hint");
                if (gestionAltaLockHint) {
                    gestionAltaLockHint.classList.toggle("d-none", showGestionAlta);
                }

                if (gestionAltaPane) {
                    gestionAltaPane.classList.toggle("d-none", !showGestionAlta);
                }

                if (showGestionAlta) {
                    return;
                }

                clearGestionAltaFields();

                if (gestionAltaPane && gestionAltaPane.classList.contains("active")) {
                    openSectionTab("tab-plan-manejo-link");
                }
            };

            const calculatePrincipalDailyDose = (frequency) => {
                const normalized = String(frequency || "").trim().toUpperCase();

                if (!normalized) {
                    return "";
                }

                if (normalized === "NO APLICA") {
                    return "NO APLICA";
                }

                if (normalized === "INFUSION CONTINUA") {
                    return "1";
                }

                const match = normalized.match(/^CADA\s+(\d+)\s+HORAS$/);
                if (!match) {
                    return "";
                }

                const hours = Number.parseInt(match[1], 10);
                if (!Number.isFinite(hours) || hours <= 0) {
                    return "";
                }

                return String(Math.max(1, Math.floor(24 / hours)));
            };

            const syncPrincipalDailyDose = () => {
                if (!frecuenciaAdministracionMxPrincipalSelect || !numeroDosisDiaMedicamentoPrincipalInput) {
                    return;
                }

                numeroDosisDiaMedicamentoPrincipalInput.value = calculatePrincipalDailyDose(frecuenciaAdministracionMxPrincipalSelect.value);
                syncAplicacionesTotales();
            };

            const syncAdditionalMedicationDailyDose = (frequencySelect, doseInput) => {
                if (!frequencySelect || !doseInput) {
                    return;
                }

                doseInput.value = calculatePrincipalDailyDose(frequencySelect.value);
                syncAplicacionesTotales();
            };

            const syncAllMedicationDailyDoses = () => {
                syncPrincipalDailyDose();
                syncAdditionalMedicationDailyDose(frecuenciaMedicamento2Select, numeroDosisMedicamento2Select);
                syncAdditionalMedicationDailyDose(frecuenciaMedicamento3Select, numeroDosisMedicamento3Select);
                syncAdditionalMedicationDailyDose(frecuenciaMedicamento4Select, numeroDosisMedicamento4Select);
                syncAdditionalMedicationDailyDose(frecuenciaMedicamento5Select, numeroDosisMedicamento5Select);
                syncAdditionalMedicationDailyDose(frecuenciaMedicamento6Select, numeroDosisMedicamento6Select);
            };

            const isMedicationAdministrationEnabled = () => {
                if (!administracionMedicamentosSelect) {
                    return false;
                }

                return String(administracionMedicamentosSelect.value || "").trim().toLowerCase() === "si";
            };

            const isServiciosComplementariosEnabled = () => {
                if (!requiereServiciosComplementariosSelect) {
                    return false;
                }

                return String(requiereServiciosComplementariosSelect.value || "").trim().toLowerCase() === "si";
            };

            const parseIsoDateInputValue = (value) => {
                const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(value || "").trim());
                if (!match) {
                    return null;
                }

                const year = Number.parseInt(match[1], 10);
                const month = Number.parseInt(match[2], 10);
                const day = Number.parseInt(match[3], 10);
                const date = new Date(year, month - 1, day);
                if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) {
                    return null;
                }

                return date;
            };

            const toIsoDateInputValue = (date) => {
                const year = String(date.getFullYear()).padStart(4, "0");
                const month = String(date.getMonth() + 1).padStart(2, "0");
                const day = String(date.getDate()).padStart(2, "0");
                return `${year}-${month}-${day}`;
            };

            const syncFechaFinTratamiento = () => {
                if (!fechaFinTratamientoInput) {
                    return;
                }

                const medicacionSi = isMedicationAdministrationEnabled();

                if (medicacionSi) {
                    fechaFinTratamientoInput.readOnly = true;
                    const startDate = parseIsoDateInputValue(fechaInicioTratamientoInput && fechaInicioTratamientoInput.value ? fechaInicioTratamientoInput.value : "");
                    const treatmentDays = Number.parseInt(diasTratamientoIvInput && diasTratamientoIvInput.value ? diasTratamientoIvInput.value : "0", 10);
                    if (!startDate || !Number.isFinite(treatmentDays) || treatmentDays < 1) {
                        fechaFinTratamientoInput.value = "";
                        return;
                    }
                    const offset = is24HorasFrecuencia(getWinningMedFreq()) ? treatmentDays - 1 : treatmentDays;
                    const endDate = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
                    endDate.setDate(endDate.getDate() + offset);
                    fechaFinTratamientoInput.value = toIsoDateInputValue(endDate);
                } else {
                    const noMedDays = Number.parseInt(diasNoMedicamentosInput && diasNoMedicamentosInput.value ? diasNoMedicamentosInput.value : "0", 10);
                    if (Number.isFinite(noMedDays) && noMedDays >= 1) {
                        fechaFinTratamientoInput.readOnly = true;
                        const startDate = parseIsoDateInputValue(fechaInicioTratamientoInput && fechaInicioTratamientoInput.value ? fechaInicioTratamientoInput.value : "");
                        if (!startDate) {
                            fechaFinTratamientoInput.value = "";
                            return;
                        }
                        const endDate = new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
                        endDate.setDate(endDate.getDate() + noMedDays);
                        fechaFinTratamientoInput.value = toIsoDateInputValue(endDate);
                    } else {
                        fechaFinTratamientoInput.readOnly = false;
                    }
                }
            };

            const calculateMedicationApplications = (doseInput, daysInput) => {
                const dose = Number.parseInt(doseInput && doseInput.value ? doseInput.value : "0", 10);
                const days = Number.parseInt(daysInput && daysInput.value ? daysInput.value : "0", 10);

                if (!Number.isFinite(dose) || !Number.isFinite(days) || dose < 1 || days < 1) {
                    return 0;
                }

                return dose * days;
            };

            const calculateMedicationApplicationsByFrequency = (frequency, daysInput) => {
                const days = getMedicationDaysValue(daysInput);
                if (days < 1) {
                    return 0;
                }

                const normalized = String(frequency || "").trim().toUpperCase();
                if (!normalized || normalized === "NO APLICA") {
                    return 0;
                }

                if (normalized === "INFUSION CONTINUA") {
                    return days;
                }

                const match = normalized.match(/^CADA\s+(\d+(?:[.,]\d+)?)\s+HORAS$/);
                if (!match) {
                    return 0;
                }

                const hours = parseRequisitionDecimal(match[1]);
                return hours > 0 ? Math.ceil((days * 24) / hours) : 0;
            };

            const getMedicationDaysValue = (daysInput) => {
                const days = Number.parseInt(daysInput && daysInput.value ? daysInput.value : "0", 10);
                if (!Number.isFinite(days) || days < 1) {
                    return 0;
                }

                return days;
            };

            const is24HorasFrecuencia = (freqValue) =>
                (freqValue || "").trim().toUpperCase() === "CADA 24 HORAS";

            const getWinningMedFreq = () => {
                const meds = [
                    { days: getMedicationDaysValue(diasMedicamentoPrincipalInput), freq: frecuenciaAdministracionMxPrincipalSelect?.value || "" },
                ];
                if (medicamento2Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento2Input), freq: frecuenciaMedicamento2Select?.value || "" });
                if (medicamento3Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento3Input), freq: frecuenciaMedicamento3Select?.value || "" });
                if (medicamento4Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento4Input), freq: frecuenciaMedicamento4Select?.value || "" });
                if (medicamento5Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento5Input), freq: frecuenciaMedicamento5Select?.value || "" });
                if (medicamento6Toggle?.checked) meds.push({ days: getMedicationDaysValue(diasMedicamento6Input), freq: frecuenciaMedicamento6Select?.value || "" });
                return meds.reduce((best, m) => m.days > best.days ? m : best, { days: 0, freq: "" }).freq;
            };

            const isCambioFrecuenciaActivo = () =>
                !!(cambioFrecuenciaAdministracionTtoSelect
                    && String(cambioFrecuenciaAdministracionTtoSelect.value || "").toLowerCase() === "si");

            const getFrequencyForApplications = (medicationNumber, originalFrequency) => {
                if (!isCambioFrecuenciaActivo()
                    || !medicamentoFrecuenciaAjustadaSelect
                    || !frecuenciaAjustadaSelect
                    || medicamentoFrecuenciaAjustadaSelect.value !== String(medicationNumber)) {
                    return originalFrequency || "";
                }

                return frecuenciaAjustadaSelect.value || originalFrequency || "";
            };

            const calculateMedicationApplicationsWithAdjustment = (medicationNumber, originalFrequencySelect, dailyDoseInput, daysInput) => {
                const frequency = getFrequencyForApplications(medicationNumber, originalFrequencySelect ? originalFrequencySelect.value : "");
                const byFrequency = calculateMedicationApplicationsByFrequency(frequency, daysInput);
                return byFrequency > 0 ? byFrequency : calculateMedicationApplications(dailyDoseInput, daysInput);
            };

            const syncCambioFrecuenciaVisibility = () => {
                const showAdjustment = isCambioFrecuenciaActivo();

                if (medicamentoFrecuenciaAjustadaContainer) {
                    medicamentoFrecuenciaAjustadaContainer.classList.toggle("d-none", !showAdjustment);
                }

                if (frecuenciaAjustadaContainer) {
                    frecuenciaAjustadaContainer.classList.toggle("d-none", !showAdjustment);
                }

                if (medicamentoFrecuenciaAjustadaSelect) {
                    const med2Avail = !!(medicamento2Toggle && medicamento2Toggle.checked);
                    const med3Avail = !!(medicamento3Toggle && medicamento3Toggle.checked);
                    const med4Avail = !!(medicamento4Toggle && medicamento4Toggle.checked);
                    const med5Avail = !!(medicamento5Toggle && medicamento5Toggle.checked);
                    const med6Avail = !!(medicamento6Toggle && medicamento6Toggle.checked);
                    const availMap = { "2": med2Avail, "3": med3Avail, "4": med4Avail, "5": med5Avail, "6": med6Avail };
                    Array.from(medicamentoFrecuenciaAjustadaSelect.options).forEach((option) => {
                        if (availMap[option.value] !== undefined) {
                            option.hidden = !availMap[option.value];
                            option.disabled = !availMap[option.value];
                        }
                    });
                    const curVal = medicamentoFrecuenciaAjustadaSelect.value;
                    if (!showAdjustment || (curVal && availMap[curVal] === false)) {
                        medicamentoFrecuenciaAjustadaSelect.value = "";
                    }
                    syncSelectPlaceholderState(medicamentoFrecuenciaAjustadaSelect);
                }

                if (!showAdjustment && frecuenciaAjustadaSelect) {
                    frecuenciaAjustadaSelect.value = "";
                }

                if (frecuenciaAjustadaSelect) {
                    syncSelectPlaceholderState(frecuenciaAjustadaSelect);
                }
            };

            const syncDiasTratamientoIv = () => {
                if (!diasTratamientoIvInput) {
                    return;
                }

                if (!isMedicationAdministrationEnabled()) {
                    diasTratamientoIvInput.value = "";
                    return;
                }

                const days = [getMedicationDaysValue(diasMedicamentoPrincipalInput)];

                if (medicamento2Toggle && medicamento2Toggle.checked) {
                    days.push(getMedicationDaysValue(diasMedicamento2Input));
                }

                if (medicamento3Toggle && medicamento3Toggle.checked) { days.push(getMedicationDaysValue(diasMedicamento3Input)); }
                if (medicamento4Toggle && medicamento4Toggle.checked) { days.push(getMedicationDaysValue(diasMedicamento4Input)); }
                if (medicamento5Toggle && medicamento5Toggle.checked) { days.push(getMedicationDaysValue(diasMedicamento5Input)); }
                if (medicamento6Toggle && medicamento6Toggle.checked) { days.push(getMedicationDaysValue(diasMedicamento6Input)); }

                const maxDays = Math.max(...days);
                diasTratamientoIvInput.value = maxDays > 0 ? String(maxDays) : "";
            };

            const syncAplicacionesTotales = () => {
                if (!aplicacionesTotalesInput) {
                    return;
                }

                if (!isMedicationAdministrationEnabled()) {
                    aplicacionesTotalesInput.value = "";
                    syncDiasTratamientoIv();
                    syncFechaFinTratamiento();
                    return;
                }

                syncCambioFrecuenciaVisibility();

                let total = calculateMedicationApplicationsWithAdjustment(1, frecuenciaAdministracionMxPrincipalSelect, numeroDosisDiaMedicamentoPrincipalInput, diasMedicamentoPrincipalInput);

                if (medicamento2Toggle && medicamento2Toggle.checked) {
                    total += calculateMedicationApplicationsWithAdjustment(2, frecuenciaMedicamento2Select, numeroDosisMedicamento2Select, diasMedicamento2Input);
                }

                if (medicamento3Toggle && medicamento3Toggle.checked) {
                    total += calculateMedicationApplicationsWithAdjustment(3, frecuenciaMedicamento3Select, numeroDosisMedicamento3Select, diasMedicamento3Input);
                }
                if (medicamento4Toggle && medicamento4Toggle.checked) {
                    total += calculateMedicationApplicationsWithAdjustment(4, frecuenciaMedicamento4Select, numeroDosisMedicamento4Select, diasMedicamento4Input);
                }
                if (medicamento5Toggle && medicamento5Toggle.checked) {
                    total += calculateMedicationApplicationsWithAdjustment(5, frecuenciaMedicamento5Select, numeroDosisMedicamento5Select, diasMedicamento5Input);
                }
                if (medicamento6Toggle && medicamento6Toggle.checked) {
                    total += calculateMedicationApplicationsWithAdjustment(6, frecuenciaMedicamento6Select, numeroDosisMedicamento6Select, diasMedicamento6Input);
                }

                aplicacionesTotalesInput.value = String(total);
                syncDiasTratamientoIv();
                syncFechaFinTratamiento();
            };

            const syncPhoneVisibility = () => {
                const hasPhone2 = telefono2Input && telefono2Input.value.trim().length > 0;
                const hasPhone3 = telefono3Input && telefono3Input.value.trim().length > 0;

                if (telefono2Toggle && hasPhone2) {
                    telefono2Toggle.checked = true;
                }

                const showPhone2 = !!(telefono2Toggle && telefono2Toggle.checked);
                if (telefono2Container) {
                    telefono2Container.classList.toggle("d-none", !showPhone2);
                }

                if (!showPhone2) {
                    if (telefono2Input) {
                        telefono2Input.value = "";
                    }
                    if (telefono3Input) {
                        telefono3Input.value = "";
                    }
                    if (telefono3Toggle) {
                        telefono3Toggle.checked = false;
                    }
                    if (telefono3Container) {
                        telefono3Container.classList.add("d-none");
                    }
                    return;
                }

                if (telefono3Toggle && hasPhone3) {
                    telefono3Toggle.checked = true;
                }

                const showPhone3 = !!(telefono3Toggle && telefono3Toggle.checked);
                if (telefono3Container) {
                    telefono3Container.classList.toggle("d-none", !showPhone3);
                }

                if (!showPhone3 && telefono3Input) {
                    telefono3Input.value = "";
                }
            };

            const clearAdditionalMedicationFields = (nombreInput, dosisInput, medidaSelect, viaAdministracionSelect, frecuenciaSelect, dosisDiariaInput, diasInput) => {
                if (nombreInput) {
                    nombreInput.value = "";
                }

                if (dosisInput) {
                    dosisInput.value = "";
                }

                if (medidaSelect) {
                    medidaSelect.value = "";
                    syncSelectPlaceholderState(medidaSelect);
                }

                if (viaAdministracionSelect) {
                    viaAdministracionSelect.value = "";
                    syncSelectPlaceholderState(viaAdministracionSelect);
                }

                if (frecuenciaSelect) {
                    frecuenciaSelect.value = "";
                    syncSelectPlaceholderState(frecuenciaSelect);
                }

                if (dosisDiariaInput) {
                    dosisDiariaInput.value = "";
                }

                if (diasInput) {
                    diasInput.value = "";
                }
            };

            const clearMedicationAdministrationFields = () => {
                if (nombreMedicamentoPrincipalInput) {
                    nombreMedicamentoPrincipalInput.value = "";
                }

                if (dosisMedicamentoPrincipalInput) {
                    dosisMedicamentoPrincipalInput.value = "";
                }

                if (medidaMedicamentoPrincipalSelect) {
                    medidaMedicamentoPrincipalSelect.value = "";
                    syncSelectPlaceholderState(medidaMedicamentoPrincipalSelect);
                }

                if (viaAdministracionMedicamentoPrincipalSelect) {
                    viaAdministracionMedicamentoPrincipalSelect.value = "";
                    syncSelectPlaceholderState(viaAdministracionMedicamentoPrincipalSelect);
                }

                if (frecuenciaAdministracionMxPrincipalSelect) {
                    frecuenciaAdministracionMxPrincipalSelect.value = "";
                    syncSelectPlaceholderState(frecuenciaAdministracionMxPrincipalSelect);
                }

                if (numeroDosisDiaMedicamentoPrincipalInput) {
                    numeroDosisDiaMedicamentoPrincipalInput.value = "";
                }

                if (diasMedicamentoPrincipalInput) {
                    diasMedicamentoPrincipalInput.value = "";
                }

                if (medicamento2Toggle) {
                    medicamento2Toggle.checked = false;
                }

                if (medicamento3Toggle) {
                    medicamento3Toggle.checked = false;
                }

                clearAdditionalMedicationFields(nombreMedicamento2Input, dosisMedicamento2Input, medidaMedicamento2Select, viaAdministracionMedicamento2Select, frecuenciaMedicamento2Select, numeroDosisMedicamento2Select, diasMedicamento2Input);
                clearAdditionalMedicationFields(nombreMedicamento3Input, dosisMedicamento3Input, medidaMedicamento3Select, viaAdministracionMedicamento3Select, frecuenciaMedicamento3Select, numeroDosisMedicamento3Select, diasMedicamento3Input);

                if (cambioFrecuenciaAdministracionTtoSelect) {
                    cambioFrecuenciaAdministracionTtoSelect.value = "";
                }

                if (medicamentoFrecuenciaAjustadaSelect) {
                    medicamentoFrecuenciaAjustadaSelect.value = "";
                }

                if (frecuenciaAjustadaSelect) {
                    frecuenciaAjustadaSelect.value = "";
                }
            };

            const syncAdministracionMedicamentosVisibility = (clearValuesWhenDisabled = false) => {
                const shouldShowAdministrationFields = isMedicationAdministrationEnabled();

                if (administracionMedicamentosFieldsContainer) {
                    administracionMedicamentosFieldsContainer.classList.toggle("d-none", !shouldShowAdministrationFields);
                }

                diasNoMedicamentosContainer?.classList.toggle("d-none", shouldShowAdministrationFields);

                if (auxiliarAsignadoInput) {
                    auxiliarAsignadoInput.disabled = !shouldShowAdministrationFields;
                    syncAuxiliarAsignadoValidation(false);
                }
                syncSection3MedicamentoValidation(false);

                if (!shouldShowAdministrationFields) {
                    if (clearValuesWhenDisabled) {
                        clearMedicationAdministrationFields();
                    }

                    [medicamento2Container, medicamento3Container, medicamento4Container, medicamento5Container, medicamento6Container].forEach(c => { if (c) c.classList.add("d-none"); });
                    syncAplicacionesTotales();
                    syncFechaFinTratamiento();
                    return;
                }

                if (clearValuesWhenDisabled && diasNoMedicamentosInput) {
                    diasNoMedicamentosInput.value = "";
                }

                syncAllMedicationDailyDoses();
                syncMedicationVisibility(true);
                syncAplicacionesTotales();
                syncFechaFinTratamiento();
            };

            const hasMedData = (nameEl, dosisEl, medidaEl, viaEl, frecuenciaEl, numDosisEl) => !!(
                (nameEl && nameEl.value.trim().length > 0) || (dosisEl && dosisEl.value)
                || (medidaEl && medidaEl.value) || (viaEl && viaEl.value)
                || (frecuenciaEl && frecuenciaEl.value) || (numDosisEl && numDosisEl.value)
            );

            const syncMedicationVisibility = (hydrateFromExistingData = false) => {
                if (!isMedicationAdministrationEnabled()) {
                    [medicamento2Container, medicamento3Container, medicamento4Container, medicamento5Container, medicamento6Container].forEach(c => { if (c) c.classList.add("d-none"); });
                    return;
                }

                const hasData2 = hasMedData(nombreMedicamento2Input, dosisMedicamento2Input, medidaMedicamento2Select, viaAdministracionMedicamento2Select, frecuenciaMedicamento2Select, numeroDosisMedicamento2Select);
                const hasData3 = hasMedData(nombreMedicamento3Input, dosisMedicamento3Input, medidaMedicamento3Select, viaAdministracionMedicamento3Select, frecuenciaMedicamento3Select, numeroDosisMedicamento3Select);
                const hasData4 = hasMedData(nombreMedicamento4Input, dosisMedicamento4Input, medidaMedicamento4Select, viaAdministracionMedicamento4Select, frecuenciaMedicamento4Select, numeroDosisMedicamento4Select);
                const hasData5 = hasMedData(nombreMedicamento5Input, dosisMedicamento5Input, medidaMedicamento5Select, viaAdministracionMedicamento5Select, frecuenciaMedicamento5Select, numeroDosisMedicamento5Select);
                const hasData6 = hasMedData(nombreMedicamento6Input, dosisMedicamento6Input, medidaMedicamento6Select, viaAdministracionMedicamento6Select, frecuenciaMedicamento6Select, numeroDosisMedicamento6Select);

                if (hydrateFromExistingData) {
                    if (medicamento2Toggle && hasData2) medicamento2Toggle.checked = true;
                    if (medicamento3Toggle && hasData3) medicamento3Toggle.checked = true;
                    if (medicamento4Toggle && hasData4) medicamento4Toggle.checked = true;
                    if (medicamento5Toggle && hasData5) medicamento5Toggle.checked = true;
                    if (medicamento6Toggle && hasData6) medicamento6Toggle.checked = true;
                }

                const show2 = !!(medicamento2Toggle && medicamento2Toggle.checked);
                if (medicamento2Container) medicamento2Container.classList.toggle("d-none", !show2);

                if (!show2) {
                    [medicamento3Toggle, medicamento4Toggle, medicamento5Toggle, medicamento6Toggle].forEach(t => { if (t) t.checked = false; });
