            const escapeHtml = (value) => {
                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#39;");
            };

            const alphanumericIdentificationTypes = new Set(["PA", "CE"]);
            const normalizeDocumentValue = (value) => String(value || "")
                .toUpperCase()
                .replace(/[^A-Z0-9]/g, "")
                .trim();
            const normalizeAddressForComparison = (value) => String(value || "")
                .trim()
                .replace(/\s+/g, " ")
                .toLocaleUpperCase("es-CO");
            const normalizeCedulaFilter = (value) => normalizeDocumentValue(value);
            const allowsAlphaNumericIdentification = (value) => alphanumericIdentificationTypes.has(String(value || "").trim().toUpperCase());
            const syncNumeroIdentificacionMode = () => {
                if (!numeroIdentificacionInput) {
                    return;
                }

                const allowAlphaNumeric = allowsAlphaNumericIdentification(tipoIdentificacionSelect ? tipoIdentificacionSelect.value : "");
                numeroIdentificacionInput.setAttribute("inputmode", allowAlphaNumeric ? "text" : "numeric");
                numeroIdentificacionInput.title = allowAlphaNumeric
                    ? "Permite letras y números para PA o CE."
                    : "Solo permite dígitos para este tipo de identificación.";

                const currentValue = String(numeroIdentificacionInput.value || "").toUpperCase();
                numeroIdentificacionInput.value = allowAlphaNumeric
                    ? currentValue.replace(/[^A-Z0-9]/g, "").slice(0, 20)
                    : currentValue.replace(/\D/g, "").slice(0, 20);
            };

            const normalizeMedicationKey = (value) => String(value || "")
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toUpperCase()
                .replace(/[^A-Z0-9]+/g, " ")
                .trim()
                .replace(/\s+/g, " ");

            const normalizeCatalogOptionKey = (value) => normalizeMedicationKey(value);

            const medicamentoCatalogByName = new Map();
            (Array.isArray(medicamentoCatalog) ? medicamentoCatalog : []).forEach((item) => {
                const keys = [
                    normalizeCatalogOptionKey(item?.Nombre),
                    normalizeCatalogOptionKey(item?.NormalizedNombre)
                ].filter((key) => key);

                keys.forEach((key) => {
                    if (!medicamentoCatalogByName.has(key)) {
                        medicamentoCatalogByName.set(key, item);
                    }
                });
            });

            const getFormControlByName = (name) => form ? form.querySelector(`[name='${name}']`) : null;

            const getFormValue = (name) => {
                const control = getFormControlByName(name);
                return control ? String(control.value || "").trim() : "";
            };

            const setKardexFieldValue = (field, value) => {
                const control = document.querySelector(`#censoKardexModal [data-kardex-field='${field}']`);
                if (control) {
                    control.value = value || "";
                }
            };

            const formatDateForKardex = (value) => {
                if (!value) {
                    return "";
                }

                const parts = String(value).split("-");
                if (parts.length !== 3) {
                    return value;
                }

                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            };

            const buildMedicationDoseText = (medication) => {
                const doseParts = [
                    medication.dose,
                    medication.measure
                ].filter((part) => part);

                return [
                    medication.name,
                    doseParts.join(" "),
                    medication.route,
                    medication.frequency,
                    medication.days ? `POR ${medication.days} DIAS` : ""
                ]
                    .filter((part) => part)
                    .join(" ")
                    .toUpperCase();
            };

            const catalogValue = (metadata, field) => metadata && metadata[field] ? String(metadata[field]).trim() : "";

            const formatInfusionTime = (metadata) => {
                const value = catalogValue(metadata, "TiempoInfusionMinutos");
                if (!value || /NO APLICA/i.test(value) || /ORDEN MEDICA/i.test(value)) {
                    return value;
                }

                return /^\d+([.,]\d+)?$/.test(value) ? `${value} MIN` : value;
            };

            const setKardexMedicationRowField = (row, field, value) => {
                const control = document.querySelector(`#censoKardexModal [data-kardex-med-row='${row}'] [data-kardex-med-field='${field}']`);
                if (control) {
                    control.value = value || "";
                }
            };

            const setRequisitionFieldValue = (field, value) => {
                const control = document.querySelector(`#censoKardexModal [data-requisition-field='${field}']`);
                if (control) {
                    control.value = value || "";
                }
            };

            const setRequisitionRowField = (row, field, value) => {
                const control = document.querySelector(`#censoKardexModal [data-requisition-row='${row}'] [data-requisition-item-field='${field}']`);
                if (control) {
                    control.value = value || "";
                }
            };

            const parseRequisitionDecimal = (value) => {
                const normalized = String(value || "")
                    .replace(/,/g, ".")
                    .replace(/[^0-9.]/g, "");
                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const formatRequisitionQuantity = (value) => {
                const numeric = Number(value);
                if (!Number.isFinite(numeric) || numeric <= 0) {
                    return "";
                }

                return Number.isInteger(numeric)
                    ? String(numeric)
                    : String(Math.round(numeric * 100) / 100);
            };

            const parseFrequencyPerDay = (frequency) => {
                const normalized = String(frequency || "").toUpperCase();
                const numberMatch = normalized.match(/(\d+(?:[.,]\d+)?)/);
                const number = numberMatch ? parseRequisitionDecimal(numberMatch[1]) : 0;
                if (normalized.includes("24") && normalized.includes("HORA")) {
                    return 1;
                }

                if (normalized.includes("12") && normalized.includes("HORA")) {
                    return 2;
                }

                if (normalized.includes("8") && normalized.includes("HORA")) {
                    return 3;
                }

                if (normalized.includes("6") && normalized.includes("HORA")) {
                    return 4;
                }

                if (normalized.includes("4") && normalized.includes("HORA")) {
                    return 6;
                }

                if (number > 0 && normalized.includes("HORA")) {
                    return 24 / number;
                }

                if (normalized.includes("DIA") || normalized.includes("DIARIA")) {
                    return number > 0 ? number : 1;
                }

                return number;
            };

            const calculateMedicationRequisitionQuantity = (medication) => {
                const dose = Math.max(parseRequisitionDecimal(medication.dose) || 1, 1);
                const dailyDoses = parseRequisitionDecimal(medication.dailyDoses) || parseFrequencyPerDay(medication.frequency);
                const days = parseRequisitionDecimal(medication.days);
                return dose * dailyDoses * days;
            };

            const calculateEveryThreeDaysQuantity = (daysValue, minimumTwoWhenLessThanOne = false) => {
                const days = parseRequisitionDecimal(daysValue);
                if (days <= 0) {
                    return minimumTwoWhenLessThanOne ? 2 : 0;
                }

                const raw = days / 3;
                if (minimumTwoWhenLessThanOne && raw < 1) {
                    return 2;
                }

                return Math.ceil(raw);
            };

            const hasRequisitionMedication = (name) => {
                const value = String(name || "").trim();
                return value.length > 0 && value.toLowerCase() !== "no";
            };

            const getRequisitionMedications = () => {
                const fechaInicio = formatDateForKardex(getFormValue("FechaInicioTratamiento"));
                const fechaFin = formatDateForKardex(getFormValue("FechaFinTratamiento"));
                return [
                    {
                        name: getFormValue("NombreMedicamentoPrincipalTratante"),
                        dose: getFormValue("DosisMedicamentoPrincipal"),
                        frequency: getFormValue("FrecuenciaAdministracionMxPrincipal"),
                        dailyDoses: getFormValue("NumeroDosisDiaMedicamentoPrincipal"),
                        days: getFormValue("DiasMedicamentoPrincipal"),
                        startDate: fechaInicio,
                        endDate: fechaFin
                    },
                    {
                        name: getFormValue("NombreMedicamentoNumero2"),
                        dose: getFormValue("DosisMedicamento2"),
                        frequency: getFormValue("FrecuenciaAdministracionMedicamento2"),
                        dailyDoses: getFormValue("NumeroDosisMedicamento2"),
                        days: getFormValue("DiasMedicamento2"),
                        startDate: fechaInicio,
                        endDate: fechaFin
                    },
                    {
                        name: getFormValue("NombreMedicamentoNumero3"),
                        dose: getFormValue("DosisMedicamento3"),
                        frequency: getFormValue("FrecuenciaAdministracionMedicamento3"),
                        dailyDoses: getFormValue("NumeroDosisMedicamento3"),
                        days: getFormValue("DiasMedicamento3"),
                        startDate: fechaInicio,
                        endDate: fechaFin
                    },
                    {
