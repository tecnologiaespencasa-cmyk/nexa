                ipsQueRemiteInput.addEventListener("change", () => {
                    syncIpsQueRemiteValidation(true);
                });
                ipsQueRemiteInput.addEventListener("blur", () => {
                    syncIpsQueRemiteValidation(true);
                });
            }

            if (auxiliarAsignadoInput) {
                auxiliarAsignadoInput.addEventListener("input", () => {
                    syncAuxiliarAsignadoValidation(false);
                });
                auxiliarAsignadoInput.addEventListener("change", () => {
                    syncAuxiliarAsignadoValidation(true);
                });
                auxiliarAsignadoInput.addEventListener("blur", () => {
                    syncAuxiliarAsignadoValidation(true);
                });
            }

            section3MedicamentoEntries.forEach((entry) => {
                if (!entry.input) {
                    return;
                }

                entry.input.addEventListener("input", () => syncSection3MedicamentoValidation(false));
                entry.input.addEventListener("change", () => syncSection3MedicamentoValidation(true));
                entry.input.addEventListener("blur", () => syncSection3MedicamentoValidation(true));
            });

            prorrogaMedicamentoEntries.forEach((entry) => {
