                const requiredFields = new Set(section.getRequiredFields());
                sectionPane.querySelectorAll("[data-valmsg-for]").forEach((messageElement) => {
                    const fieldName = messageElement.getAttribute("data-valmsg-for");
                    if (!fieldName) {
                        return;
                    }

                    if (!requiredFields.has(fieldName) || isRequiredFieldCompleted(fieldName)) {
                        clearClientRequiredMessage(fieldName);
                        return;
                    }

                    setClientRequiredMessage(fieldName);
                });
            };

