                                <input class="form-control" id="cambiarPacienteDocumento" name="cedulaPaciente" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                                <button class="btn" type="submit" aria-label="Buscar paciente">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <circle cx="11" cy="11" r="7"></circle>
                                        <path d="m20 20-3.5-3.5"></path>
                                    </svg>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <a class="btn censo-current-patient__button censo-current-patient__button--primary" asp-action="ProgramaAgudos">
                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                    <span>Nuevo ingreso</span>
                </a>
            </div>
        </section>
    }

    <section class="censo-content">
