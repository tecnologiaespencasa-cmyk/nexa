                    <div class="tab-pane fade" id="tab-datos-basicos" role="tabpanel" aria-labelledby="tab-datos-basicos-link" data-section-title="Datos básicos del paciente" data-section-description="Consolida identificación, dirección, clasificación georreferenciada y canales de contacto.">
                        <div class="card">
                            <div class="card-body">
                                <section class="censo-field-section">
                                    <div class="censo-field-section__header">
                                        <span class="censo-field-section__icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" focusable="false">
                                                <circle cx="12" cy="8" r="3"></circle>
