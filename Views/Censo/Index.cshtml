@model CensoUnificadoViewModel
@using Nexa.Data.Entities
@using Nexa.Helpers
@section Styles
{
    <link rel="stylesheet" href="~/css/censo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/censo-unificado.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Censo";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var seccionInicial = ViewData["SeccionInicial"] as string;
    var p = Model.Paciente;
    var abiertos = Model.Programas.Where(x => x.Agregado).ToList();

    // El navegador lateral lista los programas que tienen panel: los abiertos y, ademas,
    // aquellos cuya ultima atencion esta cerrada. Sin esto el panel de una atencion cerrada se
    // renderizaba pero no habia por donde llegar a el.
    var agregados = Model.Programas
        .Where(x => x.Agregado || Model.AtencionSeleccionadaDe(x.Programa) is not null)
        .ToList();

    // La exclusividad la marca lo que esta ABIERTO. Un programa cerrado no bloquea nada.
    var terapiaActiva = abiertos.Any(x => x.Programa == CensoProgramas.TerapiaAmbulatoria);

    // "A, B y C": con tres o mas, comas y una sola conjuncion al final.
    var conflictos = Model.ProgramasEnConflicto.Count switch
    {
        0 => string.Empty,
        1 => Model.ProgramasEnConflicto[0],
        _ => string.Join(", ", Model.ProgramasEnConflicto.Take(Model.ProgramasEnConflicto.Count - 1))
             + " y " + Model.ProgramasEnConflicto[^1]
    };

    // Los valores "no parametrizado" son el estado de partida y el de respaldo, no una opcion
    // que alguien deba escoger a mano.
    bool EsSinParametrizar(string? valor) =>
        string.Equals(valor?.Trim(), "NO PARAMETRIZADO", StringComparison.OrdinalIgnoreCase);

    // La sección que se abre al entrar: la pedida por URL, la primera del programa activo, o la
    // recepción del paciente cuando todavía no hay programas.
    var seccionActiva = !string.IsNullOrWhiteSpace(seccionInicial)
        ? seccionInicial
        : (Model.ProgramaActivo is not null
            ? CensoProgramaSecciones.PrimeraSeccion(Model.ProgramaActivo)
            : CensoProgramaSecciones.Paciente[0].Id);

    Func<object?, object?> RequiredMark = _ => Html.Raw("<span class=\"censo-required\" aria-hidden=\"true\">*</span>");
}

<div class="censo-page censo-unificado">
    <aside class="censo-sidebar">
        <section class="censo-section-strip">
            <div class="censo-section-strip__nav">
                <div class="censo-nav censo-nav--top" id="censoUnificadoNav" role="tablist">

                    @{ var pacienteAbierto = CensoProgramaSecciones.Paciente.Any(x => x.Id == seccionActiva); }
                    <div class="censo-nav-grupo" data-censo-grupo data-abierto="@(pacienteAbierto ? "true" : "false")">
                        <button type="button" class="censo-nav-grupo__cabecera"
                                data-censo-grupo-toggle
                                aria-expanded="@(pacienteAbierto ? "true" : "false")"
                                aria-controls="censo-grupo-paciente">
                            <span class="censo-nav-grupo__punto" aria-hidden="true"></span>
                            <span class="censo-nav-grupo__titulo">Paciente</span>
                            <svg class="censo-nav-grupo__chevron" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m9 6 6 6-6 6"></path>
                            </svg>
                        </button>
                        <div class="censo-nav-grupo__secciones" id="censo-grupo-paciente">
                        <div class="censo-nav-grupo__pista">
@foreach (var seccion in CensoProgramaSecciones.Paciente)
{
                        <button class="list-group-item list-group-item-action censo-nav__item @(seccion.Id == seccionActiva ? "active" : null)"
                                type="button"
                                role="tab"
                                data-censo-tab="@seccion.Id"
                                aria-controls="@seccion.Id"
                                aria-selected="@((seccion.Id == seccionActiva).ToString().ToLowerInvariant())">
                            <span class="censo-nav__content">
                                <span class="censo-nav__eyebrow">@seccion.Eyebrow</span>
                                <span class="censo-nav__title">@seccion.Titulo</span>
                                <span class="censo-nav__description">@seccion.Descripcion</span>
                            </span>
                        </button>
}
                        </div>
                        </div>
                    </div>

@foreach (var chip in agregados)
{
    var secciones = CensoProgramaSecciones.De(chip.Programa);
    var grupoAbierto = secciones.Any(x => x.Id == seccionActiva);
                    <div class="censo-nav-grupo" data-programa="@chip.Programa"
                         data-censo-grupo data-abierto="@(grupoAbierto ? "true" : "false")">
                        <button type="button" class="censo-nav-grupo__cabecera"
                                data-censo-grupo-toggle
                                aria-expanded="@(grupoAbierto ? "true" : "false")"
                                aria-controls="censo-grupo-@chip.Programa">
                            <span class="censo-nav-grupo__punto" aria-hidden="true"></span>
                            <span class="censo-nav-grupo__titulo">@chip.Nombre</span>
    @if (Model.EsSoloLectura(chip.Programa))
    {
                            <span class="censo-nav-grupo__nota">Cerrada</span>
    }
                            <svg class="censo-nav-grupo__chevron" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m9 6 6 6-6 6"></path>
                            </svg>
                        </button>
                        <div class="censo-nav-grupo__secciones" id="censo-grupo-@chip.Programa">
                        <div class="censo-nav-grupo__pista">
    @foreach (var seccion in secciones)
    {
                        <button class="list-group-item list-group-item-action censo-nav__item @(seccion.Id == seccionActiva ? "active" : null)"
                                type="button"
                                role="tab"
                                data-censo-tab="@seccion.Id"
                                aria-controls="@seccion.Id"
                                aria-selected="@((seccion.Id == seccionActiva).ToString().ToLowerInvariant())">
                            <span class="censo-nav__content">
                                <span class="censo-nav__eyebrow">@seccion.Eyebrow</span>
                                <span class="censo-nav__title">@seccion.Titulo</span>
                                <span class="censo-nav__description">@seccion.Descripcion</span>
                            </span>
                        </button>
    }
                        </div>
                        </div>
                    </div>
}
                </div>
            </div>
        </section>
    </aside>

    <div class="censo-content">

        @* =================== Ficha del paciente ===================
           Una sola tarjeta con las tres cosas que hay que saber antes de tocar nada: quién es,
           en qué programas está, y qué atención se está editando. Antes eran tres marcos
           separados y la misma información aparecía dos veces (los programas activos se leían
           arriba y abajo). Las bandas solo aparecen cuando tienen algo que decir. *@
        <section class="censo-ficha" aria-label="Paciente del censo">
            <div class="censo-ficha__banda censo-ficha__banda--identidad">
@if (Model.PacienteGuardado)
{
                <div class="censo-ficha__quien">
                    <h2 class="censo-ficha__nombre">@p.NombrePaciente</h2>
                    @* Los identificadores van en una sola línea: se comparan de un vistazo, no se
                       leen uno por uno, y cada uno con su propia etiqueta era media pantalla. *@
                    @{
                        // Desde cuándo es paciente: la más antigua de todas sus atenciones. Antes
                        // se leía del maestro, que guardaba una sola fecha de ingreso; ahora cada
                        // ingreso tiene la suya y la de la ficha es la primera de todas.
                        var desde = Model.Atenciones.Values
                            .SelectMany(x => x)
                            .Select(x => x.Desde)
                            .Where(x => x.HasValue)
                            .OrderBy(x => x)
                            .FirstOrDefault();
                    }
                    <p class="censo-ficha__meta">
                        <span>@p.TipoIdentificacion @p.NumeroIdentificacion</span>
                        <span>@p.Edad años</span>
                        @if (desde.HasValue)
                        {
                            <span>Paciente desde @desde.Value.ToString("dd/MM/yyyy")</span>
                        }
                    </p>
                </div>
}
else
{
                <div class="censo-ficha__quien">
                    <h2 class="censo-ficha__nombre censo-ficha__nombre--vacio">Nuevo paciente</h2>
                </div>
}
                <form method="get" asp-action="Index" class="censo-ficha__buscador" role="search">
                    <label class="visually-hidden" for="buscarDocumento">Número de documento</label>
                    <div class="censo-buscador__campo">
                        <svg class="censo-buscador__icono" viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m20 20-3.5-3.5"></path>
                        </svg>
                        <input type="text" class="censo-buscador__input" id="buscarDocumento" name="cedulaPaciente"
                               value="@Model.CedulaFiltro" placeholder="Documento del paciente" autocomplete="off" inputmode="numeric" />
                    </div>
                    <button class="censo-boton censo-boton--solido" type="submit">Buscar</button>
                    <a class="censo-boton censo-boton--sutil" asp-action="Index">Nuevo</a>
                </form>
            </div>

@if (Model.BusquedaSinResultados)
{
            @* Una búsqueda sin resultados no decía nada y la pantalla se quedaba igual que al
               entrar: no se sabía si el documento no existe o si la búsqueda no corrió. *@
            <div class="censo-ficha__banda censo-ficha__sin-resultados" role="status">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <path d="m20 20-3.5-3.5"></path>
                </svg>
                <p>
                    Ningún paciente con el documento <strong>@Model.CedulaFiltro</strong>.
                    Revisa el número o diligencia la recepción para crearlo.
                </p>
            </div>
}

            @* Los programas del paciente. Se fue el titulo y el parrafo de ayuda: las etiquetas
               de los dos grupos ya dicen la regla, y quien usa esta pantalla todos los dias no
               necesita que se la repitan en cada busqueda. *@
            <div class="censo-ficha__banda censo-ficha__banda--programas">
                @* La exclusion entre los base se ve en la estructura: comparten un solo marco
                   partido por lineas. Lo que va fuera de ese marco se puede sumar. *@
                <div class="censo-carril__grupo">
                    <p class="censo-carril__grupo-titulo">Programa base</p>
                    <div class="censo-carril__segmento" role="group"
                         aria-label="Programa base: agudos, cronicos o terapia ambulatoria, excluyentes entre si">
@foreach (var chip in Model.Programas.Where(x => CensoProgramas.EsBase(x.Programa)))
{
                        <partial name="_CensoProgramaChip" model="chip" view-data="@(new ViewDataDictionary(ViewData) { { "PacienteId", p.PacienteId }, { "CedulaFiltro", Model.CedulaFiltro } })" />
}
                    </div>
                </div>

                <div class="censo-carril__grupo censo-carril__grupo--adicionales">
                    <p class="censo-carril__grupo-titulo">
                        Programas adicionales
                        @* Solo se habla cuando hay algo que no se ve: que con terapia activa estos
                           dos no se pueden agregar. Que se combinan entre si ya lo dice el que
                           esten fuera del marco de los base. *@
@if (terapiaActiva)
{
                        <span class="censo-carril__grupo-nota">No disponibles con terapia ambulatoria</span>
}
                    </p>
                    <div class="censo-carril__adicionales">
@foreach (var chip in Model.Programas.Where(x => !CensoProgramas.EsBase(x.Programa)))
{
                        <partial name="_CensoProgramaChip" model="chip" view-data="@(new ViewDataDictionary(ViewData) { { "PacienteId", p.PacienteId }, { "CedulaFiltro", Model.CedulaFiltro } })" />
}
                    </div>
                </div>
@if (abiertos.Count == 0 && Model.PacienteGuardado)
{
                @* A lo ancho de la banda, debajo de los dos grupos: habla de los dos, no del
                   segundo. Dentro del grupo de adicionales se leia como una nota suya. *@
                <p class="censo-carril__aviso">Agrega un programa para registrar la atencion.</p>
}
            </div>

            @* La atencion que se esta editando. Hay una banda por programa y solo se ve la del
               programa activo, con el mismo mecanismo que ya usa la barra de guardado. *@
@foreach (var programa in CensoProgramas.Todos.Where(x => Model.AtencionSeleccionadaDe(x) is not null))
{
            <div class="censo-ficha__banda censo-ficha__banda--atencion" data-programa="@programa"
                 data-censo-banda-atencion>
                <partial name="_CensoAtenciones" model="Model.AtencionesDe(programa)"
                         view-data="@(new ViewDataDictionary(ViewData) { { "CedulaFiltro", Model.CedulaFiltro } })" />
                <partial name="_CensoAtencionCerrada" model="Model.AtencionSeleccionadaDe(programa)"
                         view-data="@(new ViewDataDictionary(ViewData) { { "CedulaFiltro", Model.CedulaFiltro }, { "PuedeReabrir", Model.PuedeReabrirAtencion } })" />
            </div>
}
        </section>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
        <div class="alert alert-success" role="status">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
        <div class="alert alert-danger" role="alert">@errorMessage</div>
}
@if (Model.TieneConflicto)
{
        <div class="alert alert-warning" role="alert">
            Este paciente tiene @conflictos abiertos al mismo tiempo, de antes de que esa combinación
            dejara de permitirse. Todos siguen funcionando; al cerrar uno ya no se podrá volver a abrir
            mientras otro siga activo.
        </div>
}

        @* ================= Recepción y datos básicos del paciente ================= *@
        <form asp-action="GuardarPaciente" method="post" id="censoPacienteForm" class="censo-form-shell">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Paciente.PacienteId" />
            <input type="hidden" asp-for="Paciente.DireccionEsValida" id="direccionEsValidaInput" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger censo-validation-summary mb-4" role="alert"></div>

            <div class="tab-content">

                @* La recepción ya no se captura aquí: es de cada ingreso y vive en el panel de su
                   programa. Lo que queda en la ficha del paciente es lo que de verdad se conserva
                   entre un ingreso y el siguiente. *@

                @* ---------- Sección: Datos básicos del paciente ---------- *@
                <div class="tab-pane fade @(seccionActiva == "tab-paciente-datos-basicos" ? "show active" : null)"
                     id="tab-paciente-datos-basicos" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="censo-card-heading">
                                    <span class="censo-card-heading__eyebrow">Paciente</span>
                                    <h2 class="h5 mb-0">Datos básicos del paciente</h2>
                                </div>
                                @* El extractor llena los datos del paciente, así que acompaña a esta
                                   sección. Estaba en la recepción, que se fue al panel del programa. *@
                                <button type="button" class="btn btn-sm censo-extractor-open-btn" id="abrirExtractorRemisionBtn">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <path d="M14 2v6h6"></path>
                                    </svg>
                                    <span>Extraer datos de remisión</span>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <h3>Información personal</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-6">
                                        <label asp-for="Paciente.NombrePaciente" class="form-label"></label>@RequiredMark(null)
                                        <input asp-for="Paciente.NombrePaciente" class="form-control" autocomplete="off"
                                               placeholder="Nombre completo del paciente" />
                                        <span asp-validation-for="Paciente.NombrePaciente" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Paciente.TipoIdentificacion" class="form-label"></label>@RequiredMark(null)
                                        <select asp-for="Paciente.TipoIdentificacion" asp-items="Model.TipoIdentificacionOptions"
                                                class="form-select" id="tipoIdentificacionInput">
                                            <option value="">Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Paciente.TipoIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Paciente.NumeroIdentificacion" class="form-label"></label>@RequiredMark(null)
                                        <input asp-for="Paciente.NumeroIdentificacion" class="form-control" maxlength="20"
                                               autocomplete="off" id="numeroIdentificacionMaestroInput" />
                                        <span asp-validation-for="Paciente.NumeroIdentificacion" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Paciente.FechaNacimiento" class="form-label"></label>@RequiredMark(null)
                                        <input asp-for="Paciente.FechaNacimiento" type="date" class="form-control"
                                               id="fechaNacimientoMaestroInput" max="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" />
                                        <span asp-validation-for="Paciente.FechaNacimiento" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-2">
                                        <label asp-for="Paciente.Edad" class="form-label"></label>
                                        <input asp-for="Paciente.Edad" class="form-control" id="edadMaestroInput" readonly />
                                    </div>
                                    <div class="col-lg-3">
                                        <label asp-for="Paciente.Genero" class="form-label"></label>
                                        <select asp-for="Paciente.Genero" asp-items="Model.GeneroOptions" class="form-select">
                                            <option value="">Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Paciente.Genero" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="Paciente.CorreoElectronico" class="form-label"></label>
                                        <input asp-for="Paciente.CorreoElectronico" class="form-control" type="email"
                                               autocomplete="off" placeholder="correo@@ejemplo.com" />
                                        <span asp-validation-for="Paciente.CorreoElectronico" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <h3>Información clínica y asegurador</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-lg-3">
                                        <label asp-for="Paciente.CodigoCie10" class="form-label"></label>
                                        <input asp-for="Paciente.CodigoCie10" class="form-control" maxlength="4"
                                               autocomplete="off" id="codigoCie10MaestroInput" placeholder="Ej: A090" />
                                        <span asp-validation-for="Paciente.CodigoCie10" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-5">
                                        <label asp-for="Paciente.DiagnosticoDescriptivo" class="form-label"></label>
                                        <input asp-for="Paciente.DiagnosticoDescriptivo" class="form-control"
                                               id="diagnosticoMaestroInput" readonly />
                                        <span asp-validation-for="Paciente.DiagnosticoDescriptivo" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="Paciente.Asegurador" class="form-label"></label>
                                        <select asp-for="Paciente.Asegurador" asp-items="Model.AseguradorOptions" class="form-select">
                                            <option value="">Selecciona...</option>
                                        </select>
                                        <span asp-validation-for="Paciente.Asegurador" class="text-danger"></span>
                                    </div>
                                </div>
                            </section>

                            <section class="censo-field-section">
                                <div class="censo-field-section__header">
                                    <h3>Dirección y ubicación</h3>
                                </div>
                                <div class="row g-3 censo-field-section__grid">
                                    <div class="col-12">
                                        <label asp-for="Paciente.Direccion" class="form-label"></label>
                                        <div class="input-group censo-direccion-group">
                                            <input asp-for="Paciente.Direccion" class="form-control" id="direccionMaestroInput"
                                                   placeholder="Dirección completa del paciente" />
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="validarDireccionMaestroBtn">Validar dirección</button>
                                            <button class="btn btn-outline-secondary censo-direccion-group__btn" type="button" id="limpiarDireccionMaestroBtn">Limpiar</button>
                                        </div>
                                        <span asp-validation-for="Paciente.Direccion" class="text-danger d-block"></span>
                                        <div class="alert d-none mt-2" id="direccionMaestroMensaje"></div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check censo-direccion-check">
                                            <input asp-for="Paciente.AsumirDireccionErrada" class="form-check-input" type="checkbox" />
                                            <label asp-for="Paciente.AsumirDireccionErrada" class="form-check-label">
                                                Asumir dirección errada y continuar
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label asp-for="Paciente.DetalleDireccion" class="form-label"></label>
                                        <input asp-for="Paciente.DetalleDireccion" class="form-control" maxlength="200"
                                               placeholder="Ej: Apartamento 501 torre 2" />
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="Paciente.ClasificacionZonaSura" class="form-label"></label>
                                        <select asp-for="Paciente.ClasificacionZonaSura" asp-items="Model.ClasificacionZonaSuraOptions"
                                                class="form-select" id="clasificacionZonaSuraMaestroSelect"></select>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="Paciente.MunicipioResidencia" class="form-label"></label>@RequiredMark(null)
                                        @* "No parametrizado" no aparece: es el estado del que hay que salir, no una
                                           opcion. Un paciente guardado con ese valor cae aqui sin municipio elegido,
                                           que es justo lo que obliga a resolverlo antes de volver a guardar. *@
                                        <select asp-for="Paciente.MunicipioResidencia" class="form-select" id="municipioMaestroSelect">
@foreach (var opcion in Model.MunicipioResidenciaOptions.Where(x => !EsSinParametrizar(x.Value)))
{
                                            <option value="@opcion.Value"
                                                    selected="@(string.Equals(opcion.Value, Model.Paciente.MunicipioResidencia, StringComparison.OrdinalIgnoreCase))">@opcion.Text</option>
}
                                        </select>
                                        <span asp-validation-for="Paciente.MunicipioResidencia" class="text-danger"></span>
                                    </div>
                                    <div class="col-lg-4">
                                        <label asp-for="Paciente.Barrio" class="form-label"></label>@RequiredMark(null)
                                        <input asp-for="Paciente.Barrio" class="form-control" id="barrioMaestroInput"
                                               list="barrioMaestroOptions" autocomplete="off" maxlength="120"
                                               placeholder="Escribe para buscar el barrio" />
                                        <datalist id="barrioMaestroOptions">
@foreach (var barrio in Model.BarrioOptions.Where(x => !EsSinParametrizar(x)))
{
                                            <option value="@barrio.ToUpperInvariant()"></option>
}
                                        </datalist>
