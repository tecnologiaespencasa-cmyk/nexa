                    endDate: fechaFin
                });

                syncKardexMedicationRow(3, {
                    name: getFormValue("NombreMedicamentoNumero3"),
                    dose: getFormValue("DosisMedicamento3"),
                    measure: getFormValue("MedidaMedicamento3"),
                    route: getFormValue("ViaAdministracionMedicamento3"),
                    frequency: getFormValue("FrecuenciaAdministracionMedicamento3"),
                    days: getFormValue("DiasMedicamento3"),
                    startDate: fechaInicio,
                    endDate: fechaFin
                });

                syncKardexMedicationRow(4, {
                    name: getFormValue("NombreMedicamentoNumero4"),
                    dose: getFormValue("DosisMedicamento4"),
                    measure: getFormValue("MedidaMedicamento4"),
                    route: getFormValue("ViaAdministracionMedicamento4"),
                    frequency: getFormValue("FrecuenciaAdministracionMedicamento4"),
                    days: getFormValue("DiasMedicamento4"),
                    startDate: fechaInicio,
                    endDate: fechaFin
                });

                syncKardexMedicationRow(5, {
                    name: getFormValue("NombreMedicamentoNumero5"),
                    dose: getFormValue("DosisMedicamento5"),
                    measure: getFormValue("MedidaMedicamento5"),
                    route: getFormValue("ViaAdministracionMedicamento5"),
                    frequency: getFormValue("FrecuenciaAdministracionMedicamento5"),
                    days: getFormValue("DiasMedicamento5"),
                    startDate: fechaInicio,
                    endDate: fechaFin
                });

                syncKardexMedicationRow(6, {
                    name: getFormValue("NombreMedicamentoNumero6"),
                    dose: getFormValue("DosisMedicamento6"),
                    measure: getFormValue("MedidaMedicamento6"),
                    route: getFormValue("ViaAdministracionMedicamento6"),
                    frequency: getFormValue("FrecuenciaAdministracionMedicamento6"),
                    days: getFormValue("DiasMedicamento6"),
                    startDate: fechaInicio,
                    endDate: fechaFin
                });
            };

            const syncKardexFromProrroga = (p) => {
                if (!p) { syncKardexSheet(); return; }
                const tipoDocumento = getFormValue("TipoIdentificacion");
                const numeroDocumento = getFormValue("NumeroIdentificacion");
                const telefonos = [
                    getFormValue("Telefono1"),
                    getFormValue("Telefono2"),
                    getFormValue("Telefono3")
                ].filter((v) => v).join(" / ");
                const fechaInicio = formatDateForKardex(p.fechaInicioTratamiento || "");
                const fechaFin = formatDateForKardex(p.fechaFinTratamiento || "");
                const auxiliarProrroga = (p.auxiliarAsignado || "").trim() || getFormValue("AuxiliarAsignado");

                setKardexFieldValue("paciente", getFormValue("NombrePaciente"));
                setKardexFieldValue("asegurador", getFormValue("Asegurador"));
                setKardexFieldValue("documento", [tipoDocumento, numeroDocumento].filter((v) => v).join(" "));
                setKardexFieldValue("direccion", [getFormValue("Direccion"), getFormValue("DetalleDireccion")].filter((v) => v).join(" "));
                setKardexFieldValue("telefonos", telefonos);
                setKardexFieldValue("edad", getFormValue("Edad"));
                setKardexFieldValue("cie10", getFormValue("CodigoCie10"));
                setKardexFieldValue("diagnostico", getFormValue("DiagnosticoDescriptivo"));
                setKardexFieldValue("observaciones", "");
                setKardexFieldValue("programador", getFormValue("ResponsableLlamadaBienvenida"));
                setKardexFieldValue("auxiliarAsignado", auxiliarProrroga);

                const prorrogaMeds = [
                    { name: p.nombreMedicamentoPrincipal, dose: p.dosisMedicamentoPrincipal, measure: p.medidaMedicamentoPrincipal, route: p.viaAdministracionMedicamentoPrincipal, frequency: p.frecuenciaAdministracionMxPrincipal, days: p.diasMedicamentoPrincipal },
                    p.tieneSegundoMedicamento ? { name: p.nombreMedicamentoNumero2, dose: p.dosisMedicamento2, measure: p.medidaMedicamento2, route: p.viaAdministracionMedicamento2, frequency: p.frecuenciaAdministracionMedicamento2, days: p.diasMedicamento2 } : null,
                    p.tieneTercerMedicamento ? { name: p.nombreMedicamentoNumero3, dose: p.dosisMedicamento3, measure: p.medidaMedicamento3, route: p.viaAdministracionMedicamento3, frequency: p.frecuenciaAdministracionMedicamento3, days: p.diasMedicamento3 } : null,
                    p.tieneCuartoMedicamento ? { name: p.nombreMedicamentoNumero4, dose: p.dosisMedicamento4, measure: p.medidaMedicamento4, route: p.viaAdministracionMedicamento4, frequency: p.frecuenciaAdministracionMedicamento4, days: p.diasMedicamento4 } : null,
                    p.tieneQuintoMedicamento ? { name: p.nombreMedicamentoNumero5, dose: p.dosisMedicamento5, measure: p.medidaMedicamento5, route: p.viaAdministracionMedicamento5, frequency: p.frecuenciaAdministracionMedicamento5, days: p.diasMedicamento5 } : null,
                    p.tieneSextoMedicamento ? { name: p.nombreMedicamentoNumero6, dose: p.dosisMedicamento6, measure: p.medidaMedicamento6, route: p.viaAdministracionMedicamento6, frequency: p.frecuenciaAdministracionMedicamento6, days: p.diasMedicamento6 } : null,
                ];
                for (let i = 0; i < 6; i++) {
                    const med = prorrogaMeds[i];
                    syncKardexMedicationRow(i + 1, {
                        name: med?.name || "",
                        dose: med?.dose || "",
                        measure: med?.measure || "",
                        route: med?.route || "",
                        frequency: med?.frequency || "",
                        days: med?.days || "",
                        startDate: med?.name ? fechaInicio : "",
                        endDate: med?.name ? fechaFin : ""
                    });
                }
            };

            const syncRequisitionFromProrroga = (p) => {
                if (!p) { syncRequisitionSheet(); return; }
                const telefonos = [
                    getFormValue("Telefono1"),
                    getFormValue("Telefono2"),
                    getFormValue("Telefono3")
                ].filter((v) => v).join(" / ");
                const auxiliarProrroga = (p.auxiliarAsignado || "").trim() || getFormValue("AuxiliarAsignado");
                setRequisitionFieldValue("auxiliarEncargado", auxiliarProrroga);
                setRequisitionFieldValue("realizadoPor", getFormValue("NombreRealizaKardex"));
                setRequisitionFieldValue("paciente", getFormValue("NombrePaciente"));
                setRequisitionFieldValue("autorizacion", getFormValue("AutorizacionEvento"));
                setRequisitionFieldValue("documento", getFormValue("NumeroIdentificacion"));
                setRequisitionFieldValue("direccion", getFormValue("Direccion"));
                setRequisitionFieldValue("telefonos", telefonos);
                setRequisitionFieldValue("diagnostico", [getFormValue("CodigoCie10"), getFormValue("DiagnosticoDescriptivo")].filter((v) => v).join(" "));

                const fechaInicio = formatDateForKardex(p.fechaInicioTratamiento || "");
                const fechaFin = formatDateForKardex(p.fechaFinTratamiento || "");

                const medications = [
                    { name: p.nombreMedicamentoPrincipal, dose: p.dosisMedicamentoPrincipal, frequency: p.frecuenciaAdministracionMxPrincipal, dailyDoses: "", days: p.diasMedicamentoPrincipal, startDate: fechaInicio, endDate: fechaFin },
                    p.tieneSegundoMedicamento ? { name: p.nombreMedicamentoNumero2, dose: p.dosisMedicamento2, frequency: p.frecuenciaAdministracionMedicamento2, dailyDoses: "", days: p.diasMedicamento2, startDate: fechaInicio, endDate: fechaFin } : null,
                    p.tieneTercerMedicamento ? { name: p.nombreMedicamentoNumero3, dose: p.dosisMedicamento3, frequency: p.frecuenciaAdministracionMedicamento3, dailyDoses: "", days: p.diasMedicamento3, startDate: fechaInicio, endDate: fechaFin } : null,
                    p.tieneCuartoMedicamento ? { name: p.nombreMedicamentoNumero4, dose: p.dosisMedicamento4, frequency: p.frecuenciaAdministracionMedicamento4, dailyDoses: "", days: p.diasMedicamento4, startDate: fechaInicio, endDate: fechaFin } : null,
                    p.tieneQuintoMedicamento ? { name: p.nombreMedicamentoNumero5, dose: p.dosisMedicamento5, frequency: p.frecuenciaAdministracionMedicamento5, dailyDoses: "", days: p.diasMedicamento5, startDate: fechaInicio, endDate: fechaFin } : null,
                    p.tieneSextoMedicamento ? { name: p.nombreMedicamentoNumero6, dose: p.dosisMedicamento6, frequency: p.frecuenciaAdministracionMedicamento6, dailyDoses: "", days: p.diasMedicamento6, startDate: fechaInicio, endDate: fechaFin } : null,
                ].filter((m) => m && hasRequisitionMedication(m.name));

                const rows = medications.map((medication) => ({
                    descripcion: medication.name,
                    detalle: "",
                    cantidad: formatRequisitionQuantity(calculateMedicationRequisitionQuantity(medication)),
                    fechaInicio: medication.startDate,
                    fechaFin: medication.endDate
                }));

                const pushDistinctCatalogRows = (description, field, quantity) => {
                    const details = new Map();
                    medications.forEach((medication) => {
                        const metadata = medicamentoCatalogByName.get(normalizeMedicationKey(medication.name));
                        const detail = catalogValue(metadata, field);
                        if (detail) details.set(detail.toUpperCase(), detail);
                    });
                    details.forEach((detail) => {
                        rows.push({
                            descripcion: description,
                            detalle: detail,
                            cantidad: typeof quantity === "function" ? quantity() : quantity,
                            fechaInicio: medications[0]?.startDate || "",
                            fechaFin: medications[0]?.endDate || ""
                        });
                    });
                };

                const aplicacionesTotales = formatRequisitionQuantity(parseRequisitionDecimal(p.aplicacionesTotales || ""));
                const diasTratamientoIv = p.diasTratamientoIv || "";
                pushDistinctCatalogRows("SOLUCION PARA DILUCION", "SolucionParaDilucion", "");
                pushDistinctCatalogRows("JERINGA", "Jeringa", aplicacionesTotales);
                [
                    ["JELCO #22", calculateEveryThreeDaysQuantity(diasTratamientoIv, true)],
                    ["ATI", calculateEveryThreeDaysQuantity(diasTratamientoIv)],
                    ["MACROGOTERO", calculateEveryThreeDaysQuantity(diasTratamientoIv)],
                    ["BURETRA", calculateEveryThreeDaysQuantity(diasTratamientoIv)],
                    ["GUANTES (PAR)", parseRequisitionDecimal(p.aplicacionesTotales || "")]
                ].forEach(([descripcion, cantidad]) => {
                    rows.push({
                        descripcion,
                        detalle: "",
                        cantidad: formatRequisitionQuantity(cantidad),
                        fechaInicio: medications[0]?.startDate || "",
                        fechaFin: medications[0]?.endDate || ""
                    });
                });

                for (let row = 1; row <= 16; row++) {
                    const data = rows[row - 1] || {};
                    setRequisitionRowField(row, "item", row);
                    setRequisitionRowField(row, "descripcion", data.descripcion || "");
                    setRequisitionRowField(row, "detalle", data.detalle || "");
                    setRequisitionRowField(row, "cantidad", data.cantidad || "");
                    setRequisitionRowField(row, "fechaInicio", data.fechaInicio || "");
                    setRequisitionRowField(row, "fechaFin", data.fechaFin || "");
                }
            };

            const adjuntosListEl = document.getElementById("adjuntosList");
            const adjuntoFileInput = document.getElementById("adjuntoFileInput");
            const subirAdjuntoBtn = document.getElementById("subirAdjuntoBtn");
            const adjuntoUploadStatus = document.getElementById("adjuntoUploadStatus");

            const renderAdjuntos = (adjuntos) => {
                if (!adjuntosListEl) return;
                adjuntosListEl.innerHTML = "";
                if (!adjuntos || adjuntos.length === 0) {
                    adjuntosListEl.innerHTML = `<li class="list-group-item py-1 small text-muted">Sin adjuntos</li>`;
                    return;
                }
                adjuntos.forEach((adj) => {
                    const li = document.createElement("li");
                    li.className = "list-group-item d-flex align-items-center justify-content-between py-1 px-2 small";
                    li.innerHTML = `
                        <a href="${descargarAdjuntoUrl}?adjuntoId=${adj.id}" target="_blank" class="text-truncate me-2" style="max-width:260px" title="${escapeHtml(adj.fileName)}">${escapeHtml(adj.fileName)}</a>
                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 censo-adjunto-delete-btn" data-adjunto-id="${adj.id}" title="Eliminar adjunto" aria-label="Eliminar ${escapeHtml(adj.fileName)}">
                            <svg viewBox="0 0 24 24" width="14" height="14" focusable="false" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                        </button>`;
                    adjuntosListEl.appendChild(li);
                });
            };

            const loadAdjuntos = async (recordId) => {
                if (!recordId || recordId <= 0 || !adjuntosListEl) return;
                try {
                    const resp = await fetch(`${obtenerAdjuntosUrl}?id=${recordId}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        renderAdjuntos(data);
                    }
                } catch { /* sin adjuntos cargados */ }
            };

            if (adjuntosListEl) {
                adjuntosListEl.addEventListener("click", async (e) => {
                    const btn = e.target.closest(".censo-adjunto-delete-btn");
                    if (!btn) return;
                    const adjuntoId = btn.dataset.adjuntoId;
                    if (!adjuntoId) return;
                    btn.disabled = true;
                    try {
                        const formData = new FormData();
                        formData.append("adjuntoId", adjuntoId);
                        const resp = await fetch(eliminarAdjuntoUrl, {
                            method: "POST",
                            body: formData,
                            headers: csrfTokenInput?.value ? { "RequestVerificationToken": csrfTokenInput.value } : {}
                        });
                        if (resp.ok) {
                            btn.closest("li")?.remove();
                            if (adjuntosListEl.children.length === 0) {
                                adjuntosListEl.innerHTML = `<li class="list-group-item py-1 small text-muted">Sin adjuntos</li>`;
                            }
                        }
                    } catch { btn.disabled = false; }
                });
            }

            if (subirAdjuntoBtn && adjuntoFileInput) {
                subirAdjuntoBtn.addEventListener("click", () => adjuntoFileInput.click());
                adjuntoFileInput.addEventListener("change", async () => {
                    const file = adjuntoFileInput.files?.[0];
                    if (!file) return;
                    const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                    if (recordId <= 0) {
                        if (adjuntoUploadStatus) adjuntoUploadStatus.textContent = "Guarda el censo primero.";
                        adjuntoFileInput.value = "";
                        return;
                    }
                    if (adjuntoUploadStatus) adjuntoUploadStatus.textContent = "Subiendo…";
                    subirAdjuntoBtn.disabled = true;
                    try {
                        const formData = new FormData();
                        formData.append("id", String(recordId));
                        formData.append("file", file);
                        const resp = await fetch(subirAdjuntoUrl, {
                            method: "POST",
                            body: formData,
                            headers: csrfTokenInput?.value ? { "RequestVerificationToken": csrfTokenInput.value } : {}
                        });
                        if (resp.ok) {
                            const data = await resp.json();
                            const emptyMsg = adjuntosListEl?.querySelector(".text-muted");
                            emptyMsg?.remove();
                            const li = document.createElement("li");
                            li.className = "list-group-item d-flex align-items-center justify-content-between py-1 px-2 small";
                            li.innerHTML = `
                                <a href="${descargarAdjuntoUrl}?adjuntoId=${data.adjuntoId}" target="_blank" class="text-truncate me-2" style="max-width:260px" title="${escapeHtml(data.fileName)}">${escapeHtml(data.fileName)}</a>
                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 censo-adjunto-delete-btn" data-adjunto-id="${data.adjuntoId}" title="Eliminar adjunto" aria-label="Eliminar ${escapeHtml(data.fileName)}">
                                    <svg viewBox="0 0 24 24" width="14" height="14" focusable="false" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                </button>`;
                            adjuntosListEl?.appendChild(li);
                            if (adjuntoUploadStatus) adjuntoUploadStatus.textContent = "Adjunto subido.";
                        } else {
                            const err = await resp.json().catch(() => ({}));
                            if (adjuntoUploadStatus) adjuntoUploadStatus.textContent = err.message || "Error al subir.";
                        }
                    } catch {
                        if (adjuntoUploadStatus) adjuntoUploadStatus.textContent = "Error de conexión.";
                    } finally {
                        subirAdjuntoBtn.disabled = false;
                        adjuntoFileInput.value = "";
                    }
                });
            }

            const collectKardexPayload = () => {
                const fields = {};
                document.querySelectorAll("#censoKardexModal [data-kardex-field]").forEach((control) => {
                    fields[control.dataset.kardexField] = control.value || "";
                });
                const medRows = Array.from(document.querySelectorAll("#censoKardexModal [data-kardex-med-row]"))
                    .map((rowElement) => {
                        const rowData = { row: rowElement.dataset.kardexMedRow };
                        rowElement.querySelectorAll("[data-kardex-med-field]").forEach((control) => {
                            rowData[control.dataset.kardexMedField] = control.value || "";
                        });
                        return rowData;
                    });
                return { fields, medRows };
            };

            // Campos del kardex que provienen de las secciones 1, 2 y 3 (datos del paciente):
            // siempre se sincronizan desde el formulario actual y NUNCA se restauran del JSON
            // guardado, para que las correcciones tras una reapertura se reflejen en el documento.
            const kardexPatientSyncedFields = new Set([
                "paciente", "asegurador", "documento", "direccion", "telefonos",
                "edad", "cie10", "diagnostico", "programador", "auxiliarAsignado"
            ]);

            const loadKardexPayload = (payload) => {
                if (!payload) return;
                if (payload.fields) {
                    Object.entries(payload.fields).forEach(([key, value]) => {
                        if (kardexPatientSyncedFields.has(key)) return;
                        if (key === "observaciones"
                            && String(value || "").trim() === getFormValue("ObservacionesPlanManejo")) {
                            const observationControl = document.querySelector("#censoKardexModal [data-kardex-field='observaciones']");
                            if (observationControl) observationControl.value = "";
                            return;
                        }
                        if (!value) return;
                        const control = document.querySelector(`#censoKardexModal [data-kardex-field='${key}']`);
                        if (control) control.value = value;
                    });
                }
                if (Array.isArray(payload.medRows)) {
                    payload.medRows.forEach((rowData) => {
                        const row = rowData.row;
                        Object.entries(rowData).forEach(([field, value]) => {
                            if (field === "row" || !value) return;
                            const control = document.querySelector(`#censoKardexModal [data-kardex-med-row='${row}'] [data-kardex-med-field='${field}']`);
                            if (control) control.value = value;
                        });
                    });
                }
            };

            // Igual que en el kardex: los datos del paciente de la requisición se sincronizan
            // siempre desde el formulario actual, no desde el JSON guardado.
            const requisitionPatientSyncedFields = new Set([
                "paciente", "documento", "direccion", "telefonos", "diagnostico",
                "autorizacion", "auxiliarEncargado", "realizadoPor"
            ]);

            const loadRequisitionPayload = (payload) => {
                if (!payload) return;
                if (payload.fields) {
                    Object.entries(payload.fields).forEach(([key, value]) => {
                        if (requisitionPatientSyncedFields.has(key)) return;
                        const control = document.querySelector(`#censoKardexModal [data-requisition-field='${key}']`);
                        if (control) control.value = value || "";
                    });
                }
                if (Array.isArray(payload.rows)) {
                    payload.rows.forEach((rowData, index) => {
                        const rowNum = index + 1;
                        Object.entries(rowData).forEach(([field, value]) => {
                            const control = document.querySelector(`#censoKardexModal [data-requisition-row='${rowNum}'] [data-requisition-item-field='${field}']`);
                            if (control) control.value = value || "";
                        });
                    });
                }
            };

            const getActiveProrroga = () => {
                if (!documentosState) return null;
                if (activeProrrogaVersionId) {
                    return (documentosState.prorrogas || []).find((p) => String(p.id) === String(activeProrrogaVersionId)) || null;
                }
                return documentosState.prorrogaJson
                    ? {
                        id: null,
                        numero: Number(documentosState.prorrogaNumero) || 1,
                        prorrogaJson: documentosState.prorrogaJson,
                        kardexJson: documentosState.prorrogaKardexJson,
                        requisicionJson: documentosState.prorrogaRequisicionJson,
                        cerrada: !!documentosState.prorrogaCerrada
                    }
                    : null;
            };

            const isProrrogaDocumentContext = () => {
                // El kardex/requisición se gestiona SIEMPRE según la sección activa:
                // Sección 3 (Plan de manejo) = atención original; Sección 8 (Prórroga) = prórroga.
                // No depende de banderas transitorias (activeProrrogaIsNewAdditional) para evitar que,
                // al gestionar la atención original, se cargue o guarde el kardex de una prórroga.
                return !!prorrogaTabPane?.classList.contains("active");
            };

            const getDocumentProrroga = () => {
                return isProrrogaDocumentContext() ? getActiveProrroga() : null;
            };

            const updateDocumentContextBadge = (savedProrroga) => {
                const badge = document.getElementById("censoDocumentContextBadge");
                if (!badge) return;
                if (isProrrogaDocumentContext()) {
                    const prorroga = getActiveProrroga();
                    let numero = Number(prorroga?.numero) || 0;
                    if (!numero && savedProrroga && typeof savedProrroga.numero !== "undefined") {
                        numero = Number(savedProrroga.numero) || 0;
                    }
                    if (!numero) {
                        const baseNumero = Number(documentosState?.maxProrrogaNumero)
                            || (documentosState?.prorrogaJson ? (Number(documentosState?.prorrogaNumero) || 1) : 0);
                        numero = activeProrrogaIsNewAdditional ? baseNumero + 1 : (baseNumero || 1);
                    }
                    badge.textContent = `Prórroga #${numero}`;
                    badge.classList.remove("censo-document-context-badge--original");
                    badge.classList.add("censo-document-context-badge--prorroga");
                } else {
                    badge.textContent = "Atención original";
                    badge.classList.remove("censo-document-context-badge--prorroga");
                    badge.classList.add("censo-document-context-badge--original");
                }
            };

            const isActiveDocumentClosed = () => {
                const prorroga = getDocumentProrroga();
                if (prorroga) return !!prorroga.cerrada;
                if (isProrrogaDocumentContext()) {
                    return !!documentosState?.prorrogaCerrada || !!initialProrrogaCerrada;
                }
                return !!documentosState?.principalCerrado || !!initialKardexInicialCerrado;
            };

            const setDocumentClosedMode = (closed) => {
                kardexModal?.classList.toggle("is-document-closed", closed);
                censoDocumentClosedBanner?.classList.toggle("d-none", !closed);
                document
                    .querySelectorAll("#censoKardexModal input, #censoKardexModal textarea, #censoKardexModal select")
                    .forEach((control) => {
                        if (control.id === "serviciosCargadosSwitch") {
                            control.disabled = closed;
                            return;
                        }

                        if (control.type === "hidden") return;
                        control.readOnly = closed;
                        if (control.matches("select, input[type=checkbox], input[type=radio]")) {
                            control.disabled = closed;
                        }
                    });

                if (guardarDocumentosBtn) guardarDocumentosBtn.disabled = closed;
                if (subirAdjuntoBtn) subirAdjuntoBtn.disabled = closed;
                if (enviarFarmaciaKardexBtn) enviarFarmaciaKardexBtn.disabled = closed || !(document.getElementById("serviciosCargadosSwitch")?.checked);
            };

            const setPlanManejoClosedMode = (closed) => {
                if (!planManejoTabPane) {
                    return;
                }

                planManejoTabPane.classList.toggle("is-plan-manejo-closed", closed);
                if (!closed) {
                    return;
                }

                if (!planManejoTabPane.querySelector(".censo-plan-manejo-closed-banner")) {
                    const banner = document.createElement("div");
                    banner.className = "alert alert-warning censo-plan-manejo-closed-banner mb-3";
                    banner.setAttribute("role", "alert");
                    banner.innerHTML = "<strong>Plan de manejo cerrado.</strong> El Kardex del ingreso inicial fue aprobado por farmacia. Solo permanecen editables los campos <strong>Estado</strong>, <strong>Autorización evento</strong> y <strong>Número de días autorizado</strong>.";
                    planManejoTabPane.querySelector(".card")?.before(banner);
                }

                planManejoTabPane.querySelectorAll("input:not([type=hidden]), textarea").forEach((control) => {
                    if (isClosedPlanEditableControl(control)) {
                        control.readOnly = false;
                        control.removeAttribute("aria-readonly");
                        return;
                    }
                    if (control.matches("input[type=checkbox], input[type=radio]")) {
                        control.style.pointerEvents = "none";
                        control.tabIndex = -1;
                    } else {
                        control.readOnly = true;
                    }
                    control.setAttribute("aria-readonly", "true");
                });
                planManejoTabPane.querySelectorAll("select:not(#estadoSelect)").forEach((control) => {
                    control.style.pointerEvents = "none";
                    control.tabIndex = -1;
                    control.setAttribute("aria-readonly", "true");
                });
                planManejoTabPane.querySelectorAll("button, a.btn").forEach((control) => {
                    control.style.pointerEvents = "none";
                    control.tabIndex = -1;
                    control.setAttribute("aria-disabled", "true");
                });

                if (planManejoTabLink && !planManejoTabLink.querySelector(".censo-nav__closed-badge")) {
                    const badge = document.createElement("span");
                    badge.className = "censo-nav__closed-badge";
                    badge.textContent = "Kardex cerrado";
                    planManejoTabLink.querySelector(".censo-nav__content")?.appendChild(badge);
                }
            };

            const loadDocumentosState = async (recordId) => {
                const resp = await fetch(`${obtenerDocumentosUrl}?id=${recordId}`);
                if (!resp.ok) return null;
                documentosState = await resp.json();
                setPlanManejoClosedMode(!!documentosState?.principalCerrado || !!initialKardexInicialCerrado);
                return documentosState;
            };

            const getLatestProrrogaOption = () => {
                if (!documentosState) return null;
                const versiones = (documentosState.prorrogas || [])
                    .filter((p) => p?.prorrogaJson)
                    .sort((a, b) => (Number(b.numero) || 0) - (Number(a.numero) || 0));

                if (versiones.length > 0) {
                    return { id: String(versiones[0].id) };
                }

                return documentosState.prorrogaJson ? { id: "" } : null;
            };

            const renderProrrogaVersionOptions = (preferLatest = false) => {
                if (!prorrogaVersionSelect || !documentosState) return;
                prorrogaVersionSelect.innerHTML = "";
                const latestOption = getLatestProrrogaOption();
                if (preferLatest && latestOption) {
                    activeProrrogaVersionId = latestOption.id || null;
                }

                let hasActiveOption = !activeProrrogaVersionId && !!documentosState.prorrogaJson;
                if (documentosState.prorrogaJson) {
                    const opt = document.createElement("option");
                    opt.value = "";
                    opt.textContent = `Prórroga #${Number(documentosState.prorrogaNumero) || 1}${documentosState.prorrogaCerrada ? " - cerrada" : ""}`;
                    prorrogaVersionSelect.appendChild(opt);
                }

                (documentosState.prorrogas || []).forEach((p) => {
                    const opt = document.createElement("option");
                    opt.value = String(p.id);
                    opt.textContent = `Prórroga #${p.numero}${p.cerrada ? " - cerrada" : ""}`;
                    prorrogaVersionSelect.appendChild(opt);
                    if (String(p.id) === String(activeProrrogaVersionId)) {
                        hasActiveOption = true;
                    }
                });

                if (!documentosState.prorrogaJson && (!documentosState.prorrogas || documentosState.prorrogas.length === 0)) {
                    const opt = document.createElement("option");
                    opt.value = "";
                    opt.textContent = "Sin prórrogas guardadas";
                    prorrogaVersionSelect.appendChild(opt);
                }

                if (!hasActiveOption) {
                    activeProrrogaVersionId = latestOption?.id || null;
                }
                prorrogaVersionSelect.value = activeProrrogaVersionId ? String(activeProrrogaVersionId) : "";
            };

            const updateProrrogaReadonlyMode = () => {
                const prorroga = getActiveProrroga();
                const closed = !activeProrrogaIsNewAdditional && !!prorroga?.cerrada;
                prorrogaTabPane?.classList.toggle("is-prorroga-closed", closed);
                prorrogaSoloLecturaBanner?.classList.toggle("d-none", !closed);
                if (prorrogaNumeroBadge) {
                    const baseNumero = Number(documentosState?.maxProrrogaNumero) || (documentosState?.prorrogaJson ? (Number(documentosState?.prorrogaNumero) || 1) : 0);
                    const nextNumber = (documentosState?.prorrogas || []).reduce((max, p) => Math.max(max, Number(p.numero) || 0), baseNumero) + 1;
                    prorrogaNumeroBadge.textContent = activeProrrogaIsNewAdditional
                        ? `Prórroga #${nextNumber}`
                        : prorroga
                            ? `Prórroga #${prorroga.numero}`
                            : "Prórroga #1";
                    prorrogaNumeroBadge.classList.remove("d-none");
                }

                document
                    .querySelectorAll("#tab-prorroga input, #tab-prorroga textarea, #tab-prorroga select, #guardarProrrogaBtn")
                    .forEach((control) => {
                        if (control.id === "prorrogaVersionSelect") return;
                        if (control.type === "hidden") return;
                        if (control.tagName === "BUTTON") {
                            control.disabled = closed;
                            return;
                        }
                        if (control.matches("select, input[type=checkbox], input[type=radio]")) {
                            control.disabled = closed;
                        } else {
                            control.readOnly = closed;
                        }
                    });
            };

            const clearProrrogaForm = () => {
                document
                    .querySelectorAll("#tab-prorroga input, #tab-prorroga select, #tab-prorroga textarea")
                    .forEach((control) => {
                        if (control.id === "prorrogaVersionSelect") return;
                        if (control.type === "radio" || control.type === "checkbox") {
                            control.checked = false;
                        } else {
                            control.value = "";
                        }
                    });
                ["prorrogaExtensionContainer", "prorrogaMed2Container", "prorrogaMed3Container", "prorrogaMed4Container", "prorrogaMed5Container", "prorrogaMed6Container"]
                    .forEach((id) => document.getElementById(id)?.classList.add("d-none"));
            };

            const loadSelectedProrrogaIntoForm = () => {
                if (activeProrrogaIsNewAdditional) {
                    clearProrrogaForm();
                    updateProrrogaReadonlyMode();
                    return;
                }

                const prorroga = getActiveProrroga();
                clearProrrogaForm();
                if (prorroga?.prorrogaJson && typeof loadProrrogaPayload === "function") {
                    try { loadProrrogaPayload(JSON.parse(prorroga.prorrogaJson)); } catch { }
                }
                updateProrrogaReadonlyMode();
            };

            const kardexModal = document.getElementById("censoKardexModal");
            if (kardexModal) {
                kardexModal.addEventListener("show.bs.modal", async () => {
                    const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                    let savedKardex = null;
                    let savedRequisicion = null;
                    let savedProrroga = null;
                    if (recordId > 0) {
                        try {
                            const saved = await loadDocumentosState(recordId);
                            renderProrrogaVersionOptions();
                            const activeProrroga = getDocumentProrroga();
                            if (activeProrroga) {
                                savedKardex = activeProrroga.kardexJson ? JSON.parse(activeProrroga.kardexJson) : null;
                                savedRequisicion = activeProrroga.requisicionJson ? JSON.parse(activeProrroga.requisicionJson) : null;
                                savedProrroga = activeProrroga.prorrogaJson ? JSON.parse(activeProrroga.prorrogaJson) : null;
                            } else if (saved) {
                                savedKardex = saved.kardexJson ? JSON.parse(saved.kardexJson) : null;
                                savedRequisicion = saved.requisicionJson ? JSON.parse(saved.requisicionJson) : null;
                            }
                        } catch { /* fallback to form sync */ }
                    }
                    if (savedProrroga) {
                        // Prórroga activa: base desde datos de prórroga, luego aplicar todos los ajustes guardados
                        syncKardexFromProrroga(savedProrroga);
                        syncRequisitionFromProrroga(savedProrroga);
                        if (savedKardex) loadKardexPayload(savedKardex);
                        if (savedRequisicion) loadRequisitionPayload(savedRequisicion);
                    } else {
                        syncKardexSheet();
                        if (savedKardex) loadKardexPayload(savedKardex);
                        syncRequisitionSheet();
                        if (savedRequisicion) loadRequisitionPayload(savedRequisicion);
                    }
                    updateDocumentContextBadge(savedProrroga);
                    loadAdjuntos(recordId);
                    if (adjuntoUploadStatus) adjuntoUploadStatus.textContent = "";
                    const serviciosCargadosSwitch = document.getElementById("serviciosCargadosSwitch");
                    if (serviciosCargadosSwitch) {
                        serviciosCargadosSwitch.checked = false;
                        if (enviarFarmaciaKardexBtn) enviarFarmaciaKardexBtn.disabled = true;
                    }
                    setDocumentClosedMode(isActiveDocumentClosed());
                    updateReaperturaControls();
                });
            }

            const solicitarReaperturaBtn = document.getElementById("solicitarReaperturaBtn");
            const aprobarReaperturaBtn = document.getElementById("aprobarReaperturaBtn");
            const rechazarReaperturaBtn = document.getElementById("rechazarReaperturaBtn");
            const reaperturaStatusNote = document.getElementById("reaperturaStatusNote");
            const reaperturaModalEl = document.getElementById("censoReaperturaModal");

            // Determina el documento activo del modal (principal / prórroga base / versión) y su solicitud pendiente.
            const getReaperturaContext = () => {
                if (isProrrogaDocumentContext()) {
                    if (activeProrrogaVersionId) {
                        const version = (documentosState?.prorrogas || [])
                            .find((p) => String(p.id) === String(activeProrrogaVersionId));
                        return {
                            payload: { documentoProrroga: true, prorrogaVersionId: String(activeProrrogaVersionId) },
                            solicitud: version?.reaperturaSolicitud || null
                        };
                    }
                    return {
                        payload: { documentoProrroga: true },
                        solicitud: documentosState?.reaperturaProrrogaBase || null
                    };
                }
                return {
                    payload: {},
                    solicitud: documentosState?.reaperturaPrincipal || null
                };
            };

            const updateReaperturaControls = () => {
                if (!solicitarReaperturaBtn) return;
                const closed = isActiveDocumentClosed();
                const ctx = getReaperturaContext();
                const pendiente = !!(ctx.solicitud && ctx.solicitud.estado === "Pendiente");

                solicitarReaperturaBtn.classList.toggle("d-none", !(closed && !pendiente));

                if (reaperturaStatusNote) {
                    if (pendiente) {
                        const quien = ctx.solicitud.solicitante ? ` por ${ctx.solicitud.solicitante}` : "";
                        reaperturaStatusNote.textContent = `Reapertura solicitada${quien} — pendiente de aprobación.`;
                    }
                    reaperturaStatusNote.classList.toggle("d-none", !pendiente);
                }

                const puedeGestionar = pendiente && puedeAprobarReapertura;
                aprobarReaperturaBtn?.classList.toggle("d-none", !puedeGestionar);
                rechazarReaperturaBtn?.classList.toggle("d-none", !puedeGestionar);
            };

            const postReapertura = async (url, extraFields) => {
                const formData = new FormData();
                Object.entries(extraFields || {}).forEach(([k, v]) => formData.append(k, String(v)));
                const response = await fetch(url, {
                    method: "POST",
                    body: formData,
                    headers: csrfTokenInput?.value ? { "RequestVerificationToken": csrfTokenInput.value } : {}
                });
                const data = await response.json().catch(() => ({}));
                return { ok: response.ok, data };
            };

            if (solicitarReaperturaBtn && reaperturaModalEl) {
                solicitarReaperturaBtn.addEventListener("click", () => {
                    document.querySelectorAll("#reaperturaMotivosContainer input[name='reaperturaMotivo']").forEach((r) => { r.checked = false; });
                    document.getElementById("reaperturaMotivoError")?.classList.add("d-none");
                    if (window.bootstrap && window.bootstrap.Modal) {
                        window.bootstrap.Modal.getOrCreateInstance(reaperturaModalEl).show();
                    }
                });

                const confirmarReaperturaBtn = document.getElementById("confirmarReaperturaBtn");
                confirmarReaperturaBtn?.addEventListener("click", async () => {
                    const seleccionado = document.querySelector("#reaperturaMotivosContainer input[name='reaperturaMotivo']:checked");
                    if (!seleccionado) {
                        document.getElementById("reaperturaMotivoError")?.classList.remove("d-none");
                        return;
                    }
                    const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                    if (recordId <= 0) return;
                    const ctx = getReaperturaContext();
                    confirmarReaperturaBtn.disabled = true;
                    try {
                        const { ok, data } = await postReapertura(solicitarReaperturaUrl, {
                            id: recordId,
                            motivo: seleccionado.value,
                            ...ctx.payload
                        });
                        if (window.bootstrap && window.bootstrap.Modal) {
                            window.bootstrap.Modal.getOrCreateInstance(reaperturaModalEl).hide();
                        }
                        if (!ok) {
                            showFeedbackModal("No se pudo solicitar", `<p class="mb-0">${escapeHtml(data.message || "Error al solicitar la reapertura.")}</p>`, "danger");
                            return;
                        }
                        await loadDocumentosState(recordId);
                        updateReaperturaControls();
                        showFeedbackModal("Solicitud enviada", `<p class="mb-0">${escapeHtml(data.message || "Solicitud de reapertura enviada.")}</p>`, "success");
                    } finally {
                        confirmarReaperturaBtn.disabled = false;
                    }
                });
            }

            if (aprobarReaperturaBtn) {
                aprobarReaperturaBtn.addEventListener("click", async () => {
                    const ctx = getReaperturaContext();
                    if (!ctx.solicitud) return;
                    aprobarReaperturaBtn.disabled = true;
                    try {
                        const { ok, data } = await postReapertura(aprobarReaperturaUrl, { solicitudId: ctx.solicitud.id });
                        if (!ok) {
                            showFeedbackModal("No se pudo aprobar", `<p class="mb-0">${escapeHtml(data.message || "Error al aprobar la reapertura.")}</p>`, "danger");
                            return;
                        }
                        // Recargar la página para desbloquear completamente las secciones 1, 2 y 3.
                        window.location.reload();
                    } finally {
                        aprobarReaperturaBtn.disabled = false;
                    }
                });
            }

            if (rechazarReaperturaBtn) {
                rechazarReaperturaBtn.addEventListener("click", async () => {
                    const ctx = getReaperturaContext();
                    if (!ctx.solicitud) return;
                    rechazarReaperturaBtn.disabled = true;
                    try {
                        const { ok, data } = await postReapertura(rechazarReaperturaUrl, { solicitudId: ctx.solicitud.id });
                        if (!ok) {
                            showFeedbackModal("No se pudo rechazar", `<p class="mb-0">${escapeHtml(data.message || "Error al rechazar la reapertura.")}</p>`, "danger");
                            return;
                        }
                        const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                        if (recordId > 0) await loadDocumentosState(recordId);
                        updateReaperturaControls();
                        showFeedbackModal("Solicitud rechazada", `<p class="mb-0">${escapeHtml(data.message || "Solicitud de reapertura rechazada.")}</p>`, "success");
                    } finally {
                        rechazarReaperturaBtn.disabled = false;
                    }
                });
            }

            const serviciosCargadosSwitch = document.getElementById("serviciosCargadosSwitch");
            if (serviciosCargadosSwitch) {
                serviciosCargadosSwitch.addEventListener("change", () => {
                    if (enviarFarmaciaKardexBtn) enviarFarmaciaKardexBtn.disabled = isActiveDocumentClosed() || !serviciosCargadosSwitch.checked;
                });
            }

            const enviarFarmaciaWrapper = document.getElementById("enviarFarmaciaKardexBtnWrapper");
            if (enviarFarmaciaWrapper) {
                enviarFarmaciaWrapper.addEventListener("click", () => {
                    if (enviarFarmaciaKardexBtn?.disabled) {
                        if (isActiveDocumentClosed()) {
                            showFeedbackModal(
                                "Kardex cerrado",
                                "<p class=\"mb-0\">Este kardex y su requisición ya fueron aprobados por farmacia. Están disponibles solo para consulta.</p>",
                                "warning");
                            return;
                        }

                        showFeedbackModal(
                            "Servicios no cargados",
                            "<p class=\"mb-0\">Primero tienes que cargar los servicios. Activa el interruptor <strong>Servicios cargados</strong> para poder enviar a farmacia.</p>",
                            "warning");
                    }
                });
            }

            const documentSwitchButtons = Array.from(document.querySelectorAll("#censoKardexModal [data-censo-document-target]"));
            const documentPanes = Array.from(document.querySelectorAll("#censoKardexModal [data-censo-document-pane]"));
            const switchCensoDocumentPane = (target) => {
                documentSwitchButtons.forEach((button) => {
                    const isActive = button.dataset.censoDocumentTarget === target;
                    button.classList.toggle("active", isActive);
                    button.setAttribute("aria-selected", isActive ? "true" : "false");
                });
                documentPanes.forEach((pane) => {
                    pane.classList.toggle("active", pane.dataset.censoDocumentPane === target);
                });
            };

            documentSwitchButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    switchCensoDocumentPane(button.dataset.censoDocumentTarget || "kardex");
                });
            });

            if (guardarDocumentosBtn) {
                guardarDocumentosBtn.addEventListener("click", async () => {
                    const recordId = Number(editingRecordIdInput?.value || "0") || 0;
                    if (recordId <= 0) {
                        showFeedbackModal("Guarda el censo primero", "<p class=\"mb-0\">Necesitas guardar el registro antes de poder guardar los documentos.</p>", "warning");
                        return;
                    }
                    if (isActiveDocumentClosed()) {
                        showFeedbackModal("Kardex cerrado", "<p class=\"mb-0\">Este kardex y su requisición ya fueron aprobados por farmacia y no se pueden editar.</p>", "warning");
                        return;
                    }
                    if (isProrrogaDocumentContext() && activeProrrogaIsNewAdditional && !activeProrrogaVersionId) {
                        showFeedbackModal("Guarda la prórroga primero", "<p class=\"mb-0\">Antes de gestionar el kardex de una nueva prórroga, guárdala en la sección <strong>Prórroga o cambio</strong>.</p>", "warning");
                        return;
                    }
                    guardarDocumentosBtn.disabled = true;
                    try {
                        const formData = new FormData();
                        formData.append("id", String(recordId));
                        formData.append("kardexJson", JSON.stringify(collectKardexPayload()));
                        formData.append("requisicionJson", JSON.stringify(collectRequisitionPayload()));
                        if (isProrrogaDocumentContext()) {
                            formData.append("documentoProrroga", "true");
                        }
                        if (isProrrogaDocumentContext() && activeProrrogaVersionId) {
                            formData.append("prorrogaVersionId", String(activeProrrogaVersionId));
                        }
                        const response = await fetch(guardarDocumentosUrl, {
                            method: "POST",
                            body: formData,
                            headers: csrfTokenInput?.value ? { "RequestVerificationToken": csrfTokenInput.value } : {}
                        });
                        const data = await response.json().catch(() => ({}));
                        if (!response.ok) {
                            showFeedbackModal("Error al guardar", `<p class="mb-0">${escapeHtml(data.message || "No se pudo guardar.")}</p>`, "danger");
                            return;
                        }
                        showFeedbackModal("Guardado", `<p class="mb-0">${escapeHtml(data.message || "Documentos guardados correctamente.")}</p>`, "success");
                    } finally {
                        guardarDocumentosBtn.disabled = false;
                    }
                });
            }

            const syncSelectPlaceholderState = (select) => {
                if (!select) {
                    return;
                }

                const hasValue = String(select.value || "").trim().length > 0;
                select.classList.toggle("is-placeholder", !hasValue);
            };

            const ensureHiddenPlaceholderOption = (select, placeholderText = "Selecciona...") => {
                if (!select) {
                    return;
                }

                let firstOption = select.options.length > 0 ? select.options[0] : null;
                const firstValue = firstOption ? String(firstOption.value || "").trim() : "";
                const firstText = firstOption ? String(firstOption.textContent || "").trim() : "";
                const firstLooksLikePlaceholder = firstOption
                    && firstValue === ""
                    && firstText.toLowerCase().startsWith("selecciona");

                if (!firstLooksLikePlaceholder && !Array.from(select.options).some((option) => String(option.value || "").trim() === "")) {
                    const placeholderOption = document.createElement("option");
                    placeholderOption.value = "";
                    placeholderOption.textContent = placeholderText;
                    select.insertBefore(placeholderOption, select.firstChild);
                    firstOption = placeholderOption;
                }

                if (firstOption && String(firstOption.value || "").trim() === "") {
                    firstOption.disabled = true;
                    firstOption.hidden = true;
                    if (!String(select.value || "").trim()) {
                        select.value = "";
                        firstOption.selected = true;
                    }
                }

                syncSelectPlaceholderState(select);
            };

            const initializeCensoSelectPlaceholders = () => {
                censoSelects.forEach((select) => {
                    ensureHiddenPlaceholderOption(select);
                    select.addEventListener("change", () => syncSelectPlaceholderState(select));
                });
            };

            const redirectToCedulaFilter = (cedula) => {
                const url = new URL(indexUrl, window.location.origin);
                if (cedula) {
                    url.searchParams.set("cedulaPaciente", cedula);
                }

                window.location.assign(url.toString());
            };

            const stripHtml = (value) => String(value || "").replace(/<[^>]+>/g, " ").trim();

            const openSectionTab = (tabLinkId) => {
                if (!tabLinkId) {
                    return;
                }

                const tabLink = document.getElementById(tabLinkId);
                if (!tabLink) {
                    return;
                }

                if (window.bootstrap && window.bootstrap.Tab) {
                    window.bootstrap.Tab.getOrCreateInstance(tabLink).show();
                    return;
                }

                tabLink.click();
            };

            const showFeedbackModal = (title, bodyHtml, tone) => {
                if (!feedbackModalElement || !feedbackModalTitle || !feedbackModalBody || !feedbackModalHeader) {
                    window.alert(`${title}\n${stripHtml(bodyHtml)}`);
                    return;
                }

                feedbackModalTitle.textContent = title;
                feedbackModalBody.innerHTML = bodyHtml;
                feedbackModalHeader.classList.remove("bg-success-subtle", "text-success-emphasis", "bg-danger-subtle", "text-danger-emphasis", "bg-warning-subtle", "text-warning-emphasis");

                if (tone === "success") {
                    feedbackModalHeader.classList.add("bg-success-subtle", "text-success-emphasis");
                } else if (tone === "danger") {
                    feedbackModalHeader.classList.add("bg-danger-subtle", "text-danger-emphasis");
                } else {
                    feedbackModalHeader.classList.add("bg-warning-subtle", "text-warning-emphasis");
                }

                if (window.bootstrap && window.bootstrap.Modal) {
                    window.bootstrap.Modal.getOrCreateInstance(feedbackModalElement).show();
                    return;
                }

                window.alert(`${title}\n${stripHtml(bodyHtml)}`);
            };

            let lastNewAdmissionDocument = "";
            let lastNewAdmissionResult = null;
            let currentOpenAttention = null;
            let pendingNewAdmissionGuidance = null;
            let guidanceRedirectUrl = "";
            let allowValidatedNewAdmissionSubmit = false;
            let newAdmissionValidationPromise = null;
            let newAdmissionValidationDocument = "";

            const isCreatingNewAdmission = () => !Number(editingRecordIdInput?.value || "0");

            const resetNewAdmissionValidation = () => {
                lastNewAdmissionDocument = "";
                lastNewAdmissionResult = null;
                currentOpenAttention = null;
            };

            const showNewAdmissionConflict = (attention) => {
                currentOpenAttention = attention || null;
                if (nuevoIngresoConflictDetail) {
                    const details = [
                        attention?.nombrePaciente ? `Paciente: ${attention.nombrePaciente}` : "",
                        attention?.estado ? `Estado actual: ${attention.estado}` : "",
                        attention?.recordId ? `Registro #${attention.recordId}` : ""
                    ].filter((value) => value);
                    nuevoIngresoConflictDetail.textContent = details.join(" · ");
                }

                if (nuevoIngresoConflictModalElement && window.bootstrap?.Modal) {
                    if (!nuevoIngresoConflictModalElement.classList.contains("show")) {
                        window.bootstrap.Modal.getOrCreateInstance(nuevoIngresoConflictModalElement).show();
                    }
                    return;
                }

                const isNewEvent = window.confirm("¿Estás seguro de que esta atención es un evento nuevo?");
                const message = isNewEvent
                    ? "Cierre la atención anterior de este paciente."
                    : "Diligencia el nuevo medicamento como prórroga de la atención abierta.";
                window.alert(message);
                const targetUrl = isNewEvent ? attention?.estadoUrl : attention?.prorrogaUrl;
                if (targetUrl) window.location.assign(targetUrl);
            };

            const validateNewAdmissionDocument = async (forceRefresh = false) => {
                if (!isCreatingNewAdmission()) {
                    return true;
                }

                const documentNumber = normalizeDocumentValue(numeroIdentificacionInput?.value || "");
                if (!documentNumber) {
                    return true;
                }

                if (!forceRefresh
                    && lastNewAdmissionDocument === documentNumber
                    && lastNewAdmissionResult) {
                    if (lastNewAdmissionResult.hasOpenAttention) {
                        showNewAdmissionConflict(lastNewAdmissionResult.attention);
                        return false;
                    }
                    return true;
                }

                try {
                    if (!newAdmissionValidationPromise || newAdmissionValidationDocument !== documentNumber) {
                        newAdmissionValidationDocument = documentNumber;
                        newAdmissionValidationPromise = (async () => {
                            const url = new URL(validarNuevoIngresoUrl, window.location.origin);
                            url.searchParams.set("numeroDocumento", documentNumber);
                            const response = await fetch(url.toString(), {
                                headers: { "Accept": "application/json" }
                            });
                            const data = await response.json().catch(() => ({}));
                            if (!response.ok) {
                                throw new Error(data.message || "No fue posible validar el documento.");
                            }
                            return data;
                        })();
                    }

                    const result = await newAdmissionValidationPromise;
                    if (normalizeDocumentValue(numeroIdentificacionInput?.value || "") !== documentNumber) {
                        return true;
                    }

                    lastNewAdmissionDocument = documentNumber;
                    lastNewAdmissionResult = result;
                    if (result.hasOpenAttention) {
                        showNewAdmissionConflict(result.attention);
                        return false;
                    }

                    return true;
                } catch (error) {
                    showFeedbackModal(
                        "No se pudo validar el documento",
                        `<p class="mb-0">${escapeHtml(error?.message || "Intenta nuevamente antes de guardar el ingreso.")}</p>`,
                        "warning");
                    return false;
                } finally {
                    if (newAdmissionValidationDocument === documentNumber) {
                        newAdmissionValidationPromise = null;
                        newAdmissionValidationDocument = "";
                    }
                }
            };

            const queueNewAdmissionGuidance = (isNewEvent) => {
                if (!currentOpenAttention) {
                    return;
                }

                pendingNewAdmissionGuidance = {
                    message: isNewEvent
                        ? "Cierre la atención anterior de este paciente."
                        : "Diligencia el nuevo medicamento como prórroga de la atención abierta.",
                    targetUrl: isNewEvent
                        ? currentOpenAttention.estadoUrl
                        : currentOpenAttention.prorrogaUrl
                };

                if (nuevoIngresoConflictModalElement && window.bootstrap?.Modal) {
