                        <input class="form-control censo-filter-panel__input" id="cedulaFiltroInput" name="cedulaPaciente" value="@Model.CedulaFiltro" inputmode="text" maxlength="20" placeholder="Ingrese documento" />
                        <span class="censo-filter-panel__search-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="m20 20-3.5-3.5"></path>
                            </svg>
                        </span>
                    </div>
                    <div class="censo-filter-panel__actions">
