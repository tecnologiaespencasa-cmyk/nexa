@model CensoAtencionViewModel
@using Nexa.Data.Entities
@using Nexa.Helpers
@{
    // Banda de una atención cerrada, dentro de la ficha del paciente.
    //
    // Dice una sola cosa —qué atención es y cómo se cerró— y ofrece la única acción que cambia
    // eso: reabrirla. Antes explicaba además qué secciones seguían diligenciables; se quitó por
    // fatiga de lectura, y porque la pantalla ya lo demuestra sola: las secciones bloqueadas se
    // ven apagadas y sin botón de guardar, y las que siguen vivas conservan el suyo.
    if (Model is null || Model.Abierta)
    {
        return;
    }

    var cedula = ViewData["CedulaFiltro"] as string;
    var puedeReabrir = ViewData["PuedeReabrir"] as bool? ?? false;
}

<div class="censo-atencion-cerrada" role="note">
    <svg class="censo-atencion-cerrada__candado" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="4" y="11" width="16" height="9" rx="2"></rect>
        <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
    </svg>
    <p class="censo-atencion-cerrada__titulo">
        Atención @Model.Numero, cerrada@(Model.Hasta is { } h ? $" el {h:dd/MM/yyyy}" : string.Empty)@(string.IsNullOrWhiteSpace(Model.Estado) ? string.Empty : $" · {Model.Estado}")
    </p>
@if (puedeReabrir)
{
    @* Único botón de la ficha que devuelve a editable una atención dada de alta. Lleva el color
       del sistema y no el del programa: no es navegar dentro del paciente, es cambiarle el
       estado. Solo se dibuja con el permiso de reapertura, el mismo del kardex. *@
    <form asp-action="ReabrirAtencion" method="post" class="censo-atencion-cerrada__accion"
          data-censo-reabrir="@CensoProgramas.Nombre(Model.Programa)"
          data-censo-reabrir-numero="@Model.Numero">
        @Html.AntiForgeryToken()
        <input type="hidden" name="episodioId" value="@Model.EpisodioId" />
        <input type="hidden" name="cedulaPaciente" value="@cedula" />
        <button type="submit" class="censo-boton censo-boton--reabrir">Reabrir atención</button>
    </form>
}
</div>
