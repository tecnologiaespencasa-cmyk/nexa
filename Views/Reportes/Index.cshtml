@model IntranetPrueba.Models.ViewModels.ReportesDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Reportes";

    var culture = new CultureInfo("es-CO");
    var desdeValue = Model.Filters.Desde?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var hastaValue = Model.Filters.Hasta?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var gestionTotal = Model.TotalGestionesPendientes + Model.TotalGestionesCompletas;
    var gestionPendienteShare = gestionTotal == 0 ? 0 : Math.Round(Model.TotalGestionesPendientes * 100d / gestionTotal, 2);
    var gestionCompletaShare = gestionTotal == 0 ? 0 : Math.Round(Model.TotalGestionesCompletas * 100d / gestionTotal, 2);
}

@section Styles {
    <link rel="stylesheet" href="~/css/reportes.css" asp-append-version="true" />
}

<div class="reportes-shell mt-4 mb-5">
    <section class="reportes-command">
        <div class="reportes-title-block">
            <span class="reportes-kicker">Centro de mando</span>
            <h1>Reportes dinámicos integrados</h1>
            <p>Integra el censo operativo con las novedades del Portal Administrativo para priorizar gestión, autorización y tiempos de respuesta.</p>
        </div>
        <div class="reportes-generated-at">
            <span>Actualizado</span>
            <strong>@Model.GeneratedAtLocal.ToString("dd 'de' MMMM yyyy, hh:mm tt", culture)</strong>
        </div>
    </section>

    <form class="reportes-filter-bar" method="get" asp-controller="Reportes" asp-action="Index">
        <label>
            <span>Desde</span>
            <input type="date" name="Desde" value="@desdeValue" />
        </label>
        <label>
            <span>Hasta</span>
            <input type="date" name="Hasta" value="@hastaValue" />
        </label>
        <label>
            <span>Municipio</span>
            <select name="Municipio" asp-items="Model.FilterOptions.Municipios"></select>
        </label>
        <label>
            <span>Programa</span>
            <select name="Programa" asp-items="Model.FilterOptions.Programas"></select>
        </label>
        <label>
            <span>Gestión</span>
            <select name="EstadoGestion" asp-items="Model.FilterOptions.EstadosGestion"></select>
        </label>
        <label>
            <span>Tipo de novedad</span>
            <select name="TipoNovedad" asp-items="Model.FilterOptions.TiposNovedad"></select>
        </label>
        <label>
            <span>Estado Censo Agudos</span>
            <select name="EstadoCenso" asp-items="Model.FilterOptions.EstadosCenso"></select>
        </label>
        <div class="reportes-filter-actions">
            <button type="submit">Aplicar</button>
            <a asp-controller="Reportes" asp-action="Index">Limpiar</a>
        </div>
    </form>

    @if (Model.ActiveFilterLabels.Count > 0)
    {
        <div class="reportes-filter-chips" aria-label="Filtros activos">
            @foreach (var filter in Model.ActiveFilterLabels)
            {
                <span>@filter</span>
            }
        </div>
    }

    <section class="reportes-kpi-grid">
        <article class="reportes-kpi-card reportes-kpi-card--ink">
            <span class="reportes-source reportes-source--censo">Censo Agudos</span>
            <span class="reportes-kpi-title">Registros analizados</span>
            <strong class="reportes-kpi-value">@Model.TotalRegistrosCenso.ToString("N0", culture)</strong>
            <span class="reportes-kpi-caption">Base filtrada del tablero</span>
        </article>
        <article class="reportes-kpi-card">
            <span class="reportes-source reportes-source--portal">Portal Administrativo</span>
            <span class="reportes-kpi-title">Novedades reportadas</span>
            <strong class="reportes-kpi-value">@Model.TotalNovedades.ToString("N0", culture)</strong>
            <span class="reportes-kpi-caption">@Model.PorcentajeResolucionNovedades.ToString("0.##", culture)% con cierre</span>
        </article>
        <article class="reportes-kpi-card">
            <span class="reportes-source reportes-source--censo">Censo Agudos</span>
            <span class="reportes-kpi-title">Sin autorización</span>
            <strong class="reportes-kpi-value">@Model.TotalEventosPendientesSinAutorizacion.ToString("N0", culture)</strong>
            <span class="reportes-kpi-caption">Eventos pendientes de autorización</span>
        </article>
        <article class="reportes-kpi-card">
            <span class="reportes-source reportes-source--censo">Censo Agudos</span>
            <span class="reportes-kpi-title">Gestión pendiente</span>
            <strong class="reportes-kpi-value">@Model.TotalGestionesPendientes.ToString("N0", culture)</strong>
            <span class="reportes-kpi-caption">@Model.PorcentajeGestionPendiente.ToString("0.##", culture)% del periodo</span>
        </article>
        <article class="reportes-kpi-card">
            <span class="reportes-source reportes-source--portal">Portal Administrativo</span>
            <span class="reportes-kpi-title">Resolución promedio</span>
            <strong class="reportes-kpi-value">@Model.PromedioResolucionDisplay</strong>
            <span class="reportes-kpi-caption">@Model.TotalNovedadesResueltas.ToString("N0", culture) novedades resueltas</span>
        </article>
    </section>

    <section class="reportes-grid reportes-grid--wide-left">
        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Portal Administrativo</span>
                    <h2>Novedades reportadas por día</h2>
                </div>
                <div class="reportes-chart-metrics">
                    <div>
                        <span>Total</span>
                        <strong>@Model.TotalNovedades.ToString("N0", culture)</strong>
                    </div>
                    <div class="reportes-chart-average">
                        <span>Promedio por día</span>
                        <strong>@Model.PromedioNovedadesPorDia.ToString("N0", culture)</strong>
                    </div>
                </div>
            </div>

            @if (Model.TotalNovedades == 0)
            {
                <p class="reportes-empty">Sin novedades para el filtro actual.</p>
            }
            else
            {
                <div class="reportes-chart-frame">
                    <div class="reportes-y-axis" aria-label="Escala de 0 a @Model.NovedadesPorDia.ScaleMax">
                        @foreach (var tick in Model.NovedadesPorDia.ScaleTicks)
                        {
                            <span>@tick.ToString("N0", culture)</span>
                        }
                    </div>
                    <div class="reportes-column-chart">
                        @foreach (var point in Model.NovedadesPorDia.Points)
                        {
                            <div class="reportes-column">
                                <div class="reportes-column-track">
                                    <span style="height:@point.Percentage.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                                </div>
                                <strong>@point.Value.ToString("N0", culture)</strong>
                                <small>@point.Label</small>
                            </div>
                        }
                    </div>
                </div>
            }

        </article>

        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Portal Administrativo</span>
                    <h2>Novedades por tipo</h2>
                </div>
            </div>

            @if (Model.NovedadesPorTipo.Count == 0)
            {
                <p class="reportes-empty">Sin novedades para el filtro actual.</p>
            }
            else
            {
                <ul class="reportes-bars">
                    @foreach (var item in Model.NovedadesPorTipo)
                    {
                        <li>
                            <div>
                                <strong>@item.Label</strong>
                                <span>@item.Value.ToString("N0", culture) (@item.Percentage.ToString("0.##", culture)%)</span>
                            </div>
                            <div class="reportes-bar-track">
                                <span style="width:@item.BarWidthCss; background:@item.Color"></span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>

    <section class="reportes-grid reportes-grid--even">
        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Censo Agudos</span>
                    <h2>Ingresos por día</h2>
                </div>
                <div class="reportes-chart-metrics">
                    <div>
                        <span>Total</span>
                        <strong>@Model.TotalIngresosPeriodo.ToString("N0", culture)</strong>
                    </div>
                    <div class="reportes-chart-average">
                        <span>Promedio por día</span>
                        <strong>@Model.PromedioIngresosPorDia.ToString("N0", culture)</strong>
                    </div>
                </div>
            </div>

            <div class="reportes-chart-frame">
                <div class="reportes-y-axis" aria-label="Escala de 0 a @Model.IngresosPorDia.ScaleMax">
                    @foreach (var tick in Model.IngresosPorDia.ScaleTicks)
                    {
                        <span>@tick.ToString("N0", culture)</span>
                    }
                </div>
                <div class="reportes-column-chart reportes-column-chart--compact">
                    @foreach (var point in Model.IngresosPorDia.Points)
                    {
                        <div class="reportes-column reportes-column--green">
                            <div class="reportes-column-track">
                                <span style="height:@point.Percentage.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                            </div>
                            <strong>@point.Value.ToString("N0", culture)</strong>
                            <small>@point.Label</small>
                        </div>
                    }
                </div>
            </div>
        </article>

        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Censo Agudos</span>
                    <h2>Gestión pendiente vs completa</h2>
                </div>
            </div>

            <div class="reportes-progress-track">
                <span class="reportes-progress-segment reportes-progress-segment--pending" style="width:@gestionPendienteShare.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                <span class="reportes-progress-segment reportes-progress-segment--complete" style="width:@gestionCompletaShare.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
            </div>

            <div class="reportes-progress-metrics">
                <div>
                    <strong>@Model.TotalGestionesPendientes.ToString("N0", culture)</strong>
                    <span>Pendiente (@gestionPendienteShare.ToString("0.##", culture)%)</span>
                </div>
                <div>
                    <strong>@Model.TotalGestionesCompletas.ToString("N0", culture)</strong>
                    <span>Completa (@gestionCompletaShare.ToString("0.##", culture)%)</span>
                </div>
            </div>

            <div class="reportes-alert-strip">
                <strong>@Model.TotalPendientesCriticos.ToString("N0", culture)</strong>
                <span>pendientes críticos: sin autorización y con gestión pendiente.</span>
            </div>
        </article>
    </section>

    <section class="reportes-grid reportes-grid--wide-left">
        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Terapias ambulatorias</span>
                    <h2>Ingresos por día</h2>
                </div>
                <div class="reportes-chart-metrics">
                    <div>
                        <span>Total</span>
                        <strong>@Model.TotalIngresosTerapiaAmbulatoriaPeriodo.ToString("N0", culture)</strong>
                    </div>
                    <div class="reportes-chart-average">
                        <span>Promedio por día</span>
                        <strong>@Model.PromedioIngresosTerapiaAmbulatoriaPorDia.ToString("N0", culture)</strong>
                    </div>
                </div>
            </div>

            <div class="reportes-chart-frame">
                <div class="reportes-y-axis" aria-label="Escala de 0 a @Model.IngresosTerapiaAmbulatoriaPorDia.ScaleMax">
                    @foreach (var tick in Model.IngresosTerapiaAmbulatoriaPorDia.ScaleTicks)
                    {
                        <span>@tick.ToString("N0", culture)</span>
                    }
                </div>
                <div class="reportes-column-chart reportes-column-chart--compact">
                    @foreach (var point in Model.IngresosTerapiaAmbulatoriaPorDia.Points)
                    {
                        <div class="reportes-column reportes-column--therapy">
                            <div class="reportes-column-track">
                                <span style="height:@point.Percentage.ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                            </div>
                            <strong>@point.Value.ToString("N0", culture)</strong>
                            <small>@point.Label</small>
                        </div>
                    }
                </div>
            </div>
        </article>

        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Terapias ambulatorias</span>
                    <h2>Ingresos por tipo</h2>
                </div>
            </div>

            @if (Model.IngresosTerapiaAmbulatoriaPorTipo.Count == 0)
            {
                <p class="reportes-empty">Sin ingresos por tipo para el filtro actual.</p>
            }
            else
            {
                <ul class="reportes-bars">
                    @foreach (var item in Model.IngresosTerapiaAmbulatoriaPorTipo)
                    {
                        <li>
                            <div>
                                <strong>@item.Label</strong>
                                <span>@item.Value.ToString("N0", culture) (@item.Percentage.ToString("0.##", culture)%)</span>
                            </div>
                            <div class="reportes-bar-track">
                                <span style="width:@item.BarWidthCss; background:@item.Color"></span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>

    <section class="reportes-grid reportes-grid--even">
        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Portal Administrativo</span>
                    <h2>Promedio por tipo de novedad</h2>
                </div>
            </div>

            @if (Model.ResolucionPorTipo.Count == 0)
            {
                <p class="reportes-empty">No hay novedades resueltas para el filtro actual.</p>
            }
            else
            {
                <ul class="reportes-resolution-list">
                    @foreach (var item in Model.ResolucionPorTipo)
                    {
                        <li>
                            <div>
                                <strong>@item.Type</strong>
                                <span>@item.ResolvedCount.ToString("N0", culture) resueltas</span>
                            </div>
                            <div class="reportes-resolution-meter">
                                <span style="width:@item.BarWidthCss"></span>
                            </div>
                            <em>@item.AverageDisplay</em>
                        </li>
                    }
                </ul>
            }
        </article>

        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Censo Agudos</span>
                    <h2>Eventos sin autorización por responsable</h2>
                </div>
            </div>

            @if (Model.EventosPendientesPorAuxiliar.Count == 0)
            {
                <p class="reportes-empty">No hay eventos sin autorización para el filtro actual.</p>
            }
            else
            {
                <ul class="reportes-bars">
                    @foreach (var item in Model.EventosPendientesPorAuxiliar.Take(10))
                    {
                        <li>
                            <div>
                                <strong>@item.Label</strong>
                                <span>@item.Value.ToString("N0", culture) eventos</span>
                            </div>
                            <div class="reportes-bar-track">
                                <span style="width:@item.BarWidthCss; background:@item.Color"></span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </article>
    </section>

    <section class="reportes-grid reportes-grid--wide-right">
        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Censo Agudos</span>
                    <h2>Focos operativos por municipio</h2>
                </div>
            </div>

            @if (Model.FocosOperativos.Count == 0)
            {
                <p class="reportes-empty">Sin focos operativos para mostrar.</p>
            }
            else
            {
                <div class="reportes-focus-list">
                    @foreach (var item in Model.FocosOperativos)
                    {
                        <article>
                            <div class="reportes-focus-title">
                                <strong>@item.Label</strong>
                                <span>@item.Records.ToString("N0", culture) casos</span>
                            </div>
                            <div class="reportes-focus-meter">
                                <span style="width:@Math.Max(5, item.Percentage).ToString("0.##", CultureInfo.InvariantCulture)%"></span>
                            </div>
                            <div class="reportes-focus-stats">
                                <span>@item.PendingManagement.ToString("N0", culture) pendientes</span>
                                <span>@item.WithoutAuthorization.ToString("N0", culture) sin autorización</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </article>

        <article class="reportes-card">
            <div class="reportes-card-header">
                <div>
                    <span>Censo Agudos</span>
                    <h2>Registros para revisar</h2>
                </div>
            </div>

            @if (Model.RegistrosPrioritarios.Count == 0)
            {
                <p class="reportes-empty">No hay registros prioritarios para el filtro actual.</p>
            }
            else
            {
                <div class="reportes-table-wrap">
                    <table class="reportes-table">
                        <thead>
                            <tr>
                                <th>Paciente</th>
                                <th>Municipio</th>
                                <th>Auxiliar</th>
                                <th>Alerta</th>
                                <th>Gestión</th>
                                <th>Ingreso</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.RegistrosPrioritarios)
                            {
                                <tr>
                                    <td>
                                        <strong>@row.Paciente</strong>
                                        <span>@row.Documento</span>
                                    </td>
                                    <td>@row.Municipio</td>
                                    <td>@row.Auxiliar</td>
                                    <td>
                                        <span class="reportes-status @(row.SinAutorizacion ? "is-warning" : null)">@row.Alerta</span>
                                    </td>
                                    <td>@row.EstadoGestion</td>
                                    <td>@row.FechaBase.ToString("dd/MM/yyyy", culture)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    </section>
</div>
