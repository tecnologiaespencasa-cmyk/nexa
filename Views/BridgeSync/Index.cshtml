@model BridgeSyncIndexViewModel
@{
    ViewData["Title"] = "Puente Supabase";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
    var run = Model.LastRun;

    var origenListo = Model.PatientsAvailable > 0;
    var transporteListo = Model.IsConfigured;
    var destinoListo = run is { DryRun: false, BatchesSent: > 0 };
}

@section Styles {
    <link rel="stylesheet" href="~/css/bridge-sync.css" asp-append-version="true" />
}

<div class="bridge-page">
    <div class="mb-4">
        <h1 class="h3 mb-1 bridge-page__title">Puente Supabase</h1>
        <p class="text-muted small mb-0">
            Env&iacute;a los pacientes de cl&iacute;nica de heridas a la base puente. En Supabase solo queda el HMAC del
            documento y del nombre: ni el documento real, ni el nombre real, ni ning&uacute;n dato cl&iacute;nico.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-check-circle-fill mt-1" aria-hidden="true"></i>
            <div>@successMessage</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
            <div>@errorMessage</div>
        </div>
    }

    @* El diagrama no es decorativo: cada tramo muestra el estado real de esa etapa. *@
    <section class="bridge-flow mb-4" aria-label="Estado del flujo de datos">
        <div class="bridge-flow__stage">
            <span class="bridge-flow__step">Origen</span>
            <p class="bridge-flow__name">Censo de cl&iacute;nica de heridas</p>
            <p class="bridge-flow__detail">Pacientes &uacute;nicos por documento en la intranet.</p>
            <span class="bridge-flow__state @(origenListo ? "" : "bridge-flow__state--pending")">
                <span class="bridge-flow__dot" aria-hidden="true"></span>
                @if (Model.PatientsAvailableError is not null)
                {
                    <text>Sin lectura</text>
                }
                else
                {
                    <text>@Model.PatientsAvailable paciente(s)</text>
                }
            </span>
        </div>

        <div class="bridge-flow__stage">
            <span class="bridge-flow__step">Transporte</span>
            <p class="bridge-flow__name">HTTPS con firma HMAC</p>
            <p class="bridge-flow__detail">
                Cada lote viaja firmado con <code>BRIDGE_API_SECRET</code> y caduca a los 5 minutos.
            </p>
            <span class="bridge-flow__state @(transporteListo ? "" : "bridge-flow__state--broken")">
                <span class="bridge-flow__dot" aria-hidden="true"></span>
                @(transporteListo ? "Credenciales cargadas" : "Faltan credenciales")
            </span>
        </div>

        <div class="bridge-flow__stage">
            <span class="bridge-flow__step">Puerta</span>
            <p class="bridge-flow__name">Edge Function</p>
            <p class="bridge-flow__detail">
                @(string.IsNullOrWhiteSpace(Model.ProjectHost) ? "Proyecto sin definir" : Model.ProjectHost)
                / @Model.FunctionName
            </p>
            <span class="bridge-flow__state @(transporteListo ? "" : "bridge-flow__state--pending")">
                <span class="bridge-flow__dot" aria-hidden="true"></span>
                @(Model.HashInIntranet ? "Recibe HMAC ya calculado" : "Calcula el HMAC")
            </span>
        </div>

        <div class="bridge-flow__stage">
            <span class="bridge-flow__step">Destino</span>
            <p class="bridge-flow__name">bridge.pacientes_heridas</p>
            <p class="bridge-flow__detail">Dos columnas: documento_hmac y nombre_hmac.</p>
            <span class="bridge-flow__state @(destinoListo ? "" : "bridge-flow__state--pending")">
                <span class="bridge-flow__dot" aria-hidden="true"></span>
                @(destinoListo ? "Escritura confirmada" : "Todavia sin escrituras")
            </span>
        </div>
    </section>

    @if (!Model.IsConfigured)
    {
        <div class="alert alert-warning" role="alert">
            <p class="fw-semibold mb-2">Falta configurar el puente antes de sincronizar.</p>
            <p class="mb-2 small">Define estos valores en User Secrets (local) o en variables de entorno (Azure):</p>
            <ul class="small mb-0">
                @if (string.IsNullOrWhiteSpace(Model.ProjectHost))
                {
                    <li><code>SupabaseBridge:ProjectUrl</code> &mdash; URL del proyecto de Supabase.</li>
                }
                @if (!Model.HasApiSecret)
                {
                    <li><code>SupabaseBridge:ApiSecret</code> &mdash; el mismo valor que <code>BRIDGE_API_SECRET</code> en Supabase.</li>
                }
                @if (Model.HashInIntranet && !Model.HasHmacSecret)
                {
                    <li><code>SupabaseBridge:HmacSecret</code> &mdash; requerido porque el HMAC se calcula en la intranet.</li>
                }
            </ul>
        </div>
    }

    @* La numeraci&oacute;n es real: la puesta en marcha se hace en este orden. *@
    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-4">
            <div class="bridge-step">
                <span class="bridge-step__index">Paso 1</span>
                <h2 class="bridge-step__title">Prueba con un paciente</h2>
                <p class="bridge-step__text">
                    Env&iacute;a un solo paciente y comprueba en Supabase que la fila tiene &uacute;nicamente dos valores hexadecimales.
                </p>
                <div class="bridge-step__actions">
                    <form asp-action="Ejecutar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="limite" value="1" />
                        <input type="hidden" name="simulacion" value="false" />
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(!Model.IsConfigured)">
                            Enviar 1 paciente
                        </button>
                    </form>
                    <form asp-action="Ejecutar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="limite" value="1" />
                        <input type="hidden" name="simulacion" value="true" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Simular sin enviar</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="bridge-step">
                <span class="bridge-step__index">Paso 2</span>
                <h2 class="bridge-step__title">Amplia a cinco</h2>
                <p class="bridge-step__text">
                    Repite con cinco pacientes para confirmar que el lote se procesa completo y que no se crean duplicados.
                </p>
                <div class="bridge-step__actions">
                    <form asp-action="Ejecutar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="limite" value="5" />
                        <input type="hidden" name="simulacion" value="false" />
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(!Model.IsConfigured)">
                            Enviar 5 pacientes
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="bridge-step">
                <span class="bridge-step__index">Paso 3</span>
                <h2 class="bridge-step__title">Sincroniza el censo completo</h2>
                <p class="bridge-step__text">
                    Env&iacute;a los @Model.PatientsAvailable paciente(s) en lotes de @Model.BatchSize. Puedes repetirlo cuando quieras:
                    los documentos ya existentes se actualizan, no se duplican.
                </p>
                <div class="bridge-step__actions">
                    <form asp-action="Ejecutar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="limite" value="0" />
                        <input type="hidden" name="simulacion" value="false" />
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@(!Model.IsConfigured)">
                            Enviar todos
                        </button>
                    </form>
                    <form asp-action="Ejecutar" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="limite" value="0" />
                        <input type="hidden" name="simulacion" value="true" />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Simular sin enviar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (run is not null)
    {
        <section class="card border-0 shadow-sm mb-4" aria-label="Resultado de la ultima ejecucion">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                    <div>
                        <h2 class="h5 mb-1">&Uacute;ltima ejecuci&oacute;n</h2>
                        <p class="text-muted small mb-0">@Model.LastRunTitle &middot; @run.DurationMs ms</p>
                    </div>
                    @if (run.DryRun)
                    {
                        <span class="badge text-bg-secondary">Simulaci&oacute;n</span>
                    }
                    else if (run.BatchesFailed > 0)
                    {
                        <span class="badge text-bg-danger">Con errores</span>
                    }
                    else
                    {
                        <span class="badge text-bg-success">Correcta</span>
                    }
                </div>

                <div class="row g-2">
                    <div class="col-6 col-lg-2">
                        <div class="bridge-metric">
                            <div class="bridge-metric__label">Encontrados</div>
                            <div class="bridge-metric__value">@run.PatientsFound</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="bridge-metric">
                            <div class="bridge-metric__label">Enviados</div>
                            <div class="bridge-metric__value">@run.PatientsSent</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="bridge-metric">
                            <div class="bridge-metric__label">Procesados</div>
                            <div class="bridge-metric__value">@run.PatientsProcessed</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="bridge-metric">
                            <div class="bridge-metric__label">Nuevos</div>
                            <div class="bridge-metric__value">@run.Inserted</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="bridge-metric">
                            <div class="bridge-metric__label">Actualizados</div>
                            <div class="bridge-metric__value">@run.Updated</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="bridge-metric">
                            <div class="bridge-metric__label">Lotes</div>
                            <div class="bridge-metric__value">@run.BatchesSent<span class="fs-6 text-muted">/@(run.BatchesSent + run.BatchesFailed)</span></div>
                        </div>
                    </div>
                </div>

                @if (run.Errors.Count > 0)
                {
                    <div class="mt-3">
                        <p class="fw-semibold small mb-1">Detalle t&eacute;cnico</p>
                        <ul class="small text-danger mb-0">
                            @foreach (var error in run.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </section>
    }

    <section class="card border-0 shadow-sm" aria-label="Como verificar la proteccion de los datos">
        <div class="card-body">
            <h2 class="h6 mb-2">C&oacute;mo comprobar que el dato queda protegido</h2>
            <ol class="bridge-note mb-0 ps-3">
                <li class="mb-1">
                    En Supabase abre el SQL Editor y ejecuta
                    <code>select * from bridge.pacientes_heridas limit 5;</code>
                    Debes ver solo dos columnas con 64 caracteres hexadecimales cada una.
                </li>
                <li class="mb-1">
                    Busca un documento real con
                    <code>select count(*) from bridge.pacientes_heridas where documento_hmac = '&lt;documento&gt;';</code>
                    El resultado siempre es 0: el valor real no est&aacute; almacenado.
                </li>
                <li>
                    En los registros de la Edge Function solo aparecen requestId, conteos y duraci&oacute;n. Nunca documentos,
                    nombres ni HMAC.
                </li>
            </ol>
        </div>
    </section>
</div>
