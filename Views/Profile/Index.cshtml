@model ProfileIndexViewModel
@{
    ViewData["Title"] = "Mi perfil";
}

<section class="profile-page">
    <div class="profile-heading">
        <div>
            <p class="profile-heading__eyebrow">Configuración personal</p>
            <h1>Mi perfil</h1>
            <p>Administra tu foto, correo electrónico y contraseña de acceso.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success profile-alert" role="alert">@successMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <article class="profile-card profile-summary-card">
                <img class="profile-summary-photo" src="@Url.Action("Photo", "Profile")" alt="Foto de perfil de @Model.FullName" />
                <div>
                    <h2>@Model.FullName</h2>
                    <span class="profile-role-badge">@Model.RoleName</span>
                </div>
                <dl class="profile-details">
                    <div>
                        <dt>Usuario</dt>
                        <dd>@Model.Username</dd>
                    </div>
                    <div>
                        <dt>Correo actual</dt>
                        <dd>@Model.Email</dd>
                    </div>
                </dl>
            </article>
        </div>

        <div class="col-lg-8">
            <div class="profile-settings-grid">
                <article class="profile-card">
                    <div class="profile-card__heading">
                        <span class="profile-card__icon"><i class="bi bi-person-circle"></i></span>
                        <div>
                            <h2>Foto de perfil</h2>
                            <p>Usa una imagen clara para identificarte en la intranet.</p>
                        </div>
                    </div>
                    <form asp-action="ChangePhoto" method="post" enctype="multipart/form-data" class="profile-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="profile-photo-editor">
                            <div class="profile-photo-editor__preview" aria-label="Vista previa del encuadre">
                                <img src="@Url.Action("Photo", "Profile")" alt="Vista previa de la foto de perfil" data-profile-photo-preview />
                            </div>
                            <div class="profile-photo-editor__controls">
                                <label asp-for="PhotoChange.Photo" class="form-label"></label>
                                <input asp-for="PhotoChange.Photo" class="form-control" accept="image/jpeg,image/png,image/webp" data-profile-photo-input />
                                <span asp-validation-for="PhotoChange.Photo" class="text-danger"></span>

                                <label asp-for="PhotoChange.VerticalPosition" class="form-label mt-3"></label>
                                <input asp-for="PhotoChange.VerticalPosition" type="range" class="form-range" min="0" max="100" step="1" data-profile-photo-position />
                                <div class="profile-photo-editor__range-labels" aria-hidden="true">
                                    <span>Mostrar más arriba</span>
                                    <span>Mostrar más abajo</span>
                                </div>
                                <span asp-validation-for="PhotoChange.VerticalPosition" class="text-danger"></span>
                                <p class="form-text">Ajusta el encuadre vertical para centrar tu rostro. La vista previa muestra exactamente la zona que se guardará.</p>
                            </div>
                        </div>
                        <p class="form-text mb-0">JPG, PNG o WEBP. Máximo 5 MB. Se guarda una imagen cuadrada optimizada de 320 × 320 px.</p>
                        <button type="submit" class="btn btn-primary">Actualizar foto</button>
                    </form>
                </article>

                <article class="profile-card">
                    <div class="profile-card__heading">
                        <span class="profile-card__icon"><i class="bi bi-envelope"></i></span>
                        <div>
                            <h2>Correo electrónico</h2>
                            <p>Confirma tu contraseña actual para realizar este cambio.</p>
                        </div>
                    </div>
                    <form asp-action="ChangeEmail" method="post" class="profile-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="EmailChange.NewEmail" class="form-label"></label>
                                <input asp-for="EmailChange.NewEmail" class="form-control" autocomplete="email" />
                                <span asp-validation-for="EmailChange.NewEmail" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmailChange.CurrentPassword" class="form-label"></label>
                                <input asp-for="EmailChange.CurrentPassword" class="form-control" autocomplete="current-password" />
                                <span asp-validation-for="EmailChange.CurrentPassword" class="text-danger"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Guardar correo</button>
                    </form>
                </article>

                <article class="profile-card">
                    <div class="profile-card__heading">
                        <span class="profile-card__icon"><i class="bi bi-shield-lock"></i></span>
                        <div>
                            <h2>Contraseña</h2>
                            <p>Elige una contraseña nueva de al menos 8 caracteres.</p>
                        </div>
                    </div>
                    <form asp-action="ChangePassword" method="post" class="profile-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="PasswordChange.CurrentPassword" class="form-label"></label>
                                <input asp-for="PasswordChange.CurrentPassword" class="form-control" autocomplete="current-password" />
                                <span asp-validation-for="PasswordChange.CurrentPassword" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PasswordChange.NewPassword" class="form-label"></label>
                                <input asp-for="PasswordChange.NewPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="PasswordChange.NewPassword" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="PasswordChange.ConfirmPassword" class="form-label"></label>
                                <input asp-for="PasswordChange.ConfirmPassword" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="PasswordChange.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
                    </form>
                </article>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
