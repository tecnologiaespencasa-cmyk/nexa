@model EspacioActaFirmaViewModel
@{
    ViewData["Title"] = "Firmar acta";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/espacio-corporativo.css" asp-append-version="true" />
}

<section class="espacio">

    <header class="espacio-hero">
        <div class="espacio-shell">
            <div class="espacio-hero__grid">
                <div>
                    <span class="espacio-hero__eyebrow">
                        <i class="bi bi-vector-pen" aria-hidden="true"></i>
                        Nueva acta &middot; Paso 2 de 2
                    </span>
                    <h1>Revisa y firma</h1>
                    <p>
                        Verifica el documento antes de firmar.
                        @if (!string.IsNullOrWhiteSpace(Model.CorreoRecibe))
                        {
                            <text>Al firmar se enviar&aacute; la copia a <strong>@Model.CorreoRecibe</strong>.</text>
                        }
                    </p>
                </div>
                <div class="espacio-hero__actions">
                    <a class="espacio-admin-btn" asp-action="ActaNueva" asp-route-codigo="@Model.PlantillaCodigo">
                        <i class="bi bi-arrow-left" aria-hidden="true"></i>
                        Corregir datos
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="espacio-shell">

        @await Html.PartialAsync("_EspacioAlertas")

        @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
        {
            <div class="espacio-alert espacio-alert--error" role="alert">
                <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                <span>@Model.MensajeError</span>
            </div>
        }

        <form asp-action="ActaEmitir" method="post" id="espacioActaEmitirForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="plantillaCodigo" value="@Model.PlantillaCodigo" />
            <input type="hidden" name="firmaRecibeDataUrl" />
            <input type="hidden" name="firmaEmiteDataUrl" />

            @* Los valores viajan de nuevo para que el acta se renderice igual al emitirla. *@
            @foreach (var par in Model.Valores)
            {
                <input type="hidden" name="valores[@par.Key]" value="@par.Value" />
            }

            @* ══ PREVISUALIZACIÓN ══ *@
            <section class="espacio-panel">
                <div class="espacio-panel__head">
                    <div class="espacio-panel__title">
                        <span class="espacio-panel__icon espacio-panel__icon--info"><i class="bi bi-file-earmark-text-fill" aria-hidden="true"></i></span>
                        <div>
                            <h2>Documento</h2>
                            <span>@Model.PlantillaNombre</span>
                        </div>
                    </div>
                    <span class="espacio-doc-card__meta">@Model.Fecha.ToString("dd/MM/yyyy")</span>
                </div>

                <div class="espacio-panel__body">
                    <article class="espacio-acta-hoja">
                        <header class="espacio-acta-hoja__head">
                            <img src="~/images/especialistas-en-casa-logo.png" alt="Especialistas en Casa" />
                            <h1>@Model.TituloActa</h1>
                        </header>

                        @* Cuerpo renderizado en servidor: los valores del formulario ya vienen codificados. *@
                        <div class="espacio-acta-cuerpo">
                            @Html.Raw(Model.CuerpoHtml)
                        </div>

                        <div class="espacio-acta-firmas">
                            <div class="espacio-acta-firma">
                                <div class="espacio-acta-firma__imagen" id="vistaFirmaEmite">
                                    @if (!string.IsNullOrWhiteSpace(Model.FirmaEmiteDataUrl))
                                    {
                                        <img src="@Model.FirmaEmiteDataUrl" alt="Firma de quien entrega" />
                                    }
                                </div>
                                <div class="espacio-acta-firma__linea"></div>
                                <strong>@Model.EmitidaPorNombre</strong>
                                <span>@Model.EmitidaPorCargo</span>
                                @if (!string.IsNullOrWhiteSpace(Model.EmitidaPorDocumento))
                                {
                                    <span>C.C. @Model.EmitidaPorDocumento</span>
                                }
                                <span>Entrega</span>
                            </div>

                            <div class="espacio-acta-firma">
                                <div class="espacio-acta-firma__imagen" id="vistaFirmaRecibe"></div>
                                <div class="espacio-acta-firma__linea"></div>
                                <strong>@Model.NombreRecibe</strong>
                                @if (!string.IsNullOrWhiteSpace(Model.DocumentoRecibe))
                                {
                                    <span>C.C. @Model.DocumentoRecibe</span>
                                }
                                <span>@Model.RotuloRecibe</span>
                            </div>
                        </div>
                    </article>
                </div>
            </section>

            @* ══ FIRMAS ══ *@
            <section class="espacio-panel">
                <div class="espacio-panel__head">
                    <div class="espacio-panel__title">
                        <span class="espacio-panel__icon"><i class="bi bi-vector-pen" aria-hidden="true"></i></span>
                        <div>
                            <h2>Firmas</h2>
                            <span>La firma se refleja en el documento de arriba</span>
                        </div>
                    </div>
                </div>

                <div class="espacio-panel__body">
                    @if (Model.TieneFirmaGuardada)
                    {
                        <div class="espacio-firma-guardada">
                            <img src="@Model.FirmaEmiteDataUrl" alt="Firma guardada" />
                            <div>
                                <strong>@Model.EmitidaPorNombre</strong>
                                <span>Tu firma guardada &mdash; se aplica autom&aacute;ticamente.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="espacio-firma-bloque">
                            <div class="espacio-firma-bloque__head">
                                <span>Tu firma (&aacute;rea de TI) <span class="req">*</span></span>
                                <button type="button" class="espacio-btn espacio-btn--soft espacio-btn--sm" data-firma-limpiar="emiteCanvas">
                                    Limpiar
                                </button>
                            </div>
                            <div class="espacio-firma-pad">
                                <canvas id="emiteCanvas" aria-label="Firma de quien entrega"></canvas>
                            </div>
                            <label class="espacio-switch mt-2">
                                <input type="checkbox" name="guardarFirmaEmite" value="true" checked />
                                <span>Guardar esta firma para no volver a trazarla</span>
                            </label>
                        </div>
                    }

                    <div class="espacio-firma-bloque">
                        <div class="espacio-firma-bloque__head">
                            <span>Firma de @Model.NombreRecibe <span class="req">*</span></span>
                            <button type="button" class="espacio-btn espacio-btn--soft espacio-btn--sm" data-firma-limpiar="recibeCanvas">
                                Limpiar
                            </button>
                        </div>
                        <div class="espacio-firma-pad">
                            <canvas id="recibeCanvas" aria-label="Firma de quien recibe"></canvas>
                        </div>
                    </div>

                    <p class="espacio-acta-aviso" id="espacioEmitirAviso" hidden></p>

                    <div class="d-flex gap-2 flex-wrap mt-4">
                        <button type="submit" class="espacio-btn espacio-btn--primary" id="espacioEmitirBoton">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            Firmar y enviar copia
                        </button>
                        <a class="espacio-btn espacio-btn--soft" asp-action="Actas">Cancelar</a>
                    </div>
                </div>
            </section>
        </form>
    </div>
</section>

@section Scripts
{
    <script src="~/js/espacio-corporativo.js" asp-append-version="true"></script>
}
