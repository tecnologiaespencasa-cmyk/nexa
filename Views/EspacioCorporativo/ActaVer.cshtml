@model EspacioActaEmitidaDocumentoViewModel
@{
    ViewData["Title"] = Model.TituloActa;
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.TituloActa - Acta @Model.Id</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; }

        body {
            background: #f3f5f8;
            color: #24272e;
            font-family: "Nunito", "Segoe UI", sans-serif;
            margin: 0;
            padding: 2rem 1rem;
        }

        .hoja {
            background: #fff;
            border-radius: 14px;
            box-shadow: 0 18px 40px rgba(20, 25, 35, 0.1);
            margin: 0 auto;
            max-width: 830px;
            padding: 2.4rem 2.7rem 2.8rem;
        }

        .hoja-encabezado {
            align-items: flex-start;
            border-bottom: 3px solid #e53935;
            display: flex;
            gap: 1.5rem;
            justify-content: space-between;
            padding-bottom: 1.1rem;
        }

        .hoja-encabezado img { height: 56px; width: auto; }

        .hoja-encabezado h1 {
            color: #a50f0f;
            font-size: 1.2rem;
            font-weight: 800;
            margin: 0;
            text-align: right;
            text-transform: uppercase;
        }

        .hoja-encabezado span {
            color: #7b8490;
            display: block;
            font-size: 0.8rem;
            font-weight: 700;
            text-align: right;
        }

        .cuerpo { font-size: 0.94rem; line-height: 1.68; text-align: justify; }

        .cuerpo h2 {
            color: #a50f0f;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: 0.09em;
            margin: 1.7rem 0 0.6rem;
            text-align: left;
            text-transform: uppercase;
        }

        .cuerpo ul { margin: 0.4rem 0; padding-left: 1.4rem; }

        .cuerpo li { margin-bottom: 0.3rem; }

        .cuerpo a { color: #1a5fa8; word-break: break-all; }

        .firmas { display: flex; gap: 2.6rem; margin-top: 2.8rem; }

        .firma { flex: 1 1 0; text-align: center; }

        .firma img { display: block; height: 92px; margin: 0 auto; max-width: 100%; object-fit: contain; }

        .firma-linea { border-top: 1.5px solid #24272e; margin: 0.2rem auto 0.5rem; }

        .firma strong { display: block; font-size: 0.92rem; }

        .firma span { color: #7b8490; display: block; font-size: 0.8rem; font-weight: 600; }

        .pie {
            border-top: 1px solid #eceff3;
            color: #8a929c;
            font-size: 0.74rem;
            margin-top: 2.2rem;
            padding-top: 0.8rem;
            text-align: center;
        }

        .acciones {
            display: flex;
            gap: 0.6rem;
            justify-content: center;
            margin: 0 auto 1.4rem;
            max-width: 830px;
        }

        .boton {
            background: linear-gradient(135deg, #e53935, #a50f0f);
            border: 0;
            border-radius: 11px;
            color: #fff;
            cursor: pointer;
            font-family: inherit;
            font-size: 0.9rem;
            font-weight: 800;
            padding: 0.6rem 1.15rem;
            text-decoration: none;
        }

        .boton--claro { background: #fff; box-shadow: 0 6px 16px rgba(20, 25, 35, 0.1); color: #4b5563; }

        @@media print {
            body { background: #fff; padding: 0; }
            .hoja { box-shadow: none; max-width: none; padding: 0; }
            .acciones { display: none; }
        }
    </style>
</head>
<body>
    <div class="acciones">
        <button type="button" class="boton" onclick="window.print()">Imprimir o guardar en PDF</button>
        <a class="boton boton--claro" href="@Url.Action("Actas")">Volver a Actas</a>
    </div>

    <article class="hoja">
        <header class="hoja-encabezado">
            <img src="~/images/especialistas-en-casa-logo.png" alt="Especialistas en Casa" />
            <div>
                <h1>@Model.TituloActa</h1>
                <span>Acta N&deg; @Model.Id &middot; @Model.FechaFirma.ToString("dd/MM/yyyy hh:mm tt")</span>
            </div>
        </header>

        @* El cuerpo se guardo ya renderizado y con los valores codificados al emitir el acta. *@
        <div class="cuerpo">
            @Html.Raw(Model.CuerpoHtml)
        </div>

        <div class="firmas">
            <div class="firma">
                <img src="@Model.FirmaEmiteDataUrl" alt="Firma de quien entrega" />
                <div class="firma-linea"></div>
                <strong>@Model.EmitidaPorNombre</strong>
                <span>@(string.IsNullOrWhiteSpace(Model.EmitidaPorCargo) ? "Área de Tecnología" : Model.EmitidaPorCargo)</span>
                @if (!string.IsNullOrWhiteSpace(Model.EmitidaPorDocumento))
                {
                    <span>C.C. @Model.EmitidaPorDocumento</span>
                }
                <span>Entrega</span>
            </div>

            <div class="firma">
                <img src="@Model.FirmaRecibeDataUrl" alt="Firma de quien recibe" />
                <div class="firma-linea"></div>
                <strong>@Model.NombreRecibe</strong>
                @if (!string.IsNullOrWhiteSpace(Model.DocumentoRecibe))
                {
                    <span>C.C. @Model.DocumentoRecibe</span>
                }
                <span>@Model.RotuloRecibe</span>
            </div>
        </div>

        <p class="pie">
            Documento generado electr&oacute;nicamente por Nexa &middot; Especialistas en Casa.
            Las firmas fueron capturadas de forma digital al momento de la entrega.
        </p>
    </article>
</body>
</html>
