<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas funcionales del disenador de actas. No forma parte de la solucion
       de la aplicacion: se ejecuta a mano con
       "dotnet run" apuntando a esta carpeta. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nexa.Pruebas.ActaDisenador</RootNamespace>
    <AssemblyName>PruebasActaDisenador</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nexa.csproj" />
  </ItemGroup>

</Project>
